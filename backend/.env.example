# Application Settings
PROJECT_NAME="ScamShield"
ENVIRONMENT="development"

# PostgreSQL Database URL
# Default local PostgreSQL credentials:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/scamshield"
# For isolated local testing without running PostgreSQL:
# DATABASE_URL="sqlite:///./test_scamshield.db"

# Multilingual Configuration for Senior Citizens
SUPPORTED_LANGUAGES='["en", "hi", "mr"]'
DEFAULT_LANGUAGE="en"

# CORS for React Native Local Dev
BACKEND_CORS_ORIGINS='["http://localhost:3000", "http://localhost:8081", "http://10.0.2.2:8000"]'

