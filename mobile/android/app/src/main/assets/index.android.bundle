d\u0937\u093e)",statusActive:"\u092a\u0930\u093f\u091c\u0928 \u0938\u0947 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u091c\u0941\u0921\u093c\u0947 \u0939\u0941\u090f \u0939\u0948\u0902",generateCodeButton:"\ud83d\udd11 6-\u0905\u0902\u0915\u0940\u092f \u092a\u0947\u092f\u0930\u093f\u0902\u0917 \u0915\u094b\u0921 \u092c\u0928\u093e\u090f\u0902",pairingCodeLabel:"\u0906\u092a\u0915\u093e 6-\u0905\u0902\u0915\u0940\u092f \u092a\u0947\u092f\u0930\u093f\u0902\u0917 \u0915\u094b\u0921",pairingCodeExpires:"15 \u092e\u093f\u0928\u091f \u0915\u0947 \u0932\u093f\u090f \u092e\u093e\u0928\u094d\u092f\u0964 \u092f\u0939 \u0915\u094b\u0921 \u0905\u092a\u0928\u0947 \u0935\u093f\u0936\u094d\u0935\u0938\u0928\u0940\u092f \u092a\u0930\u093f\u091c\u0928 \u0915\u0947 \u0938\u093e\u0925 \u0938\u093e\u091d\u093e \u0915\u0930\u0947\u0902\u0964",shareCodeHint:"\u0905\u092a\u0928\u0947 \u092a\u0930\u093f\u091c\u0928 \u0938\u0947 \u0915\u0939\u0947\u0902 \u0915\u093f \u0935\u0947 \u0905\u092a\u0928\u0947 \u0938\u094d\u0915\u0948\u092e\u0936\u0940\u0932\u094d\u0921 \u0910\u092a \u092e\u0947\u0902 \u092f\u0939 \u0915\u094b\u0921 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902\u0964",shareInviteButton:"\ud83d\udce4 \u0935\u094d\u0939\u093e\u091f\u094d\u0938\u090f\u092a / \u090f\u0938\u090f\u092e\u090f\u0938 \u0938\u0947 \u0906\u092e\u0902\u0924\u094d\u0930\u0923 \u0938\u093e\u091d\u093e \u0915\u0930\u0947\u0902",copyCodeButton:"\ud83d\udccb \u0915\u094b\u0921 \u0915\u0949\u092a\u0940 \u0915\u0930\u0947\u0902",cloudRelayTitle:"\u0915\u094d\u0932\u093e\u0909\u0921 \u0938\u092e\u0928\u094d\u0935\u092f \u0938\u094d\u0925\u093f\u0924\u093f",cloudRelayStatus:"\u0915\u094d\u0932\u093e\u0909\u0921 \u0930\u093f\u0932\u0947 \u0938\u0930\u094d\u0935\u0930: \u0911\u092b\u093c\u0932\u093e\u0907\u0928 / \u0938\u094d\u0925\u093e\u0928\u0940\u092f \u092e\u094b\u0921\u0964 \u0926\u0942\u0930\u0938\u094d\u0925 \u092a\u0941\u0936 \u0905\u0932\u0930\u094d\u091f \u0915\u0947 \u0932\u093f\u090f \u0915\u094d\u0932\u093e\u0909\u0921 \u0938\u0930\u094d\u0935\u0930 \u0915\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0939\u094b\u0924\u0940 \u0939\u0948\u0964 \u0938\u094d\u0925\u093e\u0928\u0940\u092f \u0938\u0939\u092e\u0924\u093f \u0915\u094b\u0921 \u0938\u0915\u094d\u0930\u093f\u092f \u0939\u0948\u0964",manualConfirmTitle:"\u092e\u0948\u0928\u094d\u092f\u0941\u0905\u0932 \u0930\u0942\u092a \u0938\u0947 \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930\u0947\u0902",manualConfirmDesc:"\u092f\u0926\u093f \u0906\u092a\u0915\u0947 \u092a\u0930\u093f\u091c\u0928 \u0928\u0947 \u0915\u094b\u0921 \u0926\u0930\u094d\u091c \u0915\u0930 \u0932\u093f\u092f\u093e \u0939\u0948, \u0924\u094b \u0928\u0940\u091a\u0947 \u0938\u0947 \u092a\u0941\u0937\u094d\u091f\u093f \u0915\u0930\u0947\u0902:",manualConfirmButton:"\u2713 \u092a\u0930\u093f\u091c\u0928 \u091c\u0941\u0921\u093c\u0947 \u0939\u094b\u0928\u0947 \u0915\u0940 \u092a\u0941\u0937\u094d\u091f\u093f \u0915\u0930\u0947\u0902",caregiverRelationDisplay:"\u0938\u0902\u092c\u0902\u0927: {{relation}}",pairedAtDisplay:"\u0938\u094d\u0928\u0947\u0939 \u0914\u0930 \u0938\u0924\u0930\u094d\u0915\u0924\u093e \u0915\u0947 \u0938\u093e\u0925 \u0906\u092a\u0915\u0940 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u092e\u0947\u0902 \u0938\u0902\u0932\u0917\u094d\u0928\u0964",activeCaregiverLabel:"\u0938\u0915\u094d\u0930\u093f\u092f \u0935\u093f\u0936\u094d\u0935\u0938\u0928\u0940\u092f \u092a\u0930\u093f\u091c\u0928",caregiverGuardingSince:"\u0938\u094d\u0928\u0947\u0939 \u0914\u0930 \u0938\u0924\u0930\u094d\u0915\u0924\u093e \u0915\u0947 \u0938\u093e\u0925 \u0906\u092a\u0915\u0940 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u092e\u0947\u0902 \u0938\u0902\u0932\u0917\u094d\u0928\u0964",revokeButton:"\u2715 \u092a\u0930\u093f\u091c\u0928 \u0915\u093e \u090f\u0915\u094d\u0938\u0947\u0938 \u0939\u091f\u093e\u090f\u0902",revokeConfirmTitle:"\u092a\u0930\u093f\u091c\u0928 \u0915\u093e \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u0939\u091f\u093e\u090f\u0902?",revokeConfirmMessage:"\u0915\u094d\u092f\u093e \u0906\u092a {{caregiverName}} \u0915\u093e \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u0939\u091f\u093e\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902? \u0907\u0938\u0915\u0947 \u092c\u093e\u0926 \u0909\u0928\u094d\u0939\u0947\u0902 \u0907\u0938 \u0921\u093f\u0935\u093e\u0907\u0938 \u0938\u0947 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0938\u0942\u091a\u0928\u093e\u090f\u0902 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u0947\u0902\u0917\u0940\u0964",revokeConfirmAction:"\u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u0939\u091f\u093e\u090f\u0902",simulatePairingButton:"\u092a\u0930\u093f\u091c\u0928 \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u0915\u093e \u092a\u0942\u0930\u094d\u0935\u093e\u092d\u094d\u092f\u093e\u0938 (\u0921\u0947\u092e\u094b)",minimalSharingTitle:"\u092a\u0930\u093f\u091c\u0928 \u0915\u0947 \u0938\u093e\u0925 \u0928\u094d\u092f\u0942\u0928\u0924\u092e \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0938\u093e\u091d\u093e\u0915\u0930\u0923",minimalSharingDesc:"\u0906\u092a\u0915\u0940 \u0917\u0930\u093f\u092e\u093e \u0914\u0930 \u092a\u0942\u0930\u094d\u0923 \u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e \u092c\u0928\u093e\u090f \u0930\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u0947\u0935\u0932 \u0938\u093e\u0930\u093e\u0902\u0936 \u092d\u0947\u091c\u093e \u091c\u093e\u0924\u093e \u0939\u0948:",sharedItem1:"\u2022 \u0909\u091a\u094d\u091a-\u091c\u094b\u0916\u093f\u092e \u0927\u094b\u0916\u093e\u0927\u0921\u093c\u0940 \u0905\u0932\u0930\u094d\u091f (\u0915\u0947\u0935\u0932 \u0930\u094b\u0915\u0947 \u0917\u090f \u0916\u0924\u0930\u0947 \u0915\u093e \u092a\u094d\u0930\u0915\u093e\u0930)",sharedItem2:"\u2022 \u0938\u094d\u0915\u0948\u092e \u0938\u093f\u092e\u0941\u0932\u0947\u091f\u0930 \u0905\u092d\u094d\u092f\u093e\u0938 \u092a\u094d\u0930\u0917\u0924\u093f \u0914\u0930 \u0938\u094d\u0915\u094b\u0930",privacyTitle:"\u0935\u0930\u093f\u0937\u094d\u0920 \u0928\u093e\u0917\u0930\u093f\u0915\u094b\u0902 \u0915\u0940 \u092a\u0942\u0930\u094d\u0923 \u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e \u0917\u093e\u0930\u0902\u091f\u0940",privacyWhatCaregiverSeesTitle:"\u0906\u092a\u0915\u0947 \u092a\u0930\u093f\u091c\u0928 \u0915\u094d\u092f\u093e \u0926\u0947\u0916 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902:",privacyWhatCaregiverSees1:"\u2022 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0938\u0915\u094d\u0930\u093f\u092f \u0939\u0948 \u092f\u093e \u0928\u0939\u0940\u0902 \u0914\u0930 \u0921\u0947\u091f\u093e\u092c\u0947\u0938 \u0905\u092a\u0921\u0947\u091f \u0939\u0948 \u092f\u093e \u0928\u0939\u0940\u0902\u0964",privacyWhatCaregiverSees2:"\u2022 \u0917\u0902\u092d\u0940\u0930 \u0935 \u0916\u0924\u0930\u0928\u093e\u0915 \u0920\u0917\u0940 \u0915\u0949\u0932 \u092f\u093e \u092e\u0948\u0938\u0947\u091c \u0930\u094b\u0915\u0947 \u091c\u093e\u0928\u0947 \u092a\u0930 \u0909\u091a\u094d\u091a-\u0938\u094d\u0924\u0930\u0940\u092f \u091a\u0947\u0924\u093e\u0935\u0928\u0940\u0964",privacyWhatCaregiverNeverSeesTitle:"\u0906\u092a\u0915\u0947 \u092a\u0930\u093f\u091c\u0928 \u0915\u092d\u0940 \u0915\u094d\u092f\u093e \u0928\u0939\u0940\u0902 \u0926\u0947\u0916 \u0938\u0915\u0924\u0947:",privacyWhatCaregiverNeverSees1:"\u2022 \u0906\u092a\u0915\u0947 \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u090f\u0938\u090f\u092e\u090f\u0938, \u0935\u094d\u0939\u093e\u091f\u094d\u0938\u090f\u092a \u092e\u0948\u0938\u0947\u091c \u092f\u093e \u092c\u093e\u0924\u091a\u0940\u0924 \u0915\u092d\u0940 \u0928\u0939\u0940\u0902 \u0926\u0947\u0916 \u0938\u0915\u0924\u0947\u0964",privacyWhatCaregiverNeverSees2:"\u2022 \u0906\u092a\u0915\u0947 \u0913\u091f\u0940\u092a\u0940, \u092a\u093f\u0928, \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u092f\u093e \u092c\u0948\u0902\u0915 \u092c\u0948\u0932\u0947\u0902\u0938 \u0915\u092d\u0940 \u0928\u0939\u0940\u0902 \u0926\u0947\u0916 \u0938\u0915\u0924\u0947\u0964",privacyWhatCaregiverNeverSees3:"\u2022 \u0906\u092a\u0915\u0940 \u0932\u094b\u0915\u0947\u0936\u0928 \u092f\u093e \u092b\u094b\u0928 \u0915\u0949\u0932 \u092c\u093e\u0924\u091a\u0940\u0924 \u0915\u092d\u0940 \u091f\u094d\u0930\u0948\u0915 \u0928\u0939\u0940\u0902 \u0915\u0940 \u091c\u093e\u0924\u0940\u0964"},scamSimulator:{title:"\u0938\u094d\u0915\u0948\u092e \u0938\u093f\u092e\u0941\u0932\u0947\u091f\u0930",subtitle:"\u0927\u094b\u0916\u093e\u0927\u0921\u093c\u0940 \u092a\u0939\u091a\u093e\u0928\u0928\u0947 \u0915\u093e \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0905\u092d\u094d\u092f\u093e\u0938",tabPractice:"\u0905\u092d\u094d\u092f\u093e\u0938 \u092a\u0930\u093f\u0926\u0943\u0936\u094d\u092f",tabDashboard:"\u0938\u0940\u0916\u0928\u0947 \u0915\u093e \u0921\u0948\u0936\u092c\u094b\u0930\u094d\u0921",progressTitle:"\u0905\u092d\u094d\u092f\u093e\u0938 \u0915\u0940 \u092a\u094d\u0930\u0917\u0924\u093f",progressCount:"\u092a\u0930\u093f\u0926\u0943\u0936\u094d\u092f {{current}} / {{total}}",scoreLabel:"\u092a\u0942\u0930\u094d\u0923 \u0915\u093f\u090f \u0917\u090f: {{completed}} / {{total}}",scenarioLabel:"\u092a\u0930\u093f\u0926\u0943\u0936\u094d\u092f {{number}}: {{title}}",scenarioDescriptionLabel:"\u0938\u0902\u0926\u093f\u0917\u094d\u0927 \u0938\u094d\u0925\u093f\u0924\u093f:",questionLabel:"\u0938\u092c\u0938\u0947 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0915\u0926\u092e \u0915\u094d\u092f\u093e \u0939\u0948?",choiceSafeLabel:"\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0915\u0926\u092e",choiceDangerLabel:"\u0916\u0924\u0930\u0928\u093e\u0915 \u0915\u0926\u092e",feedbackCorrect:"\u2713 \u0938\u0939\u0940 \u0935 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0928\u093f\u0930\u094d\u0923\u092f! \u0905\u0924\u093f \u0909\u0924\u094d\u0924\u092e",feedbackIncorrect:"\u26a0\ufe0f \u0938\u093e\u0935\u0927\u093e\u0928! \u092f\u0939 \u090f\u0915 \u0920\u0917\u0940 \u0915\u093e \u091c\u093e\u0932 \u0939\u0948",explanationTitle:"\u092f\u0939 \u0927\u094b\u0916\u093e\u0927\u0921\u093c\u0940 \u0915\u094d\u092f\u094b\u0902 \u0939\u0948:",nextScenarioButton:"\u0905\u0917\u0932\u093e \u092a\u0930\u093f\u0926\u0943\u0936\u094d\u092f \u2192",finishButton:"\ud83c\udf89 \u0905\u092d\u094d\u092f\u093e\u0938 \u092a\u0942\u0930\u093e \u0915\u0930\u0947\u0902",restartButton:"\ud83d\udd04 \u0936\u0941\u0930\u0941\u0906\u0924 \u0938\u0947 \u0926\u094b\u092c\u093e\u0930\u093e \u0905\u092d\u094d\u092f\u093e\u0938 \u0915\u0930\u0947\u0902",viewDashboardButton:"\u0938\u0940\u0916\u0928\u0947 \u0915\u093e \u0921\u0948\u0936\u092c\u094b\u0930\u094d\u0921 \u0926\u0947\u0916\u0947\u0902 \ud83d\udcca",completionBannerTitle:"\u092c\u0927\u093e\u0908 \u0939\u094b! \u0938\u092d\u0940 8 \u092a\u0930\u093f\u0926\u0943\u0936\u094d\u092f\u094b\u0902 \u0915\u093e \u0905\u092d\u094d\u092f\u093e\u0938 \u092a\u0942\u0930\u094d\u0923 \u0939\u0941\u0906",completionBannerDesc:"\u0906\u092a\u0928\u0947 \u092d\u093e\u0930\u0924 \u0915\u0947 \u0936\u0940\u0930\u094d\u0937 8 \u0921\u093f\u091c\u093f\u091f\u0932 \u0927\u094b\u0916\u093e\u0927\u0921\u093c\u0940 \u0915\u0947 \u0924\u0930\u0940\u0915\u094b\u0902 (\u092c\u093f\u091c\u0932\u0940 \u0915\u091f\u094c\u0924\u0940 \u0927\u092e\u0915\u0940, \u092b\u0930\u094d\u091c\u0940 \u0921\u093f\u091c\u093f\u091f\u0932 \u0905\u0930\u0947\u0938\u094d\u091f, \u0915\u0947\u0935\u093e\u0908\u0938\u0940 \u090f\u0915\u094d\u0938\u092a\u093e\u092f\u0930\u0940, \u0913\u091f\u0940\u092a\u0940/\u092a\u093f\u0928 \u092b\u094d\u0930\u0949\u0921, \u092a\u093e\u0930\u094d\u0938\u0932 \u0921\u093f\u0932\u0940\u0935\u0930\u0940 \u092b\u093f\u0936\u093f\u0902\u0917, \u0926\u0941\u0930\u094d\u092d\u093e\u0935\u0928\u093e\u092a\u0942\u0930\u094d\u0923 \u090f\u092a\u0940\u0915\u0947, \u0915\u094d\u092f\u0942\u0906\u0930 \u0915\u094b\u0921 \u0920\u0917\u0940, \u0914\u0930 \u092b\u0930\u094d\u091c\u0940 \u0915\u0938\u094d\u091f\u092e\u0930 \u0915\u0947\u092f\u0930) \u0915\u094b \u092a\u0939\u091a\u093e\u0928\u0928\u093e \u0938\u0940\u0916 \u0932\u093f\u092f\u093e \u0939\u0948\u0964",dashboardTitle:"\u091c\u093e\u0917\u0930\u0942\u0915\u0924\u093e \u0935 \u0938\u0940\u0916\u0928\u0947 \u0915\u093e \u0921\u0948\u0936\u092c\u094b\u0930\u094d\u0921",dashboardSubtitle:"\u0906\u092a\u0915\u0940 \u0921\u093f\u091c\u093f\u091f\u0932 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0938\u091c\u0917\u0924\u093e \u0914\u0930 \u092a\u094d\u0930\u0917\u0924\u093f",accuracyTitle:"\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0928\u093f\u0930\u094d\u0923\u092f \u0915\u094d\u0937\u092e\u0924\u093e",accuracyScore:"{{accuracy}}% \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0938\u091c\u0917\u0924\u093e",accuracyDetail:"{{total}} \u092e\u0947\u0902 \u0938\u0947 {{correct}} \u092a\u0930\u093f\u0926\u0943\u0936\u094d\u092f\u094b\u0902 \u092e\u0947\u0902 \u0938\u0939\u0940 \u0928\u093f\u0930\u094d\u0923\u092f \u0932\u093f\u092f\u093e",completedCount:"{{total}} \u092e\u0947\u0902 \u0938\u0947 {{completed}} \u0935\u093f\u0937\u092f \u092a\u0942\u0930\u0947 \u0915\u093f\u090f",masteredSectionTitle:"\u0938\u092b\u0932\u0924\u093e\u092a\u0942\u0930\u094d\u0935\u0915 \u0938\u092e\u091d\u0947 \u0917\u090f \u0935\u093f\u0937\u092f",masteredDesc:"\u0906\u092a\u0928\u0947 \u0907\u0928 \u0915\u094d\u0937\u0947\u0924\u094d\u0930\u094b\u0902 \u092e\u0947\u0902 \u0927\u094b\u0916\u093e\u0927\u0921\u093c\u0940 \u0915\u094b \u0938\u0939\u0940 \u092a\u0939\u091a\u093e\u0928\u093e:",improvementSectionTitle:"\u0938\u093e\u0935\u0927\u093e\u0928\u0940 \u092c\u0930\u0924\u0928\u0947 \u092f\u094b\u0917\u094d\u092f \u0915\u094d\u0937\u0947\u0924\u094d\u0930",improvementDesc:"\u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0915\u0947 \u0907\u0928 \u092e\u0939\u0924\u094d\u0935\u092a\u0942\u0930\u094d\u0923 \u0928\u093f\u092f\u092e\u094b\u0902 \u0915\u094b \u092f\u093e\u0926 \u0930\u0916\u0947\u0902:",noImprovementsNeeded:"\ud83c\udf1f \u0909\u0924\u094d\u0915\u0943\u0937\u094d\u091f \u091c\u093e\u0917\u0930\u0942\u0915\u0924\u093e! \u0906\u092a\u0928\u0947 \u0939\u0930 \u0916\u0924\u0930\u0947 \u0915\u094b \u0938\u0939\u0940 \u092a\u0939\u091a\u093e\u0928\u093e\u0964",practiceMorePrompt:"\u0928\u093f\u0930\u0902\u0924\u0930 \u0905\u092d\u094d\u092f\u093e\u0938 \u0938\u0947 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0938\u094d\u0935\u093e\u092d\u093e\u0935\u093f\u0915 \u0906\u0926\u0924 \u092c\u0928 \u091c\u093e\u0924\u0940 \u0939\u0948\u0964 \u0915\u092d\u0940 \u092d\u0940 \u0926\u094b\u092c\u093e\u0930\u093e \u0905\u092d\u094d\u092f\u093e\u0938 \u0915\u0930\u0947\u0902\u0964",retakePracticeButton:"\ud83d\udd04 \u0926\u094b\u092c\u093e\u0930\u093e \u0905\u092d\u094d\u092f\u093e\u0938 \u0915\u0930\u0947\u0902",continuePracticeButton:"\ud83c\udfae \u0905\u092d\u094d\u092f\u093e\u0938 \u091c\u093e\u0930\u0940 \u0930\u0916\u0947\u0902 ({{remaining}} \u0936\u0947\u0937)",topicBadge:"\u0935\u093f\u0937\u092f: {{topic}}"},callGuardian:{title:"\u0915\u0949\u0932 \u0917\u093e\u0930\u094d\u0921\u093f\u092f\u0928",subtitle:"\u0911\u092b\u093c\u0932\u093e\u0907\u0928 \u0915\u0949\u0932 \u0938\u0941\u0930\u0915\u094d\u0937\u093e",status:"\u0911\u092b\u093c\u0932\u093e\u0907\u0928 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0921\u0947\u091f\u093e\u092c\u0947\u0938 \u0938\u0915\u094d\u0930\u093f\u092f",screenIncoming:"\u0938\u0902\u0926\u093f\u0917\u094d\u0927 \u0915\u0949\u0932 \u0915\u0940 \u0938\u094d\u0935\u0924\u0903 \u091c\u093e\u0902\u091a",lastSynced:"\u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0921\u0947\u091f\u093e\u092c\u0947\u0938: \u0905\u0926\u094d\u092f\u0924\u0928 \u0939\u0948",statusCardTitle:"\u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0921\u0947\u091f\u093e\u092c\u0947\u0938 \u0938\u094d\u0925\u093f\u0924\u093f",statusSynced:"\u0921\u0947\u091f\u093e\u092c\u0947\u0938 \u0905\u0926\u094d\u092f\u0924\u0928 \u0939\u0948",statusOutdated:"\u0921\u0947\u091f\u093e\u092c\u0947\u0938 \u092a\u0941\u0930\u093e\u0928\u093e \u0939\u0948 (\u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0947\u0902)",statusNotSynced:"\u0905\u092d\u0940 \u0924\u0915 \u0938\u093f\u0902\u0915 \u0928\u0939\u0940\u0902 \u0939\u0941\u0906",threatCount:"{{count}} \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0927\u094b\u0916\u0947\u092c\u093e\u091c\u093c \u0928\u0902\u092c\u0930 \u0938\u0915\u094d\u0930\u093f\u092f",zeroThreats:"0 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0916\u0924\u0930\u0947 \u0938\u0902\u0917\u094d\u0930\u0939\u0940\u0924",lastSyncLabel:"\u0905\u0902\u0924\u093f\u092e \u0938\u093f\u0902\u0915: ",neverSynced:"\u0915\u092d\u0940 \u0938\u093f\u0902\u0915 \u0928\u0939\u0940\u0902 \u0939\u0941\u0906",syncButton:"\ud83d\udd04 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0921\u0947\u091f\u093e\u092c\u0947\u0938 \u0938\u093f\u0902\u0915 \u0915\u0930\u0947\u0902",syncing:"\u0921\u0947\u091f\u093e\u092c\u0947\u0938 \u0938\u093f\u0902\u0915 \u0915\u093f\u092f\u093e \u091c\u093e \u0930\u0939\u093e \u0939\u0948...",syncSuccess:"\u0921\u0947\u091f\u093e\u092c\u0947\u0938 \u0938\u092b\u0932\u0924\u093e\u092a\u0942\u0930\u094d\u0935\u0915 \u0905\u0926\u094d\u092f\u0924\u0928 \u0939\u0941\u0906!",syncError:"\u0938\u093f\u0902\u0915 \u0935\u093f\u092b\u0932: ",safeByDefaultTitle:"\u0905\u091c\u094d\u091e\u093e\u0924 \u0915\u0949\u0932 \u0938\u094d\u0935\u0924\u0903 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0928\u0940\u0924\u093f",safeByDefaultDesc:"\u0905\u091c\u094d\u091e\u093e\u0924 \u0928\u0902\u092c\u0930\u094b\u0902 \u0938\u0947 \u0906\u0928\u0947 \u0935\u093e\u0932\u0940 \u0915\u0949\u0932 \u0921\u093f\u092b\u093c\u0949\u0932\u094d\u091f \u0930\u0942\u092a \u0938\u0947 \u0906\u0928\u0947 \u0926\u0940 \u091c\u093e\u0924\u0940 \u0939\u0948\u0902 \u0924\u093e\u0915\u093f \u0921\u0949\u0915\u094d\u091f\u0930 \u092f\u093e \u092a\u0930\u093f\u0935\u093e\u0930 \u0915\u0940 \u0915\u0949\u0932 \u0928 \u091b\u0942\u091f\u0947\u0964 \u0915\u0947\u0935\u0932 \u0921\u0947\u091f\u093e\u092c\u0947\u0938 \u092e\u0947\u0902 \u092e\u094c\u091c\u0942\u0926 \u092a\u094d\u0930\u092e\u093e\u0923\u093f\u0924 \u0920\u0917 \u0928\u0902\u092c\u0930 \u0939\u0940 \u0930\u094b\u0915\u0947 \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964",spoofingWarningTitle:"\u0915\u0949\u0932\u0930 \u0906\u0908\u0921\u0940 \u0915\u094d\u0932\u094b\u0928\u093f\u0902\u0917 \u0915\u0940 \u091a\u0947\u0924\u093e\u0935\u0928\u0940",spoofingWarningDesc:"\u0920\u0917 \u0915\u092d\u0940-\u0915\u092d\u0940 \u0905\u0938\u0932\u0940 \u0928\u0902\u092c\u0930 \u0915\u0940 \u0928\u0915\u0932 (Spoofing) \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u092f\u0926\u093f \u0915\u094b\u0908 \u0905\u091c\u094d\u091e\u093e\u0924 \u0935\u094d\u092f\u0915\u094d\u0924\u093f \u092c\u0948\u0902\u0915 \u092f\u093e \u092a\u0941\u0932\u093f\u0938 \u092c\u0928\u0915\u0930 \u0915\u0949\u0932 \u0915\u0930\u0947, \u0924\u094b \u0924\u0941\u0930\u0902\u0924 \u092b\u094b\u0928 \u0915\u093e\u091f\u0915\u0930 \u0906\u0927\u093f\u0915\u093e\u0930\u093f\u0915 \u0928\u0902\u092c\u0930 \u092a\u0930 \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0930\u0947\u0902\u0964",noAudioListenTitle:"\u0915\u0949\u0932 \u092c\u093e\u0924\u091a\u0940\u0924 \u0915\u0940 \u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e",noAudioListenDesc:"\u0938\u094d\u0915\u0948\u092e\u0936\u0940\u0932\u094d\u0921 \u0915\u092d\u0940 \u092d\u0940 \u0906\u092a\u0915\u0940 \u092b\u094b\u0928 \u0915\u0949\u0932 \u0915\u0940 \u092c\u093e\u0924\u091a\u0940\u0924 \u0928\u0939\u0940\u0902 \u0938\u0941\u0928\u0924\u093e \u0914\u0930 \u0928 \u0939\u0940 \u0930\u093f\u0915\u0949\u0930\u094d\u0921 \u0915\u0930\u0924\u093e \u0939\u0948\u0964",callHistoryTitle:"\u0915\u0949\u0932 \u0907\u0924\u093f\u0939\u093e\u0938 \u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e",callHistoryDesc:"\u0907\u0938 \u0921\u093f\u0935\u093e\u0907\u0938 \u092a\u0930 \u0915\u0949\u0932 \u0907\u0924\u093f\u0939\u093e\u0938 \u091f\u094d\u0930\u0948\u0915 \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e\u0964 \u091c\u093e\u0902\u091a \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u0911\u092b\u093c\u0932\u093e\u0907\u0928 \u092b\u094b\u0928 \u092c\u091c\u0924\u0947 \u0938\u092e\u092f \u0939\u094b\u0924\u0940 \u0939\u0948\u0964"},scamLens:{title:"\u0938\u094d\u0915\u0948\u092e \u0932\u0947\u0902\u0938",subtitle:"\u0915\u094d\u092f\u0942\u0906\u0930 \u0915\u094b\u0921 \u090f\u0935\u0902 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u091c\u093e\u0902\u091a\u0915\u0930\u094d\u0924\u093e",tabQr:"\u0915\u094d\u092f\u0942\u0906\u0930 \u0915\u094b\u0921 \u091c\u093e\u0902\u091a",tabDocument:"\u0915\u093e\u0917\u091c\u0940 \u092a\u0924\u094d\u0930 / \u0928\u094b\u091f\u093f\u0938",qrInputLabel:"\u0915\u094d\u092f\u0942\u0906\u0930 \u0915\u094b\u0921 \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u092f\u093e \u0932\u093f\u0902\u0915",qrInputPlaceholder:"\u0921\u093f\u0915\u094b\u0921 \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u0915\u094d\u092f\u0942\u0906\u0930 \u091f\u0947\u0915\u094d\u0938\u094d\u091f (\u092f\u0942\u092a\u0940\u0906\u0908 \u0932\u093f\u0902\u0915 \u092f\u093e \u0935\u0947\u092c\u0938\u093e\u0907\u091f) \u092f\u0939\u093e\u0901 \u0921\u093e\u0932\u0947\u0902...",pasteQrButton:"\ud83d\udccb \u0915\u094d\u092f\u0942\u0906\u0930 \u0921\u0947\u091f\u093e \u092a\u0947\u0938\u094d\u091f \u0915\u0930\u0947\u0902",clearButton:"\u2715 \u0938\u093e\u092b\u093c \u0915\u0930\u0947\u0902",inspectQrButton:"\ud83d\udd0d \u0915\u094d\u092f\u0942\u0906\u0930 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u091c\u093e\u0902\u091a\u0947\u0902",sampleUpiButton:"\u0938\u0902\u0926\u093f\u0917\u094d\u0927 \u092f\u0942\u092a\u0940\u0906\u0908 \u0909\u0926\u093e\u0939\u0930\u0923",sampleUrlButton:"\u0938\u0902\u0926\u093f\u0917\u094d\u0927 \u0932\u093f\u0902\u0915 \u0909\u0926\u093e\u0939\u0930\u0923",qrResultTitle:"\u0915\u094d\u092f\u0942\u0906\u0930 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u091c\u093e\u0902\u091a \u092a\u0930\u093f\u092