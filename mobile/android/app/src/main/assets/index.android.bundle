__d(function(g,r,i,a,m,e,d){Object.defineProperty(e,"__esModule",{value:!0}),e.BANKING_SANDBOX_SCENARIOS=void 0;e.BANKING_SANDBOX_SCENARIOS=[{id:'scenario_1_fake_login',stepNumber:1,category:'fake_login',titleEn:'Fake Bank Login & Suspicious Website',titleHi:'\u0928\u0915\u0932\u0940 \u092c\u0948\u0902\u0915 \u0932\u0949\u0917\u093f\u0928 \u0914\u0930 \u0938\u0902\u0926\u093f\u0917\u094d\u0927 \u0935\u0947\u092c\u0938\u093e\u0907\u091f',titleMr:'\u092c\u0928\u093e\u0935\u091f \u092c\u0901\u0915 \u0932\u0949\u0917\u093f\u0928 \u0906\u0923\u093f \u0938\u0902\u0936\u092f\u093e\u0938\u094d\u092a\u0926 \u0935\u0947\u092c\u0938\u093e\u0907\u091f',subtitleEn:'Learn how to detect fraudulent banking links and illegal password requests',subtitleHi:'\u092b\u0930\u094d\u091c\u0940 \u092c\u0948\u0902\u0915\u093f\u0902\u0917 \u0932\u093f\u0902\u0915 \u0914\u0930 \u0905\u0935\u0948\u0927 \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0905\u0928\u0941\u0930\u094b\u0927\u094b\u0902 \u0915\u094b \u092a\u0939\u091a\u093e\u0928\u0928\u093e \u0938\u0940\u0916\u0947\u0902',subtitleMr:'\u092b\u0938\u0935\u094d\u092f\u093e \u092c\u0901\u0915\u093f\u0902\u0917 \u0932\u093f\u0902\u0915\u094d\u0938 \u0906\u0923\u093f \u0905\u0928\u0927\u093f\u0915\u0943\u0924 \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u092e\u093e\u0917\u0923\u094d\u092f\u093e \u0913\u0933\u0916\u093e\u092f\u0932\u093e \u0936\u093f\u0915\u093e',scenarioTypeLabelEn:'Scenario 1: Web Banking Security',scenarioTypeLabelHi:'\u092a\u0930\u093f\u0926\u0943\u0936\u094d\u092f 1: \u0928\u0947\u091f \u092c\u0948\u0902\u0915\u093f\u0902\u0917 \u0938\u0941\u0930\u0915\u094d\u0937\u093e',scenarioTypeLabelMr:'\u092a\u0930\u093f\u0926\u0943\u0936\u094d\u092f \u0967: \u0928\u0947\u091f \u092c\u0901\u0915\u093f\u0902\u0917 \u0938\u0941\u0930\u0915\u094d\u0937\u093e',mockUrl:'http://statetrust-secure-kyc.xyz/netbanking/login',mockBankName:'State Trust Bank of India (Simulated)',descriptionEn:'You receive an SMS warning your bank account will be blocked unless KYC is updated within 2 hours. Tapping the link opens this web page asking for your User ID, Net Banking Password, and ATM Card PIN with CVV.',descriptionHi:'\u0906\u092a\u0915\u094b \u090f\u0915 \u0938\u0902\u0926\u0947\u0936 \u092e\u093f\u0932\u0924\u093e \u0939\u0948 \u0915\u093f \u092f\u0926\u093f 2 \u0918\u0902\u091f\u0947 \u092e\u0947\u0902 \u0915\u0947\u0935\u093e\u0908\u0938\u0940 \u0905\u092a\u0921\u0947\u091f \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u0924\u094b \u0906\u092a\u0915\u093e \u092c\u0948\u0902\u0915 \u0916\u093e\u0924\u093e \u092c\u0902\u0926 \u0939\u094b \u091c\u093e\u090f\u0917\u093e\u0964 \u0932\u093f\u0902\u0915 \u0916\u094b\u0932\u0928\u0947 \u092a\u0930 \u092f\u0939 \u092a\u0947\u091c \u0906\u092a\u0915\u093e \u092f\u0942\u091c\u0930 \u0906\u0908\u0921\u0940, \u0928\u0947\u091f \u092c\u0948\u0902\u0915\u093f\u0902\u0917 \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0914\u0930 \u090f\u091f\u0940\u090f\u092e \u092a\u093f\u0928 \u0935 \u0938\u0940\u0935\u0940\u0935\u0940 \u092e\u093e\u0902\u0917\u0924\u093e \u0939\u0948\u0964',descriptionMr:'\u0924\u0941\u092e\u094d\u0939\u093e\u0932\u093e \u090f\u0915 \u092e\u0947\u0938\u0947\u091c \u092f\u0947\u0924\u094b \u0915\u0940 \u0968 \u0924\u093e\u0938\u093e\u0902\u0924 \u0915\u0947\u0935\u093e\u092f\u0938\u0940 \u0905\u092a\u0921\u0947\u091f \u0928 \u0915\u0947\u0932\u094d\u092f\u093e\u0938 \u092c\u0901\u0915 \u0916\u093e\u0924\u0947 \u092c\u0902\u0926 \u0939\u094b\u0908\u0932. \u0932\u093f\u0902\u0915 \u0909\u0918\u0921\u0932\u094d\u092f\u093e\u0935\u0930 \u0939\u0947 \u092a\u0947\u091c \u0924\u0941\u092e\u091a\u093e \u092f\u0942\u091c\u0930 \u0906\u092f\u0921\u0940, \u0928\u0947\u091f \u092c\u0901\u0915\u093f\u0902\u0917 \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0906\u0923\u093f \u090f\u091f\u0940\u090f\u092e \u092a\u093f\u0928 \u0935 \u0938\u0940\u0935\u094d\u0939\u0940\u0935\u094d\u0939\u0940 \u092e\u093e\u0917\u0924 \u0906\u0939\u0947.',goldenRuleEn:'Golden Rule: Legitimate banks NEVER ask for your ATM PIN or CVV on a login page. Genuine bank sites always use encrypted https:// with official bank domains (never .xyz or unfamiliar extensions).',goldenRuleHi:'\u0938\u094d\u0935\u0930\u094d\u0923 \u0928\u093f\u092f\u092e: \u0905\u0938\u0932\u0940 \u092c\u0948\u0902\u0915 \u0915\u092d\u0940 \u092d\u0940 \u0932\u0949\u0917\u093f\u0928 \u092a\u0947\u091c \u092a\u0930 \u0906\u092a\u0915\u093e \u090f\u091f\u0940\u090f\u092e \u092a\u093f\u0928 \u092f\u093e \u0938\u0940\u0935\u0940\u0935\u0940 \u0928\u0939\u0940\u0902 \u092e\u093e\u0902\u0917\u0924\u0947\u0964 \u0906\u0927\u093f\u0915\u093e\u0930\u093f\u0915 \u092c\u0948\u0902\u0915 \u0935\u0947\u092c\u0938\u093e\u0907\u091f \u0939\u092e\u0947\u0936\u093e https:// \u0914\u0930 \u0935\u0948\u0927 \u092c\u0948\u0902\u0915 \u0921\u094b\u092e\u0947\u0928 \u092a\u0930 \u0939\u094b\u0924\u0940 \u0939\u0948\u0902 (\u0915\u092d\u0940 .xyz \u0928\u0939\u0940\u0902)\u0964',goldenRuleMr:'\u0938\u0941\u0935\u0930\u094d\u0923 \u0928\u093f\u092f\u092e: \u0916\u0930\u0940 \u092c\u0901\u0915 \u0915\u0927\u0940\u0939\u0940 \u0932\u0949\u0917\u093f\u0928 \u092a\u0947\u091c\u0935\u0930 \u0924\u0941\u092e\u091a\u093e \u090f\u091f\u0940\u090f\u092e \u092a\u093f\u0928 \u0915\u093f\u0902\u0935\u093e \u0938\u0940\u0935\u094d\u0939\u0940\u0935\u094d\u0939\u0940 \u092e\u093e\u0917\u0924 \u0928\u093e\u0939\u0940. \u0905\u0927\u093f\u0915\u0943\u0924 \u092c\u0901\u0915 \u0935\u0947\u092c\u0938\u093e\u0907\u091f \u0928\u0947\u0939\u092e\u0940 https:// \u0906\u0923\u093f \u0905\u0927\u093f\u0915\u0943\u0924 \u0921\u094b\u092e\u0947\u0928\u0935\u0930 \u0905\u0938\u0924\u0947 (.xyz \u0915\u0927\u0940\u0939\u0940 \u0928\u093e\u0939\u0940).',dangerIndicatorsEn:['Insecure protocol: Uses unencrypted "http://" instead of secure "https://"','Suspicious web domain ending in ".xyz" instead of official ".bank.in" or ".co.in"','Dangerous credential trap: Asking for ATM PIN and CVV on a website login form','Artificial urgency: Threatening to block account in 2 hours to cause panic'],dangerIndicatorsHi:['\u0905\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u092a\u094d\u0930\u094b\u091f\u094b\u0915\u0949\u0932: \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 "https://" \u0915\u0947 \u092c\u091c\u093e\u092f \u0905\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 "http://" \u0915\u093e \u0909\u092a\u092f\u094b\u0917','\u0938\u0902\u0926\u093f\u0917\u094d\u0927 \u0921\u094b\u092e\u0947\u0928: \u0906\u0927\u093f\u0915\u093e\u0930\u093f\u0915 ".co.in" \u0915\u0947 \u092c\u091c\u093e\u092f \u092b\u0930\u094d\u091c\u0940 ".xyz" \u090f\u0915\u094d\u0938\u091f\u0947\u0902\u0936\u0928','\u0916\u0924\u0930\u0928\u093e\u0915 \u092e\u093e\u0902\u0917: \u0935\u0947\u092c \u0932\u0949\u0917\u093f\u0928 \u092a\u0930 \u090f\u091f\u0940\u090f\u092e \u0915\u093e\u0930\u094d\u0921 \u092a\u093f\u0928 \u0914\u0930 \u0938\u0940\u0935\u0940\u0935\u0940 \u092e\u093e\u0902\u0917\u0928\u093e','\u091d\u0942\u0920\u0940 \u0918\u092c\u0930\u093e\u0939\u091f: 2 \u0918\u0902\u091f\u0947 \u092e\u0947\u0902 \u0916\u093e\u0924\u093e \u092c\u0902\u0926 \u0915\u0930\u0928\u0947 \u0915\u0940 \u092b\u0930\u094d\u091c\u0940 \u0927\u092e\u0915\u0940 \u0926\u0947\u0928\u093e'],dangerIndicatorsMr:['\u0905\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u092a\u094d\u0930\u094b\u091f\u094b\u0915\u0949\u0932: \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 "https://" \u0910\u0935\u091c\u0940 \u0905\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 "http://"','\u0938\u0902\u0936\u092f\u093e\u0938\u094d\u092a\u0926 \u0921\u094b\u092e\u0947\u0928: \u0905\u0927\u093f\u0915\u0943\u0924 ".co.in" \u0910\u0935\u091c\u0940 \u092c\u0928\u093e\u0935\u091f ".xyz" \u090f\u0915\u094d\u0938\u091f\u0947\u0902\u0936\u0928','\u0927\u094b\u0915\u093e\u0926\u093e\u092f\u0915 \u092e\u093e\u0917\u0923\u0940: \u0935\u0947\u092c \u0932\u0949\u0917\u093f\u0928\u0935\u0930 \u090f\u091f\u0940\u090f\u092e \u092a\u093f\u0928 \u0906\u0923\u093f \u0938\u0940\u0935\u094d\u0939\u0940\u0935\u094d\u0939\u0940 \u0935\u093f\u091a\u093e\u0930\u0923\u0947','\u0916\u094b\u091f\u094d\u092f\u093e \u092d\u0940\u0924\u0940\u091a\u093e \u0935\u093e\u092a\u0930: \u0968 \u0924\u093e\u0938\u093e\u0902\u0924 \u0916\u093e\u0924\u0947 \u092c\u0902\u0926 \u0915\u0930\u0923\u094d\u092f\u093e\u091a\u0940 \u0927\u092e\u0915\u0940 \u0926\u0947\u090a\u0928 \u0918\u093e\u092c\u0930\u0935\u0923\u0947'],choices:[{id:'fake_login_safe',textEn:'Close the browser immediately. Real banks never ask for ATM PIN/CVV on login, and official URLs use secure https://.',textHi:'\u092c\u094d\u0930\u093e\u0909\u091c\u093c\u0930 \u0924\u0941\u0930\u0902\u0924 \u092c\u0902\u0926 \u0915\u0930\u0947\u0902\u0964 \u0905\u0938\u0932\u0940 \u092c\u0948\u0902\u0915 \u0915\u092d\u0940 \u0932\u0949\u0917\u093f\u0928 \u092a\u0930 \u090f\u091f\u0940\u090f\u092e \u092a\u093f\u0928/\u0938\u0940\u0935\u0940\u0935\u0940 \u0928\u0939\u0940\u0902 \u092e\u093e\u0902\u0917\u0924\u0947, \u0914\u0930 \u0906\u0927\u093f\u0915\u093e\u0930\u093f\u0915 \u0935\u0947\u092c\u0938\u093e\u0907\u091f \u0939\u092e\u0947\u0936\u093e \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 https:// \u092a\u0930 \u0939\u094b\u0924\u0940 \u0939\u0948\u0902\u0964',textMr:'\u092c\u094d\u0930\u093e\u0909\u091d\u0930 \u0924\u093e\u0924\u094d\u0915\u093e\u0933 \u092c\u0902\u0926 \u0915\u0930\u093e. \u0916\u0930\u0940 \u092c\u0901\u0915 \u0932\u0949\u0917\u093f\u0928\u0935\u0930 \u0915\u0927\u0940\u0939\u0940 \u090f\u091f\u0940\u090f\u092e \u092a\u093f\u0928/\u0938\u0940\u0935\u094d\u0939\u0940\u0935\u094d\u0939\u0940 \u092e\u093e\u0917\u0924 \u0928\u093e\u0939\u0940 \u0906\u0923\u093f \u0905\u0927\u093f\u0915\u0943\u0924 \u0935\u0947\u092c\u0938\u093e\u0907\u091f \u0928\u0947\u0939\u092e\u0940 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 https:// \u0935\u0930 \u0905\u0938\u0924\u0947.',isSafe:!0,feedbackEn:'Excellent! You correctly identified the fake domain, unencrypted connection, and the illegal request for an ATM PIN and CVV.',feedbackHi:'\u0936\u093e\u092c\u093e\u0936! \u0906\u092a\u0928\u0947 \u092b\u0930\u094d\u091c\u0940 \u0921\u094b\u092e\u0947\u0928, \u0905\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0932\u093f\u0902\u0915 \u0914\u0930 \u090f\u091f\u0940\u090f\u092e \u092a\u093f\u0928 \u0915\u0940 \u0917\u0948\u0930\u0915\u093e\u0928\u0942\u0928\u0940 \u092e\u093e\u0902\u0917 \u0915\u094b \u0938\u0939\u0940 \u092a\u0939\u091a\u093e\u0928\u093e\u0964',feedbackMr:'\u0909\u0924\u094d\u0915\u0943\u0937\u094d\u091f! \u0924\u0941\u092e\u094d\u0939\u0940 \u092c\u0928\u093e\u0935\u091f \u0921\u094b\u092e\u0947\u0928, \u0905\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0932\u093f\u0902\u0915 \u0906\u0923\u093f \u090f\u091f\u0940\u090f\u092e \u092a\u093f\u0928\u091a\u0940 \u092c\u0947\u0915\u093e\u092f\u0926\u0947\u0936\u0940\u0930 \u092e\u093e\u0917\u0923\u0940 \u0905\u091a\u0942\u0915 \u0913\u0933\u0916\u0932\u0940.'},{id:'fake_login_unsafe',textEn:'Enter User ID, password, and ATM PIN quickly to avoid account blockage.',textHi:'\u0916\u093e\u0924\u093e \u092c\u0902\u0926 \u0939\u094b\u0928\u0947 \u0938\u0947 \u092c\u091a\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u091c\u0932\u094d\u0926\u0940 \u0938\u0947 \u092f\u0942\u091c\u0930 \u0906\u0908\u0921\u0940, \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0914\u0930 \u090f\u091f\u0940\u090f\u092e \u092a\u093f\u0928 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902\u0964',textMr:'\u0916\u093e\u0924\u0947 \u092c\u0902\u0926 \u0939\u094b\u0923\u094d\u092f\u093e\u092a\u093e\u0938\u0942\u0928 \u0935\u093e\u091a\u0935\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0924\u094d\u0935\u0930\u093f\u0924 \u092f\u0942\u091c\u0930 \u0906\u092f\u0921\u0940, \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0906\u0923\u093f \u090f\u091f\u0940\u090f\u092e \u092a\u093f\u0928 \u092d\u0930\u093e.',isSafe:!1,feedbackEn:'Danger! This was a phishing clone. Submitting your ATM PIN or password on an unofficial page allows criminals to empty your account.',feedbackHi:'\u0916\u0924\u0930\u093e! \u092f\u0939 \u090f\u0915 \u092b\u0930\u094d\u091c\u0940 \u0915\u094d\u0932\u094b\u0928 \u0935\u0947\u092c\u0938\u093e\u0907\u091f \u0925\u0940\u0964 \u0905\u0928\u0927\u093f\u0915\u0943\u0924 \u092a\u0947\u091c \u092a\u0930 \u0905\u092a\u0928\u093e \u092a\u093f\u0928 \u092f\u093e \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0926\u0930\u094d\u091c \u0915\u0930\u0928\u0947 \u0938\u0947 \u0927\u094b\u0916\u0947\u092c\u093e\u091c \u0906\u092a\u0915\u093e \u0916\u093e\u0924\u093e \u0916\u093e\u0932\u0940 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964',feedbackMr:'\u0927\u094b\u0915\u093e! \u0939\u0940 \u090f\u0915 \u092c\u0928\u093e\u0935\u091f \u0915\u094d\u0932\u094b\u0928 \u0935\u0947\u092c\u0938\u093e\u0907\u091f \u0939\u094b\u0924\u0940. \u0905\u0928\u0927\u093f\u0915\u0943\u0924 \u092a\u0947\u091c\u0935\u0930 \u0924\u0941\u092e\u091a\u093e \u092a\u093f\u0928 \u0915\u093f\u0902\u0935\u093e \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u091f\u093e\u0915\u0932\u094d\u092f\u093e\u0938 \u0938\u093e\u092f\u092c\u0930 \u0917\u0941\u0928\u094d\u0939\u0947\u0917\u093e\u0930 \u0924\u0941\u092e\u091a\u0947 \u092c\u0901\u0915 \u0916\u093e\u0924\u0947 \u0930\u093f\u0915\u093e\u092e\u0947 \u0915\u0930\u0942 \u0936\u0915\u0924\u093e\u0924.'}]},{id:'scenario_2_upi_payment',stepNumber:2,category:'upi_payment',titleEn:'Simulated UPI Merchant Payment',titleHi:'\u0938\u093f\u092e\u094d\u092f\u0941\u0932\u0947\u091f\u0947\u0921 \u092f\u0942\u092a\u0940\u0906\u0908 \u0935\u094d\u092f\u093e\u092a\u093e\u0930\u0940 \u092d\u0941\u0917\u0924\u093e\u0928',titleMr:'\u0938\u093f\u092e\u094d\u092f\u0941\u0932\u0947\u091f\u0947\u0921 UPI \u0935\u094d\u092f\u093e\u092a\u093e\u0930\u0940 \u092a\u0947\u092e\u0947\u0902\u091f \u0938\u0930\u093e\u0935',subtitleEn:'Learn how to verify recipient identity and merchant badges before paying',subtitleHi:'\u092d\u0941\u0917\u0924\u093e\u0928 \u0915\u0930\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u092a\u094d\u0930\u093e\u092a\u094d\u0924\u0915\u0930\u094d\u0924\u093e \u0915\u093e \u0928\u093e\u092e \u0914\u0930 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u092c\u0948\u091c \u091c\u093e\u0902\u091a\u0928\u093e \u0938\u0940\u0916\u0947\u0902',subtitleMr:'\u092a\u0948\u0938\u0947 \u092a\u093e\u0920\u0935\u0923\u094d\u092f\u093e\u092a\u0942\u0930\u094d\u0935\u0940 \u092a\u094d\u0930\u093e\u092a\u094d\u0924\u0915\u0930\u094d\u0924\u094d\u092f\u093e\u091a\u0947 \u0928\u093e\u0935 \u0906\u0923\u093f \u0905\u0927\u093f\u0915\u0943\u0924 \u092c\u0945\u091c \u0924\u092a\u093e\u0938\u0923\u0947 \u0936\u093f\u0915\u093e',scenarioTypeLabelEn:'Scenario 2: UPI Payment Verification',scenarioTypeLabelHi:'\u092a\u0930\u093f\u0926\u0943\u0936\u094d\u092f 2: \u092f\u0942\u092a\u0940\u0906\u0908 \u092d\u0941\u0917\u0924\u093e\u0928 \u0938\u0924\u094d\u092f\u093e\u092a\u0928',scenarioTypeLabelMr:'\u092a\u0930\u093f\u0926\u0943\u0936\u094d\u092f \u0968: UPI \u092a\u0947\u092e\u0947\u0902\u091f \u092a\u0921\u0924\u093e\u0933\u0923\u0940',mockMerchantName:'Green Valley Fresh Groceries',mockUpiId:'greenvalley.retail@okhdfcbank',mockAmount:'\u20b9 150.00',descriptionEn:'You are at a local grocery store paying \u20b9150 for vegetables using a UPI app. You scan the store QR code. Before entering your UPI PIN, how do you verify that the payment is going to the authentic store?',descriptionHi:'\u0906\u092a \u0938\u092c\u094d\u091c\u0940 \u0915\u0940 \u0926\u0941\u0915\u093e\u0928 \u092a\u0930 \u20b9150 \u0915\u093e \u092d\u0941\u0917\u0924\u093e\u0928 \u092f\u0942\u092a\u0940\u0906\u0908 \u0938\u0947 \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902\u0964 \u0906\u092a\u0928\u0947 \u0926\u0941\u0915\u093e\u0928 \u0915\u093e \u0915\u094d\u092f\u0942\u0906\u0930 \u0915\u094b\u0921 \u0938\u094d\u0915\u0948\u0928 \u0915\u093f\u092f\u093e \u0939\u0948\u0964 \u0905\u092a\u0928\u093e \u092f\u0942\u092a\u0940\u0906\u0908 \u092a\u093f\u0928 \u0921\u093e\u0932\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0906\u092a \u0915\u0948\u0938\u0947 \u092a\u0941\u0937\u094d\u091f\u093f \u0915\u0930\u0947\u0902\u0917\u0947 \u0915\u093f \u092d\u0941\u0917\u0924\u093e\u0928 \u0938\u0939\u0940 \u0926\u0941\u0915\u093e\u0928 \u0915\u094b \u091c\u093e \u0930\u0939\u093e \u0939\u0948?',descriptionMr:'\u0924\u0941\u092e\u094d\u0939\u0940 \u092d\u093e\u091c\u0940\u092a\u093e\u0932\u094d\u092f\u093e\u091a\u094d\u092f\u093e \u0926\u0941\u0915\u093e\u0928\u093e\u0924 UPI \u0926\u094d\u0935\u093e\u0930\u0947 \u20b9\u0967\u096b\u0966 \u091a\u0947 \u092a\u0947\u092e\u0947\u0902\u091f \u0915\u0930\u0924 \u0906\u0939\u093e\u0924. \u0924\u0941\u092e\u094d\u0939\u0940 \u0926\u0941\u0915\u093e\u0928\u093e\u091a\u093e QR \u0915\u094b\u0921 \u0938\u094d\u0915\u0945\u0928 \u0915\u0947\u0932\u093e \u0906\u0939\u0947. \u0924\u0941\u092e\u091a\u093e UPI \u092a\u093f\u0928 \u091f\u093e\u0915\u0923\u094d\u092f\u093e\u092a\u0942\u0930\u094d\u0935\u0940 \u092a\u0948\u0938\u0947 \u092f\u094b\u0917\u094d\u092f \u0926\u0941\u0915\u093e\u0928\u0926\u093e\u0930\u093e\u0932\u093e \u091c\u093e\u0924 \u0906\u0939\u0947\u0924 \u0939\u0947 \u0924\u0941\u092e\u094d\u0939\u0940 \u0915\u0938\u0947 \u0924\u092a\u093e\u0938\u093e\u0932?',goldenRuleEn:'Golden Rule: Always verify that the displayed merchant name matches the physical store and shows a verified merchant tick mark. Never pay an unverified personal UPI ID for store purchases.',goldenRuleHi:'\u0938\u094d\u0935\u0930\u094d\u0923 \u0928\u093f\u092f\u092e: \u0939\u092e\u0947\u0936\u093e \u091c\u093e\u0902\u091a\u0947\u0902 \u0915\u093f \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u092a\u0930 \u0926\u093f\u0916 \u0930\u0939\u093e \u0928\u093e\u092e \u0905\u0938\u0932\u0940 \u0926\u0941\u0915\u093e\u0928 \u0938\u0947 \u092e\u0947\u0932 \u0916\u093e\u0924\u093e \u0939\u0948 \u0914\u0930 \u0909\u0938 \u092a\u0930 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u091f\u093f\u0915 \u092e\u093e\u0930\u094d\u0915 \u0939\u0948\u0964 \u0926\u0941\u0915\u093e\u0928 \u0915\u0940 \u0916\u0930\u0940\u0926\u093e\u0930\u0940 \u0915\u0947 \u0932\u093f\u090f \u0915\u093f\u0938\u0940 \u0905\u091c\u094d\u091e\u093e\u0924 \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u0906\u0908\u0921\u0940 \u092a\u0930 \u092d\u0941\u0917\u0924\u093e\u0928 \u0928 \u0915\u0930\u0947\u0902\u0964',goldenRuleMr:'\u0938\u0941\u0935\u0930\u094d\u0923 \u0928\u093f\u092f\u092e: \u0938\u094d\u0915\u094d\u0930\u0940\u0928\u0935\u0930 \u0926\u093f\u0938\u0923\u093e\u0930\u0947 \u0928\u093e\u0935 \u092a\u094d\u0930\u0924\u094d\u092f\u0915\u094d\u0937 \u0926\u0941\u0915\u093e\u0928\u093e\u0936\u0940 \u091c\u0941\u0933\u0924\u0947 \u0915\u093e \u0906\u0923\u093f \u0924\u094d\u092f\u093e\u0935\u0930 \u0905\u0927\u093f\u0915\u0943\u0924 \u091f\u093f\u0915 \u092e\u093e\u0930\u094d\u0915 \u0906\u0939\u0947 \u0915\u093e \u0924\u0947 \u0928\u0947\u0939\u092e\u0940 \u0924\u092a\u093e\u0938\u093e. \u0926\u0941\u0915\u093e\u0928\u093e\u0924\u0940\u0932 \u0916\u0930\u0947\u0926\u0940\u0938\u093e\u0920\u0940 \u0905\u0928\u094b\u0933\u0916\u0940 \u0916\u093e\u091c\u0917\u0940 \u0906\u092f\u0921\u0940\u0935\u0930 \u092a\u0948\u0938\u0947 \u092a\u093e\u0920\u0935\u0942 \u0928\u0915\u093e.',dangerIndicatorsEn:['Scammers often paste fake paper QR codes over real shop QR stands','Always confirm recipient name on screen before entering your UPI PIN','Look for the verified merchant icon on business QR codes','Never send advance booking money via UPI to unknown personal numbers'],dangerIndicatorsHi:['\u0927\u094b\u0916\u0947\u092c\u093e\u091c \u0915\u092d\u0940-\u0915\u092d\u0940 \u0905\u0938\u0932\u0940 \u0915\u094d\u092f\u0942\u0906\u0930 \u0915\u094b\u0921 \u092a\u0930 \u0905\u092a\u0928\u093e \u092b\u0930\u094d\u091c\u0940 \u0915\u094d\u092f\u0942\u0906\u0930 \u091a\u093f\u092a\u0915\u093e \u0926\u0947\u0924\u0947 \u0939\u0948\u0902','\u092f\u0942\u092a\u0940\u0906\u0908 \u092a\u093f\u0928 \u0926\u0930\u094d\u091c \u0915\u0930\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u092a\u0930 \u0926\u093f\u0916\u0928\u0947 \u0935\u093e\u0932\u093e \u0928\u093e\u092e \u0905\u0935\u0936\u094d\u092f \u092a\u0922\u093c\u0947\u0902','\u0935\u094d\u092f\u093e\u092a\u093e\u0930\u093f\u092f\u094b\u0902 \u0915\u0947 \u0915\u094d\u092f\u0942\u0906\u0930 \u0915\u094b\u0921 \u092a\u0930 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u092e\u0930\u094d\u091a\u0947\u0902\u091f \u0906\u0907\u0915\u0928 \u091c\u0930\u0942\u0930 \u0926\u0947\u0916\u0947\u0902','\u0905\u091c\u094d\u091e\u093e\u0924 \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u0928\u0902\u092c\u0930\u094b\u0902 \u092a\u0930 \u0915\u092d\u0940 \u092d\u0940 \u0905\u0917\u094d\u0930\u093f\u092e \u0930\u0915\u092e \u091f\u094d\u0930\u093e\u0902\u0938\u092b\u0930 \u0928 \u0915\u0930\u0947\u0902'],dangerIndicatorsMr:['\u0917\u0941\u0928\u094d\u0939\u0947\u0917\u093e\u0930 \u0905\u0928\u0947\u0915\u0926\u093e \u092e\u0942\u0933 QR \u0915\u094b\u0921\u0935\u0930 \u0938\u094d\u0935\u0924\u0903\u091a\u093e \u092c\u0928\u093e\u0935\u091f QR \u0915\u094b\u0921 \u091a\u093f\u0915\u091f\u0935\u0942\u0928 \u092b\u0938\u0935\u0923\u0942\u0915 \u0915\u0930\u0924\u093e\u0924','UPI \u092a\u093f\u0928 \u091f\u093e\u0915\u0923\u094d\u092f\u093e\u092a\u0942\u0930\u094d\u0935\u0940 \u0938\u094d\u0915\u094d\u0930\u0940\u0928\u0935\u0930 \u0926\u093f\u0938\u0923\u093e\u0930\u0947 \u0928\u093e\u0935 \u092a\u094d\u0930\u0924\u094d\u092f\u0915\u094d\u0937 \u0926\u0941\u0915\u093e\u0928\u0926\u093e\u0930\u093e\u0936\u0940 \u091c\u0941\u0933\u0924\u0947 \u0915\u093e \u0924\u0947 \u092a\u0939\u093e','\u0935\u094d\u092f\u093e\u092a\u093e\u0930\u0940 QR \u0915\u094b\u0921\u0935\u0930 \u0905\u0927\u093f\u0915\u0943\u0924 \u092e\u0930\u094d\u091a\u0902\u091f \u091a\u093f\u0928\u094d\u0939 \u0928\u0915\u094d\u0915\u0940 \u0924\u092a\u093e\u0938\u093e','\u0905\u0928\u094b\u0933\u0916\u0940 \u0916\u093e\u091c\u0917\u0940 \u0928\u0902\u092c\u0930\u0935\u0930 \u0915\u0927\u0940\u0939\u0940 \u0906\u0917\u093e\u090a \u0930\u0915\u094d\u0915\u092e \u092a\u093e\u0920\u0935\u0942 \u0928\u0915\u093e'],choices:[{id:'upi_pay_safe',textEn:'Verify that "Green Valley Fresh Groceries" and verified badge appear on screen, and the amount is exactly \u20b9150 before entering PIN.',textHi:'\u092a\u0941\u0937\u094d\u091f\u093f \u0915\u0930\u0947\u0902 \u0915\u093f \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u092a\u0930 "Green Valley Fresh Groceries" \u0914\u0930 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u092c\u0948\u091c \u0926\u093f\u0916 \u0930\u0939\u093e \u0939\u0948 \u0924\u0925\u093e \u0930\u093e\u0936\u093f \u0920\u0940\u0915 \u20b9150 \u0939\u0948, \u0909\u0938\u0915\u0947 \u092c\u093e\u0926 \u0939\u0940 \u092a\u093f\u0928 \u0921\u093e\u0932\u0947\u0902\u0964',textMr:'\u092a\u0921\u0924\u093e\u0933\u0923\u0940 \u0915\u0930\u093e \u0915\u0940 \u0938\u094d\u0915\u094d\u0930\u0940\u0928\u0935\u0930 "Green Valley Fresh Groceries" \u0906\u0923\u093f \u0905\u0927\u093f\u0915\u0943\u0924 \u092c\u0945\u091c \u0926\u093f\u0938\u0924 \u0906\u0939\u0947 \u0924\u0938\u0947\u091a \u0930\u0915\u094d\u0915\u092e \u0924\u0902\u0924\u094b\u0924\u0902\u0924 \u20b9\u0967\u096b\u0966 \u0906\u0939\u0947, \u092e\u0917\u091a \u092a\u093f\u0928 \u091f\u093e\u0915\u093e.',isSafe:!0,feedbackEn:'Safe Decision! Checking the payee name and verified business badge protects you from tampered QR codes and wrong transfers.',feedbackHi:'\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0928\u093f\u0930\u094d\u0923\u092f! \u092a\u094d\u0930\u093e\u092a\u094d\u0924\u0915\u0930\u094d\u0924\u093e \u0915\u093e \u0928\u093e\u092e \u0914\u0930 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u092c\u0948\u091c \u091c\u093e\u0902\u091a\u0928\u0947 \u0938\u0947 \u0906\u092a \u092c\u0926\u0932\u0947 \u0939\u0941\u090f \u0915\u094d\u092f\u0942\u0906\u0930 \u0915\u094b\u0921 \u0914\u0930 \u0917\u0932\u0924 \u091f\u094d\u0930\u093e\u0902\u0938\u092b\u0930 \u0938\u0947 \u092c\u091a\u0924\u0947 \u0939\u0948\u0902\u0964',feedbackMr:'\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0928\u093f\u0930\u094d\u0923\u092f! \u092a\u094d\u0930\u093e\u092a\u094d\u0924\u0915\u0930\u094d\u0924\u094d\u092f\u093e\u091a\u0947 \u0928\u093e\u0935 \u0906\u0923\u093f \u0905\u0927\u093f\u0915\u0943\u0924 \u092c\u0945\u091c \u0924\u092a\u093e\u0938\u0932\u094d\u092f\u093e\u0928\u0947 \u0924\u0941\u092e\u094d\u0939\u0940 \u092c\u0926\u0932\u0932\u0947\u0932\u094d\u092f\u093e QR \u0915\u094b\u0921 \u0906\u0923\u093f \u091a\u0941\u0915\u0940\u091a\u094d\u092f\u093e \u091f\u094d\u0930\u093e\u0928\u094d\u0938\u092b\u0930\u092a\u093e\u0938\u0942\u0928 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0930\u093e\u0939\u0924\u093e.'},{id:'upi_pay_unsafe',textEn:'Quickly enter the UPI PIN without looking at the recipient name or amount.',textHi:'\u092a\u094d\u0930\u093e\u092a\u094d\u0924\u0915\u0930\u094d\u0924\u093e \u0915\u093e \u0928\u093e\u092e \u092f\u093e \u0930\u093e\u0936\u093f \u0926\u0947\u0916\u0947 \u092c\u093f\u0928\u093e \u0924\u0941\u0930\u0902\u0924 \u0905\u092a\u0928\u093e \u092f\u0942\u092a\u0940\u0906\u0908 \u092a\u093f\u0928 \u0926\u0930\u094d\u091c \u0915\u0930 \u0926\u0947\u0902\u0964',textMr:'\u092a\u094d\u0930\u093e\u092a\u094d\u0924\u0915\u0930\u094d\u0924\u094d\u092f\u093e\u091a\u0947 \u0928\u093e\u0935 \u0915\u093f\u0902\u0935\u093e \u0930\u0915\u094d\u0915\u092e \u0928 \u092a\u093e\u0939\u0924\u093e \u0918\u093e\u0908\u0918\u093e\u0908\u0928\u0947 UPI \u092a\u093f\u0928 \u091f\u093e\u0915\u093e.',isSafe:!1,feedbackEn:'Risky habit! If a scammer had swapped the QR sticker with their own, your money would be permanently sent to a fraudster.',feedbackHi:'\u091c\u094b\u0916\u093f\u092e \u092d\u0930\u093e \u0915\u0926\u092e! \u092f\u0926\u093f \u0915\u093f\u0938\u0940 \u0928\u0947 \u0915\u094d\u092f\u0942\u0906\u0930 \u0938\u094d\u091f\u0940\u0915\u0930 \u092c\u0926\u0932 \u0926\u093f\u092f\u093e \u0939\u094b\u0924\u093e, \u0924\u094b \u0906\u092a\u0915\u0947 \u092a\u0948\u0938\u0947 \u0938\u0940\u0927\u0947 \u0927\u094b\u0916\u0947\u092c\u093e\u091c \u0915\u0947 \u0916\u093e\u0924\u0947 \u092e\u0947\u0902 \u091a\u0932\u0947 \u091c\u093e\u0924\u0947\u0964',feedbackMr:'\u0927\u094b\u0915\u093e\u0926\u093e\u092f\u0915 \u0938\u0935\u092f! \u091c\u0930 \u0915\u094b\u0923\u0940 \u0926\u0941\u0915\u093e\u0928\u093e\u0924\u0940\u0932 QR \u0938\u094d\u091f\u093f\u0915\u0930 \u092c\u0926\u0932\u0932\u093e \u0905\u0938\u0947\u0932, \u0924\u0930 \u0924\u0941\u092e\u091a\u0947 \u092a\u0948\u0938\u0947 \u0925\u0947\u091f \u0938\u093e\u092f\u092c\u0930 \u092d\u093e\u092e\u091f\u094d\u092f\u093e\u0915\u0921\u0947 \u091c\u093e\u0924\u0940\u0932.'}]},{id:'scenario_3_upi_collect',stepNumber:3,category:'upi_collect',titleEn:'UPI Collect Request: Receiving Money',titleHi:'\u092f\u0942\u092a\u0940\u0906\u0908 \u0915\u0932\u0947\u0915\u094d\u091f \u0930\u093f\u0915\u094d\u0935\u0947\u0938\u094d\u091f: \u092a\u0948\u0938\u0947 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0928\u093e',titleMr:'UPI \u0915\u0932\u0947\u0915\u094d\u091f \u0930\u093f\u0915\u094d\u0935\u0947\u0938\u094d\u091f: \u092a\u0948\u0938\u0947 \u092e\u093f\u0933\u0935\u0923\u0947',subtitleEn:'The #1 UPI scam in India: Entering your PIN pays money, NEVER receives money',subtitleHi:'\u092d\u093e\u0930\u0924 \u0915\u093e \u0938\u092c\u0938\u0947 \u0906\u092e \u092f\u0942\u092a\u0940\u0906\u0908 \u0938\u094d\u0915\u0948\u092e: \u092a\u093f\u0928 \u0921\u093e\u0932\u0928\u0947 \u0938\u0947 \u092a\u0948\u0938\u0947 \u0915\u091f\u0924\u0947 \u0939\u0948\u0902, \u0915\u092d\u0940 \u092e\u093f\u0932\u0924\u0947 \u0928\u0939\u0940\u0902',subtitleMr:'\u092d\u093e\u0930\u0924\u093e\u0924\u0940\u0932 \u0938\u0930\u094d\u0935\u093e\u0924 \u092e\u094b\u0920\u093e UPI \u0938\u094d\u0915\u0945\u092e: \u092a\u093f\u0928 \u091f\u093e\u0915\u0932\u094d\u092f\u093e\u0928\u0947 \u092a\u0948\u0938\u0947 \u0915\u093e\u092a\u0932\u0947 \u091c\u093e\u0924\u093e\u0924, \u0915\u0927\u0940\u0939\u0940 \u092e\u093f\u0933\u0924 \u0928\u093e\u0939\u0940\u0924',scenarioTypeLabelEn:'Scenario 3: Money Receiving Trap',scenarioTypeLabelHi:'\u092a\u0930\u093f\u0926\u0943\u0936\u094d\u092f 3: \u092a\u0948\u0938\u0947 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0928\u0947 \u0915\u093e \u091c\u093e\u0932',scenarioTypeLabelMr:'\u092a\u0930\u093f\u0926\u0943\u0936\u094d\u092f \u0969: \u092a\u0948\u0938\u0947 \u092e\u093f\u0933\u0935\u0923\u094d\u092f\u093e\u091a\u093e \u0938\u093e\u092a\u0933\u093e',mockSender:'Ramesh Kumar (OLX Buyer for Sofa)',mockAmount:'\u20b9 10,000.00',descriptionEn:'A buyer on OLX agrees to buy your old sofa for \u20b910,000. He tells you: "I am sending a payment request on Google Pay/PhonePe. Accept it and enter your 4-digit UPI PIN to receive \u20b910,000 into your bank account immediately!" A notification pops up saying: "Collect Request from Ramesh: \u20b910,000".',descriptionHi:'\u0913\u090f\u0932\u090f\u0915\u094d\u0938 \u092a\u0930 \u090f\u0915 \u0916\u0930\u0940\u0926\u093e\u0930 \u0906\u092a\u0915\u093e \u0938\u094b\u092b\u093e \u20b910,000 \u092e\u0947\u0902 \u0916\u0930\u0940\u0926\u0928\u0947 \u0915\u094b \u0924\u0948\u092f\u093e\u0930 \u0939\u094b\u0924\u093e \u0939\u0948\u0964 \u0935\u0939 \u092b\u094b\u0928 \u092a\u0930 \u0915\u0939\u0924\u093e \u0939\u0948: "\u092e\u0948\u0902\u0928\u0947 \u0917\u0942\u0917\u0932 \u092a\u0947 \u092a\u0930 \u20b910,000 \u0915\u0940 \u0930\u093f\u0915\u094d\u0935\u0947\u0938\u094d\u091f \u092d\u0947\u091c\u0940 \u0939\u0948\u0964 \u0909\u0938\u0947 \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930\u0947\u0902 \u0914\u0930 \u0905\u092a\u0928\u0947 \u0916\u093e\u0924\u0947 \u092e\u0947\u0902 \u092a\u0948\u0938\u0947 \u092a\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0905\u092a\u0928\u093e 4 \u0905\u0902\u0915\u094b\u0902 \u0915\u093e \u092f\u0942\u092a\u0940\u0906\u0908 \u092a\u093f\u0928 \u0921\u093e\u0932\u0947\u0902!" \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u092a\u0930 \u0926\u093f\u0916\u0924\u093e \u0939\u0948: "Collect Request from Ramesh: \u20b910,000".',descriptionMr:'OLX \u0935\u0930\u0940\u0932 \u090f\u0915 \u0917\u094d\u0930\u093e\u0939\u0915 \u0924\u0941\u092e\u091a\u093e \u0938\u094b\u092b\u093e \u20b9\u0967\u0966,\u0966\u0966\u0966 \u092e\u0927\u094d\u092f\u0947 \u0935\u093f\u0915\u0924 \u0918\u0947\u0923\u094d\u092f\u093e\u0938 \u0924\u092f\u093e\u0930 \u0939\u094b\u0924\u094b. \u0924\u094b \u092e\u094d\u0939\u0923\u0924\u094b: "\u092e\u0940 PhonePe \u0935\u0930 \u20b9\u0967\u0966,\u0966\u0966\u0966 \u091a\u0940 \u0930\u093f\u0915\u094d\u0935\u0947\u0938\u094d\u091f \u092a\u093e\u0920\u0935\u0932\u0940 \u0906\u0939\u0947. \u0924\u0940 \u0938\u094d\u0935\u0940\u0915\u093e\u0930\u093e \u0906\u0923\u093f \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0916\u093e\u0924\u094d\u092f\u093e\u0924 \u092a\u0948\u0938\u0947 \u092e\u093f\u0933\u0935\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0924\u0941\u092e\u091a\u093e \u096a-\u0905\u0902\u0915\u0940 UPI \u092a\u093f\u0928 \u091f\u093e\u0915\u093e!" \u0938\u094d\u0915\u094d\u0930\u0940\u0928\u0935\u0930 \u0926\u093f\u0938\u0924\u0947: "Collect Request from Ramesh: \u20b910,000".',goldenRuleEn:'CRITICAL GOLDEN RULE: You NEVER enter a UPI PIN to receive money! Entering your UPI PIN ALWAYS transfers money OUT of your bank account. To receive money, the sender only needs your mobile number or UPI ID.',goldenRuleHi:'\u0905\u0924\u094d\u092f\u0902\u0924 \u092e\u0939\u0924\u094d\u0935\u092a\u0942\u0930\u094d\u0923 \u0928\u093f\u092f\u092e: \u092a\u0948\u0938\u0947 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u092d\u0940 \u092d\u0940 \u092f\u0942\u092a\u0940\u0906\u0908 \u092a\u093f\u0928 \u0926\u0930\u094d\u091c \u0928\u0939\u0940\u0902 \u0915\u0930\u0928\u093e \u092a\u0921\u093c\u0924\u093e! \u092f\u0942\u092a\u0940\u0906\u0908 \u092a\u093f\u0928 \u0921\u093e\u0932\u0928\u0947 \u0938\u0947 \u0939\u092e\u0947\u0936\u093e \u0906\u092a\u0915\u0947 \u0916\u093e\u0924\u0947 \u0938\u0947 \u092a\u0948\u0938\u0947 \u0915\u091f\u0924\u0947 \u0939\u0948\u0902\u0964 \u092a\u0948\u0938\u0947 \u0932\u0947\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u0947\u0935\u0932 \u0906\u092a\u0915\u093e \u0928\u0902\u092c\u0930 \u092f\u093e \u092f\u0942\u092a\u0940\u0906\u0908 \u0906\u0908\u0921\u0940 \u0915\u093e\u092b\u0940 \u0939\u0948\u0964',goldenRuleMr:'\u0905\u0924\u094d\u092f\u0902\u0924 \u092e\u0939\u0924\u094d\u0924\u094d\u0935\u093e\u091a\u093e \u0938\u0941\u0935\u0930\u094d\u0923 \u0928\u093f\u092f\u092e: \u092a\u0948\u0938\u0947 \u092e\u093f\u0933\u0935\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0915\u0927\u0940\u0939\u0940 UPI \u092a\u093f\u0928 \u091f\u093e\u0915\u093e\u0935\u093e \u0932\u093e\u0917\u0924 \u0928\u093e\u0939\u0940! UPI \u092a\u093f\u0928 \u091f\u093e\u0915\u0932\u094d\u092f\u093e\u0928\u0947 \u0928\u0947\u0939\u092e\u0940 \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0916\u093e\u0924\u094d\u092f\u093e\u0924\u0942\u0928 \u092a\u0948\u0938\u0947 \u0915\u093e\u092a\u0932\u0947 \u091c\u093e\u0924\u093e\u0924. \u092a\u0948\u0938\u0947 \u0938\u094d\u0935\u0940\u0915\u093e\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092b\u0915\u094d\u0924 \u0924\u0941\u092e\u091a\u093e \u092e\u094b\u092c\u093e\u0908\u0932 \u0928\u0902\u092c\u0930 \u0915\u093f\u0902\u0935\u093e UPI ID \u092a\u0941\u0930\u0947\u0938\u093e \u0905\u0938\u0924\u094b.',dangerIndicatorsEn:['Fraudsters claim "Enter PIN to receive money" \u2014 this is completely false in all banking apps','A "Collect Request" is a DEMAND for you to pay them \u20b910,000','Entering your UPI PIN authorizes an outgoing debit transaction','Official bank rule: Receiving money requires ZERO actions and ZERO PIN entries from you'],dangerIndicatorsHi:['\u0927\u094b\u0916\u0947\u092c\u093e\u091c \u0915\u0939\u0924\u0947 \u0939\u0948\u0902 "\u092a\u0948\u0938\u0947 \u092a\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092a\u093f\u0928 \u0921\u093e\u0932\u0947\u0902" \u2014 \u092f\u0939 \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u0938\u0947 \u090f\u0915 \u0938\u092b\u0947\u0926 \u091d\u0942\u0920 \u0939\u0948','"Collect Request" \u0915\u093e \u0905\u0930\u094d\u0925 \u0939\u0948 \u0915\u093f \u0935\u0947 \u0906\u092a\u0915\u0947 \u0916\u093e\u0924\u0947 \u0938\u0947 \u20b910,000 \u092e\u093e\u0902\u0917 \u0930\u0939\u0947 \u0939\u0948\u0902','\u092f\u0942\u092a\u0940\u0906\u0908 \u092a\u093f\u0928 \u0921\u093e\u0932\u0924\u0947 \u0939\u0940 \u0906\u092a\u0915\u0947 \u092c\u0948\u0902\u0915 \u0916\u093e\u0924\u0947 \u0938\u0947 \u0924\u0941\u0930\u0902\u0924 \u092a\u0948\u0938\u0947 \u0915\u091f \u091c\u093e\u090f\u0902\u0917\u0947','\u092c\u0948\u0902\u0915 \u0915\u093e \u0928\u093f\u092f\u092e: \u092a\u0948\u0938\u0947 \u0906\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0906\u092a\u0915\u094b \u0915\u092d\u0940 \u092d\u0940 \u0915\u094b\u0908 \u092a\u093f\u0928 \u0928\u0939\u0940\u0902 \u0921\u093e\u0932\u0928\u093e \u0939\u094b\u0924\u093e'],dangerIndicatorsMr:['\u092d\u093e\u092e\u091f\u0947 \u0938\u093e\u0902\u0917\u0924\u093e\u0924 "\u092a\u0948\u0938\u0947 \u092e\u093f\u0933\u0935\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092a\u093f\u0928 \u091f\u093e\u0915\u093e" \u2014 \u0939\u0947 \u0967\u0966\u0966% \u0927\u093e\u0926\u093e\u0902\u0924 \u0916\u094b\u091f\u0947 \u0906\u0939\u0947','"Collect Request" \u091a\u093e \u0905\u0930\u094d\u0925 \u0924\u0947 \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0916\u093e\u0924\u094d\u092f\u093e\u0924\u0942\u0928 \u20b9\u0967\u0966,\u0966\u0966\u0966 \u0915\u093e\u0922\u0923\u094d\u092f\u093e\u091a\u0940 \u092e\u093e\u0917\u0923\u0940 \u0915\u0930\u0924 \u0906\u0939\u0947\u0924','UPI \u092a\u093f\u0928 \u091f\u093e\u0915\u0924\u093e\u091a \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u092c\u0901\u0915 \u0916\u093e\u0924\u094d\u092f\u093e\u0924\u0942\u0928 \u0930\u0915\u094d\u0915\u092e \u0924\u093e\u0924\u094d\u0915\u093e\u0933 \u0915\u093e\u092a\u0932\u0940 \u091c\u093e\u0908\u0932','\u092c\u0901\u0915\u0947\u091a\u093e \u0928\u093f\u092f\u092e: \u0916\u093e\u0924\u094d\u092f\u093e\u0924 \u092a\u0948\u0938\u0947 \u091c\u092e\u093e \u0939\u094b\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0915\u0927\u0940\u0939\u0940 \u0915\u094b\u0923\u0924\u093e\u0939\u0940 \u092a\u093f\u0928 \u091f\u093e\u0915\u093e\u0935\u093e \u0932\u093e\u0917\u0924 \u0928\u093e\u0939\u0940'],choices:[{id:'upi_collect_safe',textEn:'Decline the request immediately! You NEVER enter a UPI PIN to receive money. Entering a PIN will deduct \u20b910,000 from your account.',textHi:'\u0930\u093f\u0915\u094d\u0935\u0947\u0938\u094d\u091f \u0924\u0941\u0930\u0902\u0924 \u0905\u0938\u094d\u0935\u0940\u0915\u093e\u0930 (Decline) \u0915\u0930\u0947\u0902! \u092a\u0948\u0938\u0947 \u092a\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u092d\u0940 \u092a\u093f\u0928 \u0928\u0939\u0940\u0902 \u0921\u093e\u0932\u093e \u091c\u093e\u0924\u093e\u0964 \u092a\u093f\u0928 \u0921\u093e\u0932\u0928\u0947 \u0938\u0947 \u0906\u092a\u0915\u0947 \u0916\u093e\u0924\u0947 \u0938\u0947 \u20b910,000 \u0915\u091f \u091c\u093e\u090f\u0902\u0917\u0947\u0964',textMr:'\u0930\u093f\u0915\u094d\u0935\u0947\u0938\u094d\u091f \u0924\u093e\u0924\u094d\u0915\u093e\u0933 \u0928\u093e\u0915\u093e\u0930\u093e (Decline)! \u092a\u0948\u0938\u0947 \u092e\u093f\u0933\u0935\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0915\u0927\u0940\u0939\u0940 \u092a\u093f\u0928 \u091f\u093e\u0915\u0932\u093e \u091c\u093e\u0924 \u0928\u093e\u0939\u0940. \u092a\u093f\u0928 \u091f\u093e\u0915\u0932\u094d\u092f\u093e\u0938 \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0916\u093e\u0924\u094d\u092f\u093e\u0924\u0942\u0928 \u20b9\u0967\u0966,\u0966\u0966\u0966 \u0915\u093e\u092a\u0932\u0947 \u091c\u093e\u0924\u0940\u0932.',isSafe:!0,feedbackEn:'Spot on! You remembered the golden rule: Entering your UPI PIN always sends money, never receives it. Declining saved you from losing \u20b910,000.',feedbackHi:'\u092c\u093f\u0932\u094d\u0915\u0941\u0932 \u0938\u0939\u0940! \u0906\u092a\u0928\u0947 \u0938\u0941\u0928\u0939\u0930\u093e \u0928\u093f\u092f\u092e \u092f\u093e\u0926 \u0930\u0916\u093e: \u092f\u0942\u092a\u0940\u0906\u0908 \u092a\u093f\u0928 \u0915\u0947\u0935\u0932 \u092a\u0948\u0938\u0947 \u092d\u0947\u091c\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0939\u094b\u0924\u093e \u0939\u0948, \u092a\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0928\u0939\u0940\u0902\u0964 \u0930\u093f\u0915\u094d\u0935\u0947\u0938\u094d\u091f \u0920\u0941\u0915\u0930\u093e\u0915\u0930 \u0906\u092a\u0928\u0947 \u20b910,000 \u092c\u091a\u093e\u090f\u0964',feedbackMr:'\u0905\u0917\u0926\u0940 \u0905\u091a\u0942\u0915! \u0924\u0941\u092e\u094d\u0939\u0940 \u0938\u0941\u0935\u0930\u094d\u0923 \u0928\u093f\u092f\u092e \u0932\u0915\u094d\u0937\u093e\u0924 \u0920\u0947\u0935\u0932\u093e: UPI \u092a\u093f\u0928 \u092b\u0915\u094d\u0924 \u092a\u0948\u0938\u0947 \u0926\u0947\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0905\u0938\u0924\u094b, \u092e\u093f\u0933\u0935\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0928\u093e\u0939\u0940. \u0935\u093f\u0928\u0902\u0924\u0940 \u0928\u093e\u0915\u093e\u0930\u0942\u0928 \u0924\u0941\u092e\u094d\u0939\u0940 \u0924\u0941\u092e\u091a\u0947 \u20b9\u0967\u0966,\u0966\u0966\u0966 \u0935\u093e\u091a\u0935\u0932\u0947.'},{id:'upi_collect_unsafe',textEn:'Tap "Pay / Approve" and enter your UPI PIN to claim the \u20b910,000 deposit.',textHi:'"Pay / Approve" \u0926\u092c\u093e\u090f\u0902 \u0914\u0930 \u20b910,000 \u091c\u092e\u093e \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0905\u092a\u0928\u093e \u092f\u0942\u092a\u0940\u0906\u0908 \u092a\u093f\u0928 \u0921\u093e\u0932\u0947\u0902\u0964',textMr:'"Pay / Approve" \u0926\u093e\u092c\u093e \u0906\u0923\u093f \u20b9\u0967\u0966,\u0966\u0966\u0966 \u092e\u093f\u0933\u0935\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0924\u0941\u092e\u091a\u093e UPI \u092a\u093f\u0928 \u091f\u093e\u0915\u093e.',isSafe:!1,feedbackEn:'CRITICAL LOSS! You were debited \u20b910,000. Never enter your UPI PIN when someone promises to send you money.',feedbackHi:'\u092c\u0921\u093c\u093e \u0928\u0941\u0915\u0938\u093e\u0928! \u0906\u092a\u0915\u0947 \u0916\u093e\u0924\u0947 \u0938\u0947 \u20b910,000 \u0915\u091f \u0917\u090f\u0964 \u091c\u092c \u0915\u094b\u0908 \u092a\u0948\u0938\u0947 \u092d\u0947\u091c\u0928\u0947 \u0915\u093e \u0935\u093e\u0926\u093e \u0915\u0930\u0947, \u0924\u094b \u0915\u092d\u0940 \u092d\u0940 \u0905\u092a\u0928\u093e \u092f\u0942\u092a\u0940\u0906\u0908 \u092a\u093f\u0928 \u0928 \u0921\u093e\u0932\u0947\u0902\u0964',feedbackMr:'\u092e\u094b\u0920\u0947 \u0928\u0941\u0915\u0938\u093e\u0928! \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0916\u093e\u0924\u094d\u092f\u093e\u0924\u0942\u0928 \u20b9\u0967\u0966,\u0966\u0966\u0966 \u0915\u093e\u092a\u0932\u0947 \u0917\u0947\u0932\u0947. \u0915\u094b\u0923\u0940 \u092a\u0948\u0938\u0947 \u092a\u093e\u0920\u0935\u0923\u094d\u092f\u093e\u091a\u0947 \u0906\u092e\u093f\u0937 \u0926\u093e\u0916\u0935\u0932\u094d\u092f\u093e\u0938 \u0915\u0927\u0940\u0939\u0940 UPI \u092a\u093f\u0928 \u091f\u093e\u0915\u0942 \u0928\u0915\u093e.'}]},{id:'scenario_4_otp_safety',stepNumber:4,category:'otp_safety',titleEn:'Fake Bank Manager Call & OTP Trap',titleHi:'\u0928\u0915\u0932\u0940 \u092c\u0948\u0902\u0915 \u092e\u0948\u0928\u0947\u091c\u0930 \u0915\u0940 \u0915\u0949\u0932 \u0914\u0930 \u0913\u091f\u0940\u092a\u0940 \u091c\u093e\u0932',titleMr:'\u092c\u0928\u093e\u0935\u091f \u092c\u0901\u0915 \u0935\u094d\u092f\u0935\u0938\u094d\u0925\u093e\u092a\u0915\u093e\u091a\u093e \u0915\u0949\u0932 \u0906\u0923\u093f OTP \u0938\u093e\u092a\u0933\u093e',subtitleEn:'Recognize high-pressure calls demanding your OTP to "cancel" a transaction',subtitleHi:'\u0932\u0947\u0928\u0926\u0947\u0928 "\u0930\u0926\u094d\u0926" \u0915\u0930\u0928\u0947 \u0915\u0947 \u0928\u093e\u092e \u092a\u0930 \u0913\u091f\u0940\u092a\u0940 \u092e\u093e\u0902\u0917\u0928\u0947 \u0935\u093e\u0932\u0940 \u0915\u0949\u0932\u094b\u0902 \u0915\u094b \u092a\u0939\u091a\u093e\u0928\u0947\u0902',subtitleMr:'\u0935\u094d\u092f\u0935\u0939\u093e\u0930 "\u0930\u0926\u094d\u0926" \u0915\u0930\u0923\u094d\u092f\u093e\u091a\u094d\u092f\u093e \u092c\u0939\u093e\u0923\u094d\u092f\u093e\u0928\u0947 OTP \u092e\u093e\u0917\u0923\u093e\u0930\u0947 \u092b\u0938\u0935\u0947 \u0915\u0949\u0932 \u0913\u0933\u0916\u093e',scenarioTypeLabelEn:'Scenario 4: Urgent Phone Call Trap',scenarioTypeLabelHi:'\u092a\u0930\u093f\u0926\u0943\u0936\u094d\u092f 4: \u092b\u0930\u094d\u091c\u0940 \u092b\u094b\u0928 \u0915\u0949\u0932 \u0915\u093e \u0916\u0924\u0930\u093e',scenarioTypeLabelMr:'\u092a\u0930\u093f\u0926\u0943\u0936\u094d\u092f \u096a: \u092c\u0928\u093e\u0935\u091f \u092b\u094b\u0928 \u0915\u0949\u0932\u091a\u093e \u0927\u094b\u0915\u093e',mockCallerName:'Rajesh Sharma (Claims: Bank Anti-Fraud Officer)',mockCallUrgency:'HIGH URGENCY \u2014 60 Seconds Left to Stop Fraud',mockOtpCode:'8 4 9 2 0 1',mockSmsContent:'849201 is your OTP for purchase of Rs 25,000 at OnlineShop. NEVER share your OTP with anyone, including bank staff.',descriptionEn:'A stressed caller claiming to be "Chief Manager Sharma from Bank Fraud Cell" calls your phone: "Sir, an unauthorized debit of \u20b925,000 was just attempted on your account! We are trying to stop it. An SMS with a 6-digit cancellation code has been sent to your phone. Tell me the OTP immediately to block this transaction!"',descriptionHi:'\u090f\u0915 \u0918\u092c\u0930\u093e\u092f\u093e \u0939\u0941\u0906 \u0915\u0949\u0932\u0930 \u091c\u094b \u0916\u0941\u0926 \u0915\u094b "\u092c\u0948\u0902\u0915 \u092b\u094d\u0930\u0949\u0921 \u0938\u0947\u0932 \u0915\u093e \u091a\u0940\u092b \u092e\u0948\u0928\u0947\u091c\u0930 \u0936\u0930\u094d\u092e\u093e" \u092c\u0924\u093e\u0924\u093e \u0939\u0948, \u0906\u092a\u0915\u094b \u0915\u0949\u0932 \u0915\u0930\u0924\u093e \u0939\u0948: "\u0938\u0930, \u0906\u092a\u0915\u0947 \u0916\u093e\u0924\u0947 \u0938\u0947 \u20b925,000 \u0915\u093e \u092b\u0930\u094d\u091c\u0940 \u091f\u094d\u0930\u093e\u0902\u0938\u092b\u0930 \u0939\u094b \u0930\u0939\u093e \u0939\u0948! \u0939\u092e \u0907\u0938\u0947 \u0930\u094b\u0915\u0928\u0947 \u0915\u0940 \u0915\u094b\u0936\u093f\u0936 \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902\u0964 \u0906\u092a\u0915\u0947 \u092b\u094b\u0928 \u092a\u0930 6 \u0905\u0902\u0915\u094b\u0902 \u0915\u093e \u0915\u0948\u0902\u0938\u093f\u0932\u0947\u0936\u0928 \u0915\u094b\u0921 \u092d\u0947\u091c\u093e \u0917\u092f\u093e \u0939\u0948\u0964 \u0907\u0938\u0947 \u0924\u0941\u0930\u0902\u0924 \u092e\u0941\u091d\u0947 \u092c\u0924\u093e\u090f\u0902 \u0924\u093e\u0915\u093f \u0939\u092e \u0907\u0938 \u092b\u094d\u0930\u0949\u0921 \u0915\u094b \u0930\u094b\u0915 \u0938\u0915\u0947\u0902!"',descriptionMr:'\u0938\u094d\u0935\u0924\u0903\u0932\u093e "\u092c\u0901\u0915 \u092b\u094d\u0930\u0949\u0921 \u0938\u0947\u0932\u091a\u0947 \u092e\u0941\u0916\u094d\u092f \u0935\u094d\u092f\u0935\u0938\u094d\u0925\u093e\u092a\u0915 \u0936\u0930\u094d\u092e\u093e" \u0938\u093e\u0902\u0917\u0923\u093e\u0930\u093e \u090f\u0915 \u0935\u094d\u092f\u0915\u094d\u0924\u0940 \u0924\u0941\u092e\u094d\u0939\u093e\u0932\u093e \u0915\u0949\u0932 \u0915\u0930\u0924\u094b: "\u0938\u0930, \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0916\u093e\u0924\u094d\u092f\u093e\u0924\u0942\u0928 \u20b9\u0968\u096b,\u0966\u0966\u0966 \u091a\u093e \u0935\u094d\u092f\u0935\u0939\u093e\u0930 \u0939\u094b\u0924 \u0906\u0939\u0947! \u0906\u092e\u094d\u0939\u0940 \u0924\u094b \u0925\u093e\u0902\u092c\u0935\u0923\u094d\u092f\u093e\u091a\u093e \u092a\u094d\u0930\u092f\u0924\u094d\u0928 \u0915\u0930\u0924 \u0906\u0939\u094b\u0924. \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u092b\u094b\u0928\u0935\u0930 \u096c-\u0905\u0902\u0915\u0940 \u0915\u094b\u0921 \u092a\u093e\u0920\u0935\u0932\u093e \u0906\u0939\u0947. \u0939\u093e \u0935\u094d\u092f\u0935\u0939\u093e\u0930 \u0930\u0926\u094d\u0926 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092e\u0932\u093e \u0924\u093e\u0924\u094d\u0915\u093e\u0933 \u0924\u094b OTP \u0938\u093e\u0902\u0917\u093e!"',goldenRuleEn:'Golden Rule: Legitimate bank officials, RBI officers, or police will NEVER ask for your OTP over phone, SMS, or WhatsApp. The OTP message clearly states it is FOR a purchase, not to cancel one.',goldenRuleHi:'\u0938\u094d\u0935\u0930\u094d\u0923 \u0928\u093f\u092f\u092e: \u0905\u0938\u0932\u0940 \u092c\u0948\u0902\u0915 \u0905\u0927\u093f\u0915\u093e\u0930\u0940, \u0906\u0930\u092c\u0940\u0906\u0908 \u092f\u093e \u092a\u0941\u0932\u093f\u0938 \u0915\u092d\u0940 \u092d\u0940 \u092b\u094b\u0928, \u090f\u0938\u090f\u092e\u090f\u0938 \u092f\u093e \u0935\u094d\u0939\u093e\u091f\u094d\u0938\u090f\u092a \u092a\u0930 \u0906\u092a\u0915\u093e \u0913\u091f\u0940\u092a\u0940 \u0928\u0939\u0940\u0902 \u092e\u093e\u0902\u0917\u0924\u0947\u0964 \u090f\u0938\u090f\u092e\u090f\u0938 \u0938\u094d\u092a\u0937\u094d\u091f \u0930\u0942\u092a \u0938\u0947 \u0915\u0939\u0924\u093e \u0939\u0948 \u0915\u093f \u092f\u0939 \u0916\u0930\u0940\u0926\u093e\u0930\u0940 \u0915\u0947 \u0932\u093f\u090f \u0939\u0948, \u0930\u0926\u094d\u0926 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0928\u0939\u0940\u0902\u0964',goldenRuleMr:'\u0938\u0941\u0935\u0930\u094d\u0923 \u0928\u093f\u092f\u092e: \u092c\u0901\u0915\u0947\u091a\u0947 \u0916\u0930\u0947 \u0905\u0927\u093f\u0915\u093e\u0930\u0940, \u0930\u093f\u091d\u0930\u094d\u0935\u094d\u0939 \u092c\u0901\u0915 \u0915\u093f\u0902\u0935\u093e \u092a\u094b\u0932\u0940\u0938 \u0915\u0927\u0940\u0939\u0940 \u092b\u094b\u0928\u0935\u0930 OTP \u092e\u093e\u0917\u0924 \u0928\u093e\u0939\u0940\u0924. \u092e\u0947\u0938\u0947\u091c\u092e\u0927\u094d\u092f\u0947 \u0938\u094d\u092a\u0937\u094d\u091f \u0932\u093f\u0939\u093f\u0932\u0947 \u0905\u0938\u0924\u0947 \u0915\u0940 \u0939\u093e \u0935\u094d\u092f\u0935\u0939\u093e\u0930 \u092a\u0942\u0930\u094d\u0923 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0906\u0939\u0947, \u0930\u0926\u094d\u0926 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0928\u093e\u0939\u0940.',dangerIndicatorsEn:['Creating false panic to rush you into acting without thinking','Claiming an OTP is needed to "cancel" or "reverse" a transaction (OTPs only AUTHORIZE transactions)','The actual SMS text clearly warns: "NEVER share your OTP with anyone, including bank staff"','No genuine banking system requires verbal disclosure of one-time passwords'],dangerIndicatorsHi:['\u0938\u094b\u091a\u0928\u0947 \u0915\u093e \u092e\u094c\u0915\u093e \u0926\u093f\u090f \u092c\u093f\u0928\u093e \u0918\u092c\u0930\u093e\u0939\u091f \u092a\u0948\u0926\u093e \u0915\u0930\u0915\u0947 \u091c\u0932\u094d\u0926\u092c\u093e\u091c\u0940 \u0915\u0930\u0935\u093e\u0928\u093e','\u092f\u0939 \u0926\u093e\u0935\u093e \u0915\u0930\u0928\u093e \u0915\u093f \u0932\u0947\u0928\u0926\u0947\u0928 "\u0930\u0926\u094d\u0926" \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0913\u091f\u0940\u092a\u0940 \u091a\u093e\u0939\u093f\u090f (\u0913\u091f\u0940\u092a\u0940 \u0915\u0947\u0935\u0932 \u092d\u0941\u0917\u0924\u093e\u0928 \u0915\u094b \u092e\u0902\u091c\u0942\u0930\u0940 \u0926\u0947\u0924\u093e \u0939\u0948)','\u090f\u0938\u090f\u092e\u090f\u0938 \u092e\u0947\u0902 \u0938\u094d\u092a\u0937\u094d\u091f \u091a\u0947\u0924\u093e\u0935\u0928\u0940: "\u092c\u0948\u0902\u0915 \u0915\u0930\u094d\u092e\u091a\u093e\u0930\u093f\u092f\u094b\u0902 \u0938\u0939\u093f\u0924 \u0915\u093f\u0938\u0940 \u0915\u0947 \u0938\u093e\u0925 \u092d\u0940 \u0905\u092a\u0928\u093e \u0913\u091f\u0940\u092a\u0940 \u0938\u093e\u091d\u093e \u0928 \u0915\u0930\u0947\u0902"','\u0915\u094b\u0908 \u092d\u0940 \u0935\u0948\u0927 \u092c\u0948\u0902\u0915 \u092a\u094d\u0930\u0923\u093e\u0932\u0940 \u092e\u094c\u0916\u093f\u0915 \u0930\u0942\u092a \u0938\u0947 \u0913\u091f\u0940\u092a\u0940 \u0928\u0939\u0940\u0902 \u092e\u093e\u0902\u0917\u0924\u0940'],dangerIndicatorsMr:['\u0935\u093f\u091a\u093e\u0930 \u0915\u0930\u0923\u094d\u092f\u093e\u091a\u0940 \u0938\u0902\u0927\u0940 \u0928 \u0926\u0947\u0924\u093e \u0918\u092c\u0930\u093e\u091f \u0928\u093f\u0930\u094d\u092e\u093e\u0923 \u0915\u0930\u0942\u0928 \u0918\u093e\u0908 \u0915\u0930\u093e\u092f\u0932\u093e \u0932\u093e\u0935\u0923\u0947','\u0935\u094d\u092f\u0935\u0939\u093e\u0930 "\u0930\u0926\u094d\u0926" \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 OTP \u0939\u0935\u093e \u0905\u0938\u0932\u094d\u092f\u093e\u091a\u093e \u0916\u094b\u091f\u093e \u0926\u093e\u0935\u093e (OTP \u092e\u0941\u0933\u0947 \u0935\u094d\u092f\u0935\u0939\u093e\u0930 \u092e\u0902\u091c\u0942\u0930 \u0939\u094b\u0924\u094b)','\u092e\u0947\u0938\u0947\u091c\u092e\u0927\u0940\u0932 \u0938\u094d\u092a\u0937\u094d\u091f \u0907\u0936\u093e\u0930\u093e: "\u092c\u0901\u0915 \u0915\u0930\u094d\u092e\u091a\u093e\u0931\u094d\u092f\u093e\u0902\u0938\u0939 \u0915\u094b\u0923\u093e\u0936\u0940\u0939\u0940 \u0906\u092a\u0932\u093e OTP \u0936\u0947\u0905\u0930 \u0915\u0930\u0942 \u0928\u0915\u093e"','\u0915\u094b\u0923\u0924\u0940\u0939\u0940 \u0916\u0930\u0940 \u092c\u0901\u0915 \u092f\u0902\u0924\u094d\u0930\u0923\u093e \u0924\u094b\u0902\u0921\u0940 OTP \u0935\u093f\u091a\u093e\u0930\u0924 \u0928\u093e\u0939\u0940'],choices:[{id:'otp_safe',textEn:'Hang up immediately! Never share your OTP with anyone. Call the official 1930 Cybercrime Helpline or your bank branch directly.',textHi:'\u0924\u0941\u0930\u0902\u0924 \u092b\u094b\u0928 \u0915\u093e\u091f \u0926\u0947\u0902! \u0905\u092a\u0928\u093e \u0913\u091f\u0940\u092a\u0940 \u0915\u093f\u0938\u0940 \u0915\u0947 \u0938\u093e\u0925 \u0938\u093e\u091d\u093e \u0928 \u0915\u0930\u0947\u0902\u0964 \u0938\u0940\u0927\u0947 \u0906\u0927\u093f\u0915\u093e\u0930\u093f\u0915 1930 \u0938\u093e\u0907\u092c\u0930 \u0939\u0947\u0932\u094d\u092a\u0932\u093e\u0907\u0928 \u092f\u093e \u0905\u092a\u0928\u0940 \u092c\u0948\u0902\u0915 \u0936\u093e\u0916\u093e \u0938\u0947 \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0930\u0947\u0902\u0964',textMr:'\u0924\u093e\u0924\u094d\u0915\u093e\u0933 \u092b\u094b\u0928 \u0915\u091f \u0915\u0930\u093e! \u0915\u094b\u0923\u093e\u0932\u093e\u0939\u0940 \u0906\u092a\u0932\u093e OTP \u0938\u093e\u0902\u0917\u0942 \u0928\u0915\u093e. \u0925\u0947\u091f \u0905\u0927\u093f\u0915\u0943\u0924 \u0967\u096f\u0969\u0966 \u0938\u093e\u092f\u092c\u0930 \u0939\u0947\u0932\u094d\u092a\u0932\u093e\u0907\u0928 \u0915\u093f\u0902\u0935\u093e \u0906\u092a\u0932\u094d\u092f\u093e \u092c\u0901\u0915 \u0936\u093e\u0916\u0947\u0936\u0940 \u0938\u0902\u092a\u0930\u094d\u0915 \u0938\u093e\u0927\u093e.',isSafe:!0,feedbackEn:'Outstanding! You refused to fall for social engineering panic. Bank employees never need your OTP, and hanging up preserved your funds.',feedbackHi:'\u0936\u093e\u0928\u0926\u093e\u0930! \u0906\u092a \u0918\u092c\u0930\u093e\u0939\u091f \u0914\u0930 \u091d\u093e\u0902\u0938\u0947 \u092e\u0947\u0902 \u0928\u0939\u0940\u0902 \u0906\u090f\u0964 \u092c\u0948\u0902\u0915 \u0915\u0930\u094d\u092e\u091a\u093e\u0930\u093f\u092f\u094b\u0902 \u0915\u094b \u0915\u092d\u0940 \u0906\u092a\u0915\u0947 \u0913\u091f\u0940\u092a\u0940 \u0915\u0940 \u091c\u0930\u0942\u0930\u0924 \u0928\u0939\u0940\u0902 \u0939\u094b\u0924\u0940\u0964 \u092b\u094b\u0928 \u0915\u093e\u091f\u0915\u0930 \u0906\u092a\u0928\u0947 \u0905\u092a\u0928\u093e \u092a\u0948\u0938\u093e \u092c\u091a\u093e\u092f\u093e\u0964',feedbackMr:'\u0909\u0924\u094d\u0915\u0943\u0937\u094d\u091f! \u0924\u0941\u092e\u094d\u0939\u0940 \u0916\u094b\u091f\u094d\u092f\u093e \u092d\u0940\u0924\u0940\u0932\u093e \u092c\u0933\u0940 \u092a\u0921\u0932\u093e \u0928\u093e\u0939\u0940\u0924. \u092c\u0901\u0915 \u0915\u0930\u094d\u092e\u091a\u093e\u0931\u094d\u092f\u093e\u0902\u0928\u093e \u0915\u0927\u0940\u0939\u0940 \u0924\u0941\u092e\u091a\u094d\u092f\u093e OTP \u091a\u0940 \u0917\u0930\u091c \u0928\u0938\u0924\u0947. \u092b\u094b\u0928 \u0915\u091f \u0915\u0930\u0942\u0928 \u0924\u0941\u092e\u094d\u0939\u0940 \u0924\u0941\u092e\u091a\u0947 \u092a\u0948\u0938\u0947 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0920\u0947\u0935\u0932\u0947.'},{id:'otp_unsafe',textEn:'Read out the 6-digit OTP code to the caller so they can stop the \u20b925,000 debit.',textHi:'\u0915\u0949\u0932\u0930 \u0915\u094b 6 \u0905\u0902\u0915\u094b\u0902 \u0915\u093e \u0913\u091f\u0940\u092a\u0940 \u092c\u0924\u093e \u0926\u0947\u0902 \u0924\u093e\u0915\u093f \u0935\u0939 \u20b925,000 \u0915\u093e \u0932\u0947\u0928\u0926\u0947\u0928 \u0930\u094b\u0915 \u0938\u0915\u0947\u0964',textMr:'\u0915\u0949\u0932\u0930\u0932\u093e \u096c-\u0905\u0902\u0915\u0940 OTP \u0938\u093e\u0902\u0917\u093e \u091c\u0947\u0923\u0947\u0915\u0930\u0942\u0928 \u0924\u094b \u20b9\u0968\u096b,\u0966\u0966\u0966 \u091a\u093e \u0935\u094d\u092f\u0935\u0939\u093e\u0930 \u0925\u093e\u0902\u092c\u0935\u0942 \u0936\u0915\u0947\u0932.',isSafe:!1,feedbackEn:'DISASTER! You handed the keys to the fraudster. Giving the OTP authorized the criminals to complete the \u20b925,000 withdrawal instantly.',feedbackHi:'\u0917\u0902\u092d\u0940\u0930 \u0917\u0932\u0924\u0940! \u0906\u092a\u0928\u0947 \u0927\u094b\u0916\u0947\u092c\u093e\u091c \u0915\u094b \u0905\u0928\u0941\u092e\u0924\u093f \u0926\u0947 \u0926\u0940\u0964 \u0913\u091f\u0940\u092a\u0940 \u092c\u0924\u093e\u0924\u0947 \u0939\u0940 \u0905\u092a\u0930\u093e\u0927\u093f\u092f\u094b\u0902 \u0928\u0947 \u0924\u0941\u0930\u0902\u0924 \u0906\u092a\u0915\u0947 \u0916\u093e\u0924\u0947 \u0938\u0947 \u20b925,000 \u0928\u093f\u0915\u093e\u0932 \u0932\u093f\u090f\u0964',feedbackMr:'\u0917\u0902\u092d\u0940\u0930 \u091a\u0942\u0915! \u0924\u0941\u092e\u094d\u0939\u0940 \u0938\u093e\u092f\u092c\u0930 \u0917\u0941\u0928\u094d\u0939\u0947\u0917\u093e\u0930\u093e\u0932\u093e \u092e\u0902\u091c\u0941\u0930\u0940 \u0926\u093f\u0932\u0940. OTP \u0938\u093e\u0902\u0917\u0924\u093e\u091a \u092d\u093e\u092e\u091f\u094d\u092f\u093e\u0902\u0928\u0940 \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0916\u093e\u0924\u094d\u092f\u093e\u0924\u0942\u0928 \u20b9\u0968\u096b,\u0966\u0966\u0966 \u0932\u0917\u0947\u091a \u0915\u093e\u0922\u0942\u0928 \u0918\u0947\u0924\u0932\u0947.'}]}]},542,[]);
