4d\u0936\u093f\u0915\u093e",helplineButton:"\u0938\u093e\u092f\u092c\u0930 \u0939\u0947\u0932\u094d\u092a\u0932\u093e\u0907\u0928 (1930) \u0935\u0930 \u0915\u0949\u0932 \u0915\u0930\u093e",helplineDesc:"\u092d\u093e\u0930\u0924 \u0938\u0930\u0915\u093e\u0930\u091a\u0947 \u0905\u0927\u093f\u0915\u0943\u0924 \u0938\u093e\u092f\u092c\u0930 \u0917\u0941\u0928\u094d\u0939\u0947 \u092a\u094b\u0930\u094d\u091f\u0932",helplineCardTitle:"\u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u0938\u093e\u092f\u092c\u0930 \u0917\u0941\u0928\u094d\u0939\u0947 \u0939\u0947\u0932\u094d\u092a\u0932\u093e\u0907\u0928 (\u0967\u096f\u0969\u0966)",helplineCardDesc:"\u0906\u092a\u0932\u094d\u092f\u093e \u092c\u0901\u0915 \u0916\u093e\u0924\u094d\u092f\u093e\u0924\u0942\u0928 \u092b\u0938\u0935\u0923\u0941\u0915\u0940\u0928\u0947 \u092a\u0948\u0938\u0947 \u0917\u0947\u0932\u0947 \u0905\u0938\u0932\u094d\u092f\u093e\u0938 \u0932\u0917\u0947\u091a \u0967\u096f\u0969\u0966 \u0935\u0930 \u0915\u0949\u0932 \u0915\u0930\u093e.",call1930Button:"\ud83d\udea8 \u0967\u096f\u0969\u0966 \u0939\u0947\u0932\u094d\u092a\u0932\u093e\u0907\u0928\u0935\u0930 \u0915\u0949\u0932 \u0915\u0930\u093e",portalCardTitle:"\u0905\u0927\u093f\u0915\u0943\u0924 \u0938\u093e\u092f\u092c\u0930 \u0917\u0941\u0928\u094d\u0939\u0947 \u092a\u094b\u0930\u094d\u091f\u0932",portalCardDesc:"\u092d\u093e\u0930\u0924 \u0938\u0930\u0915\u093e\u0930\u091a\u094d\u092f\u093e \u0905\u0927\u093f\u0915\u0943\u0924 \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u0938\u093e\u092f\u092c\u0930 \u0915\u094d\u0930\u093e\u0908\u092e \u092a\u094b\u0930\u094d\u091f\u0932\u0935\u0930 \u0924\u0915\u094d\u0930\u093e\u0930 \u0928\u094b\u0902\u0926\u0935\u093e.",portalButton:"\ud83c\udf10 cybercrime.gov.in \u0909\u0918\u0921\u093e",confirmDialTitle:"\u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u0938\u093e\u092f\u092c\u0930 \u0939\u0947\u0932\u094d\u092a\u0932\u093e\u0907\u0928 (\u0967\u096f\u0969\u0966) \u0935\u0930 \u0915\u0949\u0932 \u0915\u0930\u093e\u092f\u091a\u093e \u0915\u093e?",confirmDialMessage:"\u0939\u0947 \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u092b\u094b\u0928\u091a\u0947 \u0921\u093e\u092f\u0932\u0930 \u0909\u0918\u0921\u0947\u0932 \u091c\u0947\u0923\u0947\u0915\u0930\u0942\u0928 \u0924\u0941\u092e\u094d\u0939\u0940 \u092d\u093e\u0930\u0924\u093e\u091a\u094d\u092f\u093e \u0905\u0927\u093f\u0915\u0943\u0924 \u0938\u093e\u092f\u092c\u0930 \u0917\u0941\u0928\u094d\u0939\u0947 \u0939\u0947\u0932\u094d\u092a\u0932\u093e\u0907\u0928 \u0967\u096f\u0969\u0966 \u0935\u0930 \u092c\u094b\u0932\u0942 \u0936\u0915\u093e\u0932.",confirmDialAction:"\u0906\u0924\u093e \u0967\u096f\u0969\u0966 \u0935\u0930 \u0915\u0949\u0932 \u0915\u0930\u093e",confirmPortalTitle:"\u0938\u093e\u092f\u092c\u0930 \u0917\u0941\u0928\u094d\u0939\u0947 \u092a\u094b\u0930\u094d\u091f\u0932 \u0909\u0918\u0921\u093e\u092f\u091a\u0947 \u0915\u093e?",confirmPortalMessage:"\u0939\u0947 \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0935\u0947\u092c \u092c\u094d\u0930\u093e\u0909\u091d\u0930\u092e\u0927\u094d\u092f\u0947 \u092d\u093e\u0930\u0924 \u0938\u0930\u0915\u093e\u0930\u091a\u0947 \u0905\u0927\u093f\u0915\u0943\u0924 \u0938\u093e\u092f\u092c\u0930 \u092a\u094b\u0930\u094d\u091f\u0932 (cybercrime.gov.in) \u0909\u0918\u0921\u0947\u0932.",confirmPortalAction:"\u092a\u094b\u0930\u094d\u091f\u0932 \u0909\u0918\u0921\u093e",guidanceTitle:"\u092b\u0938\u0935\u0923\u0941\u0915\u0940\u0935\u0930 \u0924\u093e\u0924\u094d\u0915\u093e\u0933 \u0915\u0943\u0924\u0940 (\u0917\u094b\u0932\u094d\u0921\u0928 \u0905\u0935\u0930)",guidanceSubtitle:"\u0906\u0930\u094d\u0925\u093f\u0915 \u092b\u0938\u0935\u0923\u0941\u0915\u0940\u091a\u0940 \u0936\u0902\u0915\u093e \u0906\u0932\u094d\u092f\u093e\u0938 \u0968 \u0924\u093e\u0938\u093e\u0902\u091a\u094d\u092f\u093e \u0906\u0924 \u0939\u0940 \u096a \u092e\u0939\u0924\u094d\u0924\u094d\u0935\u093e\u091a\u0940 \u092a\u093e\u0935\u0932\u0947 \u0909\u091a\u0932\u093e:",step1Title:"\u0967. \u0968 \u0924\u093e\u0938\u093e\u0902\u091a\u094d\u092f\u093e \u0906\u0924 \u092a\u093e\u0935\u0932\u0947 \u0909\u091a\u0932\u093e (\u0917\u094b\u0932\u094d\u0921\u0928 \u0905\u0935\u0930)",step1Desc:"\u0932\u0917\u0947\u091a \u0967\u096f\u0969\u0966 \u0935\u0930 \u0915\u0949\u0932 \u0915\u0930\u093e. \u0938\u093e\u092f\u092c\u0930 \u092a\u094b\u0932\u0940\u0938 \u092c\u0901\u0915 \u0916\u093e\u0924\u094d\u092f\u093e\u0902\u092e\u0927\u0940\u0932 \u091a\u094b\u0930\u0940 \u091d\u093e\u0932\u0947\u0932\u0947 \u092a\u0948\u0938\u0947 \u090f\u091f\u0940\u090f\u092e\u092e\u0927\u0942\u0928 \u0915\u093e\u0922\u0923\u094d\u092f\u093e\u092a\u0942\u0930\u094d\u0935\u0940 \u0905\u0921\u0935\u0942 \u0936\u0915\u0924\u093e\u0924.",step2Title:"\u0968. \u092c\u0901\u0915\u0947\u091a\u0947 \u0915\u093e\u0930\u094d\u0921 \u0906\u0923\u093f \u092f\u0942\u092a\u0940\u0906\u092f \u0932\u0917\u0947\u091a \u092c\u094d\u0932\u0949\u0915 \u0915\u0930\u093e",step2Desc:"\u0916\u093e\u0932\u0940\u0932 \u0905\u0927\u093f\u0915\u0943\u0924 \u092c\u0901\u0915 \u0915\u094d\u0930\u092e\u093e\u0902\u0915\u093e\u0902\u0935\u0930 \u092b\u094b\u0928 \u0915\u0930\u0942\u0928 \u0921\u0947\u092c\u093f\u091f \u0915\u093e\u0930\u094d\u0921, \u0928\u0947\u091f \u092c\u0901\u0915\u093f\u0902\u0917 \u0906\u0923\u093f \u092f\u0942\u092a\u0940\u0906\u092f \u0924\u093e\u0924\u094d\u0915\u093e\u0933 \u0925\u093e\u0902\u092c\u0935\u093e.",step3Title:"\u0969. \u092a\u0941\u0930\u093e\u0935\u0947 \u091c\u092a\u0942\u0928 \u0920\u0947\u0935\u093e",step3Desc:"\u092c\u0901\u0915\u0947\u091a\u0947 \u090f\u0938\u090f\u092e\u090f\u0938, \u092a\u0948\u0936\u093e\u0902\u091a\u094d\u092f\u093e \u0915\u092a\u093e\u0924\u0940\u091a\u0947 \u092e\u0947\u0938\u0947\u091c \u0906\u0923\u093f \u092b\u094b\u0928 \u0928\u0902\u092c\u0930 \u0921\u093f\u0932\u0940\u091f \u0915\u0930\u0942 \u0928\u0915\u093e. \u0924\u0915\u094d\u0930\u093e\u0930\u0940\u0924 \u0924\u094d\u092f\u093e\u0902\u091a\u0940 \u0917\u0930\u091c \u0905\u0938\u0924\u0947.",step4Title:"\u096a. \u0909\u0930\u094d\u0935\u0930\u093f\u0924 \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0915\u0927\u0940\u0939\u0940 \u0915\u094b\u0923\u093e\u0932\u093e \u0938\u093e\u0902\u0917\u0942 \u0928\u0915\u093e",step4Desc:"\u0905\u0927\u093f\u0915\u0943\u0924 \u092c\u0901\u0915 \u0915\u093f\u0902\u0935\u093e \u092a\u094b\u0932\u0940\u0938 \u0905\u0927\u093f\u0915\u093e\u0930\u0940 \u0915\u0927\u0940\u0939\u0940 \u0913\u091f\u0940\u092a\u0940, \u092f\u0942\u092a\u0940\u0906\u092f \u092a\u093f\u0928 \u0915\u093f\u0902\u0935\u093e \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0935\u093f\u091a\u093e\u0930\u0924 \u0928\u093e\u0939\u0940\u0924.",warningNeverShare:"\u26a0\ufe0f \u092e\u0939\u0924\u094d\u0924\u094d\u0935\u093e\u091a\u0940 \u091a\u0947\u0924\u093e\u0935\u0923\u0940: \u092c\u0901\u0915 \u0915\u0930\u094d\u092e\u091a\u093e\u0930\u0940, \u092a\u094b\u0932\u0940\u0938 \u0915\u093f\u0902\u0935\u093e \u0967\u096f\u0969\u0966 \u0939\u0947\u0932\u094d\u092a\u0932\u093e\u0907\u0928 \u0915\u0927\u0940\u0939\u0940 \u0913\u091f\u0940\u092a\u0940, \u092f\u0942\u092a\u0940\u0906\u092f \u092a\u093f\u0928 \u0915\u093f\u0902\u0935\u093e \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u092e\u093e\u0917\u0924 \u0928\u093e\u0939\u0940\u0924. \u0915\u094b\u0923\u093e\u0932\u093e\u0939\u0940 \u0938\u093e\u0902\u0917\u0942 \u0928\u0915\u093e.",noAutoFreezeDisclaimer:"\u26a0\ufe0f \u092e\u0939\u0924\u094d\u0924\u094d\u0935\u093e\u091a\u0947: \u0938\u094d\u0915\u0945\u092e\u0936\u0940\u0932\u094d\u0921 \u0938\u094d\u0935\u0924\u0903\u0939\u0942\u0928 \u092c\u0901\u0915 \u0916\u093e\u0924\u0947 \u0917\u094b\u0920\u0935\u0942 \u0936\u0915\u0924 \u0928\u093e\u0939\u0940 \u0915\u093f\u0902\u0935\u093e \u092b\u094b\u0928 \u0915\u0930\u0942 \u0936\u0915\u0924 \u0928\u093e\u0939\u0940. \u0906\u092a\u0923 \u0938\u094d\u0935\u0924\u0903 \u092c\u0901\u0915\u0947\u0936\u0940 \u0915\u093f\u0902\u0935\u093e \u0967\u096f\u0969\u0966 \u0935\u0930 \u0938\u0902\u092a\u0930\u094d\u0915 \u0938\u093e\u0927\u093e\u0935\u093e.",familyNoticeTitle:"\u0915\u0941\u091f\u0941\u0902\u092c\u093e\u0938\u093e\u0920\u0940 \u0906\u092a\u0924\u094d\u0915\u093e\u0932\u0940\u0928 \u0938\u0902\u0926\u0947\u0936",familyNoticeDesc:"\u092e\u0941\u0932\u093e\u0902\u0928\u093e \u0915\u093f\u0902\u0935\u093e \u0928\u093e\u0924\u0947\u0935\u093e\u0908\u0915\u093e\u0902\u0928\u093e \u0924\u094d\u0935\u0930\u093f\u0924 \u0915\u0933\u0935\u093e \u091c\u0947\u0923\u0947\u0915\u0930\u0942\u0928 \u0924\u0947 \u0924\u0941\u092e\u094d\u0939\u093e\u0932\u093e \u0924\u093e\u0924\u094d\u0915\u093e\u0933 \u092e\u0926\u0924 \u0915\u0930\u0942 \u0936\u0915\u0924\u0940\u0932.",templateFraudAlert:"\ud83d\udea8 \u0915\u0941\u091f\u0941\u0902\u092c\u093e\u0938\u093e\u0920\u0940 \u092b\u0938\u0935\u0923\u0941\u0915\u0940\u091a\u0940 \u0906\u092a\u0924\u094d\u0915\u093e\u0932\u0940\u0928 \u0938\u0942\u091a\u0928\u093e",templateVerifyRequest:"\u2753 \u0938\u0902\u0936\u092f\u093e\u0938\u094d\u092a\u0926 \u0915\u0949\u0932/\u092e\u0947\u0938\u0947\u091c \u092a\u0921\u0924\u093e\u0933\u0923\u0940\u091a\u0940 \u0935\u093f\u0928\u0902\u0924\u0940",familyDetailsPlaceholder:"\u092a\u0930\u094d\u092f\u093e\u092f\u0940: \u0915\u093e\u092f \u0918\u0921\u0932\u0947 \u0924\u0947 \u0925\u094b\u0921\u0915\u094d\u092f\u093e\u0924 \u0932\u093f\u0939\u093e (\u0909\u0926\u093e. \u20b9\u096b,\u0966\u0966\u0966 \u0915\u091f \u091d\u093e\u0932\u0947, \u0935\u0940\u091c \u092c\u093f\u0932 \u0915\u0949\u0932 \u0906\u0932\u093e)",shareFamilyNoticeButton:"\ud83d\udce4 \u0928\u093e\u0924\u0947\u0935\u093e\u0908\u0915\u093e\u0902\u0928\u093e \u0936\u0947\u0905\u0930 \u0915\u0930\u093e",copyFamilyNoticeButton:"\ud83d\udccb \u0938\u0902\u0926\u0947\u0936 \u091f\u0947\u092e\u094d\u092a\u0932\u0947\u091f \u0915\u0949\u092a\u0940 \u0915\u0930\u093e",familyNoticeCopied:"\u0928\u093e\u0924\u0947\u0935\u093e\u0908\u0915\u093e\u0902\u091a\u093e \u0938\u0902\u0926\u0947\u0936 \u0915\u0949\u092a\u0940 \u091d\u093e\u0932\u093e! \u0924\u094b \u0935\u094d\u0939\u0949\u091f\u094d\u0938\u0972\u092a \u0915\u093f\u0902\u0935\u093e \u090f\u0938\u090f\u092e\u090f\u0938\u092e\u0927\u094d\u092f\u0947 \u092a\u0947\u0938\u094d\u091f \u0915\u0930\u093e.",bankDirectoryTitle:"\u092c\u0901\u0915\u093e\u0902\u091a\u0947 \u0905\u0927\u093f\u0915\u0943\u0924 \u0906\u092a\u0924\u094d\u0915\u093e\u0932\u0940\u0928 \u0939\u0947\u0932\u094d\u092a\u0932\u093e\u0907\u0928 \u0928\u0902\u092c\u0930",bankDirectoryDesc:"\u0921\u0947\u092c\u093f\u091f \u0915\u093e\u0930\u094d\u0921, \u092f\u0942\u092a\u0940\u0906\u092f \u0915\u093f\u0902\u0935\u093e \u0928\u0947\u091f \u092c\u0901\u0915\u093f\u0902\u0917 \u0924\u094d\u0935\u0930\u093f\u0924 \u0925\u093e\u0902\u092c\u0935\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092c\u0901\u0915\u0947\u091a\u094d\u092f\u093e \u091f\u094b\u0932-\u092b\u094d\u0930\u0940 \u0928\u0902\u092c\u0930\u0935\u0930 \u0924\u094d\u0935\u0930\u093f\u0924 \u0915\u0949\u0932 \u0915\u0930\u093e.",bankSearchPlaceholder:"\u0905\u0927\u093f\u0915\u0943\u0924 \u092c\u0901\u0915\u0947\u091a\u0947 \u0928\u093e\u0935 \u0936\u094b\u0927\u093e...",bankNotFoundTitle:"\u0906\u092a\u0932\u0940 \u092c\u0901\u0915 \u092f\u093e\u0926\u0940\u0924 \u0928\u093e\u0939\u0940 \u0915\u093e?",bankNotFoundDesc:"\u0906\u092a\u0932\u094d\u092f\u093e \u092a\u093e\u0938\u092c\u0941\u0915 \u0915\u093f\u0902\u0935\u093e \u0921\u0947\u092c\u093f\u091f \u0915\u093e\u0930\u094d\u0921\u091a\u094d\u092f\u093e \u092e\u093e\u0917\u0947 \u091b\u093e\u092a\u0932\u0947\u0932\u094d\u092f\u093e \u091f\u094b\u0932-\u092b\u094d\u0930\u0940 \u0915\u094d\u0930\u092e\u093e\u0902\u0915\u093e\u0935\u0930 \u0938\u0902\u092a\u0930\u094d\u0915 \u0938\u093e\u0927\u093e. \u0917\u0941\u0917\u0932 \u0938\u0930\u094d\u091a\u0935\u0930\u0940\u0932 \u0905\u0928\u094b\u0933\u0916\u0940 \u0915\u094d\u0930\u092e\u093e\u0902\u0915\u093e\u0902\u0935\u0930 \u0915\u0927\u0940\u0939\u0940 \u0935\u093f\u0936\u094d\u0935\u093e\u0938 \u0920\u0947\u0935\u0942 