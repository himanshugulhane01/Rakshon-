__d(function(g,r,i,a,m,e,d){Object.defineProperty(e,"__esModule",{value:!0}),e.SAFE_BROWSING_SCENARIOS=void 0;e.SAFE_BROWSING_SCENARIOS=[{id:'sbi_phishing',title:{en:'Scenario 1: Fake Bank Login & Spoofed Subdomain',hi:'\u092a\u0930\u093f\u0926\u0943\u0936\u094d\u092f \u0967: \u092b\u0930\u094d\u091c\u0940 \u092c\u0948\u0902\u0915 \u0932\u0949\u0917\u093f\u0928 \u0914\u0930 \u0928\u0915\u0932\u0940 \u0938\u092c\u0921\u094b\u092e\u0947\u0928',mr:'\u092a\u0930\u093f\u0926\u0943\u0936\u094d\u092f \u0967: \u092c\u0928\u093e\u0935\u091f \u092c\u0901\u0915 \u0932\u0949\u0917\u093f\u0928 \u0906\u0923\u093f \u0916\u094b\u091f\u093e \u0938\u092c\u0921\u094b\u092e\u0947\u0928'},displayedUrl:'http://onlinesbi.login-portal.xyz/netbanking',protocol:'http',domain:'login-portal.xyz',realDomain:'onlinesbi.sbi',isLegitimate:!1,pageType:'bank_login',mockPage:{brandName:'State Bank NetBanking (SIMULATION)',headline:{en:'Urgent KYC Verification Notice',hi:'\u092e\u0939\u0924\u094d\u0935\u092a\u0942\u0930\u094d\u0923 \u0915\u0947\u0935\u093e\u0908\u0938\u0940 \u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u0938\u0942\u091a\u0928\u093e',mr:'\u092e\u0939\u0924\u094d\u0924\u094d\u0935\u093e\u091a\u0940 \u0915\u0947\u0935\u093e\u092f\u0938\u0940 \u092a\u0921\u0924\u093e\u0933\u0923\u0940 \u0938\u0942\u091a\u0928\u093e'},body:{en:'Your account access has been restricted. Enter your NetBanking username and password below to immediately restore access.',hi:'\u0906\u092a\u0915\u093e \u0916\u093e\u0924\u093e \u092a\u094d\u0930\u0924\u093f\u092c\u0902\u0927\u093f\u0924 \u0915\u0930 \u0926\u093f\u092f\u093e \u0917\u092f\u093e \u0939\u0948\u0964 \u0938\u0947\u0935\u093e\u090f\u0902 \u092c\u0939\u093e\u0932 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0928\u0940\u091a\u0947 \u092f\u0942\u091c\u0930\u0928\u0947\u092e \u0914\u0930 \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902\u0964',mr:'\u0924\u0941\u092e\u091a\u0947 \u092c\u0901\u0915 \u0916\u093e\u0924\u0947 \u092a\u094d\u0930\u0924\u093f\u092c\u0902\u0927\u093f\u0924 \u0915\u0930\u0923\u094d\u092f\u093e\u0924 \u0906\u0932\u0947 \u0906\u0939\u0947. \u0938\u0947\u0935\u093e \u092a\u0942\u0930\u094d\u0935\u0935\u0924 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0916\u093e\u0932\u0940 \u092f\u0942\u091c\u0930\u0928\u0947\u092e \u0906\u0923\u093f \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u091f\u093e\u0915\u093e.'},warningFlag:{en:'\ud83d\udea8 RED FLAGS: Unencrypted HTTP connection + fake .xyz domain pretending to be State Bank.',hi:'\ud83d\udea8 \u0916\u0924\u0930\u0947 \u0915\u0947 \u0938\u0902\u0915\u0947\u0924: \u0905\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 HTTP \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u0914\u0930 \u0938\u094d\u091f\u0947\u091f \u092c\u0948\u0902\u0915 \u0915\u093e \u0922\u094b\u0902\u0917 \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u093e .xyz \u0921\u094b\u092e\u0947\u0928\u0964',mr:'\ud83d\udea8 \u0927\u094b\u0915\u094d\u092f\u093e\u091a\u0947 \u0907\u0936\u093e\u0930\u0947: \u0905\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 HTTP \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u0906\u0923\u093f \u0938\u094d\u091f\u0947\u091f \u092c\u0901\u0915\u0947\u091a\u0940 \u0928\u0915\u094d\u0915\u0932 \u0915\u0930\u0923\u093e\u0930\u093e \u092c\u0928\u093e\u0935\u091f .xyz \u0921\u094b\u092e\u0947\u0928.'}},keyTakeaway:{en:'Always look at the real domain right before the final slash. "onlinesbi" here is just a trick prefix; the real domain is "login-portal.xyz". Real banks use .sbi or .bank.in.',hi:'\u0939\u092e\u0947\u0936\u093e \u0905\u0902\u0924\u093f\u092e \u0938\u094d\u0932\u0948\u0936 \u0938\u0947 \u0920\u0940\u0915 \u092a\u0939\u0932\u0947 \u0915\u093e \u092e\u0941\u0916\u094d\u092f \u0921\u094b\u092e\u0947\u0928 \u0926\u0947\u0916\u0947\u0902\u0964 \u092f\u0939\u093e\u0901 \u0905\u0938\u0932\u0940 \u0921\u094b\u092e\u0947\u0928 "login-portal.xyz" \u0939\u0948\u0964 \u0905\u0938\u0932\u0940 \u092c\u0948\u0902\u0915 .sbi \u092f\u093e .bank.in \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964',mr:'\u0928\u0947\u0939\u092e\u0940 \u0938\u094d\u0932\u0945\u0936\u091a\u094d\u092f\u093e \u0906\u0927\u0940\u091a\u0947 \u092e\u0941\u0916\u094d\u092f \u0928\u093e\u0935 \u092a\u0939\u093e. \u092f\u0947\u0925\u0947 \u092e\u0941\u0916\u094d\u092f \u0921\u094b\u092e\u0947\u0928 "login-portal.xyz" \u0906\u0939\u0947. \u0916\u0930\u0940 \u092c\u0901\u0915 .sbi \u0915\u093f\u0902\u0935\u093e .bank.in \u0935\u093e\u092a\u0930\u0924\u0947.'},choices:[{id:'unsafe_trust',text:{en:'Yes, this looks like the bank because it says "onlinesbi" in the URL.',hi:'\u0939\u093e\u0901, \u092f\u0939 \u092c\u0948\u0902\u0915 \u091c\u0948\u0938\u093e \u0932\u0917 \u0930\u0939\u093e \u0939\u0948 \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u092f\u0942\u0906\u0930\u090f\u0932 \u092e\u0947\u0902 "onlinesbi" \u0932\u093f\u0916\u093e \u0939\u0948\u0964',mr:'\u0939\u094b\u092f, \u0939\u0940 \u092c\u0901\u0915 \u0935\u093e\u091f\u0924\u0947 \u0915\u093e\u0930\u0923 \u092a\u0924\u094d\u0924\u094d\u092f\u093e\u092e\u0927\u094d\u092f\u0947 "onlinesbi" \u0932\u093f\u0939\u093f\u0932\u0947 \u0906\u0939\u0947.'},isSafe:!1,explanation:{en:'Dangerous Trap: Scammers put authentic bank names as subdomains (onlinesbi.something.xyz) to fool unsuspecting seniors.',hi:'\u0916\u0924\u0930\u0928\u093e\u0915 \u091c\u093e\u0932: \u0920\u0917 \u0935\u0930\u093f\u0937\u094d\u0920 \u0928\u093e\u0917\u0930\u093f\u0915\u094b\u0902 \u0915\u094b \u0927\u094b\u0916\u093e \u0926\u0947\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0905\u0938\u0932\u0940 \u092c\u0948\u0902\u0915 \u0915\u0947 \u0928\u093e\u092e \u0915\u093e \u0938\u092c\u0921\u094b\u092e\u0947\u0928 \u092c\u0928\u093e\u0924\u0947 \u0939\u0948\u0902\u0964',mr:'\u0927\u094b\u0915\u093e\u0926\u093e\u092f\u0915 \u0938\u093e\u092a\u0933\u093e: \u092d\u093e\u092e\u091f\u0947 \u0926\u093f\u0936\u093e\u092d\u0942\u0932 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0916\u0931\u094d\u092f\u093e \u092c\u0901\u0915\u0947\u091a\u0947 \u0928\u093e\u0935 \u0938\u0941\u0930\u0941\u0935\u093e\u0924\u0940\u0932\u093e \u091c\u094b\u0921\u0924\u093e\u0924.'}},{id:'safe_reject',text:{en:'No! This website is fake with an insecure HTTP connection and a .xyz domain.',hi:'\u0928\u0939\u0940\u0902! \u092f\u0939 \u0935\u0947\u092c\u0938\u093e\u0907\u091f \u092b\u0930\u094d\u091c\u0940 \u0939\u0948, \u0907\u0938\u092e\u0947\u0902 \u0905\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 HTTP \u0914\u0930 .xyz \u0921\u094b\u092e\u0947\u0928 \u0939\u0948\u0964',mr:'\u0928\u093e\u0939\u0940! \u0939\u0940 \u092c\u0928\u093e\u0935\u091f \u0935\u0947\u092c\u0938\u093e\u0907\u091f \u0906\u0939\u0947, \u092f\u093e\u0924 \u0905\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 HTTP \u0906\u0923\u093f .xyz \u0921\u094b\u092e\u0947\u0928 \u0906\u0939\u0947.'},isSafe:!0,explanation:{en:'Spot on! You noticed both the absence of HTTPS and the fake .xyz domain.',hi:'\u092c\u093f\u0932\u094d\u0915\u0941\u0932 \u0938\u0939\u0940! \u0906\u092a\u0928\u0947 \u0905\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u0914\u0930 \u092b\u0930\u094d\u091c\u0940 .xyz \u0921\u094b\u092e\u0947\u0928 \u0926\u094b\u0928\u094b\u0902 \u0915\u094b \u0938\u0939\u0940 \u092a\u0939\u091a\u093e\u0928\u093e\u0964',mr:'\u0905\u0917\u0926\u0940 \u092c\u0930\u094b\u092c\u0930! \u0924\u0941\u092e\u094d\u0939\u0940 \u0905\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u0906\u0923\u093f \u092c\u0928\u093e\u0935\u091f \u0921\u094b\u092e\u0947\u0928 \u0905\u091a\u0942\u0915 \u0913\u0933\u0916\u0932\u0947.'}}]},{id:'incometax_authentic',title:{en:'Scenario 2: Authentic Government Portal Verification',hi:'\u092a\u0930\u093f\u0926\u0943\u0936\u094d\u092f \u0968: \u0905\u0938\u0932\u0940 \u0938\u0930\u0915\u093e\u0930\u0940 \u092a\u094b\u0930\u094d\u091f\u0932 \u0915\u0940 \u092a\u0939\u091a\u093e\u0928',mr:'\u092a\u0930\u093f\u0926\u0943\u0936\u094d\u092f \u0968: \u0905\u0927\u093f\u0915\u0943\u0924 \u0936\u093e\u0938\u0915\u0940\u092f \u092a\u094b\u0930\u094d\u091f\u0932\u091a\u0940 \u092a\u0921\u0924\u093e\u0933\u0923\u0940'},displayedUrl:'https://eportal.incometax.gov.in/iec/foservices/',protocol:'https',domain:'incometax.gov.in',isLegitimate:!0,pageType:'government_portal',mockPage:{brandName:'Income Tax Department | Government of India',headline:{en:'e-Filing Portal Services',hi:'\u0908-\u092b\u093e\u0907\u0932\u093f\u0902\u0917 \u092a\u094b\u0930\u094d\u091f\u0932 \u0938\u0947\u0935\u093e\u090f\u0902',mr:'\u0908-\u092b\u093e\u092f\u0932\u093f\u0902\u0917 \u092a\u094b\u0930\u094d\u091f\u0932 \u0938\u0947\u0935\u093e'},body:{en:'Welcome to the official Income Tax e-Filing portal. Check ITR status, file returns, and verify PAN safely with Government security standards.',hi:'\u0906\u0927\u093f\u0915\u093e\u0930\u093f\u0915 \u0906\u092f\u0915\u0930 \u0908-\u092b\u093e\u0907\u0932\u093f\u0902\u0917 \u092a\u094b\u0930\u094d\u091f\u0932 \u092e\u0947\u0902 \u0906\u092a\u0915\u093e \u0938\u094d\u0935\u093e\u0917\u0924 \u0939\u0948\u0964 \u0938\u0930\u0915\u093e\u0930\u0940 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u092e\u093e\u0928\u0915\u094b\u0902 \u0915\u0947 \u0938\u093e\u0925 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0930\u0942\u092a \u0938\u0947 \u0930\u093f\u091f\u0930\u094d\u0928 \u092b\u093e\u0907\u0932 \u0915\u0930\u0947\u0902\u0964',mr:'\u0905\u0927\u093f\u0915\u0943\u0924 \u0906\u092f\u0915\u0930 \u0908-\u092b\u093e\u092f\u0932\u093f\u0902\u0917 \u092a\u094b\u0930\u094d\u091f\u0932\u0935\u0930 \u0906\u092a\u0932\u0947 \u0938\u094d\u0935\u093e\u0917\u0924 \u0906\u0939\u0947. \u0936\u093e\u0938\u0915\u0940\u092f \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u092e\u093e\u0928\u0915\u093e\u0902\u0928\u0941\u0938\u093e\u0930 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924\u092a\u0923\u0947 \u0915\u093e\u092e \u0915\u0930\u093e.'}},keyTakeaway:{en:'All genuine Indian government departments strictly end in ".gov.in" or ".nic.in" with a secure padlock (HTTPS).',hi:'\u0938\u092d\u0940 \u0905\u0938\u0932\u0940 \u092d\u093e\u0930\u0924\u0940\u092f \u0938\u0930\u0915\u093e\u0930\u0940 \u0935\u093f\u092d\u093e\u0917 \u0905\u0928\u093f\u0935\u093e\u0930\u094d\u092f \u0930\u0942\u092a \u0938\u0947 ".gov.in" \u092f\u093e ".nic.in" \u092a\u0930 \u0938\u092e\u093e\u092a\u094d\u0924 \u0939\u094b\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u0909\u0928 \u092a\u0930 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0924\u093e\u0932\u0947 \u0915\u093e \u0928\u093f\u0936\u093e\u0928 \u0939\u094b\u0924\u093e \u0939\u0948\u0964',mr:'\u0938\u0930\u094d\u0935 \u0905\u0927\u093f\u0915\u0943\u0924 \u092d\u093e\u0930\u0924\u0940\u092f \u0936\u093e\u0938\u0915\u0940\u092f \u0935\u0947\u092c\u0938\u093e\u0907\u091f\u094d\u0938 ".gov.in" \u0915\u093f\u0902\u0935\u093e ".nic.in" \u0928\u0947 \u0938\u0902\u092a\u0924\u093e\u0924 \u0906\u0923\u093f \u0924\u094d\u092f\u093e\u0935\u0930 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0915\u0941\u0932\u092a\u093e\u091a\u0947 \u091a\u093f\u0928\u094d\u0939 \u0905\u0938\u0924\u0947.'},choices:[{id:'safe_trust_gov',text:{en:'Yes, this is safe! It uses https:// and an official .gov.in Indian Government domain.',hi:'\u0939\u093e\u0901, \u092f\u0939 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0939\u0948! \u0907\u0938\u092e\u0947\u0902 https:// \u0914\u0930 \u0906\u0927\u093f\u0915\u093e\u0930\u093f\u0915 .gov.in \u092d\u093e\u0930\u0924\u0940\u092f \u0938\u0930\u0915\u093e\u0930\u0940 \u0921\u094b\u092e\u0947\u0928 \u0939\u0948\u0964',mr:'\u0939\u094b\u092f, \u0939\u0947 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0906\u0939\u0947! \u092f\u093e\u0924 https:// \u0906\u0923\u093f \u0905\u0927\u093f\u0915\u0943\u0924 .gov.in \u0936\u093e\u0938\u0915\u0940\u092f \u0921\u094b\u092e\u0947\u0928 \u0906\u0939\u0947.'},isSafe:!0,explanation:{en:'Correct! The ".gov.in" domain is legally restricted to legitimate Indian government authorities.',hi:'\u092c\u093f\u0932\u094d\u0915\u0941\u0932 \u0938\u0939\u0940! ".gov.in" \u0921\u094b\u092e\u0947\u0928 \u0915\u0947\u0935\u0932 \u092d\u093e\u0930\u0924 \u0938\u0930\u0915\u093e\u0930 \u0915\u0947 \u0935\u093f\u092d\u093e\u0917\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0906\u0930\u0915\u094d\u0937\u093f\u0924 \u0939\u0948\u0964',mr:'\u0905\u0917\u0926\u0940 \u092c\u0930\u094b\u092c\u0930! ".gov.in" \u0921\u094b\u092e\u0947\u0928 \u0915\u0947\u0935\u0933 \u0905\u0927\u093f\u0915\u0943\u0924 \u092d\u093e\u0930\u0924\u0940\u092f \u0936\u093e\u0938\u0915\u0940\u092f \u0935\u093f\u092d\u093e\u0917\u093e\u0902\u0928\u093e\u091a \u0926\u093f\u0932\u0947 \u091c\u093e\u0924\u0947.'}},{id:'unsafe_reject_gov',text:{en:'No, all online government portals are unsafe to use.',hi:'\u0928\u0939\u0940\u0902, \u0907\u0902\u091f\u0930\u0928\u0947\u091f \u092a\u0930 \u0938\u092d\u0940 \u0938\u0930\u0915\u093e\u0930\u0940 \u092a\u094b\u0930\u094d\u091f\u0932 \u0905\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0939\u094b\u0924\u0947 \u0939\u0948\u0902\u0964',mr:'\u0928\u093e\u0939\u0940, \u0907\u0902\u091f\u0930\u0928\u0947\u091f\u0935\u0930\u0940\u0932 \u0938\u0930\u094d\u0935 \u0936\u093e\u0938\u0915\u0940\u092f \u092a\u094b\u0930\u094d\u091f\u0932\u094d\u0938 \u0905\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0905\u0938\u0924\u093e\u0924.'},isSafe:!1,explanation:{en:'Not quite: Verifying the .gov.in domain and HTTPS ensures you are using the genuine, protected government portal.',hi:'\u0917\u0932\u0924: .gov.in \u0921\u094b\u092e\u0947\u0928 \u0914\u0930 HTTPS \u0915\u0940 \u091c\u093e\u0902\u091a \u0906\u092a\u0915\u094b \u0905\u0938\u0932\u0940 \u0938\u0930\u0915\u093e\u0930\u0940 \u0938\u0947\u0935\u093e\u0913\u0902 \u0915\u093e \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u092e\u0926\u0926 \u0915\u0930\u0924\u0940 \u0939\u0948\u0964',mr:'\u091a\u0942\u0915: .gov.in \u0906\u0923\u093f HTTPS \u0924\u092a\u093e\u0938\u0942\u0928 \u0924\u0941\u092e\u094d\u0939\u0940 \u0905\u0927\u093f\u0915\u0943\u0924 \u0936\u093e\u0938\u0915\u0940\u092f \u0938\u0947\u0935\u093e \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924\u092a\u0923\u0947 \u0935\u093e\u092a\u0930\u0942 \u0936\u0915\u0924\u093e.'}}]},{id:'amazon_typosquatting',title:{en:'Scenario 3: Typo-Squatted Festival Prize Offer',hi:'\u092a\u0930\u093f\u0926\u0943\u0936\u094d\u092f \u0969: \u0935\u0930\u094d\u0924\u0928\u0940 \u092e\u0947\u0902 \u0939\u0947\u0930\u092b\u0947\u0930 \u0915\u0930 \u092c\u0928\u093e\u0908 \u0917\u0908 \u092b\u0930\u094d\u091c\u0940 \u0936\u0949\u092a\u093f\u0902\u0917 \u0938\u093e\u0907\u091f',mr:'\u092a\u0930\u093f\u0926\u0943\u0936\u094d\u092f \u0969: \u0938\u094d\u092a\u0947\u0932\u093f\u0902\u0917\u092e\u0927\u094d\u092f\u0947 \u092c\u0926\u0932 \u0915\u0930\u0942\u0928 \u092c\u0928\u0935\u0932\u0947\u0932\u0940 \u092c\u0928\u093e\u0935\u091f \u0936\u0949\u092a\u093f\u0902\u0917 \u0938\u093e\u0907\u091f'},displayedUrl:'http://amaz0n-festival-sale.co/free-iphone',protocol:'http',domain:'amaz0n-festival-sale.co',realDomain:'amazon.in',isLegitimate:!1,pageType:'prize_typo',mockPage:{brandName:'Great Indian Festival Lucky Draw (SIMULATION)',headline:{en:'Congratulations! You Won an iPhone 16!',hi:'\u092c\u0927\u093e\u0908 \u0939\u094b! \u0906\u092a\u0928\u0947 \u0906\u0908\u092b\u094b\u0928 \u0967\u096c \u091c\u0940\u0924\u093e \u0939\u0948!',mr:'\u0905\u092d\u093f\u0928\u0902\u0926\u0928! \u0924\u0941\u092e\u094d\u0939\u0940 \u0906\u092f\u092b\u094b\u0928 \u0967\u096c \u091c\u093f\u0902\u0915\u0932\u093e \u0906\u0939\u0947!'},body:{en:'You are our 10,000th lucky visitor today! Enter your credit card or debit card details to pay \u20b999 courier charges and claim your gift.',hi:'\u0906\u092a \u0939\u092e\u093e\u0930\u0947 \u0967\u0966,\u0966\u0966\u0966\u0935\u0947\u0902 \u092d\u093e\u0917\u094d\u092f\u0936\u093e\u0932\u0940 \u0906\u0917\u0902\u0924\u0941\u0915 \u0939\u0948\u0902! \u096f\u096f \u0930\u0941\u092a\u092f\u0947 \u0915\u0942\u0930\u093f\u092f\u0930 \u0936\u0941\u0932\u094d\u0915 \u0926\u0947\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0905\u092a\u0928\u0947 \u0915\u093e\u0930\u094d\u0921 \u0915\u093e \u0935\u093f\u0935\u0930\u0923 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902\u0964',mr:'\u0924\u0941\u092e\u094d\u0939\u0940 \u0906\u092e\u091a\u0947 \u0967\u0966,\u0966\u0966\u0966 \u0935\u0947 \u092d\u093e\u0917\u094d\u092f\u0935\u093e\u0928 \u0935\u093f\u091c\u0947\u0924\u0947 \u0906\u0939\u093e\u0924! \u096f\u096f \u0930\u0941\u092a\u092f\u0947 \u0915\u0941\u0930\u093f\u0905\u0930 \u0936\u0941\u0932\u094d\u0915 \u092d\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0915\u093e\u0930\u094d\u0921\u091a\u093e \u0924\u092a\u0936\u0940\u0932 \u091f\u093e\u0915\u093e.'},warningFlag:{en:'\ud83d\udea8 RED FLAGS: "amaz0n" replaces "o" with zero "0", hyphenated name, unencrypted HTTP, advance fee demand.',hi:'\ud83d\udea8 \u0916\u0924\u0930\u0947 \u0915\u0947 \u0938\u0902\u0915\u0947\u0924: "amaz0n" \u092e\u0947\u0902 \u0905\u0915\u094d\u0937\u0930 "o" \u0915\u0940 \u091c\u0917\u0939 \u0936\u0942\u0928\u094d\u092f "0" \u0939\u0948, \u0905\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 HTTP \u0914\u0930 \u0915\u093e\u0930\u094d\u0921 \u0935\u093f\u0935\u0930\u0923 \u0915\u0940 \u092e\u093e\u0902\u0917\u0964',mr:'\ud83d\udea8 \u0927\u094b\u0915\u094d\u092f\u093e\u091a\u0947 \u0907\u0936\u093e\u0930\u0947: "amaz0n" \u092e\u0927\u094d\u092f\u0947 "o" \u0910\u0935\u091c\u0940 \u0936\u0942\u0928\u094d\u092f "0" \u0906\u0939\u0947, \u0905\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 HTTP \u0906\u0923\u093f \u0915\u093e\u0930\u094d\u0921 \u092e\u093e\u0939\u093f\u0924\u0940\u091a\u0940 \u092e\u093e\u0917\u0923\u0940.'}},keyTakeaway:{en:'Fraudsters regularly register "typo" domains (amaz0n, flipkaart) that trick the quick eye. Always check spelling and never enter card numbers for "free" prizes.',hi:'\u0927\u094b\u0916\u0947\u092c\u093e\u091c \u0938\u094d\u092a\u0947\u0932\u093f\u0902\u0917 \u092e\u0947\u0902 \u0925\u094b\u0921\u093c\u093e \u0938\u093e \u092c\u0926\u0932\u093e\u0935 (amaz0n, flipkaart) \u0915\u0930\u0915\u0947 \u092b\u0930\u094d\u091c\u0940 \u0938\u093e\u0907\u091f \u092c\u0928\u093e\u0924\u0947 \u0939\u0948\u0902\u0964 \u0939\u092e\u0947\u0936\u093e \u0938\u094d\u092a\u0947\u0932\u093f\u0902\u0917 \u0927\u094d\u092f\u093e\u0928 \u0938\u0947 \u0926\u0947\u0916\u0947\u0902\u0964',mr:'\u092d\u093e\u092e\u091f\u0947 \u0938\u094d\u092a\u0947\u0932\u093f\u0902\u0917\u092e\u0927\u094d\u092f\u0947 \u092c\u093e\u0930\u0940\u0915 \u092c\u0926\u0932 \u0915\u0930\u0942\u0928 \u0921\u094b\u092e\u0947\u0928 \u0928\u094b\u0902\u0926\u0935\u0924\u093e\u0924. \u0938\u094d\u092a\u0947\u0932\u093f\u0902\u0917 \u0928\u0947\u0939\u092e\u0940 \u0915\u093e\u0933\u091c\u0940\u092a\u0942\u0930\u094d\u0935\u0915 \u0924\u092a\u093e\u0938\u093e.'},choices:[{id:'unsafe_spin',text:{en:'Yes, \u20b999 is a small amount, so I will enter my card to get the phone.',hi:'\u0939\u093e\u0901, \u096f\u096f \u0930\u0941\u092a\u092f\u0947 \u092c\u0939\u0941\u0924 \u0915\u092e \u0939\u0948\u0902, \u0907\u0938\u0932\u093f\u090f \u092e\u0948\u0902 \u092b\u094b\u0928 \u092a\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u093e\u0930\u094d\u0921 \u0928\u0902\u092c\u0930 \u0921\u093e\u0932\u0942\u0902\u0917\u093e\u0964',mr:'\u0939\u094b\u092f, \u096f\u096f \u0930\u0941\u092a\u092f\u0947 \u0915\u092e\u0940 \u0906\u0939\u0947\u0924, \u092e\u094d\u0939\u0923\u0942\u0928 \u092e\u0940 \u092b\u094b\u0928 \u092e\u093f\u0933\u0935\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0915\u093e\u0930\u094d\u0921 \u092e\u093e\u0939\u093f\u0924\u0940 \u091f\u093e\u0915\u0947\u0928.'},isSafe:!1,explanation:{en:'Severe Risk: The scammers will steal your full debit/credit card details and drain thousands from your bank.',hi:'\u0917\u0902\u092d\u0940\u0930 \u0916\u0924\u0930\u093e: \u0920\u0917 \u0906\u092a\u0915\u0947 \u0915\u093e\u0930\u094d\u0921 \u0915\u093e \u092a\u0942\u0930\u093e \u0935\u093f\u0935\u0930\u0923 \u091a\u0941\u0930\u093e\u0915\u0930 \u0916\u093e\u0924\u0947 \u0938\u0947 \u0939\u091c\u093e\u0930\u094b\u0902 \u0930\u0941\u092a\u092f\u0947 \u0928\u093f\u0915\u093e\u0932 \u0932\u0947\u0902\u0917\u0947\u0964',mr:'\u092e\u094b\u0920\u093e \u0927\u094b\u0915\u093e: \u092d\u093e\u092e\u091f\u0947 \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0915\u093e\u0930\u094d\u0921\u091a\u0940 \u0938\u0930\u094d\u0935 \u092e\u093e\u0939\u093f\u0924\u0940 \u091a\u094b\u0930\u0942\u0928 \u0916\u093e\u0924\u094d\u092f\u093e\u0924\u0940\u0932 \u0939\u091c\u093e\u0930\u094b \u0930\u0941\u092a\u092f\u0947 \u0932\u0902\u092a\u093e\u0938 \u0915\u0930\u0924\u0940\u0932.'}},{id:'safe_spot_typo',text:{en:'No! The address has a typo ("amaz0n" with a zero) and is completely fake.',hi:'\u0928\u0939\u0940\u0902! \u092a\u0924\u0947 \u092e\u0947\u0902 \u0938\u094d\u092a\u0947\u0932\u093f\u0902\u0917 \u0915\u0940 \u0917\u0932\u0924\u0940 \u0939\u0948 ("amaz0n" \u092e\u0947\u0902 \u0936\u0942\u0928\u094d\u092f \u0939\u0948) \u0914\u0930 \u092f\u0939 \u092b\u0930\u094d\u091c\u0940 \u0939\u0948\u0964',mr:'\u0928\u093e\u0939\u0940! \u092a\u0924\u094d\u0924\u094d\u092f\u093e\u092e\u0927\u094d\u092f\u0947 \u0938\u094d\u092a\u0947\u0932\u093f\u0902\u0917\u091a\u0940 \u091a\u0942\u0915 \u0906\u0939\u0947 ("amaz0n" \u092e\u0927\u094d\u092f\u0947 \u0936\u0942\u0928\u094d\u092f \u0906\u0939\u0947) \u0906\u0923\u093f \u0939\u0940 \u092b\u0938\u0935\u0923\u0942\u0915 \u0906\u0939\u0947.'},isSafe:!0,explanation:{en:'Excellent eyesight! You caught the zero "0" in the domain and refused to expose your card.',hi:'\u092c\u0939\u0941\u0924 \u0916\u0942\u092c! \u0906\u092a\u0928\u0947 \u0921\u094b\u092e\u0947\u0928 \u092e\u0947\u0902 \u0936\u0942\u0928\u094d\u092f "0" \u0915\u094b \u092a\u0939\u091a\u093e\u0928 \u0932\u093f\u092f\u093e \u0914\u0930 \u0905\u092a\u0928\u0947 \u0915\u093e\u0930\u094d\u0921 \u0915\u094b \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0930\u0916\u093e\u0964',mr:'\u0909\u0924\u094d\u0915\u0943\u0937\u094d\u091f \u0928\u091c\u0930! \u0924\u0941\u092e\u094d\u0939\u0940 \u0921\u094b\u092e\u0947\u0928 \u092e\u0927\u0940\u0932 \u0936\u0942\u0928\u094d\u092f "0" \u0913\u0933\u0916\u0932\u093e \u0906\u0923\u093f \u0924\u0941\u092e\u091a\u0947 \u0915\u093e\u0930\u094d\u0921 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0920\u0947\u0935\u0932\u0947.'}}]},{id:'electricity_bill_phishing',title:{en:'Scenario 4: Fake Electricity Bill Payment Gateway',hi:'\u092a\u0930\u093f\u0926\u0943\u0936\u094d\u092f \u096a: \u092c\u093f\u091c\u0932\u0940 \u092c\u093f\u0932 \u092d\u0941\u0917\u0924\u093e\u0928 \u0915\u093e \u092b\u0930\u094d\u091c\u0940 \u092a\u094b\u0930\u094d\u091f\u0932',mr:'\u092a\u0930\u093f\u0926\u0943\u0936\u094d\u092f \u096a: \u0935\u0940\u091c \u092c\u093f\u0932 \u092d\u0930\u0923\u094d\u092f\u093e\u091a\u0947 \u092c\u0928\u093e\u0935\u091f \u092a\u094b\u0930\u094d\u091f\u0932'},displayedUrl:'http://mahadiscom-billpay.biz/quickpay',protocol:'http',domain:'mahadiscom-billpay.biz',realDomain:'mahadiscom.in',isLegitimate:!1,pageType:'utility_bill',mockPage:{brandName:'Electricity QuickPay Portal (SIMULATION)',headline:{en:'Disconnection Warning Notice',hi:'\u092c\u093f\u091c\u0932\u0940 \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u0915\u093e\u091f\u0928\u0947 \u0915\u0940 \u0905\u0902\u0924\u093f\u092e \u091a\u0947\u0924\u093e\u0935\u0928\u0940',mr:'\u0935\u0940\u091c \u092a\u0941\u0930\u0935\u0920\u093e \u0916\u0902\u0921\u093f\u0924 \u0915\u0930\u0923\u094d\u092f\u093e\u091a\u0940 \u0905\u0902\u0924\u093f\u092e \u0928\u094b\u091f\u0940\u0938'},body:{en:'Unpaid Bill Amount: \u20b91,420. Power will be disconnected at 8:00 PM tonight. Pay immediately using NetBanking or Debit Card.',hi:'\u092c\u0915\u093e\u092f\u093e \u092c\u093f\u0932 \u0930\u093e\u0936\u093f: \u0967,\u096a\u0968\u0966 \u0930\u0941\u092a\u092f\u0947\u0964 \u0906\u091c \u0930\u093e\u0924 \u096e:\u0966\u0966 \u092c\u091c\u0947 \u092c\u093f\u091c\u0932\u0940 \u0915\u093e\u091f \u0926\u0940 \u091c\u093e\u090f\u0917\u0940\u0964 \u0928\u0947\u091f \u092c\u0948\u0902\u0915\u093f\u0902\u0917 \u092f\u093e \u0921\u0947\u092c\u093f\u091f \u0915\u093e\u0930\u094d\u0921 \u0938\u0947 \u0924\u0941\u0930\u0902\u0924 \u092d\u0941\u0917\u0924\u093e\u0928 \u0915\u0930\u0947\u0902\u0964',mr:'\u0925\u0915\u092c\u093e\u0915\u0940 \u092c\u093f\u0932 \u0930\u0915\u094d\u0915\u092e: \u0967,\u096a\u0968\u0966 \u0930\u0941\u092a\u092f\u0947. \u0906\u091c \u0930\u093e\u0924\u094d\u0930\u0940 \u096e:\u0966\u0966 \u0935\u093e\u091c\u0924\u093e \u0935\u0940\u091c \u0916\u0902\u0921\u093f\u0924 \u0915\u0947\u0932\u0940 \u091c\u093e\u0908\u0932. \u0924\u094d\u0935\u0930\u093f\u0924 \u092a\u0947\u092e\u0947\u0902\u091f \u0915\u0930\u093e.'},warningFlag:{en:'\ud83d\udea8 RED FLAGS: .biz domain, unencrypted connection, urgent night disconnection threat.',hi:'\ud83d\udea8 \u0916\u0924\u0930\u0947 \u0915\u0947 \u0938\u0902\u0915\u0947\u0924: .biz \u0921\u094b\u092e\u0947\u0928, \u0905\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0915\u0928\u0947\u0915\u094d\u0936\u0928, \u0930\u093e\u0924 \u092e\u0947\u0902 \u092c\u093f\u091c\u0932\u0940 \u0915\u093e\u091f\u0928\u0947 \u0915\u0940 \u091d\u0942\u0920\u0940 \u0927\u092e\u0915\u0940\u0964',mr:'\ud83d\udea8 \u0927\u094b\u0915\u094d\u092f\u093e\u091a\u0947 \u0907\u0936\u093e\u0930\u0947: .biz \u0921\u094b\u092e\u0947\u0928, \u0905\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u0906\u0923\u093f \u0930\u093e\u0924\u094d\u0930\u0940 \u0935\u0940\u091c \u0924\u094b\u0921\u0923\u094d\u092f\u093e\u091a\u0940 \u0927\u092e\u0915\u0940.'}},keyTakeaway:{en:'Never pay utility bills through links sent in SMS messages. Always pay inside your authorized electricity board app or trusted UPI app.',hi:'\u090f\u0938\u090f\u092e\u090f\u0938 \u092e\u0947\u0902 \u0906\u090f \u0932\u093f\u0902\u0915 \u0938\u0947 \u0915\u092d\u0940 \u092d\u0940 \u092c\u093f\u091c\u0932\u0940 \u0915\u093e \u092c\u093f\u0932 \u0928 \u092d\u0930\u0947\u0902\u0964 \u0939\u092e\u0947\u0936\u093e \u0905\u092a\u0928\u0947 \u0905\u0927\u093f\u0915\u0943\u0924 \u092c\u093f\u091c\u0932\u0940 \u092c\u094b\u0930\u094d\u0921 \u0910\u092a \u0938\u0947 \u0939\u0940 \u092d\u0941\u0917\u0924\u093e\u0928 \u0915\u0930\u0947\u0902\u0964',mr:'\u090f\u0938\u090f\u092e\u090f\u0938\u092e\u0927\u0940\u0932 \u0932\u093f\u0902\u0915\u0935\u0930\u0942\u0928 \u0915\u0927\u0940\u0939\u0940 \u0935\u0940\u091c \u092c\u093f\u0932 \u092d\u0930\u0942 \u0928\u0915\u093e. \u0928\u0947\u0939\u092e\u0940 \u0905\u0927\u093f\u0915\u0943\u0924 \u0935\u0940\u091c \u0915\u0902\u092a\u0928\u0940\u091a\u094d\u092f\u093e \u0972\u092a\u092e\u0927\u0942\u0928\u091a \u092c\u093f\u0932 \u092d\u0930\u093e.'},choices:[{id:'unsafe_pay_bill',text:{en:'Pay immediately on this page to prevent power from being cut tonight.',hi:'\u092c\u093f\u091c\u0932\u0940 \u0915\u091f\u0928\u0947 \u0938\u0947 \u092c\u091a\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0907\u0938 \u092a\u0947\u091c \u092a\u0930 \u0924\u0941\u0930\u0902\u0924 \u092d\u0941\u0917\u0924\u093e\u0928 \u0915\u0930\u0947\u0902\u0964',mr:'\u0935\u0940\u091c \u091c\u093e\u090a \u0928\u092f\u0947 \u092e\u094d\u0939\u0923\u0942\u0928 \u092f\u093e \u092a\u0947\u091c\u0935\u0930 \u0924\u094d\u0935\u0930\u093f\u0924 \u092a\u0947\u092e\u0947\u0902\u091f \u0915\u0930\u093e.'},isSafe:!1,explanation:{en:'Dangerous Trap: Electricity fraud is rampant in India. This fake site steals banking logins and card credentials.',hi:'\u0916\u0924\u0930\u0928\u093e\u0915 \u091c\u093e\u0932: \u092d\u093e\u0930\u0924 \u092e\u0947\u0902 \u092c\u093f\u091c\u0932\u0940 \u092c\u093f\u0932 \u0915\u0947 \u0928\u093e\u092e \u092a\u0930 \u092c\u0939\u0941\u0924 \u0927\u094b\u0916\u093e\u0927\u0921\u093c\u0940 \u0939\u094b\u0924\u0940 \u0939\u0948\u0964 \u092f\u0939 \u092b\u0930\u094d\u091c\u0940 \u0938\u093e\u0907\u091f \u0906\u092a\u0915\u0947 \u092c\u0948\u0902\u0915\u093f\u0902\u0917 \u0915\u094d\u0930\u0947\u0921\u0947\u0902\u0936\u093f\u092f\u0932 \u091a\u0941\u0930\u093e \u0932\u0947\u0924\u0940 \u0939\u0948\u0964',mr:'\u0927\u094b\u0915\u093e\u0926\u093e\u092f\u0915 \u0938\u093e\u092a\u0933\u093e: \u0935\u0940\u091c \u092c\u093f\u0932\u093e\u091a\u094d\u092f\u093e \u0928\u093e\u0935\u093e\u0916\u093e\u0932\u0940 \u0939\u0940 \u092e\u094b\u0920\u0940 \u092b\u0938\u0935\u0923\u0942\u0915 \u0906\u0939\u0947. \u0939\u0940 \u0938\u093e\u0907\u091f \u0924\u0941\u092e\u091a\u0940 \u092c\u0901\u0915 \u092e\u093e\u0939\u093f\u0924\u0940 \u091a\u094b\u0930\u0924\u0947.'}},{id:'safe_reject_bill',text:{en:'Do not pay here. Check your bill in the official electricity app or physical bill.',hi:'\u092f\u0939\u093e\u0901 \u092d\u0941\u0917\u0924\u093e\u0928 \u0928 \u0915\u0930\u0947\u0902\u0964 \u0906\u0927\u093f\u0915\u093e\u0930\u093f\u0915 \u092c\u093f\u091c\u0932\u0940 \u0910\u092a \u092f\u093e \u092a\u093f\u091b\u0932\u0947 \u092c\u093f\u0932 \u0915\u0940 \u0930\u0938\u0940\u0926 \u0938\u0947 \u091c\u093e\u0902\u091a \u0915\u0930\u0947\u0902\u0964',mr:'\u092f\u0947\u0925\u0947 \u092a\u0948\u0938\u0947 \u092d\u0930\u0942 \u0928\u0915\u093e. \u0905\u0927\u093f\u0915\u0943\u0924 \u0935\u0940\u091c \u0972\u092a\u0935\u0930\u0942\u0928 \u0915\u093f\u0902\u0935\u093e \u091c\u0941\u0928\u094d\u092f\u093e \u092c\u093f\u0932\u093e\u0935\u0930\u0942\u0928 \u0916\u093e\u0924\u094d\u0930\u0940 \u0915\u0930\u093e.'},isSafe:!0,explanation:{en:'Outstanding judgment! You resisted the panic tactic and preserved your finances.',hi:'\u0936\u093e\u0928\u0926\u093e\u0930 \u0928\u093f\u0930\u094d\u0923\u092f! \u0906\u092a \u0921\u0930 \u0915\u0947 \u0926\u092c\u093e\u0935 \u092e\u0947\u0902 \u0928\u0939\u0940\u0902 \u0906\u090f \u0914\u0930 \u0905\u092a\u0928\u0947 \u092a\u0948\u0938\u0947 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0930\u0916\u0947\u0964',mr:'\u0909\u0924\u094d\u0924\u092e \u0928\u093f\u0930\u094d\u0923\u092f! \u0924\u0941\u092e\u094d\u0939\u0940 \u092d\u0940\u0924\u0940\u092a\u094b\u091f\u0940 \u0928\u093f\u0930\u094d\u0923\u092f \u0928 \u0918\u0947\u0924\u093e \u0924\u0941\u092e\u091a\u0947 \u092a\u0948\u0938\u0947 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0920\u0947\u0935\u0932\u0947.'}}]}]},546,[]);
