rInvalid:"Please enter a valid 10-digit Indian mobile number starting with 6, 7, 8, or 9.",continueButton:"Continue",demoNotice:"Notice: This demo demonstrates senior UI navigation. Real SMS verification connects in backend integration.",terms:"By continuing, you consent to ScamShield protecting your incoming notifications on this device."},home:{title:"Fraud Protection Dashboard",welcome:"Welcome",greetingWithName:"Namaste, {{name}}! \ud83d\udc4b",greetingDefault:"Welcome to Rakshon! \ud83d\udc4b",subtitle:"Your digital safety starts here. We're here to help you stay safe online.",statusActive:"Active & Guarding",statusSectionTitle:"Protection Status",callGuardian:"Call Guardian",callGuardianDesc:"Screen incoming unknown calls",callScreeningActive:"Active & Screening Calls",callScreeningDisabled:"Call Screening Disabled",callScreeningNotConfigured:"Setup Required",callScreeningUnavailable:"Not Supported on Device",enableCallScreening:"Enable Call Screening",disableCallScreening:"Turn Off",threatDbCardTitle:"Offline Threat Database",dbSynced:"Database Up to Date",dbOutdated:"Database Outdated (Sync Required)",dbNotSynced:"Not Yet Synchronized",dbUnavailable:"Database Unavailable",lastSyncedAt:"Last synchronized: ",neverSynced:"Never synchronized",checkUpdates:"Check for Updates",messageGuardian:"Message Guardian",messageGuardianDesc:"Check SMS or WhatsApp message",messageGuardianCardTitle:"Message Guardian",messageGuardianCardDesc:"Share via Android Sharesheet, paste text, or scan a screenshot for scam analysis. Never reads background SMS.",messageGuardianButton:"Analyze Message or Screenshot",emergencyTitle:"Emergency Assistance",emergencySubtitle:"National Cyber Crime Helpline (1930) & Portal",emergencyMode:"EMERGENCY HELP (1930)",call1930Button:"Call 1930 Helpline",portalButton:"Visit cybercrime.gov.in",emergencyCallConfirmTitle:"Call National Cyber Helpline (1930)?",emergencyCallConfirmMessage:"This will open your phone dialer to call India's official National C