eButton:"\ud83d\udccb \u0938\u0902\u0926\u0947\u0936 \u092a\u0947\u0938\u094d\u091f \u0915\u0930\u0947\u0902",clearButton:"\u2715 \u0938\u093e\u092b\u093c \u0915\u0930\u0947\u0902",analyzeButton:"\ud83d\udd0d \u0938\u0902\u0926\u0947\u0936 \u0915\u0940 \u091c\u093e\u0902\u091a \u0915\u0930\u0947\u0902",analyzing:"\u0927\u094b\u0916\u093e\u0927\u0921\u093c\u0940 \u0915\u0947 \u0938\u0902\u0915\u0947\u0924\u094b\u0902 \u0915\u0940 \u091c\u093e\u0902\u091a \u091c\u093e\u0930\u0940 \u0939\u0948...",screenshotNoticeTitle:"\u0938\u094d\u0915\u094d\u0930\u0940\u0928\u0936\u0949\u091f \u0914\u0930 \u0936\u0947\u092f\u0930 \u0915\u0930\u0928\u0947 \u0915\u093e \u0935\u093f\u0915\u0932\u094d\u092a",screenshotNoticeDesc:"\u0906\u092a \u0935\u094d\u0939\u093e\u091f\u094d\u0938\u090f\u092a \u092f\u093e \u090f\u0938\u090f\u092e\u090f\u0938 \u0938\u0947 \u0938\u0902\u0926\u0947\u0936 \u0938\u0940\u0927\u0947 \u0938\u094d\u0915\u0948\u092e\u0936\u0940\u0932\u094d\u0921 \u092e\u0947\u0902 \u0936\u0947\u092f\u0930 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902 \u092f\u093e \u0938\u094d\u0915\u094d\u0930\u0940\u0928\u0936\u0949\u091f \u091a\u0941\u0928 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964",pickScreenshotButton:"\ud83d\udcf7 \u0938\u094d\u0915\u094d\u0930\u0940\u0928\u0936\u0949\u091f \u091a\u0941\u0928\u0947\u0902",ocrPreparationNotice:"\u0921\u093f\u0935\u093e\u0907\u0938 \u0913\u0938\u0940\u0906\u0930 \u090f\u092a\u0940\u0915\u0947 \u092e\u0947\u0902 \u0938\u0915\u094d\u0930\u093f\u092f \u0939\u0948\u0964 \u0906\u092a \u0915\u093f\u0938\u0940 \u092d\u0940 \u0938\u094d\u0915\u094d\u0930\u0940\u0928\u0936\u0949\u091f \u0938\u0947 \u0928\u093f\u0915\u093e\u0932\u093e \u0917\u092f\u093e \u091f\u0947\u0915\u094d\u0938\u094d\u091f \u092a\u0947\u0938\u094d\u091f \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964",privacyPill:"\u0936\u0942\u0928\u094d\u092f \u090f\u0938\u090f\u092e\u090f\u0938 \u0905\u0928\u0941\u092e\u0924\u093f",privacyNote:"\u0938\u094d\u0915\u0948\u092e\u0936\u0940\u0932\u094d\u0921 \u0915\u092d\u0940 \u092d\u0940 \u092c\u0948\u0915\u0917\u094d\u0930\u093e\u0909\u0902\u0921 \u092e\u0947\u0902 \u0906\u092a\u0915\u0947 \u0938\u0902\u0926\u0947\u0936 \u0928\u0939\u0940\u0902 \u092a\u0922\u093c\u0924\u093e\u0964 \u0906\u092a \u0916\u0941\u0926 \u0924\u092f \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u0915\u094d\u092f\u093e \u091c\u093e\u0902\u091a\u0928\u093e \u0939\u0948\u0964",errorEmpty:"\u0915\u0943\u092a\u092f\u093e \u091c\u093e\u0902\u091a\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0915\u094b\u0908 \u0938\u0902\u0926\u0947\u0936 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902 \u092f\u093e \u092a\u0947\u0938\u094d\u091f \u0915\u0930\u0947\u0902\u0964",errorTooLong:"\u0938\u0902\u0926\u0947\u0936 2,000 \u0905\u0915\u094d\u0937\u0930\u094b\u0902 \u0915\u0940 \u0905\u0927\u093f\u0915\u0924\u092e \u0938\u0940\u092e\u093e \u0938\u0947 \u0905\u0927\u093f\u0915 \u0939\u0948\u0964",retryButton:"\ud83d\udd04 \u092a\u0941\u0928\u0903 \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u0930\u0947\u0902"},analysisResult:{title:"\u0938\u0941\u0930\u0915\u094d\u0937\u093e \u091c\u093e\u0902\u091a \u092a\u0930\u093f\u0923\u093e\u092e",safeTitle:"\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u090f\u0935\u0902 \u092a\u094d\u0930\u093e\u092e\u093e\u0923\u093f\u0915",cautionTitle:"\u0938\u093e\u0935\u0927\u093e\u0928\u0940 \u092c\u0930\u0924\u0947\u0902",dangerTitle:"\u092c\u0921\u093c\u093e \u0927\u094b\u0916\u093e / \u0938\u094d\u0915\u0948\u092e \u0915\u093e \u0916\u0924\u0930\u093e",riskScoreLabel:"\u0905\u0928\u0941\u092e\u093e\u0928\u093f\u0924 \u091c\u094b\u0916\u093f\u092e \u0938\u094d\u0915\u094b\u0930",riskScoreDisclaimer:"\u092f\u0939 \u0928\u093f\u092f\u092e-\u0906\u0927\u093e\u0930\u093f\u0924 \u0938\u094d\u0915\u094b\u0930 (0 \u0938\u0947 100) \u0939\u0948, \u0915\u094b\u0908 \u0938\u093e\u0902\u0916\u094d\u092f\u093f\u0915\u0940\u092f \u0917\u093e\u0930\u0902\u091f\u0940 \u0928\u0939\u0940\u0902\u0964",explanationSectionTitle:"\u091c\u093e\u0902\u091a \u0915\u093e \u0928\u093f\u0937\u094d\u0915\u0930\u094d\u0937",indicatorsSectionTitle:"\u092a\u0939\u091a\u093e\u0928\u0947 \u0917\u090f \u091a\u0947\u0924\u093e\u0935\u0928\u0940 \u0938\u0902\u0915\u0947\u0924",noIndicators:"\u0907\u0938 \u0938\u0902\u0926\u0947\u0936 \u092e\u0947\u0902 \u0915\u094b\u0908 \u0938\u0902\u0926\u093f\u0917\u094d\u0927 \u0938\u0902\u0915\u0947\u0924 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u093e\u0964",actionsSectionTitle:"\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0930\u0939\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0905\u0917\u0932\u093e \u0915\u0926\u092e",disclaimerTitle:"\u092e\u0939\u0924\u094d\u0935\u092a\u0942\u0930\u094d\u0923 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0938\u0942\u091a\u0928\u093e",copyAdviceButton:"\ud83d\udccb \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0938\u0932\u093e\u0939 \u0915\u0949\u092a\u0940 \u0915\u0930\u0947\u0902",adviceCopied:"\u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0938\u0932\u093e\u0939 \u0915\u0949\u092a\u0940 \u0939\u094b \u0917\u0908!",analyzeAnotherButton:"\ud83d\udd0d \u0926\u0942\u0938\u0930\u093e \u0938\u0902\u0926\u0947\u0936 \u091c\u093e\u0902\u091a\u0947\u0902",returnHomeButton:"\ud83c\udfe0 \u092e\u0941\u0916\u094d\u092f \u092a\u0943\u0937\u094d\u0920 \u092a\u0930 \u091c\u093e\u090f\u0902",emergencyButton:"\ud83d\udea8 \u0938\u093e\u0907\u092c\u0930 \u0939\u0947\u0932\u094d\u092a\u0932\u093e\u0907\u0928 (1930) \u092a\u0930 \u0915\u0949\u0932 \u0915\u0930\u0947\u0902",otpLegitNotice:"\u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0928\u094b\u091f: \u0913\u091f\u0940\u092a\u0940 \u0915\u093e \u0909\u0932\u094d\u0932\u0947\u0916 \u0939\u0948, \u0915\u093f\u0902\u0924\u0941 \u0915\u094b\u0908 \u0926\u0941\u0930\u094d\u092d\u093e\u0935\u0928\u093e\u092a\u0942\u0930\u094d\u0923 \u092e\u093e\u0902\u0917 \u0928\u0939\u0940\u0902 \u092a\u093e\u0908 \u0917\u0908\u0964 \u0905\u092a\u0928\u093e \u0913\u091f\u0940\u092a\u0940 \u0915\u092d\u0940 \u0915\u093f\u0938\u0940 \u0915\u094b \u0928 \u092c\u0924\u093e\u090f\u0902\u0964"},voiceGuardian:{title:"\u0935\u0949\u0907\u0938 \u0917\u093e\u0930\u094d\u0921\u093f\u092f\u0928",subtitle:"\u092c\u094b\u0932\u0915\u0930 \u0938\u0902\u0926\u0947\u0936 \u091c\u093e\u0902\u091a\u0947\u0902 \u0914\u0930 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0938\u0932\u093e\u0939 \u0938\u0941\u0928\u0947\u0902",micButtonStart:"\ud83c\udfa4 \u092c\u094b\u0932\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u091f\u0948\u092a \u0915\u0930\u0947\u0902",micButtonStop:"\u23f9\ufe0f \u0938\u0941\u0928\u0928\u093e \u092c\u0902\u0926 \u0915\u0930\u0947\u0902",stateIdle:"\u092c\u094b\u0932\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0924\u0948\u092f\u093e\u0930",stateListening:"\u0938\u0941\u0928 \u0930\u0939\u0947 \u0939\u0948\u0902... \u0905\u092a\u0928\u093e \u0938\u0902\u0926\u0947\u0936 \u0938\u094d\u092a\u0937\u094d\u091f \u092c\u094b\u0932\u0947\u0902",stateProcessing:"\u0906\u092a\u0915\u0940 \u0906\u0935\u093e\u091c\u093c \u0915\u094b \u091f\u0947\u0915\u094d\u0938\u094d\u091f \u092e\u0947\u0902 \u092c\u0926\u0932\u093e \u091c\u093e \u0930\u0939\u093e \u0939\u0948...",stateSpeaking:"\u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0938\u0932\u093e\u0939 \u092c\u094b\u0932\u0940 \u091c\u093e \u0930\u0939\u0940 \u0939\u0948...",stateError:"\u0906\u0935\u093e\u091c\u093c \u0924\u094d\u0930\u0941\u091f\u093f",transcriptionSectionTitle:"\u092c\u094b\u0932\u093e \u0917\u092f\u093e \u0938\u0902\u0926\u0947\u0936",transcriptionPlaceholder:"\u0906\u092a\u0915\u0947 \u092c\u094b\u0932\u0947 \u0917\u090f \u0936\u092c\u094d\u0926 \u092f\u0939\u093e\u0901 \u0926\u093f\u0916\u093e\u0908 \u0926\u0947\u0902\u0917\u0947\u0964 \u091c\u093e\u0902\u091a \u0915\u0930\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0906\u092a \u0907\u0928\u094d\u0939\u0947\u0902 \u092a\u0922\u093c \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964",reviewInstruction:"\u090a\u092a\u0930 \u0926\u093f\u090f \u0917\u090f \u0938\u0902\u0926\u0947\u0936 \u0915\u0940 \u091c\u093e\u0902\u091a \u0915\u0930\u0947\u0902\u0964 \u0938\u094d\u0915\u0948\u092e\u0936\u0940\u0932\u094d\u0921 \u0906\u092a\u0915\u0940 \u0905\u0928\u0941\u092e\u0924\u093f \u0915\u0947 \u092c\u093f\u0928\u093e \u0915\u092d\u0940 \u091c\u093e\u0902\u091a \u0936\u0941\u0930\u0942 \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u093e\u0964",clearText:"\u2715 \u0938\u0902\u0926\u0947\u0936 \u0939\u091f\u093e\u090f\u0902",analyzeButton:"\ud83d\udd0d \u092c\u094b\u0932\u0947 \u0917\u090f \u0938\u0902\u0926\u0947\u0936 \u0915\u0940 \u091c\u093e\u0902\u091a \u0915\u0930\u0947\u0902",analyzing:"\u0927\u094b\u0916\u093e\u0927\u0921\u093c\u0940 \u0915\u0947 \u0938\u0902\u0915\u0947\u0924\u094b\u0902 \u0915\u093e \u092e\u0942\u0932\u094d\u092f\u093e\u0902\u0915\u0928...",quickSamplesTitle:"\u0906\u0935\u093e\u091c\u093c \u0915\u093e \u0928\u092e\u0942\u0928\u093e \u0906\u091c\u093c\u092e\u093e\u090f\u0902",sampleElectricity:"\u26a1 \u092c\u093f\u091c\u0932\u0940 \u0915\u093e\u091f\u0928\u0947 \u0915\u0940 \u0927\u092e\u0915\u0940",samplePolice:"\ud83d\udea8 \u0921\u093f\u091c\u093f\u091f\u0932 \u0905\u0930\u0947\u0938\u094d\u091f \u0935\u0940\u0921\u093f\u092f\u094b \u0915\u0949\u0932",sampleOtp:"\ud83c\udfe6 \u092c\u0948\u0902\u0915 \u0916\u093e\u0924\u093e \u0938\u0924\u094d\u092f\u093e\u092a\u0928",fallbackTitle:"\u0932\u093f\u0916\u0915\u0930 \u0938\u0902\u0926\u0947\u0936 \u0921\u093e\u0932\u0928\u0947 \u0915\u093e \u0935\u093f\u0915\u0932\u094d\u092a",fallbackSubtitle:"\u092f\u0926\u093f \u0906\u0935\u093e\u091c\u093c \u0915\u093e\u092e \u0928 \u0915\u0930\u0947 \u092f\u093e \u0906\u0938\u092a\u093e\u0938 \u0936\u094b\u0930 \u0939\u094b, \u0924\u094b \u0906\u092a \u092f\u0939\u093e\u0901 \u0938\u0940\u0927\u0947 \u0938\u0902\u0926\u0947\u0936 \u0932\u093f\u0916 \u092f\u093e \u092a\u0947\u0938\u094d\u091f \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964",listenAdviceButton:"\ud83d\udd0a \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0938\u0932\u093e\u0939 \u0938\u0941\u0928\u0947\u0902",stopAdviceButton:"\u23f9\ufe0f \u092c\u094b\u0932\u0928\u093e \u0930\u094b\u0915\u0947\u0902",permissionRationaleTitle:"\u092e\u093e\u0907\u0915\u094d\u0930\u094b\u092b\u093c\u094b\u0928 \u0905\u0928\u0941\u092e\u0924\u093f \u0906\u0935\u0936\u094d\u092f\u0915 \u0939\u0948",permissionRationaleDesc:"\u0938\u094d\u0915\u0948\u092e\u0936\u0940\u0932\u094d\u0921 \u0915\u094b \u092e\u093e\u0907\u0915\u094d\u0930\u094b\u092b\u093c\u094b\u0928 \u0915\u0947\u0935\u0932 \u0906\u092a\u0915\u0947 \u092c\u094b\u0932\u0947 \u0917\u090f \u0938\u0902\u0926\u0947\u0936 \u0915\u094b \u0932\u093f\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u091a\u093e\u0939\u093f\u090f\u0964 \u0939\u092e \u0915\u092d\u0940 \u092b\u094b\u0928 \u0915\u0949\u0932 \u0928\u0939\u0940\u0902 \u0938\u0941\u0928\u0924\u0947, \u0917\u0941\u092a\u094d\u0924 \u0930\u093f\u0915\u0949\u0930\u094d\u0921\u093f\u0902\u0917 \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u0947 \u0914\u0930 \u0928 \u0939\u0940 \u0906\u0935\u093e\u091c\u093c \u0938\u0939\u0947\u091c\u0924\u0947 \u0939\u0948\u0902\u0964",permissionDeniedError:"\u092e\u093e\u0907\u0915\u094d\u0930\u094b\u092b\u093c\u094b\u0928 \u0915\u0940 \u0905\u0928\u0941\u092e\u0924\u093f \u0928\u0939\u0940\u0902 \u0926\u0940 \u0917\u0908\u0964 \u0906\u092a \u0928\u0940\u091a\u0947 \u0938\u0902\u0926\u0947\u0936 \u091f\u093e\u0907\u092a \u092f\u093e \u092a\u0947\u0938\u094d\u091f \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964",noAudioCallNotice:"\u0938\u0942\u091a\u0928\u093e: \u0938\u094d\u0915\u0948\u092e\u0936\u0940\u0932\u094d\u0921 \u092b\u094b\u0928 \u0915\u0949\u0932 \u0915\u0940 \u092c\u093e\u0924\u091a\u0940\u0924 \u0928\u0939\u0940\u0902 \u0938\u0941\u0928\u0924\u093e\u0964 \u0939\u092e \u0921\u0940\u092a\u092b\u0947\u0915 \u092f\u093e \u0915\u094d\u0932\u094b\u0928 \u0906\u0935\u093e\u091c\u093c \u092a\u0939\u091a\u093e\u0928\u0928\u0947 \u0915\u093e \u0926\u093e\u0935\u093e \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u0947\u0964",speechVsScamNotice:"\u0938\u094d\u092a\u0940\u091a-\u091f\u0942-\u091f\u0947\u0915\u094d\u0938\u094d\u091f \u0906\u092a\u0915\u0940 \u0906\u0935\u093e\u091c\u093c \u0915\u094b \u0932\u093f\u0916\u0924\u093e \u0939\u0948\u0964 \u0927\u094b\u0916\u093e\u0927\u0921\u093c\u0940 \u0915\u0940 \u091c\u093e\u0902\u091a \u0939\u092e\u093e\u0930\u0947 \u0928\u093f\u092f\u092e-\u0906\u0927\u093e\u0930\u093f\u0924 \u0907\u0902\u091c\u0928 \u0926\u094d\u0935\u093e\u0930\u093e \u0939\u094b\u0924\u0940 \u0939\u0948\u0964",errorEmpty:"\u0915\u0943\u092a\u092f\u093e \u091c\u093e\u0902\u091a \u0938\u0947 \u092a\u0939\u0932\u0947 \u092c\u094b\u0932\u0947\u0902 \u092f\u093e \u0915\u094b\u0908 \u0938\u0902\u0926\u0947\u0936 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902\u0964",errorNetwork:"\u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0938\u0947\u0935\u093e \u0938\u0947 \u0938\u0902\u092a\u0930\u094d\u0915 \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u093e\u0964 \u0915\u0943\u092a\u092f\u093e \u0907\u0902\u091f\u0930\u0928\u0947\u091f \u091c\u093e\u0902\u091a\u0947\u0902 \u0914\u0930 \u092a\u0941\u0928\u0903 \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u0930\u0947\u0902\u0964"},bankingSandbox:{title:"\u092c\u0948\u0902\u0915\u093f\u0902\u0917 \u0914\u0930 \u092f\u0942\u092a\u0940\u0906\u0908 \u0905\u092d\u094d\u092f\u093e\u0938 \u0938\u0948\u0902\u0921\u092c\u0949\u0915\u094d\u0938",subtitle:"\u0921\u093f\u091c\u093f\u091f\u0932 \u092c\u0948\u0902\u0915\u093f\u0902\u0917 \u0914\u0930 \u092f\u0942\u092a\u0940\u0906\u0908 \u0915\u093e \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0914\u0930 \u092f\u0925\u093e\u0930\u094d\u0925\u0935\u093e\u0926\u0940 \u0905\u092d\u094d\u092f\u093e\u0938",demoBanner:"\u0921\u0947\u092e\u094b / \u092a\u094d\u0930\u0936\u093f\u0915\u094d\u0937\u0923 \u0938\u093f\u092e\u0941\u0932\u0947\u0936\u0928 \u2014 \u0915\u094b\u0908 \u0905\u0938\u0932\u0940 \