__d(function(g,r,i,a,m,e,d){Object.defineProperty(e,"__esModule",{value:!0}),e.SIMULATOR_SCENARIOS=void 0;e.SIMULATOR_SCENARIOS=[{id:'scenario_electricity',category:'electricity',topicTitleEn:'Utility & Electricity Bills',topicTitleHi:'\u092c\u093f\u091c\u0932\u0940 \u0935 \u091c\u0928\u094b\u092a\u092f\u094b\u0917\u0940 \u092c\u093f\u0932',topicTitleMr:'\u0935\u0940\u091c \u0935 \u0909\u092a\u092f\u0941\u0915\u094d\u0924\u0924\u093e \u092c\u093f\u0932\u0947',titleEn:'Electricity Disconnection Threat',titleHi:'\u092c\u093f\u091c\u0932\u0940 \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u0915\u093e\u091f\u0928\u0947 \u0915\u0940 \u0927\u092e\u0915\u0940',titleMr:'\u0935\u0940\u091c \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u0924\u094b\u0921\u0923\u094d\u092f\u093e\u091a\u0940 \u0927\u092e\u0915\u0940',messageEn:'DEAR CONSUMER, YOUR ELECTRICITY POWER WILL BE DISCONNECTED TONIGHT AT 9:30 PM FROM ELECTRICITY OFFICE BECAUSE YOUR PREVIOUS MONTH BILL WAS NOT UPDATED. PLEASE IMMEDIATELY CONTACT OUR ELECTRICITY OFFICER MR. VERMA AT 9876543210. THANK YOU.',messageHi:'\u092a\u094d\u0930\u093f\u092f \u0917\u094d\u0930\u093e\u0939\u0915, \u0906\u092a\u0915\u093e \u092c\u093f\u091c\u0932\u0940 \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u0906\u091c \u0930\u093e\u0924 9:30 \u092c\u091c\u0947 \u0915\u093e\u091f \u0926\u093f\u092f\u093e \u091c\u093e\u090f\u0917\u093e \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u092a\u093f\u091b\u0932\u0947 \u092e\u0939\u0940\u0928\u0947 \u0915\u093e \u092c\u093f\u0932 \u0905\u092a\u0921\u0947\u091f \u0928\u0939\u0940\u0902 \u0939\u0941\u0906 \u0939\u0948\u0964 \u0924\u0941\u0930\u0902\u0924 \u0939\u092e\u093e\u0930\u0947 \u092c\u093f\u091c\u0932\u0940 \u0905\u0927\u093f\u0915\u093e\u0930\u0940 \u0936\u094d\u0930\u0940 \u0935\u0930\u094d\u092e\u093e \u0938\u0947 9876543210 \u092a\u0930 \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0930\u0947\u0902\u0964',messageMr:'\u092a\u094d\u0930\u093f\u092f \u0917\u094d\u0930\u093e\u0939\u0915, \u092e\u093e\u0917\u0940\u0932 \u092e\u0939\u093f\u0928\u094d\u092f\u093e\u091a\u0947 \u092c\u093f\u0932 \u0905\u092a\u0921\u0947\u091f \u0928 \u091d\u093e\u0932\u094d\u092f\u093e\u092e\u0941\u0933\u0947 \u0906\u091c \u0930\u093e\u0924\u094d\u0930\u0940 \u096f:\u0969\u0966 \u0935\u093e\u091c\u0924\u093e \u0924\u0941\u092e\u091a\u0947 \u0935\u0940\u091c \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u0924\u094b\u0921\u0932\u0947 \u091c\u093e\u0908\u0932. \u0915\u0943\u092a\u092f\u093e \u0924\u093e\u0924\u094d\u0915\u093e\u0933 \u0906\u092e\u091a\u0947 \u0935\u0940\u091c \u0905\u0927\u093f\u0915\u093e\u0930\u0940 \u0936\u094d\u0930\u0940. \u0935\u0930\u094d\u092e\u093e \u092f\u093e\u0902\u091a\u094d\u092f\u093e\u0936\u0940 9876543210 \u0935\u0930 \u0938\u0902\u092a\u0930\u094d\u0915 \u0938\u093e\u0927\u093e.',questionEn:'You receive this SMS at 8:00 PM. What is the safest action to take?',questionHi:'\u0906\u092a\u0915\u094b \u0930\u093e\u0924 8:00 \u092c\u091c\u0947 \u092f\u0939 \u0938\u0902\u0926\u0947\u0936 \u092e\u093f\u0932\u0924\u093e \u0939\u0948\u0964 \u0938\u092c\u0938\u0947 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0915\u0926\u092e \u0915\u094d\u092f\u093e \u0939\u0948?',questionMr:'\u0924\u0941\u092e\u094d\u0939\u093e\u0932\u093e \u0930\u093e\u0924\u094d\u0930\u0940 \u096e:\u0966\u0966 \u0935\u093e\u091c\u0924\u093e \u0939\u093e \u092e\u0947\u0938\u0947\u091c \u0906\u0932\u093e. \u0938\u0930\u094d\u0935\u093e\u0924 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u092a\u093e\u090a\u0932 \u0915\u094b\u0923\u0924\u0947?',choices:[{id:'elec_safe',textEn:'Ignore the number in SMS. Check your official electricity bill receipt or call the official discom customer care number.',textHi:'\u0938\u0902\u0926\u0947\u0936 \u092e\u0947\u0902 \u0926\u093f\u090f \u0928\u0902\u092c\u0930 \u092a\u0930 \u0915\u0949\u0932 \u0928 \u0915\u0930\u0947\u0902\u0964 \u0905\u092a\u0928\u0940 \u092a\u0941\u0930\u093e\u0928\u0940 \u0906\u0927\u093f\u0915\u093e\u0930\u093f\u0915 \u0930\u0938\u0940\u0926 \u0926\u0947\u0916\u0947\u0902 \u092f\u093e \u092c\u093f\u091c\u0932\u0940 \u092c\u094b\u0930\u094d\u0921 \u0915\u0947 \u0906\u0927\u093f\u0915\u093e\u0930\u093f\u0915 \u0915\u0938\u094d\u091f\u092e\u0930 \u0915\u0947\u092f\u0930 \u092a\u0930 \u092c\u093e\u0924 \u0915\u0930\u0947\u0902\u0964',textMr:'\u092e\u0947\u0938\u0947\u091c\u092e\u0927\u0940\u0932 \u0928\u0902\u092c\u0930 \u0926\u0941\u0930\u094d\u0932\u0915\u094d\u0937\u093f\u0924 \u0915\u0930\u093e. \u0905\u0927\u093f\u0915\u0943\u0924 \u0935\u0940\u091c \u092c\u093f\u0932\u093e\u091a\u0940 \u092a\u093e\u0935\u0924\u0940 \u0924\u092a\u093e\u0938\u093e \u0915\u093f\u0902\u0935\u093e \u0935\u0940\u091c \u0915\u0902\u092a\u0928\u0940\u091a\u094d\u092f\u093e \u0905\u0927\u093f\u0915\u0943\u0924 \u0915\u0938\u094d\u091f\u092e\u0930 \u0915\u0947\u0905\u0930\u0936\u0940 \u0938\u0902\u092a\u0930\u094d\u0915 \u0938\u093e\u0927\u093e.',isSafe:!0},{id:'elec_danger',textEn:'Immediately call 9876543210 and install the bill update app they send to stop the disconnection.',textHi:'\u092c\u093f\u091c\u0932\u0940 \u0915\u091f\u0928\u0947 \u0915\u0947 \u0921\u0930 \u0938\u0947 \u0924\u0941\u0930\u0902\u0924 9876543210 \u092a\u0930 \u092b\u094b\u0928 \u0915\u0930\u0947\u0902 \u0914\u0930 \u0909\u0928\u0915\u0947 \u0926\u094d\u0935\u093e\u0930\u093e \u092d\u0947\u091c\u093e \u0917\u092f\u093e \u0910\u092a \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0930\u0947\u0902\u0964',textMr:'\u0935\u0940\u091c \u091c\u093e\u0923\u094d\u092f\u093e\u091a\u094d\u092f\u093e \u092d\u0940\u0924\u0940\u0928\u0947 \u0932\u0917\u0947\u091a 9876543210 \u0935\u0930 \u0915\u0949\u0932 \u0915\u0930\u093e \u0906\u0923\u093f \u0924\u094d\u092f\u093e\u0902\u0928\u0940 \u0938\u093e\u0902\u0917\u093f\u0924\u0932\u0947\u0932\u0947 \u0972\u092a \u0921\u093e\u090a\u0928\u0932\u094b\u0921 \u0915\u0930\u093e.',isSafe:!1}],explanationEn:'Government and state electricity boards (like MSEDCL, BSES, BESCOM, UPPCL) never send personal mobile numbers for bill payments and never disconnect electricity without formal written statutory notice. Scammers use fear and urgency to make seniors install malicious screen-sharing APK apps.',explanationHi:'\u0938\u0930\u0915\u093e\u0930\u0940 \u092f\u093e \u0928\u093f\u091c\u0940 \u092c\u093f\u091c\u0932\u0940 \u092c\u094b\u0930\u094d\u0921 \u0915\u092d\u0940 \u092d\u0940 \u092c\u093f\u0932 \u092d\u0941\u0917\u0924\u093e\u0928 \u0915\u0947 \u0932\u093f\u090f \u0915\u093f\u0938\u0940 \u0915\u0930\u094d\u092e\u091a\u093e\u0930\u0940 \u0915\u093e \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u0928\u0939\u0940\u0902 \u092d\u0947\u091c\u0924\u0947 \u0914\u0930 \u0928 \u0939\u0940 \u092c\u093f\u0928\u093e \u0932\u093f\u0916\u093f\u0924 \u0928\u094b\u091f\u093f\u0938 \u092c\u093f\u091c\u0932\u0940 \u0915\u093e\u091f\u0924\u0947 \u0939\u0948\u0902\u0964 \u0920\u0917 \u0918\u092c\u0930\u093e\u0939\u091f \u092a\u0948\u0926\u093e \u0915\u0930\u0915\u0947 \u0930\u093f\u092e\u094b\u091f \u090f\u0915\u094d\u0938\u0947\u0938 \u0910\u092a \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0930\u0935\u093e \u0932\u0947\u0924\u0947 \u0939\u0948\u0902\u0964',explanationMr:'\u0938\u0930\u0915\u093e\u0930\u0940 \u0915\u093f\u0902\u0935\u093e \u0916\u093e\u091c\u0917\u0940 \u0935\u0940\u091c \u0915\u0902\u092a\u0928\u094d\u092f\u093e \u0915\u0927\u0940\u0939\u0940 \u092c\u093f\u0932\u093e\u0938\u093e\u0920\u0940 \u0915\u0930\u094d\u092e\u091a\u093e\u0931\u094d\u092f\u093e\u0902\u091a\u093e \u0935\u0948\u092f\u0915\u094d\u0924\u093f\u0915 \u092e\u094b\u092c\u093e\u0908\u0932 \u0928\u0902\u092c\u0930 \u0926\u0947\u0924 \u0928\u093e\u0939\u0940\u0924 \u0906\u0923\u093f \u0932\u0947\u0916\u0940 \u0928\u094b\u091f\u0940\u0938 \u0926\u093f\u0932\u094d\u092f\u093e\u0936\u093f\u0935\u093e\u092f \u0935\u0940\u091c \u0924\u094b\u0921\u0924 \u0928\u093e\u0939\u0940\u0924. \u092d\u093e\u092e\u091f\u0947 \u092d\u0940\u0924\u0940 \u0926\u093e\u0916\u0935\u0942\u0928 \u092e\u094b\u092c\u093e\u0908\u0932\u091a\u093e \u0924\u093e\u092c\u093e \u0918\u0947\u0923\u093e\u0930\u0947 \u0972\u092a \u0907\u0928\u094d\u0938\u094d\u091f\u0949\u0932 \u0915\u0930\u093e\u092f\u0932\u093e \u0932\u093e\u0935\u0924\u093e\u0924.',ruleLessonEn:'Rule: Never pay utility bills using phone numbers received in sudden urgent SMS warnings.',ruleLessonHi:'\u0928\u093f\u092f\u092e: \u0905\u091a\u093e\u0928\u0915 \u0906\u090f \u090f\u0938\u090f\u092e\u090f\u0938 \u092e\u0947\u0902 \u0926\u093f\u090f \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u0928\u0902\u092c\u0930\u094b\u0902 \u092a\u0930 \u0915\u092d\u0940 \u0938\u0902\u092a\u0930\u094d\u0915 \u092f\u093e \u092d\u0941\u0917\u0924\u093e\u0928 \u0928 \u0915\u0930\u0947\u0902\u0964',ruleLessonMr:'\u0928\u093f\u092f\u092e: \u092e\u0947\u0938\u0947\u091c\u092e\u0927\u094d\u092f\u0947 \u0906\u0932\u0947\u0932\u094d\u092f\u093e \u0905\u0928\u094b\u0933\u0916\u0940 \u092b\u094b\u0928 \u0928\u0902\u092c\u0930\u0935\u0930 \u0915\u0927\u0940\u0939\u0940 \u092a\u0948\u0938\u0947 \u092d\u0930\u0942 \u0928\u0915\u093e \u0915\u093f\u0902\u0935\u093e \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0930\u0942 \u0928\u0915\u093e.',safeTipEn:'State discoms never send personal mobile numbers for bill payments or cutoff notices.',safeTipHi:'\u092c\u093f\u091c\u0932\u0940 \u092c\u094b\u0930\u094d\u0921 \u092c\u093f\u0932 \u092d\u0941\u0917\u0924\u093e\u0928 \u0915\u0947 \u0932\u093f\u090f \u0915\u092d\u0940 \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u0928\u0939\u0940\u0902 \u092d\u0947\u091c\u0924\u0947\u0964',safeTipMr:'\u0935\u0940\u091c \u0915\u0902\u092a\u0928\u094d\u092f\u093e \u092c\u093f\u0932\u093e\u0938\u093e\u0920\u0940 \u0915\u0927\u0940\u0939\u0940 \u0915\u0930\u094d\u092e\u091a\u093e\u0931\u094d\u092f\u093e\u0902\u091a\u0947 \u0935\u0948\u092f\u0915\u094d\u0924\u093f\u0915 \u092e\u094b\u092c\u093e\u0908\u0932 \u0928\u0902\u092c\u0930 \u092a\u093e\u0920\u0935\u0924 \u0928\u093e\u0939\u0940\u0924.'},{id:'scenario_police',category:'police',topicTitleEn:'Police & Law Enforcement',topicTitleHi:'\u092a\u0941\u0932\u093f\u0938 \u0935 \u0915\u093e\u0928\u0942\u0928 \u092a\u094d\u0930\u0935\u0930\u094d\u0924\u0928',topicTitleMr:'\u092a\u094b\u0932\u0940\u0938 \u0935 \u0915\u093e\u092f\u0926\u0947\u0936\u0940\u0930 \u0915\u093e\u0930\u0935\u093e\u0908',titleEn:'Digital Arrest & CBI Extortion',titleHi:'\u092b\u0930\u094d\u091c\u0940 \u0921\u093f\u091c\u093f\u091f\u0932 \u0905\u0930\u0947\u0938\u094d\u091f \u0914\u0930 \u092a\u0941\u0932\u093f\u0938 \u0927\u092e\u0915\u0940',titleMr:'\u092c\u0928\u093e\u0935\u091f \u0921\u093f\u091c\u093f\u091f\u0932 \u0905\u091f\u0915 \u0906\u0923\u093f \u0927\u092e\u0915\u0940',messageEn:'ATTENTION: This is Inspector Ajay Kumar from Mumbai Crime Branch / CBI. A FedEx parcel sent to Cambodia with your Aadhaar contains 5 fake passports and 200g MDMA narcotics. You are under immediate DIGITAL ARREST. Join Skype video call immediately and transfer security collateral to RBI verification escrow.',messageHi:'\u0938\u093e\u0935\u0927\u093e\u0928: \u092f\u0939 \u092e\u0941\u0902\u092c\u0908 \u0915\u094d\u0930\u093e\u0907\u092e \u092c\u094d\u0930\u093e\u0902\u091a / \u0938\u0940\u092c\u0940\u0906\u0908 \u0938\u0947 \u0907\u0902\u0938\u094d\u092a\u0947\u0915\u094d\u091f\u0930 \u0905\u091c\u092f \u0915\u0941\u092e\u093e\u0930 \u0939\u0948\u0902\u0964 \u0906\u092a\u0915\u0947 \u0906\u0927\u093e\u0930 \u0938\u0947 \u0915\u0902\u092c\u094b\u0921\u093f\u092f\u093e \u092d\u0947\u091c\u0947 \u0917\u090f \u092a\u093e\u0930\u094d\u0938\u0932 \u092e\u0947\u0902 5 \u091c\u093e\u0932\u0940 \u092a\u093e\u0938\u092a\u094b\u0930\u094d\u091f \u0914\u0930 \u0928\u0936\u0940\u0932\u0947 \u092a\u0926\u093e\u0930\u094d\u0925 \u092e\u093f\u0932\u0947 \u0939\u0948\u0902\u0964 \u0906\u092a\u0915\u094b \u0924\u0924\u094d\u0915\u093e\u0932 \u0921\u093f\u091c\u093f\u091f\u0932 \u0905\u0930\u0947\u0938\u094d\u091f \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u0939\u0948\u0964 \u0924\u0941\u0930\u0902\u0924 \u0935\u0940\u0921\u093f\u092f\u094b \u0915\u0949\u0932 \u092a\u0930 \u0906\u090f\u0902 \u0914\u0930 \u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u0916\u093e\u0924\u0947 \u092e\u0947\u0902 \u092a\u0948\u0938\u0947 \u091f\u094d\u0930\u093e\u0902\u0938\u092b\u0930 \u0915\u0930\u0947\u0902\u0964',messageMr:'\u0938\u093e\u0935\u0927\u093e\u0928: \u092e\u0940 \u092e\u0941\u0902\u092c\u0908 \u0915\u094d\u0930\u093e\u0908\u092e \u092c\u094d\u0930\u0901\u091a / \u0938\u0940\u092c\u0940\u0906\u092f\u092e\u0927\u0942\u0928 \u0907\u0928\u094d\u0938\u094d\u092a\u0947\u0915\u094d\u091f\u0930 \u0905\u091c\u092f \u0915\u0941\u092e\u093e\u0930 \u092c\u094b\u0932\u0924 \u0906\u0939\u0947. \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0906\u0927\u093e\u0930 \u0915\u093e\u0930\u094d\u0921\u0935\u0930 \u092a\u0930\u0926\u0947\u0936\u093e\u0924 \u092a\u093e\u0920\u0935\u0932\u0947\u0932\u094d\u092f\u093e \u092a\u093e\u0930\u094d\u0938\u0932\u092e\u0927\u094d\u092f\u0947 \u092c\u0947\u0915\u093e\u092f\u0926\u0947\u0936\u0940\u0930 \u0921\u094d\u0930\u0917\u094d\u091c \u0938\u093e\u092a\u0921\u0932\u0947 \u0906\u0939\u0947\u0924. \u0924\u0941\u092e\u094d\u0939\u093e\u0932\u093e \u0921\u093f\u091c\u093f\u091f\u0932 \u0905\u091f\u0915 \u0915\u0930\u0923\u094d\u092f\u093e\u0924 \u0906\u0932\u0940 \u0906\u0939\u0947. \u0924\u094d\u0935\u0930\u093f\u0924 \u0935\u094d\u0939\u093f\u0921\u093f\u0913 \u0915\u0949\u0932\u0935\u0930 \u092f\u093e \u0906\u0923\u093f \u0938\u0941\u0930\u0915\u094d\u0937\u0947\u0938\u093e\u0920\u0940 \u0916\u093e\u0924\u094d\u092f\u093e\u0924 \u092a\u0948\u0938\u0947 \u092a\u093e\u0920\u0935\u093e.',questionEn:'The caller wears a police uniform on video and demands you stay on the call. What should you do?',questionHi:'\u092b\u094b\u0928 \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u093e \u0935\u0940\u0921\u093f\u092f\u094b \u092a\u0930 \u092a\u0941\u0932\u093f\u0938 \u0915\u0940 \u0935\u0930\u094d\u0926\u0940 \u092a\u0939\u0928\u0947 \u0939\u0948 \u0914\u0930 \u0915\u0949\u0932 \u092a\u0930 \u0930\u0939\u0928\u0947 \u0915\u094b \u0915\u0939 \u0930\u0939\u093e \u0939\u0948\u0964 \u0906\u092a \u0915\u094d\u092f\u093e \u0915\u0930\u0947\u0902\u0917\u0947?',questionMr:'\u0935\u094d\u0939\u093f\u0921\u093f\u0913 \u0915\u0949\u0932\u0935\u0930\u0940\u0932 \u0935\u094d\u092f\u0915\u094d\u0924\u0940\u0928\u0947 \u092a\u094b\u0932\u093f\u0938\u093e\u0902\u091a\u093e \u0917\u0923\u0935\u0947\u0936 \u0918\u093e\u0924\u0932\u093e \u0905\u0938\u0942\u0928 \u092b\u094b\u0928 \u091a\u093e\u0932\u0942 \u0920\u0947\u0935\u0923\u094d\u092f\u093e\u0938 \u0938\u093e\u0902\u0917\u0924 \u0906\u0939\u0947. \u0924\u0941\u092e\u094d\u0939\u0940 \u0915\u093e\u092f \u0915\u0930\u093e\u0932?',choices:[{id:'police_safe',textEn:'Hang up immediately! There is NO legal concept of "Digital Arrest" in Indian law. Call 1930 and inform family or your local police station.',textHi:'\u0924\u0941\u0930\u0902\u0924 \u092b\u094b\u0928 \u0915\u093e\u091f \u0926\u0947\u0902! \u092d\u093e\u0930\u0924\u0940\u092f \u0915\u093e\u0928\u0942\u0928 \u092e\u0947\u0902 "\u0921\u093f\u091c\u093f\u091f\u0932 \u0905\u0930\u0947\u0938\u094d\u091f" \u091c\u0948\u0938\u0940 \u0915\u094b\u0908 \u091a\u0940\u091c \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 1930 \u0921\u093e\u092f\u0932 \u0915\u0930\u0947\u0902 \u0914\u0930 \u092a\u0930\u093f\u091c\u0928\u094b\u0902 \u0935 \u0938\u094d\u0925\u093e\u0928\u0940\u092f \u092a\u0941\u0932\u093f\u0938 \u0915\u094b \u092c\u0924\u093e\u090f\u0902\u0964',textMr:'\u0932\u0917\u0947\u091a \u092b\u094b\u0928 \u0915\u091f \u0915\u0930\u093e! \u092d\u093e\u0930\u0924\u0940\u092f \u0915\u093e\u092f\u0926\u094d\u092f\u093e\u0924 "\u0921\u093f\u091c\u093f\u091f\u0932 \u0905\u091f\u0915" \u0928\u093e\u0935\u093e\u091a\u0940 \u0915\u094b\u0923\u0924\u0940\u0939\u0940 \u0915\u093e\u092f\u0926\u0947\u0936\u0940\u0930 \u0924\u0930\u0924\u0942\u0926 \u0928\u093e\u0939\u0940. \u0967\u096f\u0969\u0966 \u0935\u0930 \u0924\u0915\u094d\u0930\u093e\u0930 \u0915\u0930\u093e \u0906\u0923\u093f \u0938\u094d\u0925\u093e\u0928\u093f\u0915 \u092a\u094b\u0932\u093f\u0938\u093e\u0902\u0928\u093e \u0938\u093e\u0902\u0917\u093e.',isSafe:!0},{id:'police_danger',textEn:'Do not tell family, stay confined in your room, and transfer savings to prove your innocence to the CBI officer.',textHi:'\u092a\u0930\u093f\u0935\u093e\u0930 \u0915\u094b \u0915\u0941\u091b \u0928 \u092c\u0924\u093e\u090f\u0902, \u0915\u092e\u0930\u0947 \u092e\u0947\u0902 \u092c\u0902\u0926 \u0930\u0939\u0947\u0902 \u0914\u0930 \u0905\u092a\u0928\u0940 \u092c\u0947\u0917\u0941\u0928\u093e\u0939\u0940 \u0938\u093e\u092c\u093f\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092c\u0924\u093e\u090f \u0917\u090f \u0916\u093e\u0924\u0947 \u092e\u0947\u0902 \u092a\u0948\u0938\u0947 \u091f\u094d\u0930\u093e\u0902\u0938\u092b\u0930 \u0915\u0930 \u0926\u0947\u0902\u0964',textMr:'\u0915\u0941\u091f\u0941\u0902\u092c\u093e\u0932\u093e \u0915\u093e\u0939\u0940\u0939\u0940 \u0928 \u0938\u093e\u0902\u0917\u0924\u093e \u0916\u094b\u0932\u0940\u0924 \u092c\u0938\u093e \u0906\u0923\u093f \u0938\u094d\u0935\u0924\u0903\u091a\u0940 \u0928\u093f\u0937\u094d\u092a\u093e\u092a \u0938\u0941\u091f\u0915\u093e \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0924\u094d\u092f\u093e\u0902\u0928\u0940 \u0926\u093f\u0932\u0947\u0932\u094d\u092f\u093e \u0916\u093e\u0924\u094d\u092f\u093e\u0935\u0930 \u092a\u0948\u0938\u0947 \u092a\u093e\u0920\u0935\u093e.',isSafe:!1}],explanationEn:'The Supreme Court of India, Ministry of Home Affairs, and State Police have repeatedly clarified: Police, CBI, ED, and judges NEVER conduct arrests over WhatsApp, Skype, or phone calls, and NEVER ask citizens to transfer money to "escrow" or "security" accounts. Any threat of "digital arrest" is 100% fraud.',explanationHi:'\u0917\u0943\u0939 \u092e\u0902\u0924\u094d\u0930\u093e\u0932\u092f \u0914\u0930 \u092a\u0941\u0932\u093f\u0938 \u0928\u0947 \u0938\u094d\u092a\u0937\u094d\u091f \u0915\u093f\u092f\u093e \u0939\u0948 \u0915\u093f \u092d\u093e\u0930\u0924 \u092e\u0947\u0902 "\u0921\u093f\u091c\u093f\u091f\u0932 \u0905\u0930\u0947\u0938\u094d\u091f" \u091c\u0948\u0938\u0940 \u0915\u094b\u0908 \u0915\u093e\u0928\u0942\u0928\u0940 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u092a\u0941\u0932\u093f\u0938, \u0938\u0940\u092c\u0940\u0906\u0908 \u092f\u093e \u0905\u0926\u093e\u0932\u0924\u0947\u0902 \u0915\u092d\u0940 \u092d\u0940 \u0935\u094d\u0939\u093e\u091f\u094d\u0938\u090f\u092a \u092f\u093e \u0938\u094d\u0915\u093e\u0907\u092a \u092a\u0930 \u0917\u093f\u0930\u092b\u094d\u0924\u093e\u0930\u0940 \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u0940\u0902 \u0914\u0930 \u0928 \u0939\u0940 \u092a\u0948\u0938\u0947 \u092e\u093e\u0902\u0917\u0924\u0940 \u0939\u0948\u0902\u0964 \u092f\u0939 \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u0938\u093e\u0907\u092c\u0930 \u0920\u0917\u0940 \u0939\u0948\u0964',explanationMr:'\u0917\u0943\u0939 \u092e\u0902\u0924\u094d\u0930\u093e\u0932\u092f \u0906\u0923\u093f \u092a\u094b\u0932\u093f\u0938\u093e\u0902\u0928\u0940 \u0938\u094d\u092a\u0937\u094d\u091f \u0915\u0947\u0932\u0947 \u0906\u0939\u0947 \u0915\u0940 "\u0921\u093f\u091c\u093f\u091f\u0932 \u0905\u091f\u0915" \u092a\u0942\u0930\u094d\u0923\u092a\u0923\u0947 \u092c\u0928\u093e\u0935\u091f \u0906\u0939\u0947. \u092a\u094b\u0932\u0940\u0938 \u0915\u093f\u0902\u0935\u093e \u0938\u0940\u092c\u0940\u0906\u092f \u0915\u0927\u0940\u0939\u0940 \u0935\u094d\u0939\u0949\u091f\u094d\u0938\u0972\u092a \u0915\u093f\u0902\u0935\u093e \u0938\u094d\u0915\u093e\u0908\u092a\u0935\u0930 \u0905\u091f\u0915 \u0915\u0930\u0924 \u0928\u093e\u0939\u0940\u0924 \u0906\u0923\u093f \u0915\u094b\u0923\u0924\u094d\u092f\u093e\u0939\u0940 \u092c\u0901\u0915 \u0916\u093e\u0924\u094d\u092f\u093e\u0924 \u092a\u0948\u0938\u0947 \u092e\u093e\u0917\u0942 \u0936\u0915\u0924 \u0928\u093e\u0939\u0940\u0924.',ruleLessonEn:'Rule: No police or court will ever arrest you on video call or demand bank transfers to clear your name.',ruleLessonHi:'\u0928\u093f\u092f\u092e: \u0915\u094b\u0908 \u092d\u0940 \u092a\u0941\u0932\u093f\u0938 \u092f\u093e \u0915\u094b\u0930\u094d\u091f \u0935\u0940\u0921\u093f\u092f\u094b \u0915\u0949\u0932 \u092a\u0930 \u0917\u093f\u0930\u092b\u094d\u0924\u093e\u0930\u0940 \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u093e \u0914\u0930 \u0928 \u092a\u0948\u0938\u0947 \u092e\u093e\u0902\u0917\u0924\u093e \u0939\u0948\u0964',ruleLessonMr:'\u0928\u093f\u092f\u092e: \u0915\u094b\u0923\u0924\u0947\u0939\u0940 \u092a\u094b\u0932\u0940\u0938 \u0915\u093f\u0902\u0935\u093e \u0928\u094d\u092f\u093e\u092f\u093e\u0932\u092f \u0935\u094d\u0939\u093f\u0921\u093f\u0913 \u0915\u0949\u0932\u0935\u0930 \u0905\u091f\u0915 \u0915\u0930\u0924 \u0928\u093e\u0939\u0940\u0924 \u0915\u093f\u0902\u0935\u093e \u092a\u0948\u0938\u0947 \u092e\u093e\u0917\u0924 \u0928\u093e\u0939\u0940\u0924.',safeTipEn:'There is no concept of "Digital Arrest" in India. Police never demand bank transfers.',safeTipHi:'\u092d\u093e\u0930\u0924\u0940\u092f \u0915\u093e\u0928\u0942\u0928 \u092e\u0947\u0902 \u0921\u093f\u091c\u093f\u091f\u0932 \u0905\u0930\u0947\u0938\u094d\u091f \u0928\u0939\u0940\u0902 \u0939\u094b\u0924\u093e\u0964 \u092a\u0941\u0932\u093f\u0938 \u0915\u092d\u0940 \u092a\u0948\u0938\u0947 \u091f\u094d\u0930\u093e\u0902\u0938\u092b\u0930 \u0915\u0930\u0928\u0947 \u0915\u094b \u0928\u0939\u0940\u0902 \u0915\u0939\u0924\u0940\u0964',safeTipMr:'\u0915\u093e\u092f\u0926\u094d\u092f\u093e\u0924 \u0921\u093f\u091c\u093f\u091f\u0932 \u0905\u091f\u0915 \u0905\u0938\u094d\u0924\u093f\u0924\u094d\u0935\u093e\u0924 \u0928\u093e\u0939\u0940. \u092a\u094b\u0932\u0940\u0938 \u0915\u0927\u0940\u0939\u0940 \u092a\u0948\u0938\u0947 \u092a\u093e\u0920\u0935\u0923\u094d\u092f\u093e\u0938 \u0938\u093e\u0902\u0917\u0924 \u0928\u093e\u0939\u0940\u0924.'},{id:'scenario_kyc',category:'kyc',topicTitleEn:'Bank KYC Verification',topicTitleHi:'\u092c\u0948\u0902\u0915 \u0915\u0947\u0935\u093e\u0908\u0938\u0940 \u0938\u0924\u094d\u092f\u093e\u092a\u0928',topicTitleMr:'\u092c\u0901\u0915 \u0915\u0947\u0935\u093e\u092f\u0938\u0940 \u092a\u0921\u0924\u093e\u0933\u0923\u0940',titleEn:'Bank Account KYC Expiry Alert',titleHi:'\u092c\u0948\u0902\u0915 \u0916\u093e\u0924\u093e \u0915\u0947\u0935\u093e\u0908\u0938\u0940 \u092c\u0902\u0926 \u0939\u094b\u0928\u0947 \u0915\u0940 \u091a\u0947\u0924\u093e\u0935\u0928\u0940',titleMr:'\u092c\u0901\u0915 \u0916\u093e\u0924\u0947 \u0915\u0947\u0935\u093e\u092f\u0938\u0940 \u092c\u0902\u0926 \u0939\u094b\u0923\u094d\u092f\u093e\u091a\u0940 \u091a\u0947\u0924\u093e\u0935\u0923\u0940',messageEn:'URGENT SBI NOTICE: Your bank account has been suspended due to pending KYC Aadhaar verification. To restore banking services and avoid permanent blocking, click immediately: http://sbi-kyc-verify.vip/portal to submit OTP and PAN.',messageHi:'\u092e\u0939\u0924\u094d\u0935\u092a\u0942\u0930\u094d\u0923 \u090f\u0938\u092c\u0940\u0906\u0908 \u0938\u0942\u091a\u0928\u093e: \u0906\u0927\u093e\u0930 \u0915\u0947\u0935\u093e\u0908\u0938\u0940 \u0932\u0902\u092c\u093f\u0924 \u0939\u094b\u0928\u0947 \u0915\u0947 \u0915\u093e\u0930\u0923 \u0906\u092a\u0915\u093e \u092c\u0948\u0902\u0915 \u0916\u093e\u0924\u093e \u0928\u093f\u0932\u0902\u092c\u093f\u0924 \u0915\u0930 \u0926\u093f\u092f\u093e \u0917\u092f\u093e \u0939\u0948\u0964 \u0916\u093e\u0924\u093e \u092a\u0941\u0928\u0903 \u091a\u093e\u0932\u0942 \u0930\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0924\u0941\u0930\u0902\u0924 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902: http://sbi-kyc-verify.vip/portal \u0914\u0930 \u0913\u091f\u0940\u092a\u0940 \u0935 \u092a\u0948\u0928 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902\u0964',messageMr:'\u092e\u0939\u0924\u094d\u0924\u094d\u0935\u093e\u091a\u0940 \u090f\u0938\u092c\u0940\u0906\u092f \u0938\u0942\u091a\u0928\u093e: \u092a\u094d\u0930\u0932\u0902\u092c\u093f\u0924 \u0906\u0927\u093e\u0930 \u0915\u0947\u0935\u093e\u092f\u0938\u0940\u092e\u0941\u0933\u0947 \u0924\u0941\u092e\u091a\u0947 \u092c\u0901\u0915 \u0916\u093e\u0924\u0947 \u0938\u094d\u0925\u0917\u093f\u0924 \u0915\u0930\u0923\u094d\u092f\u093e\u0924 \u0906\u0932\u0947 \u0906\u0939\u0947. \u0938\u0947\u0935\u093e \u0938\u0941\u0930\u0933\u0940\u0924 \u0920\u0947\u0935\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0924\u094d\u0935\u0930\u093f\u0924 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e: http://sbi-kyc-verify.vip/portal \u0906\u0923\u093f \u0913\u091f\u0940\u092a\u0940 \u0935 \u092a\u0945\u0928 \u091f\u093e\u0915\u093e.',questionEn:'You hold a savings account in SBI and worry your pension will stop. What should you do?',questionHi:'\u0906\u092a\u0915\u093e \u0916\u093e\u0924\u093e \u090f\u0938\u092c\u0940\u0906\u0908 \u092e\u0947\u0902 \u0939\u0948 \u0914\u0930 \u0906\u092a\u0915\u094b \u092a\u0947\u0902\u0936\u0928 \u0930\u0941\u0915\u0928\u0947 \u0915\u0940 \u091a\u093f\u0902\u0924\u093e \u0939\u0948\u0964 \u0906\u092a\u0915\u094b \u0915\u094d\u092f\u093e \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u093f\u090f?',questionMr:'\u0924\u0941\u092e\u091a\u0947 \u090f\u0938\u092c\u0940\u0906\u092f\u092e\u0927\u094d\u092f\u0947 \u0916\u093e\u0924\u0947 \u0906\u0939\u0947 \u0906\u0923\u093f \u092a\u0947\u0928\u094d\u0936\u0928 \u0925\u093e\u0902\u092c\u0923\u094d\u092f\u093e\u091a\u0940 \u092d\u0940\u0924\u0940 \u0935\u093e\u091f\u0924\u0947. \u0924\u0941\u092e\u094d\u0939\u0940 \u0915\u093e\u092f \u0915\u0930\u093e\u0935\u0947?',choices:[{id:'kyc_safe',textEn:'Never click links in SMS. Visit your home bank branch in person or use the official bank app downloaded from Play Store.',textHi:'\u0938\u0902\u0926\u0947\u0936 \u092e\u0947\u0902 \u0926\u093f\u090f \u0932\u093f\u0902\u0915 \u092a\u0930 \u0915\u092d\u0940 \u0915\u094d\u0932\u093f\u0915 \u0928 \u0915\u0930\u0947\u0902\u0964 \u0905\u092a\u0928\u0940 \u092c\u0948\u0902\u0915 \u0936\u093e\u0916\u093e \u092e\u0947\u0902 \u0938\u094d\u0935\u092f\u0902 \u091c\u093e\u090f\u0902 \u092f\u093e \u0906\u0927\u093f\u0915\u093e\u0930\u093f\u0915 \u092c\u0948\u0902\u0915 \u0910\u092a \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0947\u0902\u0964',textMr:'\u092e\u0947\u0938\u0947\u091c\u092e\u0927\u0940\u0932 \u0932\u093f\u0902\u0915\u0935\u0930 \u0915\u0927\u0940\u0939\u0940 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0942 \u0928\u0915\u093e. \u0938\u094d\u0935\u0924\u0903 \u092c\u0901\u0915\u0947\u091a\u094d\u092f\u093e \u0936\u093e\u0916\u0947\u0924 \u091c\u093e \u0915\u093f\u0902\u0935\u093e \u0905\u0927\u093f\u0915\u0943\u0924 \u0972\u092a \u0935\u093e\u092a\u0930\u093e.',isSafe:!0},{id:'kyc_danger',textEn:'Quickly open the link, enter your internet banking password, and submit the OTP you receive on SMS.',textHi:'\u091c\u0932\u094d\u0926\u0940 \u0938\u0947 \u0932\u093f\u0902\u0915 \u0916\u094b\u0932\u0947\u0902, \u0905\u092a\u0928\u0940 \u0907\u0902\u091f\u0930\u0928\u0947\u091f \u092c\u0948\u0902\u0915\u093f\u0902\u0917 \u0906\u0908\u0921\u0940 \u0914\u0930 \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902 \u0914\u0930 \u092b\u094b\u0928 \u092a\u0930 \u0906\u092f\u093e \u0913\u091f\u0940\u092a\u0940 \u0921\u093e\u0932 \u0926\u0947\u0902\u0964',textMr:'\u0918\u093e\u0908\u0918\u093e\u0908\u0928\u0947 \u0932\u093f\u0902\u0915 \u0909\u0918\u0921\u0942\u0928 \u0907\u0902\u091f\u0930\u0928\u0947\u091f \u092c\u0901\u0915\u093f\u0902\u0917\u091a\u093e \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u091f\u093e\u0915\u093e \u0906\u0923\u093f \u092e\u094b\u092c\u093e\u0908\u0932\u0935\u0930 \u0906\u0932\u0947\u0932\u093e \u0913\u091f\u0940\u092a\u0940 \u0938\u092c\u092e\u093f\u091f \u0915\u0930\u093e.',isSafe:!1}],explanationEn:'RBI strictly forbids banks from asking customers to update KYC via SMS links. Genuine banks never send links with unofficial domain extensions like .vip, .xyz, or .top. Clicking fake phishing links allows scammers to harvest your banking credentials and drain your funds.',explanationHi:'\u0906\u0930\u092c\u0940\u0906\u0908 \u0915\u0947 \u0928\u093f\u092f\u092e\u093e\u0928\u0941\u0938\u093e\u0930 \u092c\u0948\u0902\u0915 \u0915\u092d\u0940 \u092d\u0940 \u090f\u0938\u090f\u092e\u090f\u0938 \u092e\u0947\u0902 \u0932\u093f\u0902\u0915 \u092d\u0947\u091c\u0915\u0930 \u0915\u0947\u0935\u093e\u0908\u0938\u0940 \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0928\u0947 \u0915\u094b \u0928\u0939\u0940\u0902 \u0915\u0939\u0924\u0947\u0964 .vip \u092f\u093e .xyz \u091c\u0948\u0938\u0947 \u0932\u093f\u0902\u0915 \u092b\u0930\u094d\u091c\u0940 \u0939\u094b\u0924\u0947 \u0939\u0948\u0902\u0964 \u0910\u0938\u0947 \u0932\u093f\u0902\u0915 \u092a\u0930 \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u092f\u093e \u0913\u091f\u0940\u092a\u0940 \u0921\u093e\u0932\u0924\u0947 \u0939\u0940 \u092c\u0948\u0902\u0915 \u0938\u0947 \u092a\u0948\u0938\u0947 \u0915\u091f \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964',explanationMr:'\u0906\u0930\u092c\u0940\u0906\u092f\u091a\u094d\u092f\u093e \u0928\u093f\u092f\u092e\u093e\u0902\u0928\u0941\u0938\u093e\u0930 \u092c\u0901\u0915\u093e \u0915\u0927\u0940\u0939\u0940 \u090f\u0938\u090f\u092e\u090f\u0938 \u0932\u093f\u0902\u0915\u0926\u094d\u0935\u093e\u0930\u0947 \u0915\u0947\u0935\u093e\u092f\u0938\u0940 \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0923\u094d\u092f\u093e\u0938 \u0938\u093e\u0902\u0917\u0924 \u0928\u093e\u0939\u0940\u0924. \u092c\u0928\u093e\u0935\u091f \u0932\u093f\u0902\u0915\u0935\u0930 \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0915\u093f\u0902\u0935\u093e \u0913\u091f\u0940\u092a\u0940 \u0926\u093f\u0932\u094d\u092f\u093e\u0938 \u0916\u093e\u0924\u094d\u092f\u093e\u0924\u0940\u0932 \u0938\u0930\u094d\u0935 \u092a\u0948\u0938\u0947 \u091a\u094b\u0930\u0940\u0932\u093e \u091c\u093e\u090a \u0936\u0915\u0924\u093e\u0924.',ruleLessonEn:'Rule: Banks never send website links via SMS for KYC updates. Always update KYC at your home branch.',ruleLessonHi:'\u0928\u093f\u092f\u092e: \u092c\u0948\u0902\u0915 \u0915\u092d\u0940 \u092d\u0940 \u0915\u0947\u0935\u093e\u0908\u0938\u0940 \u0915\u0947 \u0932\u093f\u090f \u090f\u0938\u090f\u092e\u090f\u0938 \u092e\u0947\u0902 \u0935\u0947\u092c\u0938\u093e\u0907\u091f \u0932\u093f\u0902\u0915 \u0928\u0939\u0940\u0902 \u092d\u0947\u091c\u0924\u0947\u0964 \u0939\u092e\u0947\u0936\u093e \u092c\u0948\u0902\u0915 \u0936\u093e\u0916\u093e \u091c\u093e\u090f\u0902\u0964',ruleLessonMr:'\u0928\u093f\u092f\u092e: \u0915\u0947\u0935\u093e\u092f\u0938\u0940 \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092c\u0901\u0915\u093e \u0915\u0927\u0940\u0939\u0940 \u092e\u0947\u0938\u0947\u091c\u092e\u0927\u094d\u092f\u0947 \u0932\u093f\u0902\u0915 \u092a\u093e\u0920\u0935\u0924 \u0928\u093e\u0939\u0940\u0924. \u0925\u0947\u091f \u092c\u0901\u0915\u0947\u091a\u094d\u092f\u093e \u0936\u093e\u0916\u0947\u0924 \u091c\u093e.',safeTipEn:'Banks never send website links via SMS for KYC. Update KYC only at your home branch.',safeTipHi:'\u0915\u0947\u0935\u093e\u0908\u0938\u0940 \u0915\u0947 \u0932\u093f\u090f \u092c\u0948\u0902\u0915 \u0915\u092d\u0940 \u090f\u0938\u090f\u092e\u090f\u0938 \u0932\u093f\u0902\u0915 \u0928\u0939\u0940\u0902 \u092d\u0947\u091c\u0924\u0947\u0964 \u0939\u092e\u0947\u0936\u093e \u0905\u092a\u0928\u0940 \u0936\u093e\u0916\u093e \u091c\u093e\u090f\u0902\u0964',safeTipMr:'\u0915\u0947\u0935\u093e\u092f\u0938\u0940\u0938\u093e\u0920\u0940 \u092c\u0901\u0915\u093e \u0915\u0927\u0940\u0939\u0940 \u0932\u093f\u0902\u0915 \u092a\u093e\u0920\u0935\u0924 \u0928\u093e\u0939\u0940\u0924. \u0928\u0947\u0939\u092e\u0940 \u092a\u094d\u0930\u0924\u094d\u092f\u0915\u094d\u0937 \u0936\u093e\u0916\u0947\u0924 \u091c\u093e.'},{id:'scenario_otp_upi',category:'otp_upi',topicTitleEn:'OTP & UPI PIN Protection',topicTitleHi:'\u0913\u091f\u0940\u092a\u0940 \u0914\u0930 \u092f\u0942\u092a\u0940\u0906\u0908 \u092a\u093f\u0928 \u0938\u0941\u0930\u0915\u094d\u0937\u093e',topicTitleMr:'\u0913\u091f\u0940\u092a\u0940 \u0906\u0923\u093f \u092f\u0941\u092a\u0940\u0906\u092f \u092a\u093f\u0928 \u0938\u0941\u0930\u0915\u094d\u0937\u093e',titleEn:'Fraud Reversal Call & OTP Request',titleHi:'\u092b\u094d\u0930\u0949\u0921 \u0915\u0948\u0902\u0938\u0932\u0947\u0936\u0928 \u0915\u0949\u0932 \u0914\u0930 \u0913\u091f\u0940\u092a\u0940 \u0905\u0928\u0941\u0930\u094b\u0927',titleMr:'\u092b\u094d\u0930\u0949\u0921 \u0930\u0926\u094d\u0926 \u0915\u0949\u0932 \u0906\u0923\u093f \u0913\u091f\u0940\u092a\u0940 \u0935\u093f\u0928\u0902\u0924\u0940',messageEn:'CALLER CLAIMING TO BE BANK FRAUD DESK: "Sir, an unauthorized debit of \u20b949,999 has just been initiated on your credit card at an electronics store. To block this transaction immediately and reverse the funds, please tell me the 6-digit OTP code sent to your mobile right now."',messageHi:'\u0915\u0949\u0932 \u092a\u0930 \u092c\u0948\u0902\u0915 \u0927\u094b\u0916\u093e\u0927\u0921\u093c\u0940 \u0930\u094b\u0915\u0925\u093e\u092e \u0905\u0927\u093f\u0915\u093e\u0930\u0940: "\u0938\u0930, \u0906\u092a\u0915\u0947 \u0915\u094d\u0930\u0947\u0921\u093f\u091f \u0915\u093e\u0930\u094d\u0921 \u0938\u0947 \u0905\u092d\u0940 \u20b949,999 \u0915\u093e \u0905\u0928\u0927\u093f\u0915\u0943\u0924 \u0932\u0947\u0928\u0926\u0947\u0928 \u0936\u0941\u0930\u0942 \u0939\u0941\u0906 \u0939\u0948\u0964 \u0907\u0938\u0947 \u0924\u0941\u0930\u0902\u0924 \u0930\u094b\u0915\u0928\u0947 \u0914\u0930 \u092a\u0948\u0938\u0947 \u0935\u093e\u092a\u0938 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f, \u0915\u0943\u092a\u092f\u093e \u0906\u092a\u0915\u0947 \u092b\u094b\u0928 \u092a\u0930 \u0906\u092f\u093e 6-\u0905\u0902\u0915\u094b\u0902 \u0915\u093e \u0913\u091f\u0940\u092a\u0940 \u0924\u0941\u0930\u0902\u0924 \u092c\u0924\u093e\u090f\u0902\u0964"',messageMr:'\u0915\u0949\u0932\u0935\u0930\u0940\u0932 \u092c\u0901\u0915 \u0905\u0927\u093f\u0915\u093e\u0930\u0940: "\u0938\u0930, \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0915\u093e\u0930\u094d\u0921\u0935\u0930\u0942\u0928 \u20b9\u096a\u096f,\u096f\u096f\u096f \u091a\u093e \u0905\u0928\u0927\u093f\u0915\u0943\u0924 \u0935\u094d\u092f\u0935\u0939\u093e\u0930 \u0938\u0941\u0930\u0942 \u091d\u093e\u0932\u093e \u0906\u0939\u0947. \u0939\u093e \u0935\u094d\u092f\u0935\u0939\u093e\u0930 \u0924\u094d\u0935\u0930\u093f\u0924 \u0925\u093e\u0902\u092c\u0935\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0906\u0923\u093f \u092a\u0948\u0938\u0947 \u092a\u0930\u0924 \u092e\u093f\u0933\u0935\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u092e\u094b\u092c\u093e\u0908\u0932\u0935\u0930 \u0906\u0932\u0947\u0932\u093e \u096c-\u0905\u0902\u0915\u0940 \u0913\u091f\u0940\u092a\u0940 \u0938\u093e\u0902\u0917\u093e."',questionEn:'The caller urges that you only have 2 minutes before the money is permanently deducted. What should you do?',questionHi:'\u0915\u0949\u0932 \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u093e \u091c\u094b\u0930 \u0926\u0947\u0915\u0930 \u0915\u0939 \u0930\u0939\u093e \u0939\u0948 \u0915\u093f \u092a\u0948\u0938\u0947 \u0915\u091f\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0906\u092a\u0915\u0947 \u092a\u093e\u0938 \u0938\u093f\u0930\u094d\u092b 2 \u092e\u093f\u0928\u091f \u0939\u0948\u0902\u0964 \u0906\u092a \u0915\u094d\u092f\u093e \u0915\u0930\u0947\u0902\u0917\u0947?',questionMr:'\u092a\u0948\u0938\u0947 \u0915\u091f \u0939\u094b\u0923\u094d\u092f\u093e\u092a\u0942\u0930\u094d\u0935\u0940 \u0924\u0941\u092e\u091a\u094d\u092f\u093e\u0915\u0921\u0947 \u092b\u0915\u094d\u0924 \u0968 \u092e\u093f\u0928\u093f\u091f\u0947 \u0906\u0939\u0947\u0924 \u0905\u0938\u0947 \u0938\u093e\u0902\u0917\u0942\u0928 \u0915\u0949\u0932\u0930 \u0918\u093e\u0908 \u0915\u0930\u0924 \u0906\u0939\u0947. \u0924\u0941\u092e\u094d\u0939\u0940 \u0915\u093e\u092f \u0915\u0930\u093e\u0932?',choices:[{id:'otp_safe',textEn:'Disconnect immediately! OTP is a secret key to authorize payments. Legitimate bank staff never need your OTP to block a card or stop fraud.',textHi:'\u0924\u0941\u0930\u0902\u0924 \u092b\u094b\u0928 \u0915\u093e\u091f \u0926\u0947\u0902! \u0913\u091f\u0940\u092a\u0940 \u092a\u0948\u0938\u0947 \u0915\u093e\u091f\u0928\u0947 \u0915\u093e \u0917\u0941\u092a\u094d\u0924 \u0915\u094b\u0921 \u0939\u0948\u0964 \u092c\u0948\u0902\u0915 \u0915\u0930\u094d\u092e\u091a\u093e\u0930\u0940 \u0915\u092d\u0940 \u092d\u0940 \u0915\u093e\u0930\u094d\u0921 \u092c\u094d\u0932\u0949\u0915 \u0915\u0930\u0928\u0947 \u092f\u093e \u0932\u0947\u0928-\u0926\u0947\u0928 \u0930\u094b\u0915\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0913\u091f\u0940\u092a\u0940 \u0928\u0939\u0940\u0902 \u092e\u093e\u0902\u0917\u0924\u0947\u0964',textMr:'\u0932\u0917\u0947\u091a \u092b\u094b\u0928 \u0915\u091f \u0915\u0930\u093e! \u0913\u091f\u0940\u092a\u0940 \u0939\u093e \u092a\u0948\u0938\u0947 \u0935\u091c\u093e \u0915\u0930\u0923\u094d\u092f\u093e\u091a\u093e \u0917\u0941\u092a\u094d\u0924 \u0915\u094b\u0921 \u0906\u0939\u0947. \u092c\u0901\u0915 \u0915\u0930\u094d\u092e\u091a\u093e\u0930\u0940 \u0915\u093e\u0930\u094d\u0921 \u092c\u094d\u0932\u0949\u0915 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0915\u0927\u0940\u0939\u0940 \u0913\u091f\u0940\u092a\u0940 \u092e\u093e\u0917\u0924 \u0928\u093e\u0939\u0940\u0924.',isSafe:!0},{id:'otp_danger',textEn:'Quickly read out the 6-digit OTP code to the caller so they can cancel the \u20b949,999 deduction.',textHi:'\u092a\u0948\u0938\u0947 \u0915\u091f\u0928\u0947 \u0938\u0947 \u092c\u091a\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0924\u0941\u0930\u0902\u0924 \u092b\u094b\u0928 \u092a\u0930 \u0906\u092f\u093e 6-\u0905\u0902\u0915\u094b\u0902 \u0915\u093e \u0913\u091f\u0940\u092a\u0940 \u0915\u0949\u0932\u0930 \u0915\u094b \u092c\u0924\u093e \u0926\u0947\u0902\u0964',textMr:'\u20b9\u096a\u096f,\u096f\u096f\u096f \u091a\u0947 \u0928\u0941\u0915\u0938\u093e\u0928 \u091f\u093e\u0933\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0915\u0949\u0932\u0930\u0932\u093e \u092e\u094b\u092c\u093e\u0908\u0932\u0935\u0930 \u0906\u0932\u0947\u0932\u093e \u096c-\u0905\u0902\u0915\u0940 \u0913\u091f\u0940\u092a\u0940 \u0932\u0917\u0947\u091a \u0938\u093e\u0902\u0917\u093e.',isSafe:!1}],explanationEn:'An OTP (One-Time Password) is your electronic approval to withdraw or transfer money out of your account. Bank systems can block cards or freeze suspicious accounts internally without customer OTPs. Scammers invent fake fraudulent charges to cause panic and steal your OTP.',explanationHi:'\u0913\u091f\u0940\u092a\u0940 \u0906\u092a\u0915\u0947 \u0916\u093e\u0924\u0947 \u0938\u0947 \u092a\u0948\u0938\u0947 \u0928\u093f\u0915\u093e\u0932\u0928\u0947 \u0915\u0940 \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u0949\u0928\u093f\u0915 \u0938\u094d\u0935\u0940\u0915\u0943\u0924\u093f \u0939\u0948\u0964 \u092c\u0948\u0902\u0915 \u0938\u0902\u0926\u093f\u0917\u094d\u0927 \u0932\u0947\u0928\u0926\u0947\u0928 \u0930\u094b\u0915\u0928\u0947 \u092f\u093e \u0915\u093e\u0930\u094d\u0921 \u092c\u094d\u0932\u0949\u0915 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u092d\u0940 \u0917\u094d\u0930\u093e\u0939\u0915 \u0938\u0947 \u0913\u091f\u0940\u092a\u0940 \u0928\u0939\u0940\u0902 \u092e\u093e\u0902\u0917\u0924\u0947\u0964 \u0920\u0917 \u091d\u0942\u0920\u093e \u0921\u0930 \u0926\u093f\u0916\u093e\u0915\u0930 \u0913\u091f\u0940\u092a\u0940 \u0939\u093e\u0938\u093f\u0932 \u0915\u0930 \u0932\u0947\u0924\u0947 \u0939\u0948\u0902\u0964',explanationMr:'\u0913\u091f\u0940\u092a\u0940 \u092e\u094d\u0939\u0923\u091c\u0947 \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0916\u093e\u0924\u094d\u092f\u093e\u0924\u0942\u0928 \u092a\u0948\u0938\u0947 \u0915\u093e\u0922\u0923\u094d\u092f\u093e\u091a\u0940 \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u0949\u0928\u093f\u0915 \u092a\u0930\u0935\u093e\u0928\u0917\u0940. \u0938\u0902\u0936\u092f\u093e\u0938\u094d\u092a\u0926 \u0935\u094d\u092f\u0935\u0939\u093e\u0930 \u0925\u093e\u0902\u092c\u0935\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092c\u0901\u0915\u0947\u0932\u093e \u0917\u094d\u0930\u093e\u0939\u0915\u093e\u0915\u0921\u0942\u0928 \u0913\u091f\u0940\u092a\u0940 \u0918\u0947\u0923\u094d\u092f\u093e\u091a\u0940 \u0917\u0930\u091c \u0928\u0938\u0924\u0947. \u092d\u093e\u092e\u091f\u0947 \u092d\u0940\u0924\u0940 \u0926\u093e\u0916\u0935\u0942\u0928 \u0913\u091f\u0940\u092a\u0940 \u092e\u093e\u0917\u0924\u093e\u0924.',ruleLessonEn:'Rule: Never share your OTP with anyone on call or message, even if they claim to be from bank security.',ruleLessonHi:'\u0928\u093f\u092f\u092e: \u092c\u0948\u0902\u0915 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0915\u093e \u0926\u093e\u0935\u093e \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u0947 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0935\u094d\u092f\u0915\u094d\u0924\u093f \u0915\u094b \u092b\u094b\u0928 \u092a\u0930 \u0915\u092d\u0940 \u0913\u091f\u0940\u092a\u0940 \u0928 \u092c\u0924\u093e\u090f\u0902\u0964',ruleLessonMr:'\u0928\u093f\u092f\u092e: \u092c\u0901\u0915\u0947\u0924\u0942\u0928 \u092c\u094b\u0932\u0924 \u0905\u0938\u0932\u094d\u092f\u093e\u091a\u093e \u0926\u093e\u0935\u093e \u0915\u0930\u0923\u093e\u0931\u094d\u092f\u093e \u0915\u094b\u0923\u093e\u0932\u093e\u0939\u0940 \u092b\u094b\u0928\u0935\u0930 \u0915\u0927\u0940\u0939\u0940 \u0913\u091f\u0940\u092a\u0940 \u0938\u093e\u0902\u0917\u0942 \u0928\u0915\u093e.',safeTipEn:'OTP is strictly for approving payments. Bank employees never need your OTP to stop fraud.',safeTipHi:'\u0913\u091f\u0940\u092a\u0940 \u0915\u0947\u0935\u0932 \u092d\u0941\u0917\u0924\u093e\u0928 \u0915\u0940 \u0905\u0928\u0941\u092e\u0924\u093f \u0915\u0947 \u0932\u093f\u090f \u0939\u0948\u0964 \u092c\u0948\u0902\u0915 \u0915\u092d\u0940 \u0927\u094b\u0916\u093e\u0927\u0921\u093c\u0940 \u0930\u094b\u0915\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0913\u091f\u0940\u092a\u0940 \u0928\u0939\u0940\u0902 \u092e\u093e\u0902\u0917\u0924\u0947\u0964',safeTipMr:'\u0913\u091f\u0940\u092a\u0940 \u092b\u0915\u094d\u0924 \u092a\u0948\u0938\u0947 \u0926\u0947\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0905\u0938\u0924\u094b. \u0935\u094d\u092f\u0935\u0939\u093e\u0930 \u0925\u093e\u0902\u092c\u0935\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092c\u0901\u0915 \u0915\u0927\u0940\u0939\u0940 \u0913\u091f\u0940\u092a\u0940 \u092e\u093e\u0917\u0924 \u0928\u093e\u0939\u0940.'},{id:'scenario_delivery',category:'delivery',topicTitleEn:'Parcel Delivery & Couriers',topicTitleHi:'\u092a\u093e\u0930\u094d\u0938\u0932 \u0921\u093f\u0932\u0940\u0935\u0930\u0940 \u0914\u0930 \u0915\u0942\u0930\u093f\u092f\u0930',topicTitleMr:'\u092a\u093e\u0930\u094d\u0938\u0932 \u0921\u093f\u0932\u093f\u0935\u094d\u0939\u0930\u0940 \u0906\u0923\u093f \u0915\u0941\u0930\u093f\u0905\u0930',titleEn:'Fake Parcel Delivery Payment Link',titleHi:'\u092b\u0930\u094d\u091c\u0940 \u092a\u093e\u0930\u094d\u0938\u0932 \u0921\u093f\u0932\u0940\u0935\u0930\u0940 \u0914\u0930 \u092a\u0947\u092e\u0947\u0902\u091f \u0932\u093f\u0902\u0915',titleMr:'\u092c\u0928\u093e\u0935\u091f \u092a\u093e\u0930\u094d\u0938\u0932 \u0921\u093f\u0932\u093f\u0935\u094d\u0939\u0930\u0940 \u0906\u0923\u093f \u092a\u0947\u092e\u0947\u0902\u091f \u0932\u093f\u0902\u0915',messageEn:'India Post Alert: Package #IN-78219 arrived at terminal hub but cannot be delivered due to missing house number. Please update your address and pay \u20b915 re-delivery charge within 12 hours at: http://indiapost-redelivery.top or parcel will be returned.',messageHi:'\u0907\u0902\u0921\u093f\u092f\u093e \u092a\u094b\u0938\u094d\u091f \u0938\u0942\u091a\u0928\u093e: \u092a\u093e\u0930\u094d\u0938\u0932 #IN-78219 \u091f\u0930\u094d\u092e\u093f\u0928\u0932 \u092a\u0930 \u0906 \u0917\u092f\u093e \u0939\u0948 \u0932\u0947\u0915\u093f\u0928 \u0905\u0927\u0942\u0930\u093e \u092a\u0924\u093e \u0939\u094b\u0928\u0947 \u0915\u0947 \u0915\u093e\u0930\u0923 \u0921\u093f\u0932\u0940\u0935\u0930 \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u093e\u0964 \u0915\u0943\u092a\u092f\u093e \u0905\u092a\u0928\u093e \u092a\u0924\u093e \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0947\u0902 \u0914\u0930 12 \u0918\u0902\u091f\u0947 \u092e\u0947\u0902 \u20b915 \u0936\u0941\u0932\u094d\u0915 \u092d\u0930\u0947\u0902: http://indiapost-redelivery.top \u0905\u0928\u094d\u092f\u0925\u093e \u092a\u093e\u0930\u094d\u0938\u0932 \u0935\u093e\u092a\u0938 \u092d\u0947\u091c \u0926\u093f\u092f\u093e \u091c\u093e\u090f\u0917\u093e\u0964',messageMr:'\u0907\u0902\u0921\u093f\u092f\u093e \u092a\u094b\u0938\u094d\u091f \u0938\u0942\u091a\u0928\u093e: \u092a\u093e\u0930\u094d\u0938\u0932 #IN-78219 \u092a\u094b\u0939\u094b\u091a\u0932\u0947 \u0906\u0939\u0947 \u092a\u0930\u0902\u0924\u0941 \u0918\u0930\u093e\u091a\u093e \u092a\u0924\u094d\u0924\u093e \u0905\u092a\u0942\u0930\u094d\u0923 \u0905\u0938\u0932\u094d\u092f\u093e\u0928\u0947 \u0935\u093f\u0924\u0930\u093f\u0924 \u0915\u0930\u0924\u093e \u0906\u0932\u0947 \u0928\u093e\u0939\u0940. \u0915\u0943\u092a\u092f\u093e \u0967\u0968 \u0924\u093e\u0938\u093e\u0902\u0924 \u092a\u0924\u094d\u0924\u093e \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u093e \u0906\u0923\u093f \u20b9\u0967\u096b \u0936\u0941\u0932\u094d\u0915 \u092d\u0930\u093e: http://indiapost-redelivery.top \u0905\u0928\u094d\u092f\u0925\u093e \u092a\u093e\u0930\u094d\u0938\u0932 \u092a\u0930\u0924 \u092a\u093e\u0920\u0935\u0932\u0947 \u091c\u093e\u0908\u0932.',questionEn:'You were expecting a family package. The charge is only \u20b915. What is the safest response?',questionHi:'\u0906\u092a \u0915\u093f\u0938\u0940 \u092a\u093e\u0930\u094d\u0938\u0932 \u0915\u093e \u0907\u0902\u0924\u091c\u093e\u0930 \u0915\u0930 \u0930\u0939\u0947 \u0925\u0947 \u0914\u0930 \u0936\u0941\u0932\u094d\u0915 \u0938\u093f\u0930\u094d\u092b \u20b915 \u0939\u0948\u0964 \u0938\u092c\u0938\u0947 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e \u0915\u094d\u092f\u093e \u0939\u0948?',questionMr:'\u0924\u0941\u092e\u094d\u0939\u0940 \u090f\u0916\u093e\u0926\u094d\u092f\u093e \u092a\u093e\u0930\u094d\u0938\u0932\u091a\u0940 \u0935\u093e\u091f \u092a\u093e\u0939\u0924 \u0939\u094b\u0924\u093e\u0924 \u0906\u0923\u093f \u0936\u0941\u0932\u094d\u0915 \u092b\u0915\u094d\u0924 \u20b9\u0967\u096b \u0906\u0939\u0947. \u0938\u0930\u094d\u0935\u093e\u0924 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u092a\u093e\u090a\u0932 \u0915\u094b\u0923\u0924\u0947?',choices:[{id:'delivery_safe',textEn:'Do not click the link! Track your parcel only on official indiapost.gov.in using your original tracking number.',textHi:'\u0932\u093f\u0902\u0915 \u092a\u0930 \u0915\u094d\u0932\u093f\u0915 \u0928 \u0915\u0930\u0947\u0902! \u0905\u092a\u0928\u0947 \u092e\u0942\u0932 \u091f\u094d\u0930\u0948\u0915\u093f\u0902\u0917 \u0928\u0902\u092c\u0930 \u0938\u0947 \u0915\u0947\u0935\u0932 \u0906\u0927\u093f\u0915\u093e\u0930\u093f\u0915 indiapost.gov.in \u0935\u0947\u092c\u0938\u093e\u0907\u091f \u092a\u0930 \u0939\u0940 \u092a\u093e\u0930\u094d\u0938\u0932 \u091f\u094d\u0930\u0948\u0915 \u0915\u0930\u0947\u0902\u0964',textMr:'\u0932\u093f\u0902\u0915\u0935\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0942 \u0928\u0915\u093e! \u092e\u0942\u0933 \u091f\u094d\u0930\u0945\u0915\u093f\u0902\u0917 \u0928\u0902\u092c\u0930 \u0935\u093e\u092a\u0930\u0942\u0928 \u092b\u0915\u094d\u0924 \u0905\u0927\u093f\u0915\u0943\u0924 indiapost.gov.in \u0935\u0930 \u092a\u093e\u0930\u094d\u0938\u0932 \u0924\u092a\u093e\u0938\u093e.',isSafe:!0},{id:'delivery_danger',textEn:'Open the link, input your home address, and enter your debit card number, expiry, CVV, and OTP to pay \u20b915.',textHi:'\u0932\u093f\u0902\u0915 \u0916\u094b\u0932\u0947\u0902, \u0905\u092a\u0928\u093e \u092a\u0924\u093e \u0932\u093f\u0916\u0947\u0902 \u0914\u0930 \u20b915 \u091a\u0941\u0915\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0921\u0947\u092c\u093f\u091f \u0915\u093e\u0930\u094d\u0921 \u0928\u0902\u092c\u0930, \u0938\u0940\u0935\u0940\u0935\u0940 \u0935 \u0913\u091f\u0940\u092a\u0940 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902\u0964',textMr:'\u0932\u093f\u0902\u0915 \u0909\u0918\u0921\u0942\u0928 \u092a\u0924\u094d\u0924\u093e \u091f\u093e\u0915\u093e \u0906\u0923\u093f \u20b9\u0967\u096b \u092d\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0921\u0947\u092c\u093f\u091f \u0915\u093e\u0930\u094d\u0921 \u0928\u0902\u092c\u0930, \u0938\u0940\u0935\u094d\u0939\u0940\u0935\u094d\u0939\u0940 \u0906\u0923\u093f \u0913\u091f\u0940\u092a\u0940 \u0938\u092c\u092e\u093f\u091f \u0915\u0930\u093e.',isSafe:!1}],explanationEn:'Phishing websites use tiny charges (like \u20b915 or \u20b925) to lower your guard. When you enter card details and submit the OTP on the fake website, scammers initiate a major debit of thousands of rupees instead of \u20b915. Genuine postal services use only .gov.in domains.',explanationHi:'\u092b\u093f\u0936\u093f\u0902\u0917 \u0935\u0947\u092c\u0938\u093e\u0907\u091f\u094d\u0938 \u0915\u0947\u0935\u0932 \u20b915 \u092f\u093e \u20b925 \u091c\u0948\u0938\u0940 \u091b\u094b\u091f\u0940 \u0930\u0915\u092e \u0915\u093e \u091d\u093e\u0902\u0938\u093e \u0926\u0947\u0924\u0940 \u0939\u0948\u0902 \u0924\u093e\u0915\u093f \u0906\u092a \u092c\u0947\u092b\u093f\u0915\u094d\u0930 \u0930\u0939\u0947\u0902\u0964 \u0915\u093e\u0930\u094d\u0921 \u0935\u093f\u0935\u0930\u0923 \u0914\u0930 \u0913\u091f\u0940\u092a\u0940 \u0921\u093e\u0932\u0924\u0947 \u0939\u0940 \u0916\u093e\u0924\u0947 \u0938\u0947 \u0939\u091c\u093e\u0930\u094b\u0902 \u0930\u0941\u092a\u092f\u0947 \u0915\u091f \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964 \u0938\u0930\u0915\u093e\u0930\u0940 \u0921\u093e\u0915 \u0935\u093f\u092d\u093e\u0917 \u0915\u0947\u0935\u0932 .gov.in \u0921\u094b\u092e\u0947\u0928 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0924\u093e \u0939\u0948\u0964',explanationMr:'\u092b\u0938\u0935\u094d\u092f\u093e \u0935\u0947\u092c\u0938\u093e\u0907\u091f\u094d\u0938 \u092b\u0915\u094d\u0924 \u20b9\u0967\u096b \u0915\u093f\u0902\u0935\u093e \u20b9\u0968\u096b \u0938\u093e\u0930\u0916\u094d\u092f\u093e \u0932\u0939\u093e\u0928 \u0930\u0915\u092e\u0947\u091a\u0947 \u0906\u092e\u093f\u0937 \u0926\u093e\u0916\u0935\u0924\u093e\u0924. \u0915\u093e\u0930\u094d\u0921\u091a\u0940 \u092e\u093e\u0939\u093f\u0924\u0940 \u0906\u0923\u093f \u0913\u091f\u0940\u092a\u0940 \u092d\u0930\u0924\u093e\u091a \u0916\u093e\u0924\u094d\u092f\u093e\u0924\u0942\u0928 \u0939\u091c\u093e\u0930\u094b \u0930\u0941\u092a\u092f\u0947 \u0915\u093e\u0922\u0932\u0947 \u091c\u093e\u0924\u093e\u0924. \u092a\u094b\u0938\u094d\u091f\u093e\u091a\u0940 \u0905\u0927\u093f\u0915\u0943\u0924 \u0938\u093e\u0908\u091f \u0928\u0947\u0939\u092e\u0940 .gov.in \u0905\u0938\u0924\u0947.',ruleLessonEn:'Rule: Official postal services never send unofficial .top or .xyz links demanding payment for address correction.',ruleLessonHi:'\u0928\u093f\u092f\u092e: \u0921\u093e\u0915 \u0935\u093f\u092d\u093e\u0917 \u0915\u092d\u0940 \u092d\u0940 \u092a\u0924\u093e \u0938\u0941\u0927\u093e\u0930\u0928\u0947 \u092f\u093e \u0936\u0941\u0932\u094d\u0915 \u0915\u0947 \u0932\u093f\u090f \u0905\u0928\u0927\u093f\u0915\u0943\u0924 .top \u092f\u093e .xyz \u0932\u093f\u0902\u0915 \u0928\u0939\u0940\u0902 \u092d\u0947\u091c\u0924\u093e\u0964',ruleLessonMr:'\u0928\u093f\u092f\u092e: \u091f\u092a\u093e\u0932 \u0935\u093f\u092d\u093e\u0917 \u0915\u0927\u0940\u0939\u0940 \u092a\u0924\u094d\u0924\u093e \u092c\u0926\u0932\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0915\u093f\u0902\u0935\u093e \u0936\u0941\u0932\u094d\u0915\u093e\u0938\u093e\u0920\u0940 \u092c\u0928\u093e\u0935\u091f \u0932\u093f\u0902\u0915 \u092a\u093e\u0920\u0935\u0924 \u0928\u093e\u0939\u0940.',safeTipEn:'Tiny re-delivery fees are traps to capture your debit card details and OTP.',safeTipHi:'\u0930\u0940-\u0921\u093f\u0932\u0940\u0935\u0930\u0940 \u0915\u0947 \u0928\u093e\u092e \u092a\u0930 \u20b915 \u0915\u093e \u091b\u094b\u091f\u093e \u0936\u0941\u0932\u094d\u0915 \u0915\u093e\u0930\u094d\u0921 \u0935\u093f\u0935\u0930\u0923 \u091a\u0941\u0930\u093e\u0928\u0947 \u0915\u093e \u091c\u093e\u0932 \u0939\u0948\u0964',safeTipMr:'\u092a\u0941\u0928\u094d\u0939\u093e \u0921\u093f\u0932\u093f\u0935\u094d\u0939\u0930\u0940\u0938\u093e\u0920\u0940 \u20b9\u0967\u096b \u091a\u0947 \u0936\u0941\u0932\u094d\u0915 \u0939\u0947 \u0915\u093e\u0930\u094d\u0921\u091a\u0940 \u092e\u093e\u0939\u093f\u0924\u0940 \u091a\u094b\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u091f\u093e\u0915\u0932\u0947\u0932\u093e \u0938\u093e\u092a\u0933\u093e \u0906\u0939\u0947.'},{id:'scenario_malware',category:'malware',topicTitleEn:'Malicious APK & Downloads',topicTitleHi:'\u0926\u0941\u0930\u094d\u092d\u093e\u0935\u0928\u093e\u092a\u0942\u0930\u094d\u0923 \u0910\u092a \u0935 \u0921\u093e\u0909\u0928\u0932\u094b\u0921',topicTitleMr:'\u0918\u093e\u0924\u0915 \u0972\u092a\u094d\u0938 \u0906\u0923\u093f \u0921\u093e\u090a\u0928\u0932\u094b\u0921\u094d\u0938',titleEn:'Malicious APK Installation Request',titleHi:'\u0926\u0941\u0930\u094d\u092d\u093e\u0935\u0928\u093e\u092a\u0942\u0930\u094d\u0923 \u090f\u092a\u0940\u0915\u0947 \u0910\u092a \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0930\u0928\u0947 \u0915\u093e \u0905\u0928\u0941\u0930\u094b\u0927',titleMr:'\u0918\u093e\u0924\u0915 \u090f\u092a\u0940\u0915\u0947 \u0972\u092a \u0921\u093e\u090a\u0928\u0932\u094b\u0921 \u0915\u0930\u0923\u094d\u092f\u093e\u091a\u0940 \u0935\u093f\u0928\u0902\u0924\u0940',messageEn:'WHATSAPP MESSAGE FROM "SBI PENSION DESK": "Respected Pensioner, RBI has launched 5G Instant Pension Credit. To receive enhanced monthly interest, install our mandatory verified security module: SBI_Pension_Rewards_5G.apk (attached file). Open the file and tap Allow All Permissions."',messageHi:'\u0935\u094d\u0939\u093e\u091f\u094d\u0938\u090f\u092a \u092a\u0930 \u0938\u0902\u0926\u0947\u0936 "\u090f\u0938\u092c\u0940\u0906\u0908 \u092a\u0947\u0902\u0936\u0928 \u0921\u0947\u0938\u094d\u0915": "\u0906\u0926\u0930\u0923\u0940\u092f \u092a\u0947\u0902\u0936\u0928\u092d\u094b\u0917\u0940, \u0906\u0930\u092c\u0940\u0906\u0908 \u0928\u0947 5G \u0924\u0941\u0930\u0902\u0924 \u092a\u0947\u0902\u0936\u0928 \u0915\u094d\u0930\u0947\u0921\u093f\u091f \u0936\u0941\u0930\u0942 \u0915\u093f\u092f\u093e \u0939\u0948\u0964 \u092c\u0922\u093c\u0940 \u0939\u0941\u0908 \u092a\u0947\u0902\u0936\u0928 \u092a\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0939\u092e\u093e\u0930\u093e \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u092e\u0949\u0921\u094d\u092f\u0942\u0932 \u0907\u0902\u0938\u094d\u091f\u0949\u0932 \u0915\u0930\u0947\u0902: SBI_Pension_Rewards_5G.apk\u0964 \u092b\u093e\u0907\u0932 \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 \u0938\u092d\u0940 \u0905\u0928\u0941\u092e\u0924\u093f\u092f\u093e\u0902 \u0926\u0947\u0902\u0964"',messageMr:'\u0935\u094d\u0939\u0949\u091f\u094d\u0938\u0972\u092a\u0935\u0930 \u092e\u0947\u0938\u0947\u091c "\u090f\u0938\u092c\u0940\u0906\u092f \u092a\u0947\u0928\u094d\u0936\u0928 \u0921\u0947\u0938\u094d\u0915": "\u0906\u0926\u0930\u0923\u0940\u092f \u092a\u0947\u0928\u094d\u0936\u0928\u0927\u093e\u0930\u0915, \u0935\u093e\u0922\u0940\u0935 \u092a\u0947\u0928\u094d\u0936\u0928 \u0906\u0923\u093f \u0935\u094d\u092f\u093e\u091c\u093e\u0938\u093e\u0920\u0940 \u0906\u092e\u091a\u0947 \u0905\u0927\u093f\u0915\u0943\u0924 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0972\u092a \u0907\u0928\u094d\u0938\u094d\u091f\u0949\u0932 \u0915\u0930\u093e: SBI_Pension_Rewards_5G.apk\u0964 \u092b\u093e\u0908\u0932 \u0909\u0918\u0921\u093e \u0906\u0923\u093f \u0938\u0930\u094d\u0935 \u092a\u0930\u0935\u093e\u0928\u0917\u094d\u092f\u093e \u0926\u094d\u092f\u093e."',questionEn:'A message asks you to download and install an APK file directly from WhatsApp. What should you do?',questionHi:'\u0935\u094d\u0939\u093e\u091f\u094d\u0938\u090f\u092a \u092a\u0930 \u0906\u092f\u093e \u0938\u0902\u0926\u0947\u0936 \u0938\u0940\u0927\u0947 \u090f\u092a\u0940\u0915\u0947 \u092b\u093e\u0907\u0932 \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0914\u0930 \u0907\u0902\u0938\u094d\u091f\u0949\u0932 \u0915\u0930\u0928\u0947 \u0915\u094b \u0915\u0939 \u0930\u0939\u093e \u0939\u0948\u0964 \u0906\u092a \u0915\u094d\u092f\u093e \u0915\u0930\u0947\u0902\u0917\u0947?',questionMr:'\u0935\u094d\u0939\u0949\u091f\u094d\u0938\u0972\u092a\u0935\u0930 \u0906\u0932\u0947\u0932\u093e \u092e\u0947\u0938\u0947\u091c \u0925\u0947\u091f \u090f\u092a\u0940\u0915\u0947 \u092b\u093e\u0908\u0932 \u0907\u0928\u094d\u0938\u094d\u091f\u0949\u0932 \u0915\u0930\u0923\u094d\u092f\u093e\u0938 \u0938\u093e\u0902\u0917\u0924 \u0906\u0939\u0947. \u0924\u0941\u092e\u094d\u0939\u0940 \u0915\u093e\u092f \u0915\u0930\u093e\u0932?',choices:[{id:'apk_safe',textEn:'Delete the message and block sender! Never install APK files from WhatsApp or SMS. Banks distribute apps ONLY through Google Play Store.',textHi:'\u0938\u0902\u0926\u0947\u0936 \u0924\u0941\u0930\u0902\u0924 \u0921\u093f\u0932\u0940\u091f \u0915\u0930\u0947\u0902 \u0914\u0930 \u0928\u0902\u092c\u0930 \u092c\u094d\u0932\u0949\u0915 \u0915\u0930\u0947\u0902! \u0935\u094d\u0939\u093e\u091f\u094d\u0938\u090f\u092a \u092f\u093e \u090f\u0938\u090f\u092e\u090f\u0938 \u0938\u0947 \u0915\u092d\u0940 \u090f\u092a\u0940\u0915\u0947 \u0907\u0902\u0938\u094d\u091f\u0949\u0932 \u0928 \u0915\u0930\u0947\u0902\u0964 \u092c\u0948\u0902\u0915 \u0915\u0947\u0935\u0932 \u0917\u0942\u0917\u0932 \u092a\u094d\u0932\u0947 \u0938\u094d\u091f\u094b\u0930 \u0938\u0947 \u0910\u092a \u0926\u0947\u0924\u0947 \u0939\u0948\u0902\u0964',textMr:'\u092e\u0947\u0938\u0947\u091c \u0932\u0917\u0947\u091a \u0921\u093f\u0932\u0940\u091f \u0915\u0930\u093e \u0906\u0923\u093f \u0928\u0902\u092c\u0930 \u092c\u094d\u0932\u0949\u0915 \u0915\u0930\u093e! \u0935\u094d\u0939\u0949\u091f\u094d\u0938\u0972\u092a\u0935\u0930\u0942\u0928 \u0915\u0927\u0940\u0939\u0940 \u090f\u092a\u0940\u0915\u0947 \u0907\u0928\u094d\u0938\u094d\u091f\u0949\u0932 \u0915\u0930\u0942 \u0928\u0915\u093e. \u092c\u0901\u0915\u093e\u0902\u091a\u0947 \u0972\u092a\u094d\u0938 \u092b\u0915\u094d\u0924 \u0917\u0941\u0917\u0932 \u092a\u094d\u0932\u0947 \u0938\u094d\u091f\u094b\u0905\u0930\u0935\u0930 \u0905\u0938\u0924\u093e\u0924.',isSafe:!0},{id:'apk_danger',textEn:'Download SBI_Pension_Rewards_5G.apk, enable "Install unknown apps" in Android settings, and grant SMS and Accessibility permissions.',textHi:'\u090f\u092a\u0940\u0915\u0947 \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0930\u0947\u0902, \u092b\u094b\u0928 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u092e\u0947\u0902 "\u0905\u091c\u094d\u091e\u093e\u0924 \u0938\u094d\u0930\u094b\u0924 \u0938\u0947 \u0907\u0902\u0938\u094d\u091f\u0949\u0932" \u091a\u093e\u0932\u0942 \u0915\u0930\u0947\u0902 \u0914\u0930 \u090f\u0938\u090f\u092e\u090f\u0938 \u0935 \u0938\u092d\u0940 \u0905\u0928\u0941\u092e\u0924\u093f\u092f\u093e\u0902 \u0926\u0947 \u0926\u0947\u0902\u0964',textMr:'\u090f\u092a\u0940\u0915\u0947 \u0921\u093e\u090a\u0928\u0932\u094b\u0921 \u0915\u0930\u093e, \u092b\u094b\u0928\u092e\u0927\u094d\u092f\u0947 \u0905\u091c\u094d\u091e\u093e\u0924 \u0938\u094d\u0924\u094d\u0930\u094b\u0924\u093e\u0935\u0930\u0942\u0928 \u0907\u0928\u094d\u0938\u094d\u091f\u0949\u0932 \u0915\u0930\u0923\u094d\u092f\u093e\u0938 \u092a\u0930\u0935\u093e\u0928\u0917\u0940 \u0926\u094d\u092f\u093e \u0906\u0923\u093f \u090f\u0938\u090f\u092e\u090f\u0938 \u0972\u0915\u094d\u0938\u0947\u0938 \u0926\u094d\u092f\u093e.',isSafe:!1}],explanationEn:'Malicious APK files sent over WhatsApp or SMS are banking trojans. Once installed, they read your SMS messages to intercept OTPs silently, record your keystrokes, and transfer money out of your accounts without showing any notifications on your screen.',explanationHi:'\u0935\u094d\u0939\u093e\u091f\u094d\u0938\u090f\u092a \u092f\u093e \u090f\u0938\u090f\u092e\u090f\u0938 \u092a\u0930 \u092d\u0947\u091c\u0940 \u091c\u093e\u0928\u0947 \u0935\u093e\u0932\u0940 \u090f\u092a\u0940\u0915\u0947 \u092b\u093e\u0907\u0932\u0947\u0902 \u0935\u093e\u092f\u0930\u0938 \u0939\u094b\u0924\u0940 \u0939\u0948\u0902\u0964 \u090f\u0915 \u092c\u093e\u0930 \u0907\u0902\u0938\u094d\u091f\u0949\u0932 \u0939\u094b\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926 \u092f\u0947 \u0906\u092a\u0915\u0947 \u092b\u094b\u0928 \u0938\u0947 \u0906\u0928\u0947 \u0935\u093e\u0932\u0947 \u0913\u091f\u0940\u092a\u0940 \u091a\u0941\u0930\u093e \u0932\u0947\u0924\u0940 \u0939\u0948\u0902 \u0914\u0930 \u092c\u093f\u0928\u093e \u0906\u092a\u0915\u0940 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0915\u0947 \u092c\u0948\u0902\u0915 \u0916\u093e\u0924\u0947 \u0938\u0947 \u092a\u0948\u0938\u0947 \u0928\u093f\u0915\u093e\u0932 \u0932\u0947\u0924\u0940 \u0939\u0948\u0902\u0964',explanationMr:'\u0935\u094d\u0939\u0949\u091f\u094d\u0938\u0972\u092a \u0915\u093f\u0902\u0935\u093e \u092e\u0947\u0938\u0947\u091c\u0935\u0930 \u092f\u0947\u0923\u093e\u0931\u094d\u092f\u093e \u090f\u092a\u0940\u0915\u0947 \u092b\u093e\u0908\u0932\u094d\u0938 \u092f\u093e \u0927\u094b\u0915\u093e\u0926\u093e\u092f\u0915 \u092e\u093e\u0932\u0935\u0947\u0905\u0930 \u0905\u0938\u0924\u093e\u0924. \u090f\u0915\u0926\u093e \u0907\u0928\u094d\u0938\u094d\u091f\u0949\u0932 \u091d\u093e\u0932\u094d\u092f\u093e\u0935\u0930 \u0924\u094d\u092f\u093e \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u092b\u094b\u0928\u092e\u0927\u0940\u0932 \u0913\u091f\u0940\u092a\u0940 \u091a\u094b\u0930\u0924\u093e\u0924 \u0906\u0923\u093f \u0916\u093e\u0924\u094d\u092f\u093e\u0924\u0940\u0932 \u092a\u0948\u0938\u0947 \u0932\u0902\u092a\u093e\u0938 \u0915\u0930\u0924\u093e\u0924.',ruleLessonEn:'Rule: Never install APK files sent via WhatsApp, SMS, or Telegram. Only install apps from Google Play Store.',ruleLessonHi:'\u0928\u093f\u092f\u092e: \u0935\u094d\u0939\u093e\u091f\u094d\u0938\u090f\u092a \u092f\u093e \u090f\u0938\u090f\u092e\u090f\u0938 \u092a\u0930 \u0906\u0908 \u090f\u092a\u0940\u0915\u0947 \u092b\u093e\u0907\u0932\u094b\u0902 \u0915\u094b \u0915\u092d\u0940 \u0907\u0902\u0938\u094d\u091f\u0949\u0932 \u0928 \u0915\u0930\u0947\u0902\u0964 \u0915\u0947\u0935\u0932 \u0917\u0942\u0917\u0932 \u092a\u094d\u0932\u0947 \u0938\u094d\u091f\u094b\u0930 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0947\u0902\u0964',ruleLessonMr:'\u0928\u093f\u092f\u092e: \u0935\u094d\u0939\u0949\u091f\u094d\u0938\u0972\u092a \u0915\u093f\u0902\u0935\u093e \u092e\u0947\u0938\u0947\u091c\u0935\u0930\u0940\u0932 \u090f\u092a\u0940\u0915\u0947 \u092b\u093e\u0908\u0932\u094d\u0938 \u0915\u0927\u0940\u0939\u0940 \u0907\u0928\u094d\u0938\u094d\u091f\u0949\u0932 \u0915\u0930\u0942 \u0928\u0915\u093e. \u092b\u0915\u094d\u0924 \u092a\u094d\u0932\u0947 \u0938\u094d\u091f\u094b\u0905\u0930 \u0935\u093e\u092a\u0930\u093e.',safeTipEn:'Install apps only from Google Play Store. Never install APK files sent via chat.',safeTipHi:'\u0915\u0947\u0935\u0932 \u0917\u0942\u0917\u0932 \u092a\u094d\u0932\u0947 \u0938\u094d\u091f\u094b\u0930 \u0938\u0947 \u0939\u0940 \u0910\u092a \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0930\u0947\u0902\u0964 \u091a\u0948\u091f \u092a\u0930 \u0906\u0908 \u090f\u092a\u0940\u0915\u0947 \u0915\u092d\u0940 \u0928 \u0916\u094b\u0932\u0947\u0902\u0964',safeTipMr:'\u092b\u0915\u094d\u0924 \u0917\u0941\u0917\u0932 \u092a\u094d\u0932\u0947 \u0938\u094d\u091f\u094b\u0905\u0930\u0935\u0930\u0942\u0928\u091a \u0972\u092a\u094d\u0938 \u0921\u093e\u090a\u0928\u0932\u094b\u0921 \u0915\u0930\u093e. \u092e\u0947\u0938\u0947\u091c\u0935\u0930\u0940\u0932 \u090f\u092a\u0940\u0915\u0947 \u0915\u0927\u0940\u0939\u0940 \u0909\u0918\u0921\u0942 \u0928\u0915\u093e.'},{id:'scenario_qr_fraud',category:'qr_fraud',topicTitleEn:'QR Codes & UPI Fraud',topicTitleHi:'\u0915\u094d\u092f\u0942\u0906\u0930 \u0915\u094b\u0921 \u0914\u0930 \u092f\u0942\u092a\u0940\u0906\u0908 \u092b\u094d\u0930\u0949\u0921',topicTitleMr:'\u0915\u094d\u092f\u0942\u0906\u0930 \u0915\u094b\u0921 \u0906\u0923\u093f \u092f\u0941\u092a\u0940\u0906\u092f \u092b\u0938\u0935\u0923\u0942\u0915',titleEn:'Receive Money QR Code Scam',titleHi:'\u092a\u0948\u0938\u0947 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u094d\u092f\u0942\u0906\u0930 \u0915\u094b\u0921 \u0918\u094b\u091f\u093e\u0932\u093e',titleMr:'\u092a\u0948\u0938\u0947 \u092e\u093f\u0933\u0935\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0915\u094d\u092f\u0942\u0906\u0930 \u0915\u094b\u0921 \u0918\u094b\u091f\u093e\u0933\u093e',messageEn:'BUYER ON PHONE: "Sir, I want to purchase your old sofa set on OLX. I am paying \u20b915,000 in advance via PhonePe/Google Pay. I am sending you a QR code on WhatsApp. Please scan it and enter your 4-digit UPI PIN so the \u20b915,000 is credited into your bank account immediately."',messageHi:'\u092b\u094b\u0928 \u092a\u0930 \u0916\u0930\u0940\u0926\u093e\u0930: "\u0938\u0930, \u092e\u0948\u0902 \u0906\u092a\u0915\u093e \u092a\u0941\u0930\u093e\u0928\u093e \u0938\u094b\u092b\u093e \u0916\u0930\u0940\u0926 \u0930\u0939\u093e \u0939\u0942\u0901\u0964 \u092e\u0948\u0902 \u092b\u094b\u0928\u092a\u0947 \u0938\u0947 \u20b915,000 \u090f\u0921\u0935\u093e\u0902\u0938 \u092d\u0947\u091c \u0930\u0939\u093e \u0939\u0942\u0901\u0964 \u092e\u0948\u0902\u0928\u0947 \u0935\u094d\u0939\u093e\u091f\u094d\u0938\u090f\u092a \u092a\u0930 \u090f\u0915 \u0915\u094d\u092f\u0942\u0906\u0930 \u0915\u094b\u0921 \u092d\u0947\u091c\u093e \u0939\u0948\u0964 \u092a\u0948\u0938\u0947 \u0906\u092a\u0915\u0947 \u0916\u093e\u0924\u0947 \u092e\u0947\u0902 \u091c\u092e\u093e \u0939\u094b\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u0943\u092a\u092f\u093e \u0907\u0938\u0947 \u0938\u094d\u0915\u0948\u0928 \u0915\u0930\u0947\u0902 \u0914\u0930 \u0905\u092a\u0928\u093e 4-\u0905\u0902\u0915\u0940\u092f \u092f\u0942\u092a\u0940\u0906\u0908 \u092a\u093f\u0928 \u0921\u093e\u0932\u0947\u0902\u0964"',messageMr:'\u0916\u0930\u0947\u0926\u0940\u0926\u093e\u0930 \u092b\u094b\u0928\u0935\u0930: "\u0938\u0930, \u092e\u0940 \u0924\u0941\u092e\u091a\u093e \u091c\u0941\u0928\u093e \u0938\u094b\u092b\u093e \u0935\u093f\u0915\u0924 \u0918\u0947\u0924 \u0906\u0939\u0947. \u092e\u0940 \u20b9\u0967\u096b,\u0966\u0966\u0966 \u0972\u0921\u0935\u094d\u0939\u093e\u0928\u094d\u0938 \u092a\u093e\u0920\u0935\u0924 \u0906\u0939\u0947. \u092e\u0940 \u0935\u094d\u0939\u0949\u091f\u094d\u0938\u0972\u092a\u0935\u0930 \u0915\u094d\u092f\u0942\u0906\u0930 \u0915\u094b\u0921 \u092a\u093e\u0920\u0935\u0932\u093e \u0906\u0939\u0947. \u092a\u0948\u0938\u0947 \u0916\u093e\u0924\u094d\u092f\u093e\u0924 \u092f\u0947\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0924\u094b \u0938\u094d\u0915\u0945\u0928 \u0915\u0930\u093e \u0906\u0923\u093f \u0924\u0941\u092e\u091a\u093e \u092f\u0941\u092a\u0940\u0906\u092f \u092a\u093f\u0928 \u091f\u093e\u0915\u093e."',questionEn:'The buyer is insisting and rushing you to scan. How should you react?',questionHi:'\u0916\u0930\u0940\u0926\u093e\u0930 \u091c\u0932\u094d\u0926\u092c\u093e\u091c\u0940 \u0915\u0930 \u0930\u0939\u093e \u0939\u0948 \u0914\u0930 \u0924\u0941\u0930\u0902\u0924 \u0938\u094d\u0915\u0948\u0928 \u0915\u0930\u0928\u0947 \u0915\u094b \u0915\u0939 \u0930\u0939\u093e \u0939\u0948\u0964 \u0906\u092a \u0915\u094d\u092f\u093e \u0915\u0930\u0947\u0902\u0917\u0947?',questionMr:'\u0916\u0930\u0947\u0926\u0940\u0926\u093e\u0930 \u0918\u093e\u0908 \u0915\u0930\u0924 \u0905\u0938\u0942\u0928 \u0932\u0917\u0947\u091a \u0938\u094d\u0915\u0945\u0928 \u0915\u0930\u0923\u094d\u092f\u093e\u0938 \u0938\u093e\u0902\u0917\u0924 \u0906\u0939\u0947. \u0924\u0941\u092e\u094d\u0939\u0940 \u0915\u093e\u092f \u0915\u0930\u093e\u0932?',choices:[{id:'qr_safe',textEn:'Refuse to scan! You NEVER enter a UPI PIN or scan a QR code to RECEIVE money. Entering your PIN will DEBIT money from your account.',textHi:'\u0938\u094d\u0915\u0948\u0928 \u0915\u0930\u0928\u0947 \u0938\u0947 \u0938\u093e\u092b \u092e\u0928\u093e \u0915\u0930\u0947\u0902! \u092a\u0948\u0938\u0947 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u092d\u0940 \u092d\u0940 \u0915\u094d\u092f\u0942\u0906\u0930 \u0915\u094b\u0921 \u0938\u094d\u0915\u0948\u0928 \u092f\u093e \u092f\u0942\u092a\u0940\u0906\u0908 \u092a\u093f\u0928 \u0928\u0939\u0940\u0902 \u0921\u093e\u0932\u093e \u091c\u093e\u0924\u093e\u0964 \u092a\u093f\u0928 \u0921\u093e\u0932\u0928\u0947 \u0938\u0947 \u0906\u092a\u0915\u0947 \u0916\u093e\u0924\u0947 \u0938\u0947 \u092a\u0948\u0938\u0947 \u0915\u091f \u091c\u093e\u090f\u0902\u0917\u0947\u0964',textMr:'\u0938\u094d\u0915\u0945\u0928 \u0915\u0930\u0923\u094d\u092f\u093e\u0938 \u0938\u094d\u092a\u0937\u094d\u091f \u0928\u0915\u093e\u0930 \u0926\u094d\u092f\u093e! \u092a\u0948\u0938\u0947 \u092e\u093f\u0933\u0935\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0915\u0927\u0940\u0939\u0940 \u0915\u094d\u092f\u0942\u0906\u0930 \u0915\u094b\u0921 \u0938\u094d\u0915\u0945\u0928 \u0915\u0930\u093e\u0935\u093e \u0932\u093e\u0917\u0924 \u0928\u093e\u0939\u0940 \u0915\u093f\u0902\u0935\u093e \u092a\u093f\u0928 \u091f\u093e\u0915\u093e\u0935\u093e \u0932\u093e\u0917\u0924 \u0928\u093e\u0939\u0940. \u092a\u093f\u0928 \u091f\u093e\u0915\u0932\u094d\u092f\u093e\u0938 \u0924\u0941\u092e\u091a\u0947\u091a \u092a\u0948\u0938\u0947 \u091c\u093e\u0924\u0940\u0932.',isSafe:!0},{id:'qr_danger',textEn:'Scan the WhatsApp QR code in PhonePe/GPay and enter your secret 4-digit UPI PIN to accept the \u20b915,000 credit.',textHi:'\u0935\u094d\u0939\u093e\u091f\u094d\u0938\u090f\u092a \u092a\u0930 \u0906\u092f\u093e \u0915\u094d\u092f\u0942\u0906\u0930 \u0915\u094b\u0921 \u0938\u094d\u0915\u0948\u0928 \u0915\u0930\u0947\u0902 \u0914\u0930 \u20b915,000 \u091c\u092e\u093e \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0905\u092a\u0928\u093e \u0917\u0941\u092a\u094d\u0924 4-\u0905\u0902\u0915\u0940\u092f \u092f\u0942\u092a\u0940\u0906\u0908 \u092a\u093f\u0928 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902\u0964',textMr:'\u0935\u094d\u0939\u0949\u091f\u094d\u0938\u0972\u092a\u0935\u0930 \u0906\u0932\u0947\u0932\u093e \u0915\u094d\u092f\u0942\u0906\u0930 \u0915\u094b\u0921 \u0938\u094d\u0915\u0945\u0928 \u0915\u0930\u093e \u0906\u0923\u093f \u20b9\u0967\u096b,\u0966\u0966\u0966 \u0916\u093e\u0924\u094d\u092f\u093e\u0924 \u092f\u0947\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0924\u0941\u092e\u091a\u093e \u0917\u0941\u092a\u094d\u0924 \u092f\u0941\u092a\u0940\u0906\u092f \u092a\u093f\u0928 \u091f\u093e\u0915\u093e.',isSafe:!1}],explanationEn:'GOLDEN RULE OF UPI: You only enter your UPI PIN to SEND money or deduct balance from your bank. Receiving money requires ZERO action from your side; money gets credited automatically. Anyone telling you to "scan a QR code to receive payment" is a scammer trying to debit your account.',explanationHi:'\u092f\u0942\u092a\u0940\u0906\u0908 \u0915\u093e \u0938\u094d\u0935\u0930\u094d\u0923\u093f\u092e \u0928\u093f\u092f\u092e: \u092f\u0942\u092a\u0940\u0906\u0908 \u092a\u093f\u0928 \u0915\u0947\u0935\u0932 \u092a\u0948\u0938\u0947 \u092d\u0947\u091c\u0928\u0947 (\u0916\u093e\u0924\u0947 \u0938\u0947 \u0915\u093e\u091f\u0928\u0947) \u0915\u0947 \u0932\u093f\u090f \u0921\u093e\u0932\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u092a\u0948\u0938\u0947 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u092d\u0940 \u092d\u0940 \u092a\u093f\u0928 \u0921\u093e\u0932\u0928\u0947 \u092f\u093e \u0915\u094d\u092f\u0942\u0906\u0930 \u0915\u094b\u0921 \u0938\u094d\u0915\u0948\u0928 \u0915\u0930\u0928\u0947 \u0915\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0928\u0939\u0940\u0902 \u0939\u094b\u0924\u0940\u0964',explanationMr:'\u092f\u0941\u092a\u0940\u0906\u092f\u091a\u093e \u0938\u0941\u0935\u0930\u094d\u0923 \u0928\u093f\u092f\u092e: \u092f\u0941\u092a\u0940\u0906\u092f \u092a\u093f\u0928 \u092b\u0915\u094d\u0924 \u092a\u0948\u0938\u0947 \u0926\u0947\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 (\u0916\u093e\u0924\u094d\u092f\u093e\u0924\u0942\u0928 \u0935\u091c\u093e \u0939\u094b\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940) \u0932\u093e\u0917\u0924\u094b. \u092a\u0948\u0938\u0947 \u092e\u093f\u0933\u0935\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0915\u0927\u0940\u0939\u0940 \u092a\u093f\u0928 \u091f\u093e\u0915\u0923\u094d\u092f\u093e\u091a\u0940 \u0915\u093f\u0902\u0935\u093e \u0915\u094d\u092f\u0942\u0906\u0930 \u0915\u094b\u0921 \u0938\u094d\u0915\u0945\u0928 \u0915\u0930\u0923\u094d\u092f\u093e\u091a\u0940 \u0917\u0930\u091c \u0928\u0938\u0924\u0947.',ruleLessonEn:'Rule: UPI PIN is strictly for paying. You NEVER enter a PIN or scan a QR code to receive money.',ruleLessonHi:'\u0928\u093f\u092f\u092e: \u092f\u0942\u092a\u0940\u0906\u0908 \u092a\u093f\u0928 \u0915\u0947\u0935\u0932 \u092d\u0941\u0917\u0924\u093e\u0928 \u0915\u0947 \u0932\u093f\u090f \u0939\u0948\u0964 \u092a\u0948\u0938\u0947 \u092a\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u092d\u0940 \u092a\u093f\u0928 \u0928 \u0921\u093e\u0932\u0947\u0902\u0964',ruleLessonMr:'\u0928\u093f\u092f\u092e: \u092f\u0941\u092a\u0940\u0906\u092f \u092a\u093f\u0928 \u092b\u0915\u094d\u0924 \u092a\u0948\u0938\u0947 \u0926\u0947\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0906\u0939\u0947. \u092a\u0948\u0938\u0947 \u092e\u093f\u0933\u0935\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0915\u0927\u0940\u0939\u0940 \u092a\u093f\u0928 \u091f\u093e\u0915\u0942 \u0928\u0915\u093e.',safeTipEn:'You NEVER enter a UPI PIN or scan a QR code to receive money.',safeTipHi:'\u092a\u0948\u0938\u0947 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u092d\u0940 \u092d\u0940 \u092f\u0942\u092a\u0940\u0906\u0908 \u092a\u093f\u0928 \u092f\u093e \u0915\u094d\u092f\u0942\u0906\u0930 \u0938\u094d\u0915\u0948\u0928 \u0915\u0940 \u091c\u0930\u0942\u0930\u0924 \u0928\u0939\u0940\u0902 \u0939\u094b\u0924\u0940\u0964',safeTipMr:'\u092a\u0948\u0938\u0947 \u092e\u093f\u0933\u0935\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0915\u0927\u0940\u0939\u0940 \u092f\u0941\u092a\u0940\u0906\u092f \u092a\u093f\u0928 \u091f\u093e\u0915\u0923\u094d\u092f\u093e\u091a\u0940 \u0915\u093f\u0902\u0935\u093e \u0915\u094d\u092f\u0942\u0906\u0930 \u0938\u094d\u0915\u0945\u0928 \u0915\u0930\u0923\u094d\u092f\u093e\u091a\u0940 \u0917\u0930\u091c \u0928\u0938\u0924\u0947.'},{id:'scenario_helpline',category:'helpline',topicTitleEn:'Customer Care & Remote Apps',topicTitleHi:'\u0915\u0938\u094d\u091f\u092e\u0930 \u0915\u0947\u092f\u0930 \u0914\u0930 \u0930\u093f\u092e\u094b\u091f \u0910\u092a',topicTitleMr:'\u0915\u0938\u094d\u091f\u092e\u0930 \u0915\u0947\u0905\u0930 \u0906\u0923\u093f \u0930\u093f\u092e\u094b\u091f \u0972\u092a\u094d\u0938',titleEn:'Fake Customer Care Number & Remote Access',titleHi:'\u092b\u0930\u094d\u091c\u0940 \u0915\u0938\u094d\u091f\u092e\u0930 \u0915\u0947\u092f\u0930 \u0928\u0902\u092c\u0930 \u0914\u0930 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0936\u0947\u092f\u0930\u093f\u0902\u0917',titleMr:'\u092c\u0928\u093e\u0935\u091f \u0915\u0938\u094d\u091f\u092e\u0930 \u0915\u0947\u0905\u0930 \u0906\u0923\u093f \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0936\u0947\u0905\u0930\u093f\u0902\u0917',messageEn:'PHONE CALL WITH "AIRLINE SUPPORT HELPLINE": "Sir, we received your flight cancellation request. To process your \u20b95,500 refund back to your bank account, please install AnyDesk / QuickSupport from Google Play Store and give me the 9-digit address code so our system can reverse the funds."',messageHi:'\u0915\u0949\u0932 \u092a\u0930 "\u090f\u092f\u0930\u0932\u093e\u0907\u0928 \u0915\u0938\u094d\u091f\u092e\u0930 \u0938\u092a\u094b\u0930\u094d\u091f": "\u0938\u0930, \u0906\u092a\u0915\u0940 \u091f\u093f\u0915\u091f \u0915\u0948\u0902\u0938\u0932\u0947\u0936\u0928 \u0915\u093e \u20b95,500 \u0930\u093f\u092b\u0902\u0921 \u0935\u093e\u092a\u0938 \u092d\u0947\u091c\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f, \u0915\u0943\u092a\u092f\u093e \u092a\u094d\u0932\u0947 \u0938\u094d\u091f\u094b\u0930 \u0938\u0947 AnyDesk / QuickSupport \u0910\u092a \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0930\u0947\u0902 \u0914\u0930 \u0905\u092a\u0928\u0940 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u092a\u0930 \u0926\u093f\u0916 \u0930\u0939\u093e 9-\u0905\u0902\u0915\u094b\u0902 \u0915\u093e \u0915\u094b\u0921 \u092c\u0924\u093e\u090f\u0902\u0964"',messageMr:'\u0915\u0949\u0932\u0935\u0930 "\u0935\u093f\u092e\u093e\u0928 \u0915\u0902\u092a\u0928\u0940 \u0915\u0938\u094d\u091f\u092e\u0930 \u0915\u0947\u0905\u0930": "\u0938\u0930, \u0924\u0941\u092e\u091a\u0947 \u0924\u093f\u0915\u0940\u091f \u0930\u0926\u094d\u0926 \u091d\u093e\u0932\u0947 \u0905\u0938\u0942\u0928 \u20b9\u096b,\u096b\u0966\u0966 \u091a\u093e \u092a\u0930\u0924\u093e\u0935\u093e \u0916\u093e\u0924\u094d\u092f\u093e\u0924 \u092a\u093e\u0920\u0935\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940, \u0915\u0943\u092a\u092f\u093e AnyDesk \u0915\u093f\u0902\u0935\u093e QuickSupport \u0972\u092a \u0907\u0928\u094d\u0938\u094d\u091f\u0949\u0932 \u0915\u0930\u093e \u0906\u0923\u093f \u0938\u094d\u0915\u094d\u0930\u0940\u0928\u0935\u0930\u0940\u0932 \u096f-\u0905\u0902\u0915\u0940 \u0915\u094b\u0921 \u0938\u093e\u0902\u0917\u093e."',questionEn:'The support representative asks you to install a remote access app to assist your refund. What should you do?',questionHi:'\u0915\u0938\u094d\u091f\u092e\u0930 \u0915\u0947\u092f\u0930 \u092a\u094d\u0930\u0924\u093f\u0928\u093f\u0927\u093f \u0930\u093f\u092b\u0902\u0921 \u0915\u0947 \u0932\u093f\u090f \u0930\u093f\u092e\u094b\u091f \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0910\u092a \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0930\u0928\u0947 \u0915\u094b \u0915\u0939 \u0930\u0939\u093e \u0939\u0948\u0964 \u0906\u092a \u0915\u094d\u092f\u093e \u0915\u0930\u0947\u0902\u0917\u0947?',questionMr:'\u0915\u0938\u094d\u091f\u092e\u0930 \u0915\u0947\u0905\u0930 \u092a\u094d\u0930\u0924\u093f\u0928\u093f\u0927\u0940 \u092a\u0930\u0924\u093e\u0935\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0936\u0947\u0905\u0930\u093f\u0902\u0917 \u0972\u092a \u0921\u093e\u090a\u0928\u0932\u094b\u0921 \u0915\u0930\u0923\u094d\u092f\u093e\u0938 \u0938\u093e\u0902\u0917\u0924 \u0906\u0939\u0947. \u0924\u0941\u092e\u094d\u0939\u0940 \u0915\u093e\u092f \u0915\u0930\u093e\u0932?',choices:[{id:'helpline_safe',textEn:'Hang up immediately! Legitimate customer support NEVER asks you to install AnyDesk, TeamViewer, or remote access apps.',textHi:'\u0924\u0941\u0930\u0902\u0924 \u092b\u094b\u0928 \u0915\u093e\u091f \u0926\u0947\u0902! \u0905\u0938\u0932\u0940 \u0915\u0938\u094d\u091f\u092e\u0930 \u0915\u0947\u092f\u0930 \u0915\u092d\u0940 \u092d\u0940 AnyDesk, TeamViewer \u092f\u093e \u0930\u093f\u092e\u094b\u091f \u0910\u092a \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0930\u0928\u0947 \u0915\u094b \u0928\u0939\u0940\u0902 \u0915\u0939\u0924\u0947\u0964',textMr:'\u0932\u0917\u0947\u091a \u092b\u094b\u0928 \u0915\u091f \u0915\u0930\u093e! \u0905\u0927\u093f\u0915\u0943\u0924 \u0915\u0938\u094d\u091f\u092e\u0930 \u0915\u0947\u0905\u0930 \u0915\u0927\u0940\u0939\u0940 AnyDesk \u0915\u093f\u0902\u0935\u093e \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0936\u0947\u0905\u0930\u093f\u0902\u0917 \u0972\u092a \u0907\u0928\u094d\u0938\u094d\u091f\u0949\u0932 \u0915\u0930\u0923\u094d\u092f\u093e\u0938 \u0938\u093e\u0902\u0917\u0924 \u0928\u093e\u0939\u0940.',isSafe:!0},{id:'helpline_danger',textEn:'Install AnyDesk and read out the 9-digit remote control code so the support agent can process the refund.',textHi:'AnyDesk \u0910\u092a \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0930\u0947\u0902 \u0914\u0930 \u0930\u093f\u092b\u0902\u0921 \u092a\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u092a\u0930 \u0926\u093f\u0916 \u0930\u0939\u093e 9-\u0905\u0902\u0915\u094b\u0902 \u0915\u093e \u0915\u094b\u0921 \u092a\u094d\u0930\u0924\u093f\u0928\u093f\u0927\u093f \u0915\u094b \u092c\u0924\u093e \u0926\u0947\u0902\u0964',textMr:'AnyDesk \u0921\u093e\u090a\u0928\u0932\u094b\u0921 \u0915\u0930\u093e \u0906\u0923\u093f \u092a\u0930\u0924\u093e\u0935\u093e \u092e\u093f\u0933\u0935\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092a\u094d\u0930\u0924\u093f\u0928\u093f\u0927\u0940\u0932\u093e \u0938\u094d\u0915\u094d\u0930\u0940\u0928\u0935\u0930\u0940\u0932 \u096f-\u0905\u0902\u0915\u0940 \u0915\u094b\u0921 \u0938\u093e\u0902\u0917\u093e.',isSafe:!1}],explanationEn:'AnyDesk, QuickSupport, and TeamViewer are remote desktop tools. Giving someone the access code gives them complete visual and touch control over your smartphone. Scammers open your banking apps, read SMS OTPs, and steal your money directly before your eyes.',explanationHi:'AnyDesk \u092f\u093e QuickSupport \u0930\u093f\u092e\u094b\u091f \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0936\u0947\u092f\u0930\u093f\u0902\u0917 \u0910\u092a \u0939\u0948\u0902\u0964 \u0907\u0928\u0915\u093e \u0915\u094b\u0921 \u0915\u093f\u0938\u0940 \u0915\u094b \u0926\u0947\u0928\u0947 \u0915\u093e \u092e\u0924\u0932\u092c \u0939\u0948 \u0905\u092a\u0928\u0947 \u092a\u0942\u0930\u0947 \u092b\u094b\u0928 \u0915\u093e \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0923 \u0909\u0938\u0947 \u0938\u094c\u0902\u092a \u0926\u0947\u0928\u093e\u0964 \u0920\u0917 \u0906\u092a\u0915\u0940 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0926\u0947\u0916\u0924\u0947 \u0939\u0941\u090f \u092c\u0948\u0902\u0915\u093f\u0902\u0917 \u0910\u092a \u0916\u094b\u0932\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u092a\u0948\u0938\u0947 \u091f\u094d\u0930\u093e\u0902\u0938\u092b\u0930 \u0915\u0930 \u0932\u0947\u0924\u0947 \u0939\u0948\u0902\u0964',explanationMr:'AnyDesk \u0915\u093f\u0902\u0935\u093e QuickSupport \u0939\u0940 \u0930\u093f\u092e\u094b\u091f \u0972\u0915\u094d\u0938\u0947\u0938 \u0972\u092a\u094d\u0938 \u0906\u0939\u0947\u0924. \u0924\u094d\u092f\u093e\u0902\u091a\u093e \u0915\u094b\u0921 \u0926\u093f\u0932\u094d\u092f\u093e\u0938 \u092d\u093e\u092e\u091f\u094d\u092f\u093e\u0902\u0928\u093e \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u092b\u094b\u0928\u091a\u093e \u092a\u0942\u0930\u094d\u0923 \u0924\u093e\u092c\u093e \u092e\u093f\u0933\u0924\u094b. \u0924\u0947 \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0926\u0947\u0916\u0924 \u092c\u0901\u0915\u0947\u091a\u0947 \u0972\u092a\u094d\u0938 \u0909\u0918\u0921\u0942\u0928 \u0938\u0930\u094d\u0935 \u092a\u0948\u0938\u0947 \u091a\u094b\u0930\u0942\u0928 \u0918\u0947\u0924\u093e\u0924.',ruleLessonEn:'Rule: Never install screen-sharing apps (AnyDesk, TeamViewer) at the request of any phone caller.',ruleLessonHi:'\u0928\u093f\u092f\u092e: \u092b\u094b\u0928 \u092a\u0930 \u0915\u093f\u0938\u0940 \u0915\u0947 \u092d\u0940 \u0915\u0939\u0928\u0947 \u092a\u0930 \u0915\u092d\u0940 \u0938\u094d\u0915\u094d\u0930\u0940\u0928-\u0936\u0947\u092f\u0930\u093f\u0902\u0917 \u0910\u092a (AnyDesk \u0906\u0926\u093f) \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0928 \u0915\u0930\u0947\u0902\u0964',ruleLessonMr:'\u0928\u093f\u092f\u092e: \u092b\u094b\u0928\u0935\u0930\u0940\u0932 \u0935\u094d\u092f\u0915\u094d\u0924\u0940\u091a\u094d\u092f\u093e \u0938\u093e\u0902\u0917\u0923\u094d\u092f\u093e\u0935\u0930\u0942\u0928 \u0915\u0927\u0940\u0939\u0940 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0936\u0947\u0905\u0930\u093f\u0902\u0917 \u0972\u092a \u0921\u093e\u090a\u0928\u0932\u094b\u0921 \u0915\u0930\u0942 \u0928\u0915\u093e.',safeTipEn:'Legitimate customer care never asks you to install screen-sharing software.',safeTipHi:'\u0905\u0938\u0932\u0940 \u0915\u0938\u094d\u091f\u092e\u0930 \u0915\u0947\u092f\u0930 \u0915\u092d\u0940 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0936\u0947\u092f\u0930\u093f\u0902\u0917 \u0910\u092a \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0930\u0928\u0947 \u0915\u094b \u0928\u0939\u0940\u0902 \u0915\u0939\u0924\u0947\u0964',safeTipMr:'\u0905\u0927\u093f\u0915\u0943\u0924 \u0915\u0938\u094d\u091f\u092e\u0930 \u0915\u0947\u0905\u0930 \u0915\u0927\u0940\u0939\u0940 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0936\u0947\u0905\u0930\u093f\u0902\u0917 \u0972\u092a \u0921\u093e\u090a\u0928\u0932\u094b\u0921 \u0915\u0930\u0923\u094d\u092f\u093e\u0938 \u0938\u093e\u0902\u0917\u0924 \u0928\u093e\u0939\u0940.'}]},521,[]);
