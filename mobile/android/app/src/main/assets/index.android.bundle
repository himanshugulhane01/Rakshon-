ent:"Revoke Caregiver Access",grantConsent:"Grant Caregiver Access",whatIsSharedTitle:"What information is shared?",whatIsSharedItem1:"\u2713 Practice module completion and safety quiz scores",whatIsSharedItem2:"\u2713 Device protection status (call screening & database sync)",whatIsSharedItem3:"\u2713 User-authorized high-risk fraud alerts",whatIsNeverSharedTitle:"What is NEVER shared?",whatIsNeverSharedItem1:"\ud83d\udeab Private SMS or WhatsApp chat contents",whatIsNeverSharedItem2:"\ud83d\udeab Bank passwords, PINs, or OTPs",whatIsNeverSharedItem3:"\ud83d\udeab Private phone call audio or personal dial logs",recentAlertsTitle:"Recent Safety Alerts (Authorized)",noAlertsMessage:"No recent high-risk alerts detected. Device is secure.",quickHelpTitle:"Emergency Family Contact",callSeniorButton:"\ud83d\udcde Call Senior Member",callHelplineButton:"\ud83d\udea8 Call 1930 Cybercrime Helpline",switchConsentConfirm:"Are you sure you want to change caregiver consent?"},unifiedChecker:{title:"Is This Safe? Unified Checker",subtitle:"Check messages, websites, phone numbers, or screenshots in one place",entryCardTitle:"Is This Safe? Unified Checker",entryCardSubtitle:"Quickly verify any message, website link, or phone number before taking action.",entryCardBadge:"INSTANT CHECK",openButton:"Check Safety Now \u2192",tabMessage:"\ud83d\udcac Message",tabUrl:"\ud83c\udf10 Website",tabPhone:"\ud83d\udcde Phone",tabImage:"\ud83d\uddbc\ufe0f Screenshot",inputPlaceholderMessage:"Paste SMS, WhatsApp text, or suspicious message...",inputPlaceholderUrl:"Enter website link (e.g. sbi-login.xyz or incometax.gov.in)...",inputPlaceholderPhone:"Enter 10-digit caller number or +91 number...",checkButton:"Check If This Is Safe \u2192",checkingButton:"Analyzing for Fraud Patterns...",resultTitle:"Safety Analysis Result",warningSignsTitle:"Detected Red Flags & Warning Signs",recommendedActionsTitle:"Recommended Protective Actions",copyReportButton:"\ud83d\udccb Copy Safety Summary",reportCopied:"Safety report copied to clipboard!",checkAnotherButton:"Check Another Item",noThreatsFound:"No high-risk indicators found. Still remain cautious with unsolicited requests.",samplePrompt:"Try a Senior Practice Sample:"}}},484,[]);
