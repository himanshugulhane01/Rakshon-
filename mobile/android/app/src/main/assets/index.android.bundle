922\u0933\u0932\u093e \u0928\u093e\u0939\u0940. \u0921\u093f\u0935\u094d\u0939\u093e\u0907\u0938 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0906\u0939\u0947.",quickHelpTitle:"\u0906\u092a\u0924\u094d\u0915\u093e\u0932\u0940\u0928 \u0915\u0941\u091f\u0941\u0902\u092c \u0938\u0902\u092a\u0930\u094d\u0915",callSeniorButton:"\ud83d\udcde \u091c\u094d\u092f\u0947\u0937\u094d\u0920 \u0938\u0926\u0938\u094d\u092f\u093e\u0932\u093e \u0915\u0949\u0932 \u0915\u0930\u093e",callHelplineButton:"\ud83d\udea8 \u0967\u096f\u0969\u0966 \u0938\u093e\u092f\u092c\u0930 \u0939\u0947\u0932\u094d\u092a\u0932\u093e\u0907\u0928\u0935\u0930 \u0915\u0949\u0932 \u0915\u0930\u093e",switchConsentConfirm:"\u0924\u0941\u092e\u094d\u0939\u093e\u0932\u093e \u0915\u0947\u0905\u0930\u0917\u093f\u0935\u094d\u0939\u0930 \u0938\u0902\u092e\u0924\u0940 \u0938\u094d\u0925\u093f\u0924\u0940 \u092c\u0926\u0932\u093e\u092f\u091a\u0940 \u0906\u0939\u0947 \u0915\u093e?"},unifiedChecker:{title:"\u0939\u0947 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0906\u0939\u0947 \u0915\u093e? \u092f\u0941\u0928\u093f\u092b\u093e\u0907\u0921 \u091a\u0947\u0915\u0930",subtitle:"\u092e\u0947\u0938\u0947\u091c, \u0935\u0947\u092c\u0938\u093e\u0907\u091f, \u092b\u094b\u0928 \u0928\u0902\u092c\u0930 \u0915\u093f\u0902\u0935\u093e \u0938\u094d\u0915\u094d\u0930\u0940\u0928\u0936\u0949\u091f \u090f\u0915\u093e\u091a \u0920\u093f\u0915\u093e\u0923\u0940 \u0924\u092a\u093e\u0938\u093e",entryCardTitle:"\u0939\u0947 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0906\u0939\u0947 \u0915\u093e? \u092f\u0941\u0928\u093f\u092b\u093e\u0907\u0921 \u091a\u0947\u0915\u0930",entryCardSubtitle:"\u0915\u094b\u0923\u0924\u093e\u0939\u0940 \u092e\u0947\u0938\u0947\u091c, \u0935\u0947\u092c\u0938\u093e\u0907\u091f \u0932\u093f\u0902\u0915 \u0915\u093f\u0902\u0935\u093e \u092b\u094b\u0928 \u0928\u0902\u092c\u0930 \u0932\u0917\u0947\u091a \u0924\u092a\u093e\u0938\u093e.",entryCardBadge:"\u0924\u094d\u0935\u0930\u093f\u0924 \u0924\u092a\u093e\u0938\u0923\u0940",openButton:"\u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0924\u092a\u093e\u0938\u093e \u2192",tabMessage:"\ud83d\udcac \u092e\u0947\u0938\u0947\u091c",tabUrl:"\ud83c\udf10 \u0935\u0947\u092c\u0938\u093e\u0907\u091f",tabPhone:"\ud83d\udcde \u092b\u094b\u0928",tabImage:"\ud83d\uddbc\ufe0f \u0938\u094d\u0915\u094d\u0930\u0940\u0928\u0936\u0949\u091f",inputPlaceholderMessage:"\u090f\u0938\u090f\u092e\u090f\u0938, \u0935\u094d\u0939\u0949\u091f\u094d\u0938\u0972\u092a \u0915\u093f\u0902\u0935\u093e \u0938\u0902\u0936\u092f\u093e\u0938\u094d\u092a\u0926 \u0938\u0902\u0926\u0947\u0936 \u092f\u0947\u0925\u0947 \u092a\u0947\u0938\u094d\u091f \u0915\u0930\u093e...",inputPlaceholderUrl:"\u0935\u0947\u092c\u0938\u093e\u0907\u091f \u0932\u093f\u0902\u0915 \u091f\u093e\u0915\u093e (\u0909\u0926\u093e. sbi-login.xyz \u0915\u093f\u0902\u0935\u093e incometax.gov.in)...",inputPlaceholderPhone:"\u0967\u0966 \u0905\u0902\u0915\u0940 \u0915\u0949\u0932\u0930 \u0928\u0902\u092c\u0930 \u0915\u093f\u0902\u0935\u093e +91 \u0928\u0902\u092c\u0930 \u091f\u093e\u0915\u093e...",checkButton:"\u0939\u0947 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0906\u0939\u0947 \u0915\u093e \u0924\u0947 \u0924\u092a\u093e\u0938\u093e \u2192",checkingButton:"\u092b\u0938\u0935\u0923\u0941\u0915\u0940\u091a\u094d\u092f\u093e \u0932\u0915\u094d\u0937\u0923\u093e\u0902\u091a\u0947 \u0935\u093f\u0936\u094d\u0932\u0947\u0937\u0923 \u0938\u0941\u0930\u0942 \u0906\u0939\u0947...",resultTitle:"\u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0935\u093f\u0936\u094d\u0932\u0947\u0937\u0923 \u0928\u093f\u0915\u093e\u0932",warningSignsTitle:"\u0906\u0922\u0933\u0932\u0947\u0932\u0947 \u0927\u094b\u0915\u0947 \u0906\u0923\u093f \u091a\u0947\u0924\u093e\u0935\u0923\u0940 \u091a\u093f\u0928\u094d\u0939\u0947",recommendedActionsTitle:"\u0924\u0941\u092e\u094d\u0939\u0940 \u0906\u0924\u093e \u0915\u093e\u092f \u0915\u0930\u093e\u0935\u0947",copyReportButton:"\ud83d\udccb \u0938\u0941\u0930\u0915