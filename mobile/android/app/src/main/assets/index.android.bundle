btitle:"\u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u0938\u093e\u0907\u092c\u0930 \u0939\u0947\u0932\u094d\u092a\u0932\u093e\u0907\u0928 1930 \u090f\u0935\u0902 \u092c\u0948\u0902\u0915 \u0916\u093e\u0924\u093e \u0924\u0941\u0930\u0902\u0924 \u0930\u094b\u0915\u0928\u0947 \u0915\u0940 \u092e\u093e\u0930\u094d\u0917\u0926\u0930\u094d\u0936\u093f\u0915\u093e",helplineButton:"\u0938\u093e\u0907\u092c\u0930 \u0939\u0947\u0932\u094d\u092a\u0932\u093e\u0907\u0928 (1930) \u092a\u0930 \u0915\u0949\u0932 \u0915\u0930\u0947\u0902",helplineDesc:"\u092d\u093e\u0930\u0924 \u0938\u0930\u0915\u093e\u0930 \u0915\u093e \u0906\u0927\u093f\u0915\u093e\u0930\u093f\u0915 \u0938\u093e\u0907\u092c\u0930 \u0905\u092a\u0930\u093e\u0927 \u092a\u094b\u0930\u094d\u091f\u0932",helplineCardTitle:"\u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u0938\u093e\u0907\u092c\u0930 \u0905\u092a\u0930\u093e\u0927 \u0939\u0947\u0932\u094d\u092a\u0932\u093e\u0907\u0928 (1930)",helplineCardDesc:"\u092f\u0926\u093f \u0906\u092a\u0915\u0947 \u092c\u0948\u0902\u0915 \u0916\u093e\u0924\u0947 \u0938\u0947 \u0927\u094b\u0916\u093e\u0927\u0921\u093c\u0940 \u0938\u0947 \u092a\u0948\u0938\u0947 \u0915\u091f \u0917\u090f \u0939\u0948\u0902, \u0924\u094b \u0924\u0941\u0930\u0902\u0924 1930 \u092a\u0930 \u0915\u0949\u0932 \u0915\u0930\u0947\u0902\u0964",call1930Button:"\ud83d\udea8 1930 \u0939\u0947\u0932\u094d\u092a\u0932\u093e\u0907\u0928 \u092a\u0930 \u0915\u0949\u0932 \u0915\u0930\u0947\u0902",portalCardTitle:"\u0906\u0927\u093f\u0915\u093e\u0930\u093f\u0915 \u0938\u093e\u0907\u092c\u0930 \u0905\u092a\u0930\u093e\u0927 \u092a\u094b\u0930\u094d\u091f\u0932",portalCardDesc:"\u092d\u093e\u0930\u0924 \u0938\u0930\u0915\u093e\u0930 \u0915\u0947 \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u0938\u093e\u0907\u092c\u0930 \u0905\u092a\u0930\u093e\u0927 \u092a\u094b\u0930\u094d\u091f\u0932 \u092a\u0930 \u0906\u0927\u093f\u0915\u093e\u0930\u093f\u0915 \u0936\u093f\u0915\u093e\u092f\u0924 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902\u0964",portalButton:"\ud83c\udf10 cybercrime.gov.in \u0916\u094b\u0932\u0947\u0902",confirmDialTitle:"\u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u0938\u093e\u0907\u092c\u0930 \u0939\u0947\u0932\u094d\u092a\u0932\u093e\u0907\u0928 (1930) \u092a\u0930 \u0915\u0949\u0932 \u0915\u0930\u0947\u0902?",confirmDialMessage:"\u092f\u0939 \u0906\u092a\u0915\u0947 \u092b\u094b\u0928 \u0921\u093e\u092f\u0932\u0930 \u0915\u094b \u0916\u094b\u0932\u0947\u0917\u093e \u091c\u093f\u0938\u0938\u0947 \u0906\u092a \u092d\u093e\u0930\u0924 \u0938\u0930\u0915\u093e\u0930 \u0915\u0940 \u0906\u0927\u093f\u0915\u093e\u0930\u093f\u0915 \u0939\u0947\u0932\u094d\u092a\u0932\u093e\u0907\u0928 1930 \u092a\u0930 \u092c\u093e\u0924 \u0915\u0930 \u0938\u0915\u0947\u0902\u0917\u0947\u0964",confirmDialAction:"\u0905\u092d\u0940 1930 \u092a\u0930 \u0915\u0949\u0932 \u0915\u0930\u0947\u0902",confirmPortalTitle:"\u0938\u093e\u0907\u092c\u0930 \u0905\u092a\u0930\u093e\u0927 \u092a\u094b\u0930\u094d\u091f\u0932 \u0916\u094b\u0932\u0947\u0902?",confirmPortalMessage:"\u092f\u0939 \u0906\u092a\u0915\u0947 \u092c\u094d\u0930\u093e\u0909\u091c\u093c\u0930 \u092e\u0947\u0902 \u092d\u093e\u0930\u0924 \u0938\u0930\u0915\u093e\u0930 \u0915\u093e \u0906\u0927\u093f\u0915\u093e\u0930\u093f\u0915 \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u0938\u093e\u0907\u092c\u0930 \u0905\u092a\u0930\u093e\u0927 \u0930\u093f\u092a\u094b\u0930\u094d\u091f\u093f\u0902\u0917 \u092a\u094b\u0930\u094d\u091f\u0932 \u0916\u094b\u0932\u0947\u0917\u093e\u0964",confirmPortalAction:"\u092a\u094b\u0930\u094d\u091f\u0932 \u0916\u094b\u0932\u0947\u0902",guidanceTitle:"\u0927\u094b\u0916\u093e\u0927\u0921\u093c\u0940 \u092a\u0930 \u0924\u094d\u0935\u0930\u093f\u0924 \u0915\u093e\u0930\u094d\u0930\u0935\u093e\u0908 (\u0917\u094b\u0932\u094d\u0921\u0928 \u0911\u0935\u0930)",guidanceSubtitle:"\u0935\u093f\u0924\u094d\u0924\u0940\u092f \u0927\u094b\u0916\u093e\u0927\u0921\u093c\u0940 \u0915\u093e \u0938\u0902\u0926\u0947\u0939 \u0939\u094b\u0928\u0947 \u092a\u0930 2 \u0918\u0902\u091f\u0947 \u0915\u0947 \u092d\u0940\u0924\u0930 \u092f\u0947 4 \u092e\u0939\u0924\u094d\u0935\u092a\u0942\u0930\u094d\u0923 \u0915\u0926\u092e \u0909\u0920\u093e\u090f\u0902:",step1Title:"1. 2 \u0918\u0902\u091f\u0947 \u0915\u0947 \u092d\u0940\u0924\u0930 \u0915\u093e\u0930\u094d\u0930\u0935\u093e\u0908 (\u0917\u094b\u0932\u094d\u0921\u0928 \u0911\u0935\u0930)",step1Desc:"\u0924\u0941\u0930\u0902\u0924 1930 \u092a\u0930 \u0915\u0949\u0932 \u0915\u0930\u0947\u0902\u0964 \u0938\u093e\u0907\u092c\u0930 \u092a\u0941\u0932\u093f\u0938 \u092c\u0948\u0902\u0915 \u090f\u0938\u094d\u0915\u094d\u0930\u094b \u0916\u093e\u0924\u094b\u0902 \u0915\u0947 \u092c\u0940\u091a \u091a\u094b\u0930\u0940 \u0939\u0941\u090f \u092a\u0948\u0938\u0947 \u0915\u094b \u090f\u091f\u0940\u090f\u092e \u0938\u0947 \u0928\u093f\u0915\u093e\u0932\u0947 \u091c\u093e\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0930\u094b\u0915 \u0938\u0915\u0924\u0940 \u0939\u0948\u0964",step2Title:"2. \u092c\u0948\u0902\u0915 \u092e\u0947\u0902 \u0915\u093e\u0930\u094d\u0921 \u0914\u0930 \u092f\u0942\u092a\u0940\u0906\u0908 \u0924\u0941\u0930\u0902\u0924 \u092c\u094d\u0932\u0949\u0915 \u0915\u0930\u0935\u093e\u090f\u0902",step2Desc:"\u0928\u0940\u091a\u0947 \u0926\u093f\u090f \u0917\u090f \u0906\u0927\u093f\u0915\u093e\u0930\u093f\u0915 \u092c\u0948\u0902\u0915 \u0928\u0902\u092c\u0930\u094b\u0902 \u092a\u0930 \u0924\u0941\u0930\u0902\u0924 \u0915\u0949\u0932 \u0915\u0930\u0915\u0947 \u0921\u0947\u092c\u093f\u091f \u0915\u093e\u0930\u094d\u0921, \u0928\u0947\u091f \u092c\u0948\u0902\u0915\u093f\u0902\u0917 \u0914\u0930 \u092f\u0942\u092a\u0940\u0906\u0908 \u092c\u0902\u0926 \u0915\u0930\u093e\u090f\u0902\u0964",step3Title:"3. \u0938\u092c\u0942\u0924 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0930\u0916\u0947\u0902",step3Desc:"\u092c\u0948\u0902\u0915 \u0938\u0947 \u0906\u090f \u090f\u0938\u090f\u092e\u090f\u0938, \u0915\u091f\u094c\u0924\u0940 \u0915\u0947 \u092e\u0948\u0938\u0947\u091c \u0914\u0930 \u0915\u0949\u0932 \u0928\u0902\u092c\u0930 \u0921\u093f\u0932\u0940\u091f \u0928 \u0915\u0930\u0947\u0902\u0964 \u0936\u093f\u0915\u093e\u092f\u0924 \u092e\u0947\u0902 \u0907\u0928\u0915\u0940 \u091c\u0930\u0942\u0930\u0924 \u0939\u094b\u0924\u0940 \u0939\u0948\u0964",step4Title:"4. \u092c\u093e\u0915\u0940 \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0915\u092d\u0940 \u0915\u093f\u0938\u0940 \u0915\u094b \u0928 \u092c\u0924\u093e\u090f\u0902",step4Desc:"\u0905\u0938\u0932\u0940 \u092a\u0941\u0932\u093f\u0938 \u092f\u093e \u092c\u0948\u0902\u0915 \u0905\u0927\u093f\u0915\u093e\u0930\u0940 \u0915\u092d\u0940 \u092d\u0940 \u0906\u092a\u0938\u0947 \u0913\u091f\u0940\u092a\u0940, \u092f\u0942\u092a\u0940\u0906\u0908 \u092a\u093f\u0928 \u092f\u093e \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0928\u0939\u0940\u0902 \u092e\u093e\u0902\u0917\u0924\u0947\u0964",warningNeverShare:"\u26a0\ufe0f \u092e\u0939\u0924\u094d\u0935\u092a\u0942\u0930\u094d\u0923 \u091a\u0947\u0924\u093e\u0935\u0928\u0940: \u092c\u0948\u0902\u0915 \u0915\u0930\u094d\u092e\u091a\u093e\u0930\u0940, \u092a\u0941\u0932\u093f\u0938 \u092f\u093e 1930 \u0939\u0947\u0932\u094d\u092a\u0932\u093e\u0907\u0928 \u0915\u092d\u0940 \u092d\u0940 \u0906\u092a\u0938\u0947 \u0913\u091f\u0940\u092a\u0940, \u092f\u0942\u092a\u0940\u0906\u0908 \u092a\u093f\u0928 \u092f\u093e \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0928\u0939\u0940\u0902 \u092e\u093e\u0902\u0917\u0924\u0947\u0964 \u0915\u093f\u0938\u0940 \u0915\u094b \u0928 \u092c\u0924\u093e\u090f\u0902\u0964",noAutoFreezeDisclaimer:"\u26a0\ufe0f \u092e\u0939\u0924\u094d\u0935\u092a\u0942\u0930\u094d\u0923: \u0938\u094d\u0915\u0948\u092e\u0936\u0940\u0932\u094d\u0921 \u0905\u092a\u0928\u0947 \u0906\u092a \u092c\u0948\u0902\u0915 \u0916\u093e\u0924\u093e \u092b\u094d\u0930\u0940\u091c \u092f\u093e \u0915\u0949\u0932 \u0928\u0939\u0940\u0902 \u0915\u0930 \u0938\u0915\u0924\u093e\u0964 \u0906\u092a\u0915\u094b \u0938\u0940\u0927\u0947 \u092c\u0948\u0902\u0915 \u092f\u093e 1930 \u092a\u0930 \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0930\u0928\u093e \u0939\u094b\u0917\u093e\u0964",familyNoticeTitle:"\u092a\u0930\u093f\u091c\u0928\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0906\u092a\u093e\u0924\u0915\u093e\u0932\u0940\u0928 \u0938\u0902\u0926\u0947\u0936",familyNoticeDesc:"\u0905\u092a\u0928\u0947 \u092c\u091a\u094d\u091a\u094b\u0902 \u092f\u093e \u092a\u0930\u093f\u091c\u0928\u094b\u0902 \u0915\u094b \u0924\u0941\u0930\u0902\u0924 \u0938\u0942\u091a\u093f\u0924 \u0915\u0930\u0947\u0902 \u0924\u093e\u0915\u093f \u0935\u0947 \u0924\u0941\u0930\u0902\u0924 \u0906\u092a\u0915\u0940 \u092e\u0926\u0926 \u0915\u0930 \u0938\u0915\u0947\u0902\u0964",templateFraudAlert:"\ud83d\udea8 \u092a\u0930\u093f\u091c\u0928\u094b\u0902 \u0915\u094b \u0927\u094b\u0916\u093e\u0927\u0921\u093c\u0940 \u0915\u0940 \u0906\u092a\u093e\u0924 \u0938\u0942\u091a\u0928\u093e",templateVerifyRequest:"\u2753 \u0938\u0902\u0926\u093f\u0917\u094d\u0927 \u0915\u0949\u0932/\u092e\u0948\u0938\u0947\u091c \u091c\u093e\u0902\u091a\u0928\u0947 \u0915\u093e \u0905\u0928\u0941\u0930\u094b\u0927",familyDetailsPlaceholder:"\u0935\u0948\u0915\u0932\u094d\u092a\u093f\u0915: \u0938\u0902\u0915\u094d\u0937\u0947\u092a \u092e\u0947\u0902 \u092c\u0924\u093e\u090f\u0902 \u0915\u094d\u092f\u093e \u0939\u0941\u0906 (\u0909\u0926\u093e. \u20b95,000 \u0915\u091f\u0947, \u092c\u093f\u091c\u0932\u0940 \u0915\u091f\u0928\u0947 \u0915\u093e \u0915\u0949\u0932 \u0906\u092f\u093e)",shareFamilyNoticeButton:"\ud83d\udce4 \u092a\u0930\u093f\u091c\u0928\u094b\u0902 \u0915\u094b \u0936\u0947\u092f\u0930 \u0915\u0930\u0947\u0902",copyFamilyNoticeButton:"\ud83d\udccb \u0938\u0902\u0926\u0947\u0936 \u091f\u0947\u092e\u094d\u092a\u0932\u0947\u091f \u0915\u0949\u092a\u0940 \u0915\u0930\u0947\u0902",familyNoticeCopied:"\u092a\u0930\u093f\u091c\u0928\u094b\u0902 \u0915\u093e \u0938\u0902\u0926\u0947\u0936 \u0915\u0949\u092a\u0940 \u0939\u094b \u0917\u092f\u093e! \u0907\u0938\u0947 \u0935\u094d\u0939\u093e\u091f\u094d\u0938\u090f\u092a \u092f\u093e \u090f\u0938\u090f\u092e\u090f\u0938 \u092e\u0947\u0902 \u092a\u0947\u0938\u094d\u091f \u0915\u0930\u0947\u0902\u0964",bankDirectoryTitle:"\u092c\u0948\u0902\u0915\u094b\u0902 \u0915\u0947 \u0906\u0927\u093f\u0915\u093e\u0930\u093f\u0915 \u0906\u092a\u093e\u0924\u0915\u093e\u0932\u0940\u0928 \u0928\u0902\u092c\u0930",bankDirectoryDesc:"\u0905\u092a\u0928\u093e \u0921\u0947\u092c\u093f\u091f \u0915\u093e\u0930\u094d\u0921, \u092f\u0942\u092a\u0940\u0906\u0908 \u092f\u093e \u0928\u0947\u091f \u092c\u0948\u0902\u0915\u093f\u0902\u0917 \u0924\u0941\u0930\u0902\u0924 \u0930\u094b\u0915\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0905\u092a\u0928\u0947 \u092c\u0948\u0902\u0915 \u0915\u0947 \u091f\u094b\u0932-\u092b\u094d\u0930\u0940 \u0928\u0902\u092c\u0930 \u092a\u0930 \u0915\u0949\u0932 \u0915\u0930\u0947\u0902\u0964",bankSearchPlaceholder:"\u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u092c\u0948\u0902\u0915 \u0915\u093e \u0928\u093e\u092e \u0916\u094b\u091c\u0947\u0902...",bankNotFoundTitle:"\u0915\u094d\u092f\u093e \u0906\u092a\u0915\u093e \u092c\u0948\u0902\u0915 \u0938\u0942\u091a\u0940 \u092e\u0947\u0902 \u0928\u0939\u0940\u0902 \u0939\u0948?",bankNotFoundDesc:"\u0905\u092a\u0928\u0947 \u092a\u093e\u0938\u092c\u0941\u0915 \u092f\u093e \u0921\u0947\u092c\u093f\u091f \u0915\u093e\u0930\u094d\u0921 \u0915\u0947 \u092a\u0940\u091b\u0947 \u091b\u092a\u0947 \u091f\u094b\u0932-\u092b\u094d\u0930\u0940 \u0928\u0902\u092c\u0930 \u092a\u0930 \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0930\u0947\u0902\u0964 \u0917\u0942\u0917\u0932 \u0938\u0930\u094d\u091a \u0935\u093f\u091c\u094d\u091e\u093e\u092a\u0928\u094b\u0902 \u092e\u0947\u0902 \u0926\u093f\u090f \u092b\u094b\u0928 \u0928\u0902\u092c\u0930\u094b\u0902 \u092a\u0930 \u0915\u092d\u0940 \u092d\u0930\u094b\u0938\u093e \u0928 \u0915\u0930\u0947\u0902\u0964",confirmBankDia