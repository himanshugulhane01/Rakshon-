2\u0964",privacyGuarantee:"\u0917\u093e\u0930\u0902\u091f\u0940: \u0938\u094d\u0915\u0948\u092e\u0936\u0940\u0932\u094d\u0921 \u0915\u092d\u0940 \u0905\u092a\u0928\u0947 \u0906\u092a \u0915\u094b\u0908 \u090f\u0938\u090f\u092e\u090f\u0938 \u0928\u0939\u0940\u0902 \u092d\u0947\u091c\u0924\u093e\u0964 \u0906\u092a \u0938\u094d\u0935\u092f\u0902 \u0938\u0902\u0926\u0947\u0936 \u092a\u0922\u093c\u0915\u0930 \u092d\u0947\u091c\u0924\u0947 \u0939\u0948\u0902\u0964",errorSelectBank:"\u0915\u0943\u092a\u092f\u093e \u0905\u092a\u0928\u0947 \u092c\u0948\u0902\u0915 \u0915\u093e \u0928\u093e\u092e \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902\u0964",errorDigits:"\u0915\u0943\u092a\u092f\u093e \u0916\u093e\u0924\u0947 \u092f\u093e \u0915\u093e\u0930\u094d\u0921 \u0915\u0947 \u0905\u0902\u0924\u093f\u092e 4 \u0905\u0902\u0915 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902\u0964"},familyCircle:{title:"\u092a\u0930\u093f\u0935\u093e\u0930 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0918\u0947\u0930\u093e",subtitle:"\u0938\u0939\u092e\u0924\u093f-\u0906\u0927\u093e\u0930\u093f\u0924 \u092a\u0930\u093f\u091c\u0928 \u0938\u0941\u0930\u0915\u094d\u0937\u093e",consentTitle:"\u0938\u0939\u092e\u0924\u093f-\u092a\u094d\u0930\u0925\u092e \u092a\u0930\u093f\u091c\u0928 \u0938\u0941\u0930\u0915\u094d\u0937\u093e",consentDesc:"\u0905\u092a\u0928\u0947 \u092c\u0947\u091f\u0947, \u092c\u0947\u091f\u0940 \u092f\u093e \u0915\u093f\u0938\u0940 \u0935\u093f\u0936\u094d\u0935\u0938\u0928\u0940\u092f \u092a\u0930\u093f\u091c\u0928 \u0915\u094b \u091c\u094b\u0921\u093c\u0947\u0902\u0964 \u092b\u094b\u0928 \u092a\u0930 \u0917\u0902\u092d\u0940\u0930 \u0920\u0917\u0940 \u0915\u093e \u092a\u094d\u0930\u092f\u093e\u0938 \u0926\u093f\u0916\u0928\u0947 \u092a\u0930 \u0909\u0928\u094d\u0939\u0947\u0902 \u0909\u091a\u094d\u091a-\u0938\u094d\u0924\u0930\u0940\u092f \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0938\u0942\u091a\u0928\u093e \u092e\u093f\u0932\u0947\u0917\u0940\u0964",inviteCardTitle:"\u0