__d(function(e,t,a,i,n,r,o){n.exports={common:{appName:"\u0938\u094d\u0915\u0945\u092e\u0936\u0940\u0932\u094d\u0921 (ScamShield)",safe:"\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924",caution:"\u0938\u093e\u0935\u0927\u093e\u0928",danger:"\u092e\u094b\u0920\u093e \u0927\u094b\u0915\u093e",continue:"\u092a\u0941\u0922\u0947 \u091c\u093e",cancel:"\u0930\u0926\u094d\u0926 \u0915\u0930\u093e",back:"\u092e\u093e\u0917\u0947 \u091c\u093e",language:"\u092d\u093e\u0937\u093e \u092c\u0926\u0932\u093e",notifications:"\u0938\u0942\u091a\u0928\u093e",help:"\u092e\u0926\u0924 \u0939\u0935\u0940 \u0906\u0939\u0947?",loading:"\u0915\u0943\u092a\u092f\u093e \u0925\u093e\u0902\u092c\u093e...",demoModeBadge:"\u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0921\u0947\u092e\u094b \u092e\u094b\u0921"},splash:{tagline:"\u0925\u093e\u0902\u092c\u093e. \u0924\u092a\u093e\u0938\u093e. \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0930\u093e\u0939\u093e.",subTagline:"\u0921\u093f\u091c\u093f\u091f\u0932 \u092b\u0938\u0935\u0923\u0941\u0915\u0940\u092a\u093e\u0938\u0942\u0928 \u0924\u0941\u092e\u091a\u0947 \u0935\u0948\u092f\u0915\u094d\u0924\u093f\u0915 \u0938\u0902\u0930\u0915\u094d\u0937\u0923",loading:"\u0938\u0941\u0930\u0915\u094d\u0937\u093e \u092f\u0902\u0924\u094d\u0930\u0923\u093e \u0938\u0941\u0930\u0942 \u0939\u094b\u0924 \u0906\u0939\u0947..."},onboarding:{skip:"\u0935\u0917\u0933\u093e",continue:"\u092a\u0941\u0922\u0947 \u091c\u093e",getStarted:"\u0938\u0941\u0930\u0942 \u0915\u0930\u093e",slide1Title:"\u092e\u0947\u0938\u0947\u091c \u0917\u093e\u0930\u094d\u0921\u093f\u092f\u0928",slide1Subtitle:"\u092e\u0947\u0938\u0947\u091c \u0936\u0947\u0905\u0930 \u0915\u0930\u093e \u0915\u093f\u0902\u0935\u093e \u0938\u094d\u0915\u094d\u0930\u0940\u0928\u0936\u0949\u091f \u0924\u092a\u093e\u0938\u093e",slide1Desc:"\u0938\u0902\u0936\u092f\u093e\u0938\u094d\u092a\u0926 \u090f\u0938\u090f\u092e\u090f\u0938 \u0915\u093f\u0902\u0935\u093e \u0935\u094d\u0939\u0949\u091f\u094d\u0938\u0972\u092a \u092e\u0947\u0938\u0947\u091c \u0924\u092a\u093e\u0938\u093e. \u092e\u091c\u0915\u0942\u0930 \u0936\u0947\u0905\u0930 \u0915\u0930\u093e, \u092a\u0947\u0938\u094d\u091f \u0915\u0930\u093e \u0915\u093f\u0902\u0935\u093e \u0938\u094d\u0915\u094d\u0930\u0940\u0928\u0936\u0949\u091f \u0938\u094d\u0915\u0945\u0928 \u0915\u0930\u093e. \u0938\u094d\u0915\u0945\u092e\u0936\u0940\u0932\u094d\u0921 \u0915\u0927\u0940\u0939\u0940 \u092c\u0945\u0915\u0917\u094d\u0930\u093e\u0909\u0902\u0921\u092e\u0927\u094d\u092f\u0947 \u0924\u0941\u092e\u091a\u0947 \u0916\u093e\u091c\u0917\u0940 \u092e\u0947\u0938\u0947\u091c \u0935\u093e\u091a\u0924 \u0928\u093e\u0939\u0940.",slide2Title:"\u0915\u0949\u0932 \u0917\u093e\u0930\u094d\u0921\u093f\u092f\u0928",slide2Subtitle:"\u0911\u092b\u0932\u093e\u0907\u0928 \u0915\u0949\u0932 \u0924\u092a\u093e\u0938\u0923\u0940",slide2Desc:"\u0905\u0928\u094b\u0933\u0916\u0940 \u0915\u0949\u0932\u094d\u0938\u091a\u0940 \u092a\u0921\u0924\u093e\u0933\u0923\u0940 \u0911\u092b\u0932\u093e\u0907\u0928 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0921\u0947\u091f\u093e\u092c\u0947\u0938\u092e\u0927\u0942\u0928 \u0915\u0930\u093e. \u0906\u092e\u094d\u0939\u0940 \u0924\u0941\u092e\u091a\u0947 \u0938\u0902\u092d\u093e\u0937\u0923 \u0915\u0927\u0940\u0939\u0940 \u0910\u0915\u0924 \u0928\u093e\u0939\u0940 \u0915\u093f\u0902\u0935\u093e \u0930\u0947\u0915\u0949\u0930\u094d\u0921 \u0915\u0930\u0924 \u0928\u093e\u0939\u0940. \u092f\u093e\u0938\u093e\u0920\u0940 \u0905\u0901\u0921\u094d\u0930\u0949\u0907\u0921 \u0915\u0949\u0932 \u0938\u094d\u0915\u094d\u0930\u0940\u0928\u093f\u0902\u0917 \u092a\u0930\u0935\u093e\u0928\u0917\u0940 \u0906\u0935\u0936\u094d\u092f\u0915 \u0906\u0939\u0947.",slide3Title:"\u0924\u093e\u0924\u0921\u0940\u091a\u0940 \u0939\u0947\u0932\u094d\u092a\u0932\u093e\u0907\u0928 \u0967\u096f\u0969\u0966",slide3Subtitle:"\u0925\u0947\u091f \u0938\u093e\u092f\u092c\u0930 \u0917\u0941\u0928\u094d\u0939\u0947 \u092e\u0926\u0924",slide3Desc:"\u092d\u093e\u0930\u0924 \u0938\u0930\u0915\u093e\u0930\u091a\u094d\u092f\u093e \u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u0938\u093e\u092f\u092c\u0930 \u0917\u0941\u0928\u094d\u0939\u0947 \u0939\u0947\u0932\u094d\u092a\u0932\u093e\u0907\u0928\u0935\u0930 (1930) \u0924\u094d\u0935\u0930\u093f\u0924 \u0915\u0949\u0932 \u0915\u0930\u093e \u0915\u093f\u0902\u0935\u093e \u0905\u0927\u093f\u0915\u0943\u0924 \u092a\u094b\u0930\u094d\u091f\u0932\u0932\u093e (cybercrime.gov.in) \u092d\u0947\u091f \u0926\u094d\u092f\u093e. \u092c\u0901\u0915 \u0916\u093e\u0924\u0947 \u0930\u094b\u0916\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092a\u0942\u0930\u094d\u0935-\u092e\u093e\u0930\u094d\u0917\u0926\u0930\u094d\u0936\u0928."},languageSelect:{title:"\u0906\u092a\u0932\u0940 \u092d\u093e\u0937\u093e \u0928\u093f\u0935\u0921\u093e",subtitle:"\u0924\u0941\u092e\u094d\u0939\u093e\u0932\u093e \u0935\u093e\u091a\u093e\u092f\u0932\u093e \u0906\u0923\u093f \u0910\u0915\u093e\u092f\u0932\u093e \u0938\u094b\u092a\u0940 \u0935\u093e\u091f\u0923\u093e\u0930\u0940 \u092d\u093e\u0937\u093e \u0928\u093f\u0935\u0921\u093e. \u0924\u0941\u092e\u094d\u0939\u0940 \u0924\u0940 \u0928\u0902\u0924\u0930 \u0915\u0927\u0940\u0939\u0940 \u092c\u0926\u0932\u0942 \u0936\u0915\u0924\u093e.",englishLabel:"English (\u0907\u0902\u0917\u094d\u0930\u091c\u0940)",hindiLabel:"\u0939\u093f\u0902\u0926\u0940",marathiLabel:"\u092e\u0930\u093e\u0920\u0940",confirmButton:"\u0928\u093f\u0935\u0921\u0932\u0947\u0932\u094d\u092f\u093e \u092d\u093e\u0937\u0947\u0938\u0939 \u092a\u0941\u0922\u0947 \u091c\u093e"},login:{title:"\u0938\u094d\u0915\u0945\u092e\u0936\u0940\u0932\u094d\u0921\u092e\u0927\u094d\u092f\u0947 \u0906\u092a\u0932\u0947 \u0938\u094d\u0935\u093e\u0917\u0924 \u0906\u0939\u0947",subtitle:"\u0938\u094d\u0935\u0924\u0903\u091a\u0947 \u0906\u0923\u093f \u0915\u0941\u091f\u0941\u0902\u092c\u093e\u091a\u0947 \u0930\u0915\u094d\u0937\u0923 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u09