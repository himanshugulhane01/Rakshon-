\u0915\u093e\u0933\u091c\u0940\u0935\u093e\u0939\u0915",caregiverGuardingSince:"\u092a\u094d\u0930\u0947\u092e\u093e\u0928\u0947 \u0906\u0923\u093f \u0926\u0915\u094d\u0937\u0924\u0947\u0928\u0947 \u0924\u0941\u092e\u091a\u0947 \u0930\u0915\u094d\u0937\u0923 \u0915\u0930\u0924 \u0906\u0939\u0947\u0924.",revokeButton:"\u2715 \u0915\u093e\u0933\u091c\u0940\u0935\u093e\u0939\u0915\u093e\u091a\u093e \u092a\u094d\u0930\u0935\u0947\u0936 \u0930\u0926\u094d\u0926 \u0915\u0930\u093e",revokeConfirmTitle:"\u0915\u093e\u0933\u091c\u0940\u0935\u093e\u0939\u0915\u093e\u091a\u093e \u092a\u094d\u0930\u0935\u0947\u0936 \u0930\u0926\u094d\u0926 \u0915\u0930\u093e\u092f\u091a\u093e \u0915\u093e?",revokeConfirmMessage:"\u0924\u0941\u092e\u094d\u0939\u093e\u0932\u093e {{caregiverName}} \u092f\u093e\u0902\u091a\u093e \u0938\u0902\u092a\u0930\u094d\u0915 \u0930\u0926\u094d\u0926 \u0915\u0930\u093e\u092f\u091a\u093e \u0906\u0939\u0947 \u0915\u093e? \u092f\u093e\u0928\u0902\u0924\u0930 \u0924\u094d\u092f\u093e\u0902\u0928\u093e \u092f\u093e \u0921\u093f\u0935\u094d\u0939\u093e\u0907\u0938\u092c\u093e\u092c\u0924 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0938\u0942\u091a\u0928\u093e \u092e\u093f\u0933\u0923\u093e\u0930 \u0928\u093e\u0939\u0940\u0924.",revokeConfirmAction:"\u092a\u094d\u0930\u0935\u0947\u0936 \u0930\u0926\u094d\u0926 \u0915\u0930\u093e",simulatePairingButton:"\u0915\u093e\u0933\u091c\u0940\u0935\u093e\u0939\u0915 \u091c\u094b\u0921\u0923\u0940\u091a\u093e \u0938\u0930\u093e\u0935 (\u0921\u0947\u092e\u094b)",privacyTitle:"\u091c\u094d\u092f\u0947\u0937\u094d\u0920 \u0928\u093e\u0917\u0930\u093f\u0915\u093e\u0902\u091a\u0940 \u0938\u0902\u092a\u0942\u0930\u094d\u0923 \u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e \u0939\u092e\u0940",privacyWhatCaregiverSeesTitle:"\u0915\u093e\u0933\u091c\u0940\u0935\u093e\u0939\u0915 \u0915\u093e\u092f \u092a\u093e\u0939\u0942 \u0936\u0915\u0924\u093e\u0924:",privacyWhatCaregiverSees1:"\u2022 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0938\u0941\u0930\u0942 \u0906\u0939\u0947 \u0915\u0940 \u0928\u093e\u0939\u0940 \u0906\u0923\u093f \u0921\u0947\u091f\u093e\u092c\u0947\u0938 \u0905\u0926\u094d\u092f\u092f\u093e\u0935\u0924 \u0906\u0939\u0947 \u0915\u0940 \u0928\u093e\u0939\u0940.",privacyWhatCaregiverSees2:"\u2022 \u0917\u0902\u092d\u0940\u0930 \u0935 \u0927\u094b\u0915\u093e\u0926\u093e\u092f\u0915 \u092b\u0938\u0935\u0923\u0942\u0915 \u0915\u0949\u0932 \u0915\u093f\u0902\u0935\u093e \u092e\u0947\u0938\u0947\u091c \u0930\u094b\u0916\u0932\u094d\u092f\u093e\u0935\u0930 \u0938\u093e\u0935\u0927 \u0915\u0930\u0923\u093e\u0930\u0940 \u0938\u0942\u091a\u0928\u093e.",privacyWhatCaregiverNeverSeesTitle:"\u0915\u093e\u0933\u091c\u0940\u0935\u093e\u0939\u0915 \u0915\u0927\u0940\u0939\u0940 \u0915\u093e\u092f \u092a\u093e\u0939\u0942 \u0936\u0915\u0924 \u0928\u093e\u0939\u0940\u0924:",privacyWhatCaregiverNeverSees1:"\u2022 \u0924\u0941\u092e\u091a\u0947 \u0935\u0948\u092f\u0915\u094d\u0924\u093f\u0915 \u090f\u0938\u090f\u092e\u090f\u0938, \u0935\u094d\u0939\u0949\u091f\u094d\u0938\u0972\u092a \u092e\u0947\u0938\u0947\u091c \u0915\u093f\u0902\u0935\u093e \u0938\u0902\u092d\u093e\u0937\u0923 \u0915\u0927\u0940\u0939\u0940 \u0926\u093f\u0938\u0923\u093e\u0930 \u0928\u093e\u0939\u0940.",privacyWhatCaregiverNeverSees2:"\u2022 \u0924\u0941\u092e\u091a\u0947 \u0913\u091f\u0940\u092a\u0940, \u092a\u093f\u0928, \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0915\u093f\u0902\u0935\u093e \u092c\u0901\u0915 \u0936\u093f\u0932\u094d\u0932\u0915 \u0915\u0927\u0940\u0939\u0940 \u0926\u093f\u0938\u0923\u093e\u0930 \u0928\u093e\u0939\u0940.",privacyWhatCaregiverNeverSees3:"\u2022 \u0924\u0941\u092e\u091a\u0947 \u0932\u094b\u0915\u0947\u0936\u0928 \u0915\u093f\u0902\u0935\u093e \u092b\u094b\u0928 \u0915\u0949\u0932 \u0915\u0927\u0940\u0939\u0940 \u091f\u094d\u0930\u0945\u0915 \u0915\u0947\u0932\u0947 \u091c\u093e\u0924 \u0928\u093e\u0939\u0940\u0924.",inviteCardTitle:"\u0935\u093f\u0936\u094d\u0935\u093e\u0938\u0942 \u0928\u093e\u0924\u0947\u0935\u093e\u0908\u0915\u093e\u0932\u093e \u0906\u092e\u0902\u0924\u094d\u0930\u093f\u0924 \u0915\u0930\u093e",caregiverNameLabel:"\u0928\u093e\u0924\u0947\u0935\u093e\u0908\u0915\u093e\u091a\u0947 \u092a\u0942\u0930\u094d\u0923 \u0928\u093e\u0935",caregiverNamePlaceholder:"\u0909\u0926\u093e. \u0930\u093e\u0939\u0941\u0932 \u0936\u0930\u094d\u092e\u093e",caregiverRelationLabel:"\u0928\u093e\u0924\u0947 / \u0938\u0902\u092c\u0902\u0927",caregiverRelationPlaceholder:"\u0909\u0926\u093e. \u092e\u0941\u0932\u0917\u093e, \u092e\u0941\u0932\u0917\u0940, \u0928\u093e\u0924\u0942, \u091c\u094b\u0921\u0940\u0926\u093e\u0930",consentCheckboxLabel:"\u092e\u0940 \u092f\u093e \u0928\u093e\u0924\u0947\u0935\u093e\u0908\u0915\u093e\u0938\u094b\u092c\u0924 \u0917\u0902\u092d\u0940\u0930 \u0938\u093e\u092f\u092c\u0930 \u0907\u0936\u093e\u0930\u0947 \u0906\u0923\u093f \u0936\u093f\u0915\u0923\u094d\u092f\u093e\u091a\u0940 \u092a\u094d\u0930\u0917\u0924\u0940 \u0936\u0947\u0905\u0930 \u0915\u0930\u0923\u094d\u092f\u093e\u0938 \u0938\u094d\u092a\u0937\u094d\u091f \u0938\u0902\u092e\u0924\u0940 \u0926\u0947\u0924\u094b/\u0926\u0947\u0924\u0947.",consentError:"\u0906\u092e\u0902\u0924\u094d\u0930\u0923 \u0924\u092f\u093e\u0930 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0938\u0902\u092e\u0924\u0940 \u091a\u0947\u0915\u092c\u0949\u0915\u094d\u0938 \u0928\u093f\u0935\u0921\u0923\u0947 \u0906\u0935\u0936\u094d\u092f\u0915 \u0906\u0939\u0947.",nameRequiredError:"\u0915\u0943\u092a\u092f\u093e \u0928\u093e\u0924\u0947\u0935\u093e\u0908\u0915\u093e\u091a\u0947 \u0928\u093e\u0935 \u091f\u093e\u0915\u093e.",shareInviteButton:"\ud83d\udce4 \u0935\u094d\u0939\u0949\u091f\u094d\u0938\u0972\u092a / \u090f\u0938\u090f\u092e\u090f\u0938\u0926\u094d\u0935\u093e\u0930\u0947 \u0906\u092e\u0902\u0924\u094d\u0930\u0923 \u092a\u093e\u0920\u0935\u093e",copyCodeButton:"\ud83d\udccb \u0915\u094b\u0921 \u0915\u0949\u092a\u0940 \u0915\u0930\u093e",cloudRelayTitle:"\u0915\u094d\u0932\u093e\u0909\u0921 \u0938\u092e\u0928\u094d\u0935\u092f \u0938\u094d\u0925\u093f\u0924\u0940",cloudRelayStatus:"\u0915\u094d\u0932\u093e\u0909\u0921 \u0930\u093f\u0932\u0947 \u0938\u0930\u094d\u0935\u094d\u0939\u0930: \u0911\u092b\u0932\u093e\u0907\u0928 / \u0938\u094d\u0925\u093e\u0928\u093f\u0915 \u092e\u094b\u0921. \u0930\u093f\u092e\u094b\u091f \u092a\u0941\u0936 \u0938\u0942\u091a\u0928\u093e\u0902\u0938\u093e\u0920\u0940 \u0915\u094d\u0932\u093e\u0909\u0921 \u0938\u0930\u094d\u0935\u094d\u0939\u0930\u091a\u0940 \u0917\u0930\u091c \u0905\u0938\u0924\u0947. \u0938\u094d\u0925\u093e\u0928\u093f\u0915 \u0938\u0902\u092e\u0924\u0940 \u0915\u094b\u0921 \u0938\u0915\u094d\u0930\u093f\u092f \u0906\u0939\u0947.",manualConfirmTitle:"\u091c\u094b\u0921\u0923\u0940\u091a\u0940 \u092e\u0945\u0928\u094d\u092f\u0941\u0905\u0932 \u092a\u0941\u0937\u094d\u091f\u0940 \u0915\u0930\u093e",manualConfirmDesc:"\u0928\u093e\u0924\u0947\u0935\u093e\u0908\u0915\u093e\u0928\u0947 \u0915\u094b\u0921 \u091f\u093e\u0915\u0932\u094d\u092f\u093e\u0938, \u0916\u093e\u0932\u0940\u0932 \u092c\u091f\u0923\u093e\u0928\u0947 \u091c\u094b\u0921\u0923\u0940\u091a\u0940 \u092a\u0941\u0937\u094d\u091f\u0940 \u0915\u0930\u093e:",manualConfirmButton:"\u2713 \u0928\u093e\u0924\u0947\u0935\u093e\u0908\u0915 \u091c\u094b\u0921\u0932\u094d\u092f\u093e\u091a\u0940 \u092a\u0941\u0937\u094d\u091f\u0940 \u0915\u0930\u093e",caregiverRelationDisplay:"\u0928\u093e\u0924\u0947: {{relation}}",pairedAtDisplay:"\u092a\u094d\u0930\u0947\u092e\u093e\u0928\u0947 \u0906\u0923\u093f \u0926\u0915\u094d\u0937\u0924\u0947\u0928\u0947 \u0924\u0941\u092e\u091a\u0947 \u0930\u0915\u094d\u0937\u0923 \u0915\u0930\u0924 \u0906\u0939\u0947\u0924.",minimalSharingTitle:"\u0928\u093e\u0924\u0947\u0935\u093e\u0908\u0915\u093e\u0902\u0936\u0940 \u0915\u093f\u092e\u093e\u0928 \u092e\u093e\u0939\u093f\u0924\u0940\u091a\u0940 \u0926\u0947\u0935\u093e\u0923\u0918\u0947\u0935\u093e\u0923",minimalSharingDesc:"\u0924\u0941\u092e\u091a\u093e \u0938\u0928\u094d\u092e\u093e\u0928 \u0906\u0923\u093f \u0938\u0902\u092a\u0942\u0930\u094d\u0923 \u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e \u091c\u092a\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092b\u0915\u094d\u0924 \u0938\u093e\u0930\u093e\u0902\u0936 \u092a\u093e\u0920\u0935\u0932\u093e \u091c\u093e\u0924\u094b:",sharedItem1:"\u2022 \u0909\u091a\u094d\u091a-\u0927\u094b\u0915\u093e \u092b\u0938\u0935\u0923\u0942\u0915 \u0907\u0936\u093e\u0930\u0947 (\u0915\u0947\u0935\u0933 \u0930\u094b\u0916\u0932\u0947\u0932\u094d\u092f\u093e \u0938\u0902\u0915\u091f\u093e\u091a\u093e \u092a\u094d\u0930\u0915\u093e\u0930)",sharedItem2:"\u2022 \u0938\u094d\u0915\u0945\u092e \u0938\u093f\u092e\u094d\u092f\u0941\u0932\u0947\u091f\u0930 \u0938\u0930\u093e\u0935 \u092a\u094d\u0930\u0917\u0924\u0940 \u0906\u0923\u093f \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924\u0924\u093e \u0917\u0941\u0923"},scamSimulator:{title:"\u0938\u094d\u0915\u0945\u092e \u0938\u093f\u092e\u094d\u092f\u0941\u0932\u0947\u091f\u0930",subtitle:"\u092b\u0938\u0935\u0923\u0942\u0915 \u0913\u0933\u0916\u0923\u094d\u092f\u093e\u091a\u093e \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0938\u0930\u093e\u0935",tabPractice:"\u0938\u0930\u093e\u0935 \u092a\u094d\u0930\u0938\u0902\u0917",tabDashboard:"\u0936\u093f\u0915\u0923\u094d\u092f\u093e\u091a\u0947 \u0921\u0945\u0936\u092c\u094b\u0930\u094d\u0921",progressTitle:"\u0938\u0930\u093e\u0935\u093e\u091a\u0940 \u092a\u094d\u0930\u0917\u0924\u0940",progressCount:"\u092a\u094d\u0930\u0938\u0902\u0917 {{current}} / {{total}}",scoreLabel:"\u092a\u0942\u0930\u094d\u0923 \u0915\u0947\u0932\u0947\u0932\u0947: {{completed}} / {{total}}",scenarioLabel:"\u092a\u094d\u0930\u0938\u0902\u0917 {{number}}: {{title}}",scenarioDescriptionLabel:"\u0938\u0902\u0936\u092f\u093e\u0938\u094d\u092a\u0926 \u092a\u094d\u0930\u0938\u0902\u0917:",questionLabel:"\u0938\u0930\u094d\u0935\u093e\u0924 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u092a\u093e\u090a\u0932 \u0915\u094b\u0923\u0924\u0947?",choiceSafeLabel:"\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0915\u0943\u0924\u0940",choiceDangerLabel:"\u0927\u094b\u0915\u093e\u0926\u093e\u092f\u0915 \u0915\u0943\u0924\u0940",feedbackCorrect:"\u2713 \u092f\u094b\u0917\u094d\u092f \u0935 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0928\u093f\u0930\u094d\u0923\u092f! \u0905\u0924\u093f\u0936\u092f \u091b\u093e\u0928",feedbackIncorrect:"\u26a0\ufe0f \u0938\u093e\u0935\u0927\u093e\u0928! \u0939\u093e \u092b\u0938\u0935\u0923\u0941\u0915\u0940\u091a\u093e \u0938\u093e\u092a\u0933\u093e \u0906\u0939\u0947",explanationTitle:"\u0939\u0940 \u092b\u0938\u0935\u0923\u0942\u0915 \u0915\u093e \u0906\u0939\u0947:",nextScenarioButton:"\u092a\u0941\u0922\u0940\u0932 \u092a\u094d\u0930\u0938\u0902\u0917 \u2192",finishButton:"\ud83c\udf89 \u0938\u0930\u093e\u0935 \u092a\u0942\u0930\u094d\u0923 \u0915\u0930\u093e",restartButton:"\ud83d\udd04 \u0938\u0941\u0930\u0941\u0935\u093e\u0924\u0940\u092a\u093e\u0938\u0942\u0928 \u092a\u0941\u0928\u094d\u0939\u093e \u0938\u0930\u093e\u0935 \u0915\u0930\u093e",viewDashboardButton:"\u0936\u093f\u0915\u0923\u094d\u092f\u093e\u091a\u0947 \u0921\u0945\u0936\u092c\u094b\u0930\u094d\u0921 \u092a\u0939\u093e \ud83d\udcca",completionBannerTitle:"\u0905\u092d\u093f\u0928\u0902\u0926\u0928! \u0938\u0930\u094d\u0935 \u096e \u092a\u094d\u0930\u0938\u0902\u0917\u093e\u0902\u091a\u093e \u0938\u0930\u093e\u0935 \u092a\u0942\u0930\u094d\u0923 \u091d\u093e\u0932\u093e",completionBannerDesc:"\u0924\u0941\u092e\u094d\u0939\u0940 \u092d\u093e\u0930\u0924\u093e\u0924\u0940\u0932 \u0906\u0918\u093e\u0921\u0940\u091a\u094d\u092f\u093e \u096e \u0921\u093f\u091c\u093f\u091f\u0932 \u092b\u0938\u0935\u0923\u0941\u0915\u0940\u091a\u094d\u092f\u093e \u092a\u0926\u094d\u0927\u0924\u0940 (\u0935\u0940\u091c \u0916\u0902\u0921\u093f\u0924 \u0915\u0930\u0923\u094d\u092f\u093e\u091a\u0940 \u0927\u092e\u0915\u0940, \u092c\u0928\u093e\u0935\u091f \u0921\u093f\u091c\u093f\u091f\u0932 \u0905\u091f\u0915, \u0915\u0947\u0935\u093e\u092f\u0938\u0940 \u0932\u093f\u0902\u0915, \u0913\u091f\u0940\u092a\u0940/\u092a\u093f\u0928 \u091a\u094b\u0930\u0940, \u092a\u093e\u0930\u094d\u0938\u0932 \u0921\u093f\u0932\u093f\u0935\u094d\u0939\u0930\u0940 \u092b\u093f\u0936\u093f\u0902\u0917, \u0918\u093e\u0924\u0915 \u090f\u092a\u0940\u0915\u0947, \u0915\u094d\u092f\u0942\u0906\u0930 \u0915\u094b\u0921 \u092b\u0938\u0935\u0923\u0942\u0915, \u0906\u0923\u093f \u092c\u0928\u093e\u0935\u091f \u0915\u0938\u094d\u091f\u092e\u0930 \u0915\u0947\u0905\u0930) \u0913\u0933\u0916\u0923\u094d\u092f\u093e\u0938 \u0936\u093f\u0915\u0932\u093e \u0906\u0939\u093e\u0924.",dashboardTitle:"\u091c\u093e\u0917\u0930\u0942\u0915\u0924\u093e \u0906\u0923\u093f \u0936\u093f\u0915\u0923\u094d\u092f\u093e\u091a\u0947 \u0921\u0945\u0936\u092c\u094b\u0930\u094d\u0921",dashboardSubtitle:"\u0924\u0941\u092e\u091a\u0940 \u0921\u093f\u091c\u093f\u091f\u0932 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0938\u091c\u0917\u0924\u093e \u0906\u0923\u093f \u092a\u094d\u0930\u0917\u0924\u0940",accuracyTitle:"\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0928\u093f\u0930\u094d\u0923\u092f \u0915\u094d\u0937\u092e\u0924\u093e",accuracyScore:"{{accuracy}}% \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0938\u091c\u0917\u0924\u093e",accuracyDetail:"{{total}} \u092a\u0948\u0915\u0940 {{correct}} \u092a\u094d\u0930\u0938\u0902\u0917\u093e\u0902\u092e\u0927\u094d\u092f\u0947 \u092f\u094b\u0917\u094d\u092f \u0928\u093f\u0930\u094d\u0923\u092f \u0918\u0947\u0924\u0932\u093e",completedCount:"{{total}} \u092a\u0948\u0915\u0940 {{completed}} \u0935\u093f\u0937\u092f \u092a\u0942\u0930\u094d\u0923 \u0915\u0947\u0932\u0947",masteredSectionTitle:"\u092f\u0936\u0938\u094d\u0935\u0940\u0930\u0940\u0924\u094d\u092f\u093e \u0938\u092e\u091c\u0932\u0947\u0932\u0947 \u0935\u093f\u0937\u092f",masteredDesc:"\u0924\u0941\u092e\u094d\u0939\u0940 \u092f\u093e \u0915\u094d\u0937\u0947\u0924\u094d\u0930\u093e\u0902\u092e\u0927\u0940\u0932 \u092b\u0938\u0935\u0923\u0942\u0915 \u0905\u091a\u0942\u0915\u092a\u0923\u0947 \u0913\u0933\u0916\u0932\u0940:",improvementSectionTitle:"\u0938\u0930\u093e\u0935 \u0906\u0923\u093f \u0926\u0915\u094d\u0937\u0924\u0947\u091a\u0947 \u0915\u094d\u0937\u0947\u0924\u094d\u0930",improvementDesc:"\u0938\u0941\u0930\u0915\u094d\u0937\u0947\u091a\u0947 \u0939\u0947 \u092e\u0939\u0924\u094d\u0924\u094d\u0935\u093e\u091a\u0947 \u0928\u093f\u092f\u092e \u0932\u0915\u094d\u0937\u093e\u0924 \u0920\u0947\u0935\u093e:",noImprovementsNeeded:"\ud83c\udf1f \u0909\u0924\u094d\u0915\u0943\u0937\u094d\u091f \u091c\u093e\u0917\u0930\u0942\u0915\u0924\u093e! \u0924\u0941\u092e\u094d\u0939\u0940 \u0938\u0930\u094d\u0935 \u0927\u094b\u0915\u0947 \u092f\u094b\u0917\u094d\u092f\u0930\u093f\u0924\u094d\u092f\u093e \u0913\u0933\u0916\u0932\u0947.",practiceMorePrompt:"\u0938\u0924\u0924 \u0938\u0930\u093e\u0935\u093e\u0928\u0947 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0939\u0940 \u0938\u094d\u0935\u093e\u092d\u093e\u0935\u093f\u0915 \u0938\u0935\u092f \u092c\u0928\u0924\u0947. \u0915\u0947\u0935\u094d\u0939\u093e\u0939\u0940 \u092a\u0941\u0928\u094d\u0939\u093e \u0938\u0930\u093e\u0935 \u0915\u0930\u093e.",retakePracticeButton:"\ud83d\udd04 \u092a\u0941\u0928\u094d\u0939\u093e \u0938\u0930\u093e\u0935 \u0915\u0930\u093e",continuePracticeButton:"\ud83c\udfae \u0938\u0930\u093e\u0935 \u0938\u0941\u0930\u0942 \u0920\u0947\u0935\u093e ({{remaining}} \u0936\u093f\u0932\u094d\u0932\u0915)",topicBadge:"\u0935\u093f\u0937\u092f: {{topic}}"},callGuardian:{title:"\u0915\u0949\u0932 \u0917\u093e\u0930\u094d\u0921\u093f\u092f\u0928",subtitle:"\u0911\u092b\u0932\u093e\u0907\u0928 \u0915\u0949\u0932 \u0924\u092a\u093e\u0938\u0923\u0940",status:"\u0911\u092b\u0932\u093e\u0907\u0928 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0921\u0947\u091f\u093e\u092c\u0947\u0938 \u0938\u0941\u0930\u0942",screenIncoming:"\u0938\u0902\u0936\u092f\u093e\u0938\u094d\u092a\u0926 \u0915\u0949\u0932\u091a\u0940 \u0938\u094d\u0935\u092f\u0902\u091a\u0932\u093f\u0924 \u0924\u092a\u093e\u0938\u0923\u0940",lastSynced:"\u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0921\u0947\u091f\u093e\u092c\u0947\u0938: \u0905\u0926\u094d\u092f\u092f\u093e\u0935\u0924 \u0906\u0939\u0947",statusCardTitle:"\u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0921\u0947\u091f\u093e\u092c\u0947\u0938 \u0938\u094d\u0925\u093f\u0924\u0940",statusSynced:"\u0921\u0947\u091f\u093e\u092c\u0947\u0938 \u0905\u0926\u094d\u092f\u092f\u093e\u0935\u0924 \u0906\u0939\u0947",statusOutdated:"\u0921\u0947\u091f\u093e\u092c\u0947\u0938 \u091c\u0941\u0928\u093e \u0906\u0939\u0947 (\u0905\u092a\u0921\u0947\u091f \u0906\u0935\u0936\u094d\u092f\u0915)",statusNotSynced:"\u0905\u0926\u094d\u092f\u093e\u092a \u0938\u093f\u0902\u0915 \u091d\u093e\u0932\u0947 \u0928\u093e\u0939\u0940",threatCount:"{{count}} \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u092b\u0938\u0935\u0923\u0942\u0915 \u0928\u0902\u092c\u0930 \u0938\u0915\u094d\u0930\u093f\u092f",zeroThreats:"\u0966 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0927\u094b\u0915\u0947 \u0938\u093e\u0920\u0935\u0932\u0947 \u0906\u0939\u0947\u0924",lastSyncLabel:"\u0936\u0947\u0935\u091f\u091a\u093e \u0938\u093f\u0902\u0915: ",neverSynced:"\u0915\u0927\u0940\u0939\u0940 \u0938\u093f\u0902\u0915 \u091d\u093e\u0932\u0947 \u0928\u093e\u0939\u0940",syncButton:"\ud83d\udd04 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0921\u0947\u091f\u093e\u092c\u0947\u0938 \u0938\u093f\u0902\u0915 \u0915\u0930\u093e",syncing:"\u0921\u0947\u091f\u093e\u092c\u0947\u0938 \u0938\u093f\u0902\u0915 \u0915\u0930\u0924 \u0906\u0939\u094b\u0924...",syncSuccess:"\u0921\u0947\u091f\u093e\u092c\u0947\u0938 \u092f\u0936\u0938\u094d\u0935\u0940\u0930\u093f\u0924\u094d\u092f\u093e \u0938\u093f\u0902\u0915 \u091d\u093e\u0932\u093e!",syncError:"\u0938\u093f\u0902\u0915 \u0905\u092f\u0936\u0938\u094d\u0935\u0940: ",safeByDefaultTitle:"\u0905\u0928\u094b\u0933\u0916\u0940 \u0915\u0949\u0932 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0927\u094b\u0930\u0923",safeByDefaultDesc:"\u0905\u0928\u094b\u0933\u0916\u0940 \u0928\u0902\u092c\u0930\u0935\u0930\u0942\u0928 \u092f\u0947\u0923\u093e\u0930\u0947 \u0915\u0949\u0932\u094d\u0938 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u092e\u093e\u0928\u0932\u0947 \u091c\u093e\u0924\u093e\u0924 \u091c\u0947\u0923\u0947\u0915\u0930\u0942\u0928 \u0921\u0949\u0915\u094d\u091f\u0930 \u0915\u093f\u0902\u0935\u093e \u0928\u093e\u0924\u0947\u0935\u093e\u0908\u0915\u093e\u0902\u091a\u0947 \u0915\u0949\u0932\u094d\u0938 \u091a\u0941\u0915\u0923\u093e\u0930 \u0928\u093e\u0939\u0940\u0924. \u0915\u0947\u0935\u0933 \u092a\u094d\u0930\u092e\u093e\u0923\u093f\u0924 \u092b\u0938\u0935\u0923\u0942\u0915 \u0928\u0902\u092c\u0930\u091a \u0930\u094b\u0916\u0932\u0947 \u091c\u093e\u0924\u093e\u0924.",spoofingWarningTitle:"\u0915\u0949\u0932\u0930 \u0906\u092f\u0921\u0940 \u0915\u094d\u0932\u094b\u0928\u093f\u0902\u0917 \u091a\u0947\u0924\u093e\u0935\u0923\u0940",spoofingWarningDesc:"\u0917\u0941\u0928\u094d\u0939\u0947\u0917\u093e\u0930 \u092c\u0928\u093e\u0935\u091f \u0915\u0949\u0932\u0930 \u0906\u092f\u0921\u0940 \u0935\u093e\u092a\u0930\u0942 \u0936\u0915\u0924\u093e\u0924. \u0905\u0928\u094b\u0933\u0916\u0940 \u0935\u094d\u092f\u0915\u094d\u0924\u0940 \u092c\u0901\u0915 \u0915\u093f\u0902\u0935\u093e \u092a\u094b\u0932\u0940\u0938 \u092e\u094d\u0939\u0923\u0942\u0928 \u092c\u094b\u0932\u0924 \u0905\u0938\u0932\u094d\u092f\u093e\u0938 \u092b\u094b\u0928 \u092c\u0902\u0926 \u0915\u0930\u0942\u0928 \u0905\u0927\u093f\u0915\u0943\u0924 \u0928\u0902\u092c\u0930\u0935\u0930 \u0938\u0902\u092a\u0930\u094d\u0915 \u0938\u093e\u0927\u093e.",noAudioListenTitle:"\u0915\u0949\u0932 \u0938\u0902\u092d\u093e\u0937\u0923\u093e\u091a\u0940 \u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e",noAudioListenDesc:"\u0938\u094d\u0915\u0945\u092e\u0936\u0940\u0932\u094d\u0921 \u0924\u0941\u092e\u091a\u0947 \u0915\u094b\u0923\u0924\u0947\u0939\u0940 \u092b\u094b\u0928 \u0938\u0902\u092d\u093e\u0937\u0923 \u0915\u0927\u0940\u0939\u0940 \u0910\u0915\u0924 \u0928\u093e\u0939\u0940 \u0915\u093f\u0902\u0935\u093e \u0930\u0947\u0915\u0949\u0930\u094d\u0921 \u0915\u0930\u0924 \u0928\u093e\u0939\u0940.",callHistoryTitle:"\u0915\u0949\u0932 \u0907\u0924\u093f\u0939\u093e\u0938 \u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e",callHistoryDesc:"\u092f\u093e \u0921\u093f\u0935\u094d\u0939\u093e\u0907\u0938\u0935\u0930 \u0915\u0949\u0932 \u0907\u0924\u093f\u0939\u093e\u0938 \u092a\u093e\u0939\u093f\u0932\u093e \u0915\u093f\u0902\u0935\u093e \u0938\u093e\u0920\u0935\u0932\u093e \u091c\u093e\u0924 \u0928\u093e\u0939\u0940. \u0924\u092a\u093e\u0938\u0923\u0940 \u092a\u0942\u0930\u094d\u0923\u092a\u0923\u0947 \u0911\u092b\u0932\u093e\u0907\u0928 \u092b\u094b\u0928 \u0935\u093e\u091c\u0924\u093e\u0928\u093e \u0939\u094b\u0924\u0947."},scamLens:{title:"\u0938\u094d\u0915\u0945\u092e \u0932\u0947\u0928\u094d\u0938",subtitle:"\u0915\u094d\u092f\u0942\u0906\u0930 \u0915\u094b\u0921 \u0906\u0923\u093f \u0915\u093e\u0917\u0926\u092a\u0924\u094d\u0930 \u0924\u092a\u093e\u0938\u0923\u0940",tabQr:"\u0915\u094d\u092f\u0942\u0906\u0930 \u0915\u094b\u0921 \u0924\u092a\u093e\u0938\u0923\u0940",tabDocument:"\u0915\u093e\u0917\u0926\u0940 \u092a\u0924\u094d\u0930 / \u0928\u094b\u091f\u0940\u0938",qrInputLabel:"\u0915\u094d\u092f\u0942\u0906\u0930 \u0915\u094b\u0921 \u092e\u091c\u0915\u0942\u0930 \u0915\u093f\u0902\u0935\u093e \u0932\u093f\u0902\u0915",qrInputPlaceholder:"\u0921\u093f\u0915\u094b\u0921 \u0915\u0947\u0932\u0947\u0932\u093e \u0915\u094d\u092f\u0942\u0906\u0930 \u092e\u091c\u0915\u0942\u0930 (\u092f\u0942\u092a\u0940\u0906\u092f \u0915\u093f\u0902\u0935\u093e \u0935\u0947\u092c\u0938\u093e\u0907\u091f) \u092f\u0947\u0925\u0947 \u091f\u093e\u0915\u093e...",pasteQrButton:"\ud83d\udccb \u0915\u094d\u092f\u0942\u0906\u0930 \u092e\u091c\u0915\u0942\u0930 \u092a\u0947\u0938\u094d\u091f \u0915\u0930\u093e",clearButton:"\u2715 \u0915\u093e\u0922\u093e",inspectQrButton:"\ud83d\udd0d \u0915\u094d\u092f\u0942\u0906\u0930 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0924\u092a\u093e\u0938\u093e",sampleUpiButton:"\u0938\u0902\u0936\u092f\u093e\u0938\u094d\u092a\u0926 \u092f\u0942\u092a\u0940\u0906\u092f \u0909\u0926\u093e\u0939\u0930\u0923",sampleUrlButton:"\u0938\u0902\u0936\u092f\u093e\u0938\u094d\u092a\u0926 \u0932\u093f\u0902\u0915 \u0909\u0926\u093e\u0939\u0930\u0923",qrResultTitle:"\u0915\u094d\u092f\u0942\u0906\u0930 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0928\u093f\u0915\u093e\u0932",upiRecipientLabel:"\u092a\u094d\u0930\u093e\u092a\u094d\u0924\u0915\u0930\u094d\u0924\u093e \u092f\u0942\u092a\u0940\u0906\u092f \u0906\u092f\u0921\u0940",upiNameLabel:"\u092a\u094d\u0930\u093e\u092a\u094d\u0924\u0915\u0930\u094d\u0924\u094d\u092f\u093e\u091a\u0947 \u0928\u093e\u0935",upiAmountLabel:"\u092e\u093e\u0917\u093f\u0924\u0932\u0947\u0932\u0940 \u0930\u0915\u094d\u0915\u092e",upiNoteLabel:"\u0928\u094b\u0902\u0926",noPaymentWarning:"\u092e\u0939\u0924\u094d\u0924\u094d\u0935\u093e\u091a\u0947: \u0915\u094d\u092f\u0942\u0906\u0930 \u0915\u094b\u0921 \u0938\u094d\u0915\u0945\u0928 \u0915\u0947\u0932\u094d\u092f\u093e\u0928\u0947 \u0915\u0947\u0935\u0933 \u092a\u0948\u0938\u0947 \u092a\u093e\u0920\u0935\u0932\u0947 \u091c\u093e\u0924\u093e\u0924. \u092a\u0948\u0938\u0947 \u092e\u093f\u0933\u0935\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0915\u0927\u0940\u0939\u0940 \u0915\u094d\u092f\u0942\u0906\u0930 \u0938\u094d\u0915\u0945\u0928 \u0915\u0930\u0942 \u0928\u0915\u093e.",noAutoOpenNotice:"\u0938\u094d\u0915\u0945\u092e\u0936\u0940\u0932\u094d\u0921 \u0915\u0927\u0940\u0939\u0940 \u0932\u093f\u0902\u0915 \u0906\u092a\u094b\u0906\u092a \u0909\u0918\u0921\u0924 \u0928\u093e\u0939\u0940 \u0915\u093f\u0902\u0935\u093e \u092a\u0947\u092e\u0947\u0902\u091f \u0938\u0941\u0930\u0942 \u0915\u0930\u0924 \u0928\u093e\u0939\u0940.",documentInputLabel:"\u0915\u093e\u0917\u0926\u092a\u0924\u094d\u0930 \u0915\u093f\u0902\u0935\u093e \u0928\u094b\u091f\u0940\u0938 \u092e\u091c\u0915\u0942\u0930",documentInputPlaceholder:"\u0935\u0940\u091c \u092c\u093f\u0932, \u0915\u094b\u0930\u094d\u091f \u0928\u094b\u091f\u0940\u0938 \u0915\u093f\u0902\u0935\u093e \u092a\u0924\u094d\u0930\u093e\u091a\u093e \u092e\u091c\u0915\u0942\u0930 \u092f\u0947\u0925\u0947 \u0932\u093f\u0939\u093e \u0915\u093f\u0902\u0935\u093e \u092a\u0947\u0938\u094d\u091f \u0915\u0930\u093e...",inspectDocumentButton:"\ud83d\udd0d \u092b\u0938\u0935\u0923\u0941\u0915\u0940\u091a\u0947 \u0938\u0902\u0915\u0947\u0924 \u0924\u092a\u093e\u0938\u093e",sampleNoticeButton:"\u092c\u0928\u093e\u0935\u091f \u0935\u0940\u091c \u092a\u0924\u094d\u0930\u093e\u091a\u0947 \u0909\u0926\u093e\u0939\u0930\u0923",ocrUnavailableNotice:"\u0915\u0945\u092e\u0947\u0930\u093e \u0913\u0938\u0940\u0906\u0930 \u090f\u092a\u0940\u0915\u0947 \u092e\u0927\u094d\u092f\u0947 \u0938\u0915\u094d\u0930\u093f\u092f \u0906\u0939\u0947. \u0915\u0943\u092a\u092f\u093e \u092a\u0924\u094d\u0930\u093e\u0924\u0940\u0932 \u092e\u091c\u0915\u0942\u0930 \u0916\u093e\u0932\u0940 \u0932\u093f\u0939\u093e \u0915\u093f\u0902\u0935\u093e \u092a\u0947\u0938\u094d\u091f \u0915\u0930\u093e.",documentResultTitle:"\u0915\u093e\u0917\u0926\u092a\u0924\u094d\u0930 \u092b\u0938\u0935\u0923\u0942\u0915 \u0924\u092a\u093e\u0938\u0923\u0940 \u0928\u093f\u0915\u093e\u0932",errorEmpty:"\u0915\u0943\u092a\u092f\u093e \u0924\u092a\u093e\u0938\u0923\u094d\u092f\u093e\u092a\u0942\u0930\u094d\u0935\u0940 \u0915\u094d\u092f\u0942\u0906\u0930 \u0915\u093f\u0902\u0935\u093e \u0915\u093e\u0917\u0926\u092a\u0924\u094d\u0930\u093e\u091a\u093e \u092e\u091c\u0915\u0942\u0930 \u091f\u093e\u0915\u093e."},messageGuardian:{title:"\u092e\u0947\u0938\u0947\u091c \u0917\u093e\u0930\u094d\u0921\u093f\u092f\u0928",subtitle:"\u0938\u0902\u0936\u092f\u093e\u0938\u094d\u092a\u0926 \u092e\u0947\u0938\u0947\u091c \u0915\u093f\u0902\u0935\u093e \u0935\u094d\u0939\u0949\u091f\u094d\u0938\u0972\u092a \u0924\u092a\u093e\u0938\u093e",inputLabel:"\u092e\u0947\u0938\u0947\u091c \u092e\u091c\u0915\u0942\u0930",inputPlaceholder:"\u0938\u0902\u0936\u092f\u093e\u0938\u094d\u092a\u0926 \u092e\u0947\u0938\u0947\u091c \u092f\u0947\u0925\u0947 \u092a\u0947\u0938\u094d\u091f \u0915\u0930\u093e \u0915\u093f\u0902\u0935\u093e \u091f\u093e\u0908\u092a \u0915\u0930\u093e...",pasteButton:"\ud83d\udccb \u092e\u0947\u0938\u0947\u091c \u092a\u0947\u0938\u094d\u091f \u0915\u0930\u093e",clearButton:"\u2715 \u092e\u091c\u0915\u0942\u0930 \u0915\u093e\u0922\u093e",analyzeButton:"\ud83d\udd0d \u092e\u0947\u0938\u0947\u091c \u0924\u092a\u093e\u0938\u093e",analyzing:"\u092b\u0938\u0935\u0923\u0941\u0915\u0940\u091a\u0947 \u0938\u0902\u0915\u0947\u0924 \u0924\u092a\u093e\u0938\u0924 \u0906\u0939\u094b\u0924...",screenshotNoticeTitle:"\u0938\u094d\u0915\u094d\u0930\u0940\u0928\u0936\u0949\u091f \u0906\u0923\u093f \u0936\u0947\u0905\u0930\u093f\u0902\u0917 \u092a\u0930\u094d\u092f\u093e\u092f",screenshotNoticeDesc:"\u0924\u0941\u092e\u094d\u0939\u0940 \u0935\u094d\u0939\u0949\u091f\u094d\u0938\u0972\u092a \u0915\u093f\u0902\u0935\u093e \u090f\u0938\u090f\u092e\u090f\u0938\u092e\u0927\u0942\u0928 \u092e\u0947\u0938\u0947\u091c \u0925\u0947\u091f \u0938\u094d\u0915\u0945\u092e\u0936\u0940\u0932\u094d\u0921\u092e\u0927\u094d\u092f\u0947 \u0936\u0947\u0905\u0930 \u0915\u0930\u0942 \u0936\u0915\u0924\u093e \u0915\u093f\u0902\u0935\u093e \u0938\u094d\u0915\u094d\u0930\u0940\u0928\u0936\u0949\u091f \u0928\u093f\u0935\u0921\u0942 \u0936\u0915\u0924\u093e.",pickScreenshotButton:"\ud83d\udcf7 \u0938\u094d\u0915\u094d\u0930\u0940\u0928\u0936\u0949\u091f \u0928\u093f\u0935\u0921\u093e",ocrPreparationNotice:"\u0921\u093f\u0935\u094d\u0939\u093e\u0907\u0938 \u0913\u0938\u0940\u0906\u0930 \u090f\u092a\u0940\u0915\u0947 \u092e\u0927\u094d\u092f\u0947 \u0909\u092a\u0932\u092c\u094d\u0927 \u0906\u0939\u0947. \u0924\u0941\u092e\u094d\u0939\u0940 \u0938\u094d\u0915\u094d\u0930\u0940\u0928\u0936\u0949\u091f\u092e\u0927\u0940\u0932 \u092e\u091c\u0915\u0942\u0930 \u092a\u0947\u0938\u094d\u091f \u0926\u0947\u0916\u0940\u0932 \u0915\u0930\u0942 \u0936\u0915\u0924\u093e.",privacyPill:"\u0936\u0942\u0928\u094d\u092f \u090f\u0938\u090f\u092e\u090f\u0938 \u092a\u0930\u0935\u093e\u0928\u0917\u0940",privacyNote:"\u0938\u094d\u0915\u0945\u092e\u0936\u0940\u0932\u094d\u0921 \u0915\u0927\u0940\u0939\u0940 \u092c\u0945\u0915\u0917\u094d\u0930\u093e\u0909\u0902\u0921\u092e\u0927\u094d\u092f\u0947 \u0924\u0941\u092e\u091a\u0947 \u092e\u0947\u0938\u0947\u091c \u0935\u093e\u091a\u0924 \u0928\u093e\u0939\u0940. \u0915\u093e\u092f \u0924\u092a\u093e\u0938\u093e\u092f\u091a\u0947 \u0939\u0947 \u0924\u0941\u092e\u094d\u0939\u0940 \u0920\u0930\u0935\u0924\u093e.",errorEmpty:"\u0915\u0943\u092a\u092f\u093e \u0924\u092a\u093e\u0938\u0923\u094d\u092f\u093e\u092a\u0942\u0930\u094d\u0935\u0940 \u092e\u0947\u0938\u0947\u091c \u091f\u093e\u0915\u093e \u0915\u093f\u0902\u0935\u093e \u092a\u0947\u0938\u094d\u091f \u0915\u0930\u093e.",errorTooLong:"\u092e\u0947\u0938\u0947\u091c \u0968,\u0966\u0966\u0966 \u0905\u0915\u094d\u0937\u0930\u093e\u0902\u092a\u0947\u0915\u094d\u0937\u093e \u092e\u094b\u0920\u093e \u0906\u0939\u0947.",retryButton:"\ud83d\udd04 \u092a\u0941\u0928\u094d\u0939\u093e \u092a\u094d\u0930\u092f\u0924\u094d\u0928 \u0915\u0930\u093e"},analysisResult:{title:"\u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0924\u092a\u093e\u0938\u0923\u0940 \u0928\u093f\u0915\u093e\u0932",safeTitle:"\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0906\u0923\u093f \u0916\u0930\u093e",cautionTitle:"\u0938\u093e\u0935\u0927\u093e\u0928\u0924\u093e \u092c\u093e\u0933\u0917\u093e",dangerTitle:"\u092e\u094b\u0920\u093e \u092b\u0938\u0935\u0923\u0941\u0915\u0940\u091a\u093e \u0927\u094b\u0915\u093e \u0906\u0922\u0933\u0932\u093e",riskScoreLabel:"\u0905\u0902\u0926\u093e\u091c\u093f\u0924 \u0927\u094b\u0915\u093e \u0917\u0941\u0923 (Score)",riskScoreDisclaimer:"\u0939\u093e \u0928\u093f\u092f\u092e\u093e\u0902\u0935\u0930 \u0906\u0927\u093e\u0930\u093f\u0924 \u0938\u094d\u0915\u094b\u0905\u0930 (\u0966 \u0924\u0947 \u0967\u0966\u0966) \u0906\u0939\u0947, \u0915\u094b\u0923\u0924\u0940\u0939\u0940 \u0939\u092e\u0940 \u0928\u093e\u0939\u0940.",explanationSectionTitle:"\u0924\u092a\u093e\u0938\u0923\u0940\u091a\u093e \u0928\u093f\u0937\u094d\u0915\u0930\u094d\u0937",indicatorsSectionTitle:"\u0906\u0922\u0933\u0932\u0947\u0932\u0947 \u091a\u0947\u0924\u093e\u0935\u0923\u0940 \u0938\u0902\u0915\u0947\u0924",noIndicators:"\u092f\u093e \u092e\u0947\u0938\u0947\u091c\u092e\u0927\u094d\u092f\u0947 \u0915\u094b\u0923\u0924\u093e\u0939\u0940 \u0938\u0902\u0936\u092f\u093e\u0938\u094d\u092a\u0926 \u0938\u0902\u0915\u0947\u0924 \u0906\u0922\u0933\u0932\u093e \u0928\u093e\u0939\u0940.",actionsSectionTitle:"\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0930\u093e\u0939\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092a\u0941\u0922\u0940\u0932 \u092a\u093e\u092f\u0931\u094d\u092f\u093e",disclaimerTitle:"\u092e\u0939\u0924\u094d\u0924\u094d\u0935\u093e\u091a\u0940 \u0938\u0942\u091a\u0928\u093e",copyAdviceButton:"\ud83d\udccb \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0938\u0932\u094d\u0932\u093e \u0915\u0949\u092a\u0940 \u0915\u0930\u093e",adviceCopied:"\u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0938\u0932\u094d\u0932\u093e \u0915\u0949\u092a\u0940 \u091d\u093e\u0932\u093e!",analyzeAnotherButton:"\ud83d\udd0d \u0926\u0941\u0938\u0930\u093e \u092e\u0947\u0938\u0947\u091c \u0924\u092a\u093e\u0938\u093e",returnHomeButton:"\ud83c\udfe0 \u092e\u0941\u0916\u094d\u092f \u092a\u0943\u0937\u094d\u0920\u093e\u0935\u0930 \u091c\u093e",emergencyButton:"\ud83d\udea8 \u0938\u093e\u092f\u092c\u0930 \u0939\u0947\u0932\u094d\u092a\u0932\u093e\u0907\u0928 (\u0967\u096f\u0969\u0966) \u0935\u0930 \u0915\u0949\u0932 \u0915\u0930\u093e",otpLegitNotice:"\u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0938\u0942\u091a\u0928\u093e: \u0913\u091f\u0940\u092a\u0940\u091a\u093e \u0909\u0932\u094d\u0932\u0947\u0916 \u0906\u0922\u0933\u0932\u093e \u0906\u0939\u0947, \u092a\u0930\u0902\u0924\u0941 \u0915\u094b\u0923\u0924\u0940\u0939\u0940 \u092b\u0938\u0935\u0923\u0942\u0915 \u0906\u0922\u0933\u0932\u0940 \u0928\u093e\u0939\u0940. \u0906\u092a\u0932\u093e \u0913\u091f\u0940\u092a\u0940 \u0915\u094b\u0923\u093e\u0932\u093e\u0939\u0940 \u0938\u093e\u0902\u0917\u0942 \u0928\u0915\u093e."},voiceGuardian:{title:"\u0935\u094d\u0939\u0949\u0907\u0938 \u0917\u093e\u0930\u094d\u0921\u093f\u092f\u0928",subtitle:"\u092c\u094b\u0932\u0942\u0928 \u0938\u0902\u0926\u0947\u0936 \u0924\u092a\u093e\u0938\u093e \u0906\u0923\u093f \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0938\u0932\u094d\u0932\u093e \u0910\u0915\u093e",micButtonStart:"\ud83c\udfa4 \u092c\u094b\u0932\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u091f\u0945\u092a \u0915\u0930\u093e",micButtonStop:"\u23f9\ufe0f \u0910\u0915\u0923\u0947 \u0925\u093e\u0902\u092c\u0935\u093e",stateIdle:"\u092c\u094b\u0932\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0938\u091c\u094d\u091c",stateListening:"\u0910\u0915\u0924 \u0906\u0939\u094b\u0924... \u0924\u0941\u092e\u091a\u093e \u0938\u0902\u0926\u0947\u0936 \u0938\u094d\u092a\u0937\u094d\u091f \u092c\u094b\u0932\u093e",stateProcessing:"\u0924\u0941\u092e\u091a\u093e \u0906\u0935\u093e\u091c \u092e\u091c\u0915\u0941\u0930\u093e\u0924 \u092c\u0926\u0932\u0924 \u0906\u0939\u094b\u0924...",stateSpeaking:"\u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0938\u0932\u094d\u0932\u093e \u0910\u0915\u0935\u0924 \u0906\u0939\u094b\u0924...",stateError:"\u0906\u0935\u093e\u091c \u0924\u094d\u0930\u0941\u091f\u0940",transcriptionSectionTitle:"\u092c\u094b\u0932\u0932\u0947\u0932\u093e \u0938\u0902\u0926\u0947\u0936",transcriptionPlaceholder:"\u0924\u0941\u092e\u094d\u0939\u0940 \u092c\u094b\u0932\u0932\u0947\u0932\u0947 \u0936\u092c\u094d\u0926 \u092f\u0947\u0925\u0947 \u0926\u093f\u0938\u0924\u0940\u0932. \u0924\u092a\u093e\u0938\u0923\u094d\u092f\u093e\u092a\u0942\u0930\u094d\u0935\u0940 \u0924\u0941\u092e\u094d\u0939\u0940 \u0924\u0947 \u0935\u093e\u091a\u0942 \u0936\u0915\u0924\u093e.",reviewInstruction:"\u0935\u0930\u0940\u0932 \u0938\u0902\u0926\u0947\u0936 \u0928\u0940\u091f \u0924\u092a\u093e\u0938\u093e. \u0938\u094d\u0915\u0945\u092e\u0936\u0940\u0932\u094d\u0921 \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0938\u0902\u092e\u0924\u0940\u0936\u093f\u0935\u093e\u092f \u0915\u0927\u0940\u0939\u0940 \u0938\u0902\u0926\u0947\u0936 \u092a\u093e\u0920\u0935\u0924 \u0928\u093e\u0939\u0940.",clearText:"\u2715 \u0938\u0902\u0926\u0947\u0936 \u092a\u0941\u0938\u093e",analyzeButton:"\ud83d\udd0d \u092c\u094b\u0932\u0932\u0947\u0932\u094d\u092f\u093e \u0938\u0902\u0926\u0947\u0936\u093e\u091a\u0940 \u0924\u092a\u093e\u0938\u0923\u0940 \u0915\u0930\u093e",analyzing:"\u092b\u0938\u0935\u0923\u0942\u0915 \u0918\u091f\u0915\u093e\u0902\u091a\u0940 \u0924\u092a\u093e\u0938\u0923\u0940 \u0915\u0930\u0924 \u0906\u0939\u094b\u0924...",quickSamplesTitle:"\u0906\u0935\u093e\u091c\u093e\u091a\u093e \u0928\u092e\u0941\u0928\u093e \u0935\u093e\u092a\u0930\u0942\u0928 \u092a\u0939\u093e",sampleElectricity:"\u26a1 \u0935\u0940\u091c \u0924\u094b\u0921\u0923\u094d\u092f\u093e\u091a\u0940 \u0927\u092e\u0915\u0940",samplePolice:"\ud83d\udea8 \u0921\u093f\u091c\u093f\u091f\u0932 \u0905\u091f\u0915 \u0935\u094d\u0939\u093f\u0921\u093f\u0913 \u0915\u0949\u0932",sampleOtp:"\ud83c\udfe6 \u092c\u0901\u0915 \u0916\u093e\u0924\u0947 \u092a\u0921\u0924\u093e\u0933\u0923\u0940",fallbackTitle:"\u091f\u093e\u0908\u092a \u0915\u0930\u0942\u0928 \u0938\u0902\u0926\u0947\u0936 \u091f\u093e\u0915\u0923\u094d\u092f\u093e\u091a\u093e \u092a\u0930\u094d\u092f\u093e\u092f",fallbackSubtitle:"\u0906\u0935\u093e\u091c \u0910\u0915\u0923\u094d\u092f\u093e\u0924 \u0905\u0921\u091a\u0923 \u092f\u0947\u0924 \u0905\u0938\u0932\u094d\u092f\u093e\u0938 \u0915\u093f\u0902\u0935\u093e \u0906\u091c\u0942\u092c\u093e\u091c\u0942\u0932\u093e \u0917\u094b\u0902\u0917\u093e\u091f \u0905\u0938\u0932\u094d\u092f\u093e\u0938 \u0924\u0941\u092e\u094d\u0939\u0940 \u0925\u0947\u091f \u0938\u0902\u0926\u0947\u0936 \u091f\u093e\u0908\u092a \u0915\u093f\u0902\u0935\u093e \u092a\u0947\u0938\u094d\u091f \u0915\u0930\u0942 \u0936\u0915\u0924\u093e.",listenAdviceButton:"\ud83d\udd0a \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0938\u0932\u094d\u0932\u093e \u0910\u0915\u093e",stopAdviceButton:"\u23f9\ufe0f \u092c\u094b\u0932\u0923\u0947 \u0925\u093e\u0902\u092c\u0935\u093e",permissionRationaleTitle:"\u092e\u093e\u092f\u0915\u094d\u0930\u094b\u092b\u094b\u0928 \u092a\u0930\u0935\u093e\u0928\u0917\u0940 \u0906\u0935\u0936\u094d\u092f\u0915",permissionRationaleDesc:"\u0938\u094d\u0915\u0945\u092e\u0936\u0940\u0932\u094d\u0921\u0932\u093e \u092e\u093e\u092f\u0915\u094d\u0930\u094b\u092b\u094b\u0928 \u0915\u0947\u0935\u0933 \u0924\u0941\u092e\u094d\u0939\u0940 \u092c\u094b\u0932\u0932\u0947\u0932\u093e \u0938\u0902\u0926\u0947\u0936 \u0932\u093f\u0939\u093f\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0939\u0935\u093e \u0906\u0939\u0947. \u0906\u092e\u094d\u0939\u0940 \u092b\u094b\u0928 \u0915\u0949\u0932\u094d\u0938 \u0910\u0915\u0924 \u0928\u093e\u0939\u0940, \u0917\u0941\u092a\u091a\u0942\u092a \u0930\u0947\u0915\u0949\u0930\u094d\u0921\u093f\u0902\u0917 \u0915\u0930\u0924 \u0928\u093e\u0939\u0940 \u0906\u0923\u093f \u0906\u0935\u093e\u091c \u0938\u093e\u0920\u0935\u0924 \u0928\u093e\u0939\u0940.",permissionDeniedError:"\u092e\u093e\u092f\u0915\u094d\u0930\u094b\u092b\u094b\u0928\u091a\u0940 \u092a\u0930\u0935\u093e\u0928\u0917\u0940 \u0928\u093e\u0915\u093e\u0930\u0932\u0940 \u0917\u0947\u0932\u0940. \u0924\u0941\u092e\u094d\u0939\u0940 \u0916\u093e\u0932\u0940 \u0938\u0902\u0926\u0947\u0936 \u091f\u093e\u0908\u092a \u0915\u093f\u0902\u0935\u093e \u092a\u0947\u0938\u094d\u091f \u0915\u0930\u0942 \u0936\u0915\u0924\u093e.",noAudioCallNotice:"\u0938\u0942\u091a\u0928\u093e: \u0938\u094d\u0915\u0945\u092e\u0936\u0940\u0932\u094d\u0921 \u092b\u094b\u0928 \u0915\u0949\u0932\u094d\u0938\u091a\u0947 \u0938\u0902\u092d\u093e\u0937\u0923 \u0910\u0915\u0924 \u0928\u093e\u0939\u0940. \u0906\u092e\u094d\u0939\u0940 \u0915\u094d\u0932\u094b\u0928 \u0915\u093f\u0902\u0935\u093e \u092c\u0928\u093e\u0935\u091f \u0906\u0935\u093e\u091c \u0913\u0933\u0916\u0923\u094d\u092f\u093e\u091a\u093e \u0926\u093e\u0935\u093e \u0915\u0930\u0924 \u0928\u093e\u0939\u0940.",speechVsScamNotice:"\u0938\u094d\u092a\u0940\u091a-\u091f\u0942-\u091f\u0947\u0915\u094d\u0938\u094d\u091f \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0906\u0935\u093e\u091c\u093e\u091a\u0947 \u092e\u091c\u0915\u0941\u0930\u093e\u0924 \u0930\u0942\u092a\u093e\u0902\u0924\u0930 \u0915\u0930\u0924\u0947. \u092b\u0938\u0935\u0923\u0941\u0915\u0940\u091a\u0940 \u0924\u092a\u093e\u0938\u0923\u0940 \u0906\u092e\u091a\u094d\u092f\u093e \u0928\u093f\u092f\u092e-\u0906\u0927\u093e\u0930\u093f\u0924 \u0907\u0902\u091c\u093f\u0928\u0926\u094d\u0935\u093e\u0930\u0947 \u0915\u0947\u0932\u0940 \u091c\u093e\u0924\u0947.",errorEmpty:"\u0915\u0943\u092a\u092f\u093e \u0924\u092a\u093e\u0938\u0923\u0940\u092a\u0942\u0930\u094d\u0935\u0940 \u092c\u094b\u0932\u093e \u0915\u093f\u0902\u0935\u093e \u0938\u0902\u0926\u0947\u0936 \u091f\u093e\u0908\u092a \u0915\u0930\u093e.",errorNetwork:"\u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0938\u0947\u0935\u0947\u0936\u0940 \u0938\u0902\u092a\u0930\u094d\u0915 \u0939\u094b\u090a \u0936\u0915\u0932\u093e \u0928\u093e\u0939\u0940. \u0915\u0943\u092a\u092f\u093e \u0907\u0902\u091f\u0930\u0928\u0947\u091f \u0924\u092a\u093e\u0938\u093e \u0906\u0923\u093f \u092a\u0941\u0928\u094d\u0939\u093e \u092a\u094d\u0930\u092f\u0924\u094d\u0928 \u0915\u0930\u093e."},bankingSandbox:{title:"\u092c\u0901\u0915\u093f\u0902\u0917 \u0906\u0923\u093f UPI \u0938\u0930\u093e\u0935 \u0938\u0901\u0921\u092c\u0949\u0915\u094d\u0938",subtitle:"\u0921\u093f\u091c\u093f\u091f\u0932 \u092c\u0901\u0915\u093f\u0902\u0917 \u0906\u0923\u093f UPI \u091a\u093e \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0906\u0923\u093f \u0935\u093e\u0938\u094d\u0924\u0935\u0935\u093e\u0926\u0940 \u0938\u0930\u093e\u0935",demoBanner:"\u0921\u0947\u092e\u094b / \u092a\u094d\u0930\u0936\u093f\u0915\u094d\u0937\u0923 \u0938\u093f\u092e\u094d\u092f\u0941\u0932\u0947\u0936\u0928 \u2014 \u0915\u094b\u0923\u0924\u0947\u0939\u0940 \u0916\u0930\u0947 \u092a\u0948\u0938\u0947 \u0928\u093e\u0939\u0940\u0924",demoBannerSub:"\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0938\u0930\u093e\u0935 \u0938\u0901\u0921\u092c\u0949\u0915\u094d\u0938 \u2014 \u0936\u0942\u0928\u094d\u092f \u0916\u0930\u0940 \u092e\u093e\u0939\u093f\u0924\u0940 \u0915\u093f\u0902\u0935\u093e \u0906\u0930\u094d\u0925\u093f\u0915 \u0927\u094b\u0915\u093e",entryCardTitle:"\u092c\u0901\u0915\u093f\u0902\u0917 \u0906\u0923\u093f UPI \u0938\u0930\u093e\u0935 \u0938\u0901\u0921\u092c\u0949\u0915\u094d\u0938",entryCardSubtitle:"\u092c\u0928\u093e\u0935\u091f \u092c\u0901\u0915 \u0932\u0949\u0917\u093f\u0928, UPI \u0915\u0932\u0947\u0915\u094d\u091f \u092b\u094d\u0930\u0949\u0921 \u0906\u0923\u093f OTP \u0938\u093e\u092a\u0933\u0947 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0935\u093e\u0924\u093e\u0935\u0930\u0923\u093e\u0924 \u0913\u0933\u0916\u093e\u092f\u0932\u093e \u0936\u093f\u0915\u093e.",entryCardBadge:"\u0928\u0935\u0940\u0928 \u0938\u0930\u093e\u0935",startSandboxButton:"\u092c\u0901\u0915\u093f\u0902\u0917 \u0938\u0901\u0921\u092c\u0949\u0915\u094d\u0938 \u0938\u0941\u0930\u0942 \u0915\u0930\u093e \u2192",scenarioProgress:"\u091f\u092a\u094d\u092a\u093e {{current}} / {{total}}",mockBrowserNotice:"\u0938\u093f\u092e\u094d\u092f\u0941\u0932\u0947\u091f\u0947\u0921 \u0935\u0947\u092c \u092c\u094d\u0930\u093e\u0909\u091d\u0930 \u0926\u0943\u0936\u094d\u092f",mockUpiNotice:"\u0938\u093f\u092e\u094d\u092f\u0941\u0932\u0947\u091f\u0947\u0921 UPI \u0972\u092a \u0926\u0943\u0936\u094d\u092f",mockPhoneNotice:"\u0938\u093f\u092e\u094d\u092f\u0941\u0932\u0947\u091f\u0947\u0921 \u092b\u094b\u0928 \u0915\u0949\u0932 \u0906\u0923\u093f \u090f\u0938\u090f\u092e\u090f\u0938 \u0926\u0943\u0936\u094d\u092f",goldenRuleTitle:"\u092e\u0939\u0924\u094d\u0924\u094d\u0935\u093e\u091a\u093e \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0928\u093f\u092f\u092e",dangerSignsTitle:"\u092b\u0938\u0935\u0923\u0941\u0915\u0940\u091a\u0940 \u092e\u0941\u0916\u094d\u092f \u0932\u0915\u094d\u0937\u0923\u0947",selectActionTitle:"\u0938\u0930\u094d\u0935\u093e\u0924 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u092a\u093e\u090a\u0932 \u0915\u094b\u0923\u0924\u0947?",safeChoiceBadge:"\u2713 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0928\u093f\u0930\u094d\u0923\u092f",dangerChoiceBadge:"\u26a0\ufe0f \u0927\u094b\u0915\u093e\u0926\u093e\u092f\u0915 \u092a\u093e\u090a\u0932 / \u092b\u0938\u0935\u0923\u0941\u0915\u0940\u091a\u093e \u0938\u093e\u092a\u0933\u093e",nextScenarioButton:"\u092a\u0941\u0922\u0940\u0932 \u092a\u0930\u093f\u0926\u0943\u0936\u094d\u092f \u2192",viewResultsButton:"\u0938\u0930\u093e\u0935 \u0928\u093f\u0915\u093e\u0932 \u092a\u0939\u093e \ud83d\udcca",resultsTitle:"\u0938\u0901\u0921\u092c\u0949\u0915\u094d\u0938 \u0938\u0930\u093e\u0935 \u0928\u093f\u0915\u093e\u0932",resultsSubtitle:"\u092c\u0901\u0915\u093f\u0902\u0917 \u0906\u0923\u093f UPI \u092a\u0930\u093f\u0926\u0943\u0936\u094d\u092f\u093e\u0902\u092e\u0927\u094d\u092f\u0947 \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0938\u0941\u0930\u0915\u094d\u0937\u0947\u091a\u094d\u092f\u093e \u0938\u091c\u0917\u0924\u0947\u091a\u0947 \u092a\u0941\u0928\u0930\u093e\u0935\u0932\u094b\u0915\u0928 \u0915\u0930\u093e",scoreLabel:"\u0924\u0941\u092e\u091a\u093e \u0938\u0930\u093e\u0935 \u0938\u094d\u0915\u094b\u0905\u0930",perfectScoreMessage:"\u0909\u0924\u094d\u0915\u0943\u0937\u094d\u091f \u0938\u091c\u0917\u0924\u093e! \u0924\u0941\u092e\u094d\u0939\u0940 \u0938\u0930\u094d\u0935 \u0938\u093e\u092a\u0933\u0947 \u0913\u0933\u0916\u0942\u0928 \u0924\u0941\u092e\u091a\u0947 \u092a\u0948\u0938\u0947 \u092a\u0942\u0930\u094d\u0923\u092a\u0923\u0947 \u0938\u0