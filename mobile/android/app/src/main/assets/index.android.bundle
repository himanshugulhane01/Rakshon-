rDashboard:{title:"\u0915\u0947\u0905\u0930\u0917\u093f\u0935\u094d\u0939\u0930 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0921\u0945\u0936\u092c\u094b\u0930\u094d\u0921",subtitle:"\u0915\u0941\u091f\u0941\u0902\u092c\u093e\u0924\u0940\u0932 \u0938\u0926\u0938\u094d\u092f\u093e\u0902\u0938\u093e\u0920\u0940 \u092a\u093e\u0930\u0926\u0930\u094d\u0936\u0915 \u0906\u0923\u093f \u0938\u0902\u092e\u0924\u0940-\u0906\u0927\u093e\u0930\u093f\u0924 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0926\u0947\u0916\u0930\u0947\u0916",entryCardTitle:"\u0915\u0947\u0905\u0930\u0917\u093f\u0935\u094d\u0939\u0930 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0921\u0945\u0936\u092c\u094b\u0930\u094d\u0921",entryCardSubtitle:"\u0938\u093e\u092e\u093e\u092f\u093f\u0915 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0938\u094d\u0925\u093f\u0924\u0940, \u0938\u0930\u093e\u0935 \u092a\u094d\u0930\u0917\u0924\u0940 \u0906\u0923\u093f \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0907\u0936\u093e\u0930\u0947 \u092a\u0939\u093e.",entryCardBadge:"\u0915\u0941\u091f\u0941\u0902\u092c \u0938\u0941\u0930\u0915\u094d\u0937\u093e",openButton:"\u0915\u0947\u0905\u0930\u0917\u093f\u0935\u094d\u0939\u0930 \u0935\u094d\u0939\u094d\u092f\u0942 \u0909\u0918\u0921\u093e \u2192",seniorConsentStatus:"\u091c\u094d\u092f\u0947\u0937\u094d\u0920 \u0938\u0926\u0938\u094d\u092f\u093e\u091a\u0940 \u0938\u0902\u092e\u0924\u0940 \u0938\u094d\u0925\u093f\u0924\u0940",consentGranted:"\u0938\u0902\u092e\u0924\u0940 \u0938\u0915\u094d\u0930\u093f\u092f \u0906\u0939\u0947",consentRevoked:"\u0938\u0902\u092e\u0924\u0940 \u092e\u093e\u0917\u0947 \u0918\u0947\u0924\u0932\u0940 / \u0928\u093f\u0937\u094d\u0915\u094d\u0930\u093f\u092f",revokeConsent:"\u0938\u0902\u092e\u0924\u0940 \u092e\u093e\u0917\u0947 \u0918\u094d\u092f\u093e",grantConsent:"\u0938\u0902\u092e\u0924\u0940 \u0926\u094d\u092f\u093e",whatIsSharedTitle:"\u0915\u094b\u0923\u0924\u0940 \u092e\u093e\u0939\u093f\u0924\u0940 \u0938\u093e\u092e\u093e\u092f\u093