__d(function(g,r,i,a,m,e,d){Object.defineProperty(e,"__esModule",{value:!0}),e.AUDIO_VISUAL_MODULES=void 0;e.AUDIO_VISUAL_MODULES=[{id:'kyc_update',icon:'\ud83d\udcb3',badge:'Banking Safety',estimatedMinutes:3,title:{en:'KYC Update Scams',hi:'\u0915\u0947\u0935\u093e\u0908\u0938\u0940 \u0905\u092a\u0921\u0947\u091f \u0927\u094b\u0916\u093e\u0927\u0921\u093c\u0940',mr:'\u0915\u0947\u0935\u093e\u092f\u0938\u0940 \u0905\u092a\u0921\u0947\u091f \u092b\u0938\u0935\u0923\u0942\u0915'},subtitle:{en:'Learn how scammers use fake KYC expiry warnings to drain bank accounts',hi:'\u091c\u093e\u0928\u0947\u0902 \u0915\u093f \u0927\u094b\u0916\u0947\u092c\u093e\u091c \u092b\u0930\u094d\u091c\u0940 \u0915\u0947\u0935\u093e\u0908\u0938\u0940 \u0938\u092e\u093e\u092a\u094d\u0924\u093f \u0915\u0940 \u091a\u0947\u0924\u093e\u0935\u0928\u0940 \u0926\u0947\u0915\u0930 \u0916\u093e\u0924\u0947 \u0915\u0948\u0938\u0947 \u0916\u093e\u0932\u0940 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902',mr:'\u092c\u0928\u093e\u0935\u091f \u0915\u0947\u0935\u093e\u092f\u0938\u0940 \u0938\u092e\u093e\u092a\u094d\u0924\u0940\u091a\u0940 \u092d\u0940\u0924\u0940 \u0926\u093e\u0916\u0935\u0942\u0928 \u092c\u0901\u0915 \u0916\u093e\u0924\u0947 \u0915\u0938\u0947 \u0932\u0941\u091f\u0932\u0947 \u091c\u093e\u0924\u0947 \u0924\u0947 \u0936\u093f\u0915\u093e'},goldenRule:{en:'Banks NEVER update KYC through links in SMS or WhatsApp. Visit your official bank branch in person.',hi:'\u092c\u0948\u0902\u0915 \u0915\u092d\u0940 \u092d\u0940 \u090f\u0938\u090f\u092e\u090f\u0938 \u092f\u093e \u0935\u094d\u0939\u093e\u091f\u094d\u0938\u090f\u092a \u0932\u093f\u0902\u0915 \u0938\u0947 \u0915\u0947\u0935\u093e\u0908\u0938\u0940 \u0905\u092a\u0921\u0947\u091f \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u0947\u0964 \u0939\u092e\u0947\u0936\u093e \u0905\u092a\u0928\u0940 \u092c\u0948\u0902\u0915 \u0936\u093e\u0916\u093e \u092e\u0947\u0902 \u091c\u093e\u090f\u0902\u0964',mr:'\u092c\u0901\u0915 \u0915\u0927\u0940\u0939\u0940 \u090f\u0938\u090f\u092e\u090f\u0938 \u0915\u093f\u0902\u0935\u093e \u0935\u094d\u0939\u0949\u091f\u094d\u0938\u0972\u092a \u0932\u093f\u0902\u0915\u0926\u094d\u0935\u093e\u0930\u0947 \u0915\u0947\u0935\u093e\u092f\u0938\u0940 \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0924 \u0928\u093e\u0939\u0940. \u092a\u094d\u0930\u0924\u094d\u092f\u0915\u094d\u0937 \u092c\u0901\u0915\u0947\u091a\u094d\u092f\u093e \u0936\u093e\u0916\u0947\u0924 \u091c\u093e.'},slides:[{slideNumber:1,headline:{en:'The Threat: Fake Account Deactivation Message',hi:'\u0927\u092e\u0915\u0940: \u092c\u0948\u0902\u0915 \u0916\u093e\u0924\u093e \u092c\u0902\u0926 \u0939\u094b\u0928\u0947 \u0915\u093e \u092b\u0930\u094d\u091c\u0940 \u0938\u0902\u0926\u0947\u0936',mr:'\u0927\u092e\u0915\u0940: \u092c\u0901\u0915 \u0916\u093e\u0924\u0947 \u092c\u0902\u0926 \u0939\u094b\u0923\u094d\u092f\u093e\u091a\u093e \u092c\u0928\u093e\u0935\u091f \u092e\u0947\u0938\u0947\u091c'},content:{en:'You receive an SMS: "Dear Customer, your bank account will be blocked within 24 hours due to pending KYC. Click link to update immediately."',hi:'\u0906\u092a\u0915\u094b \u090f\u0915 \u090f\u0938\u090f\u092e\u090f\u0938 \u092e\u093f\u0932\u0924\u093e \u0939\u0948: "\u092a\u094d\u0930\u093f\u092f \u0917\u094d\u0930\u093e\u0939\u0915, \u0915\u0947\u0935\u093e\u0908\u0938\u0940 \u0932\u0902\u092c\u093f\u0924 \u0939\u094b\u0928\u0947 \u0915\u0947 \u0915\u093e\u0930\u0923 \u0906\u092a\u0915\u093e \u092c\u0948\u0902\u0915 \u0916\u093e\u0924\u093e 24 \u0918\u0902\u091f\u0947 \u092e\u0947\u0902 \u092c\u094d\u0932\u0949\u0915 \u0915\u0930 \u0926\u093f\u092f\u093e \u091c\u093e\u090f\u0917\u093e\u0964 \u0924\u0941\u0930\u0902\u0924 \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0932\u093f\u0902\u0915 \u092a\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902\u0964"',mr:'\u0924\u0941\u092e\u094d\u0939\u093e\u0932\u093e \u092e\u0947\u0938\u0947\u091c \u092f\u0947\u0924\u094b: "\u092a\u094d\u0930\u093f\u092f \u0917\u094d\u0930\u093e\u0939\u0915, \u0915\u0947\u0935\u093e\u092f\u0938\u0940 \u092a\u094d\u0930\u0932\u0902\u092c\u093f\u0924 \u0905\u0938\u0932\u094d\u092f\u093e\u0928\u0947 \u0924\u0941\u092e\u091a\u0947 \u092c\u0901\u0915 \u0916\u093e\u0924\u0947 \u0968\u096a \u0924\u093e\u0938\u093e\u0902\u0924 \u092c\u094d\u0932\u0949\u0915 \u0939\u094b\u0908\u0932. \u0924\u094d\u0935\u0930\u093f\u0924 \u0905\u092a\u0921\u0947\u091f\u0938\u093e\u0920\u0940 \u0932\u093f\u0902\u0915\u0935\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e."'},tip:{en:'Notice the false urgency: Scammers give a 24-hour deadline to create panic and stop you from verifying.',hi:'\u091d\u0942\u0920\u0940 \u091c\u0932\u094d\u0926\u092c\u093e\u091c\u0940 \u092a\u0930 \u0927\u094d\u092f\u093e\u0928 \u0926\u0947\u0902: \u0927\u094b\u0916\u0947\u092c\u093e\u091c \u0918\u092c\u0930\u093e\u0939\u091f \u092a\u0948\u0926\u093e \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0968\u096a \u0918\u0902\u091f\u0947 \u0915\u0940 \u0938\u092e\u092f \u0938\u0940\u092e\u093e \u0926\u0947\u0924\u0947 \u0939\u0948\u0902\u0964',mr:'\u092c\u0928\u093e\u0935\u091f \u0918\u093e\u0908 \u0932\u0915\u094d\u0937\u093e\u0924 \u0918\u094d\u092f\u093e: \u0918\u093e\u092c\u0930\u0935\u0942\u0928 \u0935\u093f\u091a\u093e\u0930 \u0928 \u0915\u0930\u0924\u093e \u0928\u093f\u0930\u094d\u0923\u092f \u0918\u0947\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092d\u093e\u092e\u091f\u0947 \u0968\u096a \u0924\u093e\u0938\u093e\u0902\u091a\u0940 \u092e\u0941\u0926\u0924 \u0926\u0947\u0924\u093e\u0924.'},speechScript:{en:'Lesson 1: KYC Update Scams. Scammers send messages claiming your bank account will be blocked within 24 hours. They want you to panic and tap an unsafe link. Real banks never block your account over an SMS.',hi:'\u092a\u093e\u0920 \u0967: \u0915\u0947\u0935\u093e\u0908\u0938\u0940 \u0905\u092a\u0921\u0947\u091f \u0927\u094b\u0916\u093e\u0927\u0921\u093c\u0940\u0964 \u0920\u0917 \u0938\u0902\u0926\u0947\u0936 \u092d\u0947\u091c\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0906\u092a\u0915\u093e \u092c\u0948\u0902\u0915 \u0916\u093e\u0924\u093e \u091a\u094c\u092c\u0940\u0938 \u0918\u0902\u091f\u0947 \u092e\u0947\u0902 \u092c\u0902\u0926 \u0939\u094b \u091c\u093e\u090f\u0917\u093e\u0964 \u0935\u0947 \u0906\u092a\u0915\u094b \u0921\u0930\u093e\u0915\u0930 \u0917\u0932\u0924 \u0932\u093f\u0902\u0915 \u092a\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0935\u093e\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902\u0964 \u0905\u0938\u0932\u0940 \u092c\u0948\u0902\u0915 \u0915\u092d\u0940 \u090f\u0938\u090f\u092e\u090f\u0938 \u092a\u0930 \u0916\u093e\u0924\u093e \u092c\u094d\u0932\u0949\u0915 \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u0947\u0964',mr:'\u0927\u0921\u093e \u0967: \u0915\u0947\u0935\u093e\u092f\u0938\u0940 \u0905\u092a\u0921\u0947\u091f \u092b\u0938\u0935\u0923\u0942\u0915. \u092b\u0938\u0935\u0923\u0942\u0915 \u0915\u0930\u0923\u093e\u0930\u0947 \u0924\u0941\u092e\u091a\u0947 \u0916\u093e\u0924\u0947 \u0968\u096a \u0924\u093e\u0938\u093e\u0902\u0924 \u092c\u0902\u0926 \u0939\u094b\u0908\u0932 \u0905\u0938\u093e \u092e\u0947\u0938\u0947\u091c \u092a\u093e\u0920\u0935\u0942\u0928 \u0918\u093e\u092c\u0930\u0935\u0924\u093e\u0924. \u0916\u0930\u0940 \u092c\u0901\u0915 \u0915\u0927\u0940\u0939\u0940 \u0905\u0936\u093e \u092e\u0947\u0938\u0947\u091c\u0935\u0930\u0942\u0928 \u0916\u093e\u0924\u0947 \u092c\u094d\u0932\u0949\u0915 \u0915\u0930\u0924 \u0928\u093e\u0939\u0940.'}},{slideNumber:2,headline:{en:'The Safe Habit: Always Visit Your Branch',hi:'\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0906\u0926\u0924: \u0939\u092e\u0947\u0936\u093e \u0905\u092a\u0928\u0940 \u092c\u0948\u0902\u0915 \u0936\u093e\u0916\u093e \u092e\u0947\u0902 \u091c\u093e\u090f\u0902',mr:'\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0938\u0935\u092f: \u0928\u0947\u0939\u092e\u0940 \u0905\u0927\u093f\u0915\u0943\u0924 \u092c\u0901\u0915 \u0936\u093e\u0916\u0947\u0924 \u091c\u093e'},content:{en:'Never click links sent via SMS. If you are unsure about your KYC status, visit your nearest bank branch or call the official number on the back of your debit card.',hi:'\u090f\u0938\u090f\u092e\u090f\u0938 \u092e\u0947\u0902 \u0906\u090f \u0932\u093f\u0902\u0915 \u092a\u0930 \u0915\u092d\u0940 \u0915\u094d\u0932\u093f\u0915 \u0928 \u0915\u0930\u0947\u0902\u0964 \u092f\u0926\u093f \u0906\u092a\u0915\u094b \u0938\u0902\u0926\u0947\u0939 \u0939\u0948, \u0924\u094b \u0905\u092a\u0928\u0940 \u0928\u091c\u0926\u0940\u0915\u0940 \u092c\u0948\u0902\u0915 \u0936\u093e\u0916\u093e \u092e\u0947\u0902 \u091c\u093e\u090f\u0902 \u092f\u093e \u0905\u092a\u0928\u0947 \u0921\u0947\u092c\u093f\u091f \u0915\u093e\u0930\u094d\u0921 \u0915\u0947 \u092a\u0940\u091b\u0947 \u0926\u093f\u090f \u0917\u090f \u0928\u0902\u092c\u0930 \u092a\u0930 \u0915\u0949\u0932 \u0915\u0930\u0947\u0902\u0964',mr:'\u090f\u0938\u090f\u092e\u090f\u0938\u092e\u0927\u0940\u0932 \u0932\u093f\u0902\u0915\u0935\u0930 \u0915\u0927\u0940\u0939\u0940 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0942 \u0928\u0915\u093e. \u0936\u0902\u0915\u093e \u0905\u0938\u0932\u094d\u092f\u093e\u0938 \u091c\u0935\u0933\u091a\u094d\u092f\u093e \u092c\u0901\u0915 \u0936\u093e\u0916\u0947\u0924 \u091c\u093e \u0915\u093f\u0902\u0935\u093e \u0921\u0947\u092c\u093f\u091f \u0915\u093e\u0930\u094d\u0921\u091a\u094d\u092f\u093e \u092a\u093e\u0920\u0940\u092e\u093e\u0917\u0940\u0932 \u0928\u0902\u092c\u0930\u0935\u0930 \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0930\u093e.'},tip:{en:'Real bank managers will never ask you to download any app like AnyDesk or QuickSupport for KYC.',hi:'\u0905\u0938\u0932\u0940 \u092c\u0948\u0902\u0915 \u0915\u0930\u094d\u092e\u091a\u093e\u0930\u0940 \u0915\u092d\u0940 \u092d\u0940 \u0915\u0947\u0935\u093e\u0908\u0938\u0940 \u0915\u0947 \u0932\u093f\u090f \u090f\u0928\u0940\u0921\u0947\u0938\u094d\u0915 \u091c\u0948\u0938\u093e \u0915\u094b\u0908 \u0910\u092a \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0930\u0928\u0947 \u0915\u094b \u0928\u0939\u0940\u0902 \u0915\u0939\u0924\u0947\u0964',mr:'\u0916\u0930\u0947 \u092c\u0901\u0915 \u0905\u0927\u093f\u0915\u093e\u0930\u0940 \u0915\u0947\u0935\u093e\u092f\u0938\u0940\u0938\u093e\u0920\u0940 AnyDesk \u0938\u093e\u0930\u0916\u0947 \u0972\u092a \u0921\u093e\u090a\u0928\u0932\u094b\u0921 \u0915\u0930\u093e\u092f\u0932\u093e \u0938\u093e\u0902\u0917\u0924 \u0928\u093e\u0939\u0940\u0924.'},speechScript:{en:'Slide 2: Safe habits. Never click links in SMS messages. If you receive a KYC notice, verify it in person at your bank branch or call the customer care number printed on your debit card.',hi:'\u0938\u094d\u0932\u093e\u0907\u0921 \u0968: \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0906\u0926\u0924\u0964 \u0938\u0902\u0926\u0947\u0936 \u092e\u0947\u0902 \u0926\u093f\u090f \u0932\u093f\u0902\u0915 \u092a\u0930 \u0915\u092d\u0940 \u0915\u094d\u0932\u093f\u0915 \u0928 \u0915\u0930\u0947\u0902\u0964 \u0905\u0917\u0930 \u0915\u0947\u0935\u093e\u0908\u0938\u0940 \u0915\u093e \u092e\u0948\u0938\u0947\u091c \u0906\u090f \u0924\u094b \u0938\u0940\u0927\u0947 \u092c\u0948\u0902\u0915 \u091c\u093e\u090f\u0902 \u092f\u093e \u0921\u0947\u092c\u093f\u091f \u0915\u093e\u0930\u094d\u0921 \u092a\u0930 \u0932\u093f\u0916\u0947 \u0928\u0902\u092c\u0930 \u092a\u0930 \u092c\u093e\u0924 \u0915\u0930\u0947\u0902\u0964',mr:'\u0938\u094d\u0932\u093e\u0907\u0921 \u0968: \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0938\u0935\u092f. \u092e\u0947\u0938\u0947\u091c\u092e\u0927\u0940\u0932 \u0932\u093f\u0902\u0915\u0935\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0942 \u0928\u0915\u093e. \u0915\u0947\u0935\u093e\u092f\u0938\u0940\u091a\u0940 \u0928\u094b\u091f\u0940\u0938 \u0906\u0932\u094d\u092f\u093e\u0938 \u0925\u0947\u091f \u0936\u093e\u0916\u0947\u0924 \u091c\u093e \u0915\u093f\u0902\u0935\u093e \u0921\u0947\u092c\u093f\u091f \u0915\u093e\u0930\u094d\u0921\u0935\u0930\u0940\u0932 \u0928\u0902\u092c\u0930\u0935\u0930 \u0915\u0949\u0932 \u0915\u0930\u093e.'}}],quiz:{question:{en:'You receive an SMS saying your bank account will be closed today unless you click a link to update KYC. What should you do?',hi:'\u0906\u092a\u0915\u094b \u090f\u0915 \u090f\u0938\u090f\u092e\u090f\u0938 \u092e\u093f\u0932\u0924\u093e \u0939\u0948 \u0915\u093f \u0915\u0947\u0935\u093e\u0908\u0938\u0940 \u0932\u093f\u0902\u0915 \u092a\u0930 \u0915\u094d\u0932\u093f\u0915 \u0928 \u0915\u0930\u0928\u0947 \u092a\u0930 \u0906\u092a\u0915\u093e \u0916\u093e\u0924\u093e \u0906\u091c \u092c\u0902\u0926 \u0939\u094b \u091c\u093e\u090f\u0917\u093e\u0964 \u0906\u092a\u0915\u094b \u0915\u094d\u092f\u093e \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u093f\u090f?',mr:'\u0915\u0947\u0935\u093e\u092f\u0938\u0940 \u0932\u093f\u0902\u0915\u0935\u0930 \u0915\u094d\u0932\u093f\u0915 \u0928 \u0915\u0947\u0932\u094d\u092f\u093e\u0938 \u0916\u093e\u0924\u0947 \u0906\u091c \u092c\u0902\u0926 \u0939\u094b\u0908\u0932 \u0905\u0938\u093e \u092e\u0947\u0938\u0947\u091c \u0906\u0932\u093e \u0924\u0930 \u0924\u0941\u092e\u094d\u0939\u0940 \u0915\u093e\u092f \u0915\u0930\u093e\u0932?'},options:[{id:'opt1',text:{en:'Ignore the link and check with your bank branch in person.',hi:'\u0932\u093f\u0902\u0915 \u0915\u094b \u0905\u0928\u0926\u0947\u0916\u093e \u0915\u0930\u0947\u0902 \u0914\u0930 \u0938\u094d\u0935\u092f\u0902 \u092c\u0948\u0902\u0915 \u0936\u093e\u0916\u093e \u091c\u093e\u0915\u0930 \u091c\u093e\u0902\u091a \u0915\u0930\u0947\u0902\u0964',mr:'\u0932\u093f\u0902\u0915\u0915\u0921\u0947 \u0926\u0941\u0930\u094d\u0932\u0915\u094d\u0937 \u0915\u0930\u093e \u0906\u0923\u093f \u0938\u094d\u0935\u0924\u0903 \u092c\u0901\u0915 \u0936\u093e\u0916\u0947\u0924 \u091c\u093e\u090a\u0928 \u0916\u093e\u0924\u094d\u0930\u0940 \u0915\u0930\u093e.'},isCorrect:!0,explanation:{en:'Correct! Banks never require instant online updates via unverified SMS links.',hi:'\u092c\u093f\u0932\u094d\u0915\u0941\u0932 \u0938\u0939\u0940! \u092c\u0948\u0902\u0915 \u0915\u092d\u0940 \u092d\u0940 \u090f\u0938\u090f\u092e\u090f\u0938 \u0932\u093f\u0902\u0915 \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u0924\u0924\u094d\u0915\u093e\u0932 \u0905\u092a\u0921\u0947\u091f \u0915\u0940 \u092e\u093e\u0902\u0917 \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u0947\u0964',mr:'\u0905\u0917\u0926\u0940 \u092c\u0930\u094b\u092c\u0930! \u092c\u0901\u0915 \u0915\u0927\u0940\u0939\u0940 \u0905\u0928\u094b\u0933\u0916\u0940 \u092e\u0947\u0938\u0947\u091c \u0932\u093f\u0902\u0915\u0935\u0930\u0942\u0928 \u0924\u094d\u0935\u0930\u093f\u0924 \u0905\u092a\u0921\u0947\u091f \u092e\u093e\u0917\u0924 \u0928\u093e\u0939\u0940.'}},{id:'opt2',text:{en:'Click the link immediately to prevent account suspension.',hi:'\u0916\u093e\u0924\u093e \u092c\u0902\u0926 \u0939\u094b\u0928\u0947 \u0938\u0947 \u092c\u091a\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0924\u0941\u0930\u0902\u0924 \u0932\u093f\u0902\u0915 \u092a\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902\u0964',mr:'\u0916\u093e\u0924\u0947 \u092c\u0902\u0926 \u0939\u094b\u090a \u0928\u092f\u0947 \u092e\u094d\u0939\u0923\u0942\u0928 \u0932\u0917\u0947\u091a \u0932\u093f\u0902\u0915\u0935\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u093e.'},isCorrect:!1,explanation:{en:'Unsafe: Clicking the link opens a phishing website designed to steal your credentials.',hi:'\u0905\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924: \u0932\u093f\u0902\u0915 \u092a\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0928\u0947 \u0938\u0947 \u092b\u0930\u094d\u091c\u0940 \u0935\u0947\u092c\u0938\u093e\u0907\u091f \u0916\u0941\u0932\u0924\u0940 \u0939\u0948 \u091c\u094b \u0906\u092a\u0915\u0940 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u091a\u0941\u0930\u093e\u0924\u0940 \u0939\u0948\u0964',mr:'\u0927\u094b\u0915\u093e\u0926\u093e\u092f\u0915: \u0939\u0940 \u092c\u0928\u093e\u0935\u091f \u0935\u0947\u092c\u0938\u093e\u0907\u091f \u0905\u0938\u0924\u0947 \u091c\u0940 \u0924\u0941\u092e\u091a\u0940 \u092c\u0901\u0915 \u0916\u093e\u0924\u094d\u092f\u093e\u091a\u0940 \u092e\u093e\u0939\u093f\u0924\u0940 \u091a\u094b\u0930\u0924\u0947.'}}]}},{id:'otp_theft',icon:'\ud83d\udd10',badge:'Credential Safety',estimatedMinutes:3,title:{en:'OTP & Password Safety',hi:'\u0913\u091f\u0940\u092a\u0940 \u0914\u0930 \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0938\u0941\u0930\u0915\u094d\u0937\u093e',mr:'\u0913\u091f\u0940\u092a\u0940 \u0906\u0923\u093f \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0938\u0941\u0930\u0915\u094d\u0937\u093e'},subtitle:{en:'Why One-Time Passwords are keys to your money and must never be shared verbally',hi:'\u0913\u091f\u0940\u092a\u0940 \u0906\u092a\u0915\u0947 \u0927\u0928 \u0915\u0940 \u091a\u093e\u092c\u0940 \u0939\u0948, \u0907\u0938\u0947 \u0915\u092d\u0940 \u092d\u0940 \u0915\u093f\u0938\u0940 \u0915\u094b \u092c\u094b\u0932\u0915\u0930 \u0928 \u092c\u0924\u093e\u090f\u0902',mr:'\u0913\u091f\u0940\u092a\u0940 \u0939\u0940 \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u092a\u0948\u0936\u093e\u0902\u091a\u0940 \u091a\u093e\u0935\u0940 \u0906\u0939\u0947, \u0915\u094b\u0923\u093e\u0936\u0940\u0939\u0940 \u0936\u0947\u0905\u0930 \u0915\u0930\u0942 \u0928\u0915\u093e'},goldenRule:{en:'An OTP is strictly for YOUR eyes only. Bank staff, police, and family will never ask you to read it aloud.',hi:'\u0913\u091f\u0940\u092a\u0940 \u0915\u0947\u0935\u0932 \u0906\u092a\u0915\u0940 \u0906\u0901\u0916\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0939\u0948\u0964 \u092c\u0948\u0902\u0915 \u0915\u0930\u094d\u092e\u091a\u093e\u0930\u0940, \u092a\u0941\u0932\u093f\u0938 \u092f\u093e \u0915\u094b\u0908 \u092d\u0940 \u0907\u0938\u0947 \u092a\u0942\u091b\u0928\u0947 \u0915\u093e \u0905\u0927\u093f\u0915\u093e\u0930 \u0928\u0939\u0940\u0902 \u0930\u0916\u0924\u093e\u0964',mr:'\u0913\u091f\u0940\u092a\u0940 \u092b\u0915\u094d\u0924 \u0924\u0941\u092e\u091a\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0905\u0938\u0924\u094b. \u092c\u0901\u0915 \u0915\u0930\u094d\u092e\u091a\u093e\u0930\u0940 \u0915\u093f\u0902\u0935\u093e \u092a\u094b\u0932\u093f\u0938 \u0915\u0927\u0940\u0939\u0940 \u092b\u094b\u0928\u0935\u0930 \u0913\u091f\u0940\u092a\u0940 \u092e\u093e\u0917\u0924 \u0928\u093e\u0939\u0940\u0924.'},slides:[{slideNumber:1,headline:{en:'What is an OTP Really For?',hi:'\u0913\u091f\u0940\u092a\u0940 \u0935\u093e\u0938\u094d\u0924\u0935 \u092e\u0947\u0902 \u0915\u093f\u0938\u0932\u093f\u090f \u0939\u094b\u0924\u093e \u0939\u0948?',mr:'\u0913\u091f\u0940\u092a\u0940 \u0928\u0947\u092e\u0915\u093e \u0915\u0936\u093e\u0938\u093e\u0920\u0940 \u0905\u0938\u0924\u094b?'},content:{en:'OTP stands for One-Time Password. It authorizes money to leave your account or changes your account password. An OTP is never needed to receive money.',hi:'\u0913\u091f\u0940\u092a\u0940 \u0915\u093e \u0905\u0930\u094d\u0925 \u0939\u0948 \u0935\u0928-\u091f\u093e\u0907\u092e \u092a\u093e\u0938\u0935\u0930\u094d\u0921\u0964 \u092f\u0939 \u0906\u092a\u0915\u0947 \u0916\u093e\u0924\u0947 \u0938\u0947 \u092a\u0948\u0938\u0947 \u092d\u0947\u091c\u0928\u0947 \u092f\u093e \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u092c\u0926\u0932\u0928\u0947 \u0915\u0940 \u0905\u0928\u0941\u092e\u0924\u093f \u0926\u0947\u0924\u093e \u0939\u0948\u0964 \u092a\u0948\u0938\u0947 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0913\u091f\u0940\u092a\u0940 \u0915\u0940 \u0915\u092d\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0928\u0939\u0940\u0902 \u0939\u094b\u0924\u0940\u0964',mr:'\u0913\u091f\u0940\u092a\u0940 \u092e\u094d\u0939\u0923\u091c\u0947 \u0935\u0928-\u091f\u093e\u0907\u092e \u092a\u093e\u0938\u0935\u0930\u094d\u0921. \u0939\u093e \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0916\u093e\u0924\u094d\u092f\u093e\u0924\u0942\u0928 \u092a\u0948\u0938\u0947 \u092a\u093e\u0920\u0935\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0915\u093f\u0902\u0935\u093e \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u092c\u0926\u0932\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0905\u0938\u0924\u094b. \u092a\u0948\u0938\u0947 \u092e\u093f\u0933\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0913\u091f\u0940\u092a\u0940 \u0915\u0927\u0940\u091a \u0932\u093e\u0917\u0924 \u0928\u093e\u0939\u0940.'},tip:{en:'Read the full SMS: The message always states the exact amount being debited.',hi:'\u092a\u0942\u0930\u093e \u090f\u0938\u090f\u092e\u090f\u0938 \u092a\u0922\u093c\u0947\u0902: \u0938\u0902\u0926\u0947\u0936 \u092e\u0947\u0902 \u0939\u092e\u0947\u0936\u093e \u0915\u091f\u0928\u0947 \u0935\u093e\u0932\u0940 \u0938\u0939\u0940 \u0930\u093e\u0936\u093f \u0932\u093f\u0916\u0940 \u0939\u094b\u0924\u0940 \u0939\u0948\u0964',mr:'\u092a\u0942\u0930\u094d\u0923 \u090f\u0938\u090f\u092e\u090f\u0938 \u0935\u093e\u091a\u093e: \u092e\u0947\u0938\u0947\u091c\u092e\u0927\u094d\u092f\u0947 \u0928\u0947\u0939\u092e\u0940 \u0916\u093e\u0924\u094d\u092f\u093e\u0924\u0942\u0928 \u0915\u091f \u0939\u094b\u0923\u093e\u0930\u0940 \u0930\u0915\u094d\u0915\u092e \u0938\u094d\u092a\u0937\u094d\u091f \u0932\u093f\u0939\u093f\u0932\u0947\u0932\u0940 \u0905\u0938\u0924\u0947.'},speechScript:{en:'Lesson 2: OTP Safety. An OTP is a digital key that authorizes money to leave your account. Fraudsters will call asking for this code under various pretexts. Remember, sharing your OTP means giving away your money.',hi:'\u092a\u093e\u0920 \u0968: \u0913\u091f\u0940\u092a\u0940 \u0938\u0941\u0930\u0915\u094d\u0937\u093e\u0964 \u0913\u091f\u0940\u092a\u0940 \u090f\u0915 \u0921\u093f\u091c\u093f\u091f\u0932 \u091a\u093e\u092c\u0940 \u0939\u0948 \u091c\u093f\u0938\u0938\u0947 \u0906\u092a\u0915\u0947 \u0916\u093e\u0924\u0947 \u0938\u0947 \u092a\u0948\u0938\u0947 \u0915\u091f\u0924\u0947 \u0939\u0948\u0902\u0964 \u0927\u094b\u0916\u0947\u092c\u093e\u091c \u092c\u0939\u093e\u0928\u0947 \u092c\u0928\u093e\u0915\u0930 \u092f\u0939 \u0915\u094b\u0921 \u092e\u093e\u0902\u0917\u0924\u0947 \u0939\u0948\u0902\u0964 \u092f\u093e\u0926 \u0930\u0916\u0947\u0902, \u0913\u091f\u0940\u092a\u0940 \u092c\u0924\u093e\u0928\u093e \u092e\u0924\u0932\u092c \u0905\u092a\u0928\u0947 \u092a\u0948\u0938\u0947 \u0917\u0902\u0935\u093e\u0928\u093e\u0964',mr:'\u0927\u0921\u093e \u0968: \u0913\u091f\u0940\u092a\u0940 \u0938\u0941\u0930\u0915\u094d\u0937\u093e. \u0913\u091f\u0940\u092a\u0940 \u0939\u0940 \u0921\u093f\u091c\u093f\u091f\u0932 \u091a\u093e\u0935\u0940 \u0906\u0939\u0947 \u091c\u094d\u092f\u093e\u0928\u0947 \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0916\u093e\u0924\u094d\u092f\u093e\u0924\u0942\u0928 \u092a\u0948\u0938\u0947 \u092c\u093e\u0939\u0947\u0930 \u091c\u093e\u0924\u093e\u0924. \u092d\u093e\u092e\u091f\u0947 \u0935\u093f\u0935\u093f\u0927 \u0915\u093e\u0930\u0923\u0947 \u0938\u093e\u0902\u0917\u0942\u0928 \u0939\u093e \u0915\u094b\u0921 \u092e\u093e\u0917\u0924\u093e\u0924. \u0913\u091f\u0940\u092a\u0940 \u0915\u0927\u0940\u0939\u0940 \u0915\u094b\u0923\u093e\u0932\u093e \u0938\u093e\u0902\u0917\u0942 \u0928\u0915\u093e.'}}],quiz:{question:{en:'A caller claiming to be from your electricity company says they need your OTP to stop power disconnection. Should you share it?',hi:'\u092c\u093f\u091c\u0932\u0940 \u0915\u0902\u092a\u0928\u0940 \u0915\u093e \u0915\u0930\u094d\u092e\u091a\u093e\u0930\u0940 \u092c\u0928\u0915\u0930 \u0915\u0949\u0932 \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u093e \u092c\u093f\u091c\u0932\u0940 \u0915\u091f\u0928\u0947 \u0938\u0947 \u0930\u094b\u0915\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0913\u091f\u0940\u092a\u0940 \u092e\u093e\u0902\u0917\u0924\u093e \u0939\u0948\u0964 \u0915\u094d\u092f\u093e \u0906\u092a\u0915\u094b \u092c\u0924\u093e\u0928\u093e \u091a\u093e\u0939\u093f\u090f?',mr:'\u0935\u0940\u091c \u0915\u0902\u092a\u0928\u0940\u091a\u093e \u0905\u0927\u093f\u0915\u093e\u0930\u0940 \u092c\u094b\u0932\u0924 \u0905\u0938\u0932\u094d\u092f\u093e\u091a\u0947 \u0938\u093e\u0902\u0917\u0942\u0928 \u0935\u0940\u091c \u092a\u0941\u0930\u0935\u0920\u093e \u0916\u0902\u0921\u093f\u0924 \u0928 \u0939\u094b\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0913\u091f\u0940\u092a\u0940 \u092e\u093e\u0917\u093f\u0924\u0932\u094d\u092f\u093e\u0938 \u0924\u0941\u092e\u094d\u0939\u0940 \u0915\u093e\u092f \u0915\u0930\u093e\u0932?'},options:[{id:'opt1',text:{en:'Never share the OTP under any circumstances.',hi:'\u0915\u093f\u0938\u0940 \u092d\u0940 \u092a\u0930\u093f\u0938\u094d\u0925\u093f\u0924\u093f \u092e\u0947\u0902 \u0913\u091f\u0940\u092a\u0940 \u0915\u092d\u0940 \u0938\u093e\u091d\u093e \u0928 \u0915\u0930\u0947\u0902\u0964',mr:'\u0915\u094b\u0923\u0924\u094d\u092f\u093e\u0939\u0940 \u092a\u0930\u093f\u0938\u094d\u0925\u093f\u0924\u0940\u0924 \u0913\u091f\u0940\u092a\u0940 \u0915\u0927\u0940\u0939\u0940 \u0936\u0947\u0905\u0930 \u0915\u0930\u0942 \u0928\u0915\u093e.'},isCorrect:!0,explanation:{en:'Spot on! Utility companies never require OTPs over the phone to prevent disconnections.',hi:'\u092c\u093f\u0932\u094d\u0915\u0941\u0932 \u0938\u0939\u0940! \u092c\u093f\u091c\u0932\u0940 \u0935\u093f\u092d\u093e\u0917 \u0915\u092d\u0940 \u092d\u0940 \u092b\u094b\u0928 \u092a\u0930 \u0913\u091f\u0940\u092a\u0940 \u0928\u0939\u0940\u0902 \u092e\u093e\u0902\u0917\u0924\u093e\u0964',mr:'\u0905\u0917\u0926\u0940 \u092c\u0930\u094b\u092c\u0930! \u0935\u0940\u091c \u0935\u093f\u0924\u0930\u0923 \u0915\u093e\u0930\u094d\u092f\u093e\u0932\u092f \u092b\u094b\u0928\u0935\u0930 \u0905\u0938\u093e \u0913\u091f\u0940\u092a\u0940 \u092e\u093e\u0917\u0924 \u0928\u093e\u0939\u0940.'}},{id:'opt2',text:{en:'Share it quickly so power is not cut off.',hi:'\u091c\u0932\u094d\u0926\u0940 \u0938\u0947 \u092c\u0924\u093e \u0926\u0947\u0902 \u0924\u093e\u0915\u093f \u092c\u093f\u091c\u0932\u0940 \u0928 \u0915\u091f\u0947\u0964',mr:'\u0935\u0940\u091c \u091c\u093e\u090a \u0928\u092f\u0947 \u092e\u094d\u0939\u0923\u0942\u0928 \u092a\u091f\u0915\u0928 \u0938\u093e\u0902\u0917\u093e.'},isCorrect:!1,explanation:{en:'Dangerous: Sharing the OTP allows the criminal to debit money from your account immediately.',hi:'\u0916\u0924\u0930\u0928\u093e\u0915: \u0913\u091f\u0940\u092a\u0940 \u0938\u093e\u091d\u093e \u0915\u0930\u0928\u0947 \u0938\u0947 \u0927\u094b\u0916\u0947\u092c\u093e\u091c \u0906\u092a\u0915\u0947 \u0916\u093e\u0924\u0947 \u0938\u0947 \u092a\u0948\u0938\u0947 \u0928\u093f\u0915\u093e\u0932 \u0932\u0947\u0917\u093e\u0964',mr:'\u0927\u094b\u0915\u093e\u0926\u093e\u092f\u0915: \u0913\u091f\u0940\u092a\u0940 \u0938\u093e\u0902\u0917\u0924\u093e\u091a \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0916\u093e\u0924\u094d\u092f\u093e\u0924\u0942\u0928 \u092a\u0948\u0938\u0947 \u091a\u094b\u0930\u0940 \u0939\u094b\u0924\u0940\u0932.'}}]}},{id:'lottery_prize',icon:'\ud83c\udf81',badge:'Fraud Awareness',estimatedMinutes:2,title:{en:'Lottery & Prize Scams',hi:'\u0932\u0949\u091f\u0930\u0940 \u0914\u0930 \u0908\u0928\u093e\u092e \u0927\u094b\u0916\u093e\u0927\u0921\u093c\u0940',mr:'\u0932\u0949\u091f\u0930\u0940 \u0906\u0923\u093f \u092c\u0915\u094d\u0937\u0940\u0938 \u092b\u0938\u0935\u0923\u0942\u0915'},subtitle:{en:'Recognize fake KBC prizes, car lotteries, and advance-fee demands',hi:'\u0915\u0947\u092c\u0940\u0938\u0940 \u0932\u0949\u091f\u0930\u0940 \u0914\u0930 \u0909\u092a\u0939\u093e\u0930 \u0915\u0947 \u0928\u093e\u092e \u092a\u0930 \u0939\u094b\u0928\u0947 \u0935\u093e\u0932\u0947 \u0927\u094b\u0916\u0947 \u0915\u094b \u092a\u0939\u091a\u093e\u0928\u0947\u0902',mr:'\u0915\u0947\u092c\u0940\u0938\u0940 \u0932\u0949\u091f\u0930\u0940 \u0906\u0923\u093f \u092c\u0915\u094d\u0937\u0940\u0938\u093e\u0902\u091a\u094d\u092f\u093e \u0928\u093e\u0935\u093e\u0916\u093e\u0932\u0940 \u0939\u094b\u0923\u093e\u0931\u094d\u092f\u093e \u092b\u0938\u0935\u0923\u0941\u0915\u0940\u092a\u093e\u0938\u0942\u0928 \u0938\u093e\u0935\u0927 \u0930\u093e\u0939\u093e'},goldenRule:{en:'You cannot win a lottery you never bought a ticket for. Genuine prizes NEVER ask for advance processing fees.',hi:'\u091c\u093f\u0938 \u0932\u0949\u091f\u0930\u0940 \u0915\u093e \u091f\u093f\u0915\u091f \u0906\u092a\u0928\u0947 \u0928\u0939\u0940\u0902 \u0916\u0930\u0940\u0926\u093e, \u0909\u0938\u0947 \u0906\u092a \u0915\u092d\u0940 \u0928\u0939\u0940\u0902 \u091c\u0940\u0924 \u0938\u0915\u0924\u0947\u0964 \u0905\u0938\u0932\u0940 \u0908\u0928\u093e\u092e \u092e\u0947\u0902 \u0915\u094b\u0908 \u0905\u0917\u094d\u0930\u093f\u092e \u0936\u0941\u0932\u094d\u0915 \u0928\u0939\u0940\u0902 \u0932\u0917\u0924\u093e\u0964',mr:'\u091c\u094d\u092f\u093e\u091a\u0940 \u0932\u0949\u091f\u0930\u0940 \u0924\u0941\u092e\u094d\u0939\u0940 \u0916\u0930\u0947\u0926\u0940\u091a \u0915\u0947\u0932\u0940 \u0928\u093e\u0939\u0940 \u0924\u0940 \u091c\u093f\u0902\u0915\u0923\u0947 \u0905\u0936\u0915\u094d\u092f \u0906\u0939\u0947. \u0916\u0930\u0940 \u092c\u0915\u094d\u0937\u093f\u0938\u0947 \u0915\u0927\u0940\u0939\u0940 \u0906\u0927\u0940 \u092a\u0948\u0938\u0947 \u092e\u093e\u0917\u0924 \u0928\u093e\u0939\u0940\u0924.'},slides:[{slideNumber:1,headline:{en:'The Golden Rule of Lotteries',hi:'\u0932\u0949\u091f\u0930\u0940 \u0915\u093e \u0938\u0941\u0928\u0939\u0930\u093e \u0928\u093f\u092f\u092e',mr:'\u0932\u0949\u091f\u0930\u0940\u091a\u093e \u0938\u0941\u0935\u0930\u094d\u0923 \u0928\u093f\u092f\u092e'},content:{en:'Scammers send WhatsApp letters with official-looking logos claiming you won \u20b925 Lakhs in KBC or a car lottery. They ask for \u20b95,000 for "GST and processing charges".',hi:'\u0920\u0917 \u0935\u094d\u0939\u093e\u091f\u094d\u0938\u090f\u092a \u092a\u0930 \u092b\u0930\u094d\u091c\u0940 \u0932\u0947\u091f\u0930 \u092d\u0947\u091c\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0906\u092a\u0928\u0947 \u0915\u0947\u092c\u0940\u0938\u0940 \u092e\u0947\u0902 \u0968\u096b \u0932\u093e\u0916 \u091c\u0940\u0924\u0947 \u0939\u0948\u0902\u0964 \u0935\u0947 "\u091c\u0940\u090f\u0938\u091f\u0940 \u0914\u0930 \u092b\u093e\u0907\u0932 \u091a\u093e\u0930\u094d\u091c" \u0915\u0947 \u0928\u093e\u092e \u092a\u0930 \u096b,\u0966\u0966\u0966 \u0930\u0941\u092a\u092f\u0947 \u092e\u093e\u0902\u0917\u0924\u0947 \u0939\u0948\u0902\u0964',mr:'\u092d\u093e\u092e\u091f\u0947 \u0935\u094d\u0939\u0949\u091f\u094d\u0938\u0972\u092a\u0935\u0930 \u0932\u0947\u091f\u0930 \u092a\u093e\u0920\u0935\u0924\u093e\u0924 \u0915\u0940 \u0924\u0941\u092e\u094d\u0939\u0940 \u0915\u0947\u092c\u0940\u0938\u0940\u092e\u0927\u094d\u092f\u0947 \u0968\u096b \u0932\u093e\u0916 \u091c\u093f\u0902\u0915\u0932\u0947 \u0906\u0939\u0947\u0924 \u0906\u0923\u093f \u091c\u0940\u090f\u0938\u091f\u0940\u0938\u093e\u0920\u0940 \u096b,\u0966\u0966\u0966 \u0930\u0941\u092a\u092f\u0947 \u092e\u093e\u0917\u093e\u092f\u0932\u093e \u0938\u093e\u0902\u0917\u0924\u093e\u0924.'},tip:{en:'Any demand to pay money to receive a prize is 100% fraud.',hi:'\u0908\u0928\u093e\u092e \u092a\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092a\u0939\u0932\u0947 \u092a\u0948\u0938\u0947 \u0926\u0947\u0928\u0947 \u0915\u0940 \u0915\u094b\u0908 \u092d\u0940 \u092e\u093e\u0902\u0917 \u0967\u0966\u0966% \u0927\u094b\u0916\u093e\u0927\u0921\u093c\u0940 \u0939\u0948\u0964',mr:'\u092c\u0915\u094d\u0937\u0940\u0938 \u092e\u093f\u0933\u0935\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0906\u0927\u0940 \u092a\u0948\u0938\u0947 \u092e\u093e\u0917\u0923\u0947 \u0939\u0940 \u0967\u0966\u0966% \u092b\u0938\u0935\u0923\u0942\u0915 \u0905\u0938\u0924\u0947.'},speechScript:{en:'Lesson 3: Lottery Scams. If you receive an alert saying you won a lottery or car, ask yourself: Did I buy a ticket? No genuine organization asks for advance fees to release prize money.',hi:'\u092a\u093e\u0920 \u0969: \u0932\u0949\u091f\u0930\u0940 \u0927\u094b\u0916\u093e\u0927\u0921\u093c\u0940\u0964 \u0905\u0917\u0930 \u0906\u092a\u0915\u094b \u0932\u0949\u091f\u0930\u0940 \u091c\u0940\u0924\u0928\u0947 \u0915\u093e \u0938\u0902\u0926\u0947\u0936 \u0906\u090f, \u0924\u094b \u0938\u094b\u091a\u0947\u0902: \u0915\u094d\u092f\u093e \u092e\u0948\u0902\u0928\u0947 \u091f\u093f\u0915\u091f \u0916\u0930\u0940\u0926\u093e \u0925\u093e? \u0915\u094b\u0908 \u092d\u0940 \u0905\u0938\u0932\u0940 \u0938\u0902\u0938\u094d\u0925\u093e \u0908\u0928\u093e\u092e \u0926\u0947\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092a\u0939\u0932\u0947 \u092a\u0948\u0938\u0947 \u0928\u0939\u0940\u0902 \u092e\u093e\u0902\u0917\u0924\u0940\u0964',mr:'\u0927\u0921\u093e \u0969: \u0932\u0949\u091f\u0930\u0940 \u092b\u0938\u0935\u0923\u0942\u0915. \u091c\u0930 \u0924\u0941\u092e\u094d\u0939\u093e\u0932\u093e \u0932\u0949\u091f\u0930\u0940 \u0932\u093e\u0917\u0932\u094d\u092f\u093e\u091a\u093e \u092e\u0947\u0938\u0947\u091c \u0906\u0932\u093e \u0924\u0930 \u0935\u093f\u091a\u093e\u0930 \u0915\u0930\u093e: \u092e\u0940 \u0924\u093f\u0915\u0940\u091f \u0916\u0930\u0947\u0926\u0940 \u0915\u0947\u0932\u0947 \u0939\u094b\u0924\u0947 \u0915\u093e? \u0916\u0930\u0940 \u092c\u0915\u094d\u0937\u093f\u0938\u0947 \u0915\u0927\u0940\u0939\u0940 \u0906\u0927\u0940 \u092a\u0948\u0938\u0947 \u092e\u093e\u0917\u0924 \u0928\u093e\u0939\u0940\u0924.'}}],quiz:{question:{en:'A WhatsApp message with a KBC logo says you won \u20b925 Lakhs, but you must pay \u20b94,500 tax first. What should you do?',hi:'\u0935\u094d\u0939\u093e\u091f\u094d\u0938\u090f\u092a \u092a\u0930 \u090f\u0915 \u0938\u0902\u0926\u0947\u0936 \u0906\u0924\u093e \u0939\u0948 \u0915\u093f \u0906\u092a\u0928\u0947 \u0968\u096b \u0932\u093e\u0916 \u091c\u0940\u0924\u0947 \u0939\u0948\u0902, \u0932\u0947\u0915\u093f\u0928 \u092a\u0939\u0932\u0947 \u096a,\u096b\u0966\u0966 \u0930\u0941\u092a\u092f\u0947 \u091f\u0948\u0915\u094d\u0938 \u0926\u0947\u0928\u093e \u0939\u094b\u0917\u093e\u0964 \u0906\u092a \u0915\u094d\u092f\u093e \u0915\u0930\u0947\u0902\u0917\u0947?',mr:'\u0935\u094d\u0939\u0949\u091f\u094d\u0938\u0972\u092a\u0935\u0930 \u092e\u0947\u0938\u0947\u091c \u0906\u0932\u093e \u0915\u0940 \u0924\u0941\u092e\u094d\u0939\u0940 \u0968\u096b \u0932\u093e\u0916 \u091c\u093f\u0902\u0915\u0932\u0947\u0924, \u092a\u0923 \u0906\u0927\u0940 \u096a,\u096b\u0966\u0966 \u0930\u0941\u092a\u092f\u0947 \u091f\u0945\u0915\u094d\u0938 \u092d\u0930\u093e\u0935\u093e \u0932\u093e\u0917\u0947\u0932. \u0924\u0941\u092e\u094d\u0939\u0940 \u0915\u093e\u092f \u0915\u0930\u093e\u0932?'},options:[{id:'opt1',text:{en:'Delete the message and block the sender. It is completely fake.',hi:'\u0938\u0902\u0926\u0947\u0936 \u0939\u091f\u093e\u090f\u0902 \u0914\u0930 \u0928\u0902\u092c\u0930 \u092c\u094d\u0932\u0949\u0915 \u0915\u0930\u0947\u0902\u0964 \u092f\u0939 \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u0938\u0947 \u092b\u0930\u094d\u091c\u0940 \u0939\u0948\u0964',mr:'\u092e\u0947\u0938\u0947\u091c \u0921\u093f\u0932\u0940\u091f \u0915\u0930\u093e \u0906\u0923\u093f \u0928\u0902\u092c\u0930 \u092c\u094d\u0932\u0949\u0915 \u0915\u0930\u093e. \u0939\u0940 \u092a\u0942\u0930\u094d\u0923\u092a\u0923\u0947 \u092b\u0938\u0935\u0923\u0942\u0915 \u0906\u0939\u0947.'},isCorrect:!0,explanation:{en:'Correct! Advance fee fraud is among the most common scams targeting seniors.',hi:'\u092c\u093f\u0932\u094d\u0915\u0941\u0932 \u0938\u0939\u0940! \u0908\u0928\u093e\u092e \u0915\u0947 \u0928\u093e\u092e \u092a\u0930 \u092a\u0948\u0938\u0947 \u092e\u093e\u0902\u0917\u0928\u093e \u0935\u0930\u093f\u0937\u094d\u0920 \u0928\u093e\u0917\u0930\u093f\u0915\u094b\u0902 \u0915\u094b \u0920\u0917\u0928\u0947 \u0915\u093e \u0906\u092e \u0924\u0930\u0940\u0915\u093e \u0939\u0948\u0964',mr:'\u0905\u0917\u0926\u0940 \u092c\u0930\u094b\u092c\u0930! \u0906\u0927\u0940 \u092a\u0948\u0938\u0947 \u092e\u093e\u0917\u0923\u0947 \u0939\u093e \u091c\u094d\u092f\u0947\u0937\u094d\u0920\u093e\u0902\u0928\u093e \u092b\u0938\u0935\u0923\u094d\u092f\u093e\u091a\u093e \u0928\u0947\u0939\u092e\u0940\u091a\u093e \u092e\u093e\u0930\u094d\u0917 \u0906\u0939\u0947.'}},{id:'opt2',text:{en:'Transfer \u20b94,500 to claim the \u20b925 Lakhs.',hi:'\u0968\u096b \u0932\u093e\u0916 \u092a\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u096a,\u096b\u0966\u0966 \u0930\u0941\u092a\u092f\u0947 \u091f\u094d\u0930\u093e\u0902\u0938\u092b\u0930 \u0915\u0930\u0947\u0902\u0964',mr:'\u0968\u096b \u0932\u093e\u0916 \u092e\u093f\u0933\u0935\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u096a,\u096b\u0966\u0966 \u0930\u0941\u092a\u092f\u0947 \u092a\u093e\u0920\u0935\u093e.'},isCorrect:!1,explanation:{en:'Unsafe: You will lose the \u20b94,500 and the scammer will demand even more money.',hi:'\u0905\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924: \u0906\u092a\u0915\u0947 \u096a,\u096b\u0966\u0966 \u0930\u0941\u092a\u092f\u0947 \u0921\u0942\u092c \u091c\u093e\u090f\u0902\u0917\u0947 \u0914\u0930 \u0920\u0917 \u0914\u0930 \u0905\u0927\u093f\u0915 \u092a\u0948\u0938\u094b\u0902 \u0915\u0940 \u092e\u093e\u0902\u0917 \u0915\u0930\u0947\u0917\u093e\u0964',mr:'\u0927\u094b\u0915\u093e\u0926\u093e\u092f\u0915: \u0924\u0941\u092e\u091a\u0947 \u096a,\u096b\u0966\u0966 \u0930\u0941\u092a\u092f\u0947 \u091c\u093e\u0924\u0940\u0932 \u0906\u0923\u093f \u092d\u093e\u092e\u091f\u093e \u0906\u0923\u0916\u0940 \u092a\u0948\u0938\u0947 \u092e\u093e\u0917\u0947\u0932.'}}]}},{id:'upi_fraud',icon:'\u26a1',badge:'UPI Safety',estimatedMinutes:3,title:{en:'UPI Payment Fraud & Collect Requests',hi:'\u092f\u0942\u092a\u0940\u0906\u0908 \u092d\u0941\u0917\u0924\u093e\u0928 \u0927\u094b\u0916\u093e\u0927\u0921\u093c\u0940',mr:'\u092f\u0942\u092a\u0940\u0906\u092f \u092a\u0947\u092e\u0947\u0902\u091f \u092b\u0938\u0935\u0923\u0942\u0915'},subtitle:{en:'Remember the golden rule: Entering your UPI PIN ALWAYS sends money',hi:'\u092f\u093e\u0926 \u0930\u0916\u0947\u0902: \u092f\u0942\u092a\u0940\u0906\u0908 \u092a\u093f\u0928 \u0926\u0930\u094d\u091c \u0915\u0930\u0928\u0947 \u0938\u0947 \u0939\u092e\u0947\u0936\u093e \u092a\u0948\u0938\u0947 \u0915\u091f\u0924\u0947 \u0939\u0948\u0902, \u0906\u0924\u0947 \u0928\u0939\u0940\u0902',mr:'\u0932\u0915\u094d\u0937\u093e\u0924 \u0920\u0947\u0935\u093e: \u092f\u0942\u092a\u0940\u0906\u092f \u092a\u093f\u0928 \u091f\u093e\u0915\u0932\u094d\u092f\u093e\u0928\u0947 \u0928\u0947\u0939\u092e\u0940 \u092a\u0948\u0938\u0947 \u091c\u093e\u0924\u093e\u0924, \u092f\u0947\u0924 \u0928\u093e\u0939\u0940\u0924'},goldenRule:{en:'You NEVER enter a UPI PIN to receive money. To receive funds, you only share your mobile number or QR code.',hi:'\u092a\u0948\u0938\u0947 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u092d\u0940 \u092d\u0940 \u092f\u0942\u092a\u0940\u0906\u0908 \u092a\u093f\u0928 \u0926\u0930\u094d\u091c \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e\u0964 \u0915\u0947\u0935\u0932 \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0902\u092c\u0930 \u092f\u093e \u0915\u094d\u092f\u0942\u0906\u0930 \u0915\u094b\u0921 \u0926\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964',mr:'\u092a\u0948\u0938\u0947 \u092e\u093f\u0933\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0915\u0927\u0940\u0939\u0940 \u092f\u0942\u092a\u0940\u0906\u092f \u092a\u093f\u0928 \u091f\u093e\u0915\u093e\u0935\u093e \u0932\u093e\u0917\u0924 \u0928\u093e\u0939\u0940. \u092b\u0915\u094d\u0924 \u0924\u0941\u092e\u091a\u093e \u092e\u094b\u092c\u093e\u0908\u0932 \u0928\u0902\u092c\u0930 \u092a\u0941\u0930\u0947\u0936\u093e \u0905\u0938\u0924\u094b.'},slides:[{slideNumber:1,headline:{en:'How the Collect Request Trap Works',hi:'\u0915\u0932\u0947\u0915\u094d\u091f \u0930\u093f\u0915\u094d\u0935\u0947\u0938\u094d\u091f \u0915\u093e \u091c\u093e\u0932 \u0915\u0948\u0938\u0947 \u0915\u093e\u092e \u0915\u0930\u0924\u093e \u0939\u0948',mr:'\u0915\u0932\u0947\u0915\u094d\u091f \u0930\u093f\u0915\u094d\u0935\u0947\u0938\u094d\u091f\u091a\u0940 \u092b\u0938\u0935\u0923\u0942\u0915 \u0915\u0936\u0940 \u0939\u094b\u0924\u0947'},content:{en:'A buyer on OLX agrees to buy your item and sends a payment request on PhonePe, GPay, or Paytm saying: "Accept this and enter PIN to receive money in your account."',hi:'\u0915\u094b\u0908 \u0916\u0930\u0940\u0926\u093e\u0930 \u0906\u092a\u0915\u094b \u092b\u094b\u0928\u092a\u0947 \u092f\u093e \u0917\u0942\u0917\u0932\u092a\u0947 \u092a\u0930 \u0915\u0932\u0947\u0915\u094d\u091f \u0930\u093f\u0915\u094d\u0935\u0947\u0938\u094d\u091f \u092d\u0947\u091c\u0924\u093e \u0939\u0948 \u0914\u0930 \u0915\u0939\u0924\u093e \u0939\u0948: "\u0907\u0938\u0947 \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930\u0947\u0902 \u0914\u0930 \u092a\u0948\u0938\u0947 \u092a\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0905\u092a\u0928\u093e \u092a\u093f\u0928 \u0921\u093e\u0932\u0947\u0902\u0964"',mr:'\u0916\u0930\u0947\u0926\u0940\u0926\u093e\u0930 \u092b\u094b\u0928\u092a\u0947 \u0915\u093f\u0902\u0935\u093e \u0917\u0941\u0917\u0932\u092a\u0947\u0935\u0930 \u0915\u0932\u0947\u0915\u094d\u091f \u0930\u093f\u0915\u094d\u0935\u0947\u0938\u094d\u091f \u092a\u093e\u0920\u0935\u0942\u0928 \u0938\u093e\u0902\u0917\u0924\u094b: "\u0939\u0940 \u0930\u093f\u0915\u094d\u0935\u0947\u0938\u094d\u091f \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930\u093e \u0906\u0923\u093f \u092a\u0948\u0938\u0947 \u0916\u093e\u0924\u094d\u092f\u093e\u0924 \u092f\u0947\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092a\u093f\u0928 \u091f\u093e\u0915\u093e."'},tip:{en:'The moment you enter your 4 or 6-digit PIN, your bank transfers the money to the scammer.',hi:'\u091c\u0948\u0938\u0947 \u0939\u0940 \u0906\u092a \u0905\u092a\u0928\u093e \u096a \u092f\u093e \u096c \u0905\u0902\u0915\u094b\u0902 \u0915\u093e \u092a\u093f\u0928 \u0921\u093e\u0932\u0924\u0947 \u0939\u0948\u0902, \u092a\u0948\u0938\u0947 \u0906\u092a\u0915\u0947 \u0916\u093e\u0924\u0947 \u0938\u0947 \u0924\u0941\u0930\u0902\u0924 \u0915\u091f \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964',mr:'\u0924\u0941\u092e\u094d\u0939\u0940 \u096a \u0915\u093f\u0902\u0935\u093e \u096c \u0905\u0902\u0915\u0940 \u092a\u093f\u0928 \u091f\u093e\u0915\u0924\u093e\u091a \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0916\u093e\u0924\u094d\u092f\u093e\u0924\u0942\u0928 \u092a\u0948\u0938\u0947 \u092d\u093e\u092e\u091f\u094d\u092f\u093e\u091a\u094d\u092f\u093e \u0916\u093e\u0924\u094d\u092f\u093e\u0924 \u091c\u092e\u093e \u0939\u094b\u0924\u093e\u0924.'},speechScript:{en:'Lesson 4: UPI Collect Requests. The most common UPI trap in India involves fraudsters claiming you must enter your PIN to receive money. Always remember: You only enter your PIN when YOU want to PAY.',hi:'\u092a\u093e\u0920 \u096a: \u092f\u0942\u092a\u0940\u0906\u0908 \u0915\u0932\u0947\u0915\u094d\u091f \u0930\u093f\u0915\u094d\u0935\u0947\u0938\u094d\u091f\u0964 \u092d\u093e\u0930\u0924 \u092e\u0947\u0902 \u0938\u092c\u0938\u0947 \u0906\u092e \u0927\u094b\u0916\u093e \u092f\u0939 \u0939\u0948 \u0915\u093f \u092a\u0948\u0938\u0947 \u092a\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092a\u093f\u0928 \u0921\u093e\u0932\u0928\u0947 \u0915\u094b \u0915\u0939\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u0939\u092e\u0947\u0936\u093e \u092f\u093e\u0926 \u0930\u0916\u0947\u0902: \u092a\u093f\u0928 \u0915\u0947\u0935\u0932 \u092a\u0948\u0938\u0947 \u092d\u0947\u091c\u0924\u0947 \u0938\u092e\u092f \u0921\u093e\u0932\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964',mr:'\u0927\u0921\u093e \u096a: \u092f\u0942\u092a\u0940\u0906\u092f \u0915\u0932\u0947\u0915\u094d\u091f \u0930\u093f\u0915\u094d\u0935\u0947\u0938\u094d\u091f. \u092a\u0948\u0938\u0947 \u092e\u093f\u0933\u0935\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092a\u093f\u0928 \u091f\u093e\u0915\u093e\u0935\u093e \u0932\u093e\u0917\u0924\u094b \u0939\u093e \u092e\u094b\u0920\u093e \u0917\u0948\u0930\u0938\u092e\u091c \u0906\u0939\u0947. \u0932\u0915\u094d\u0937\u093e\u0924 \u0920\u0947\u0935\u093e: \u091c\u0947\u0935\u094d\u0939\u093e \u0924\u0941\u092e\u094d\u0939\u093e\u0932\u093e \u0938\u094d\u0935\u0924\u0903 \u092a\u0948\u0938\u0947 \u092a\u093e\u0920\u0935\u093e\u092f\u091a\u0947 \u0905\u0938\u0924\u093e\u0924, \u0924\u0947\u0935\u094d\u0939\u093e\u091a \u092a\u093f\u0928 \u091f\u093e\u0915\u0932\u093e \u091c\u093e\u0924\u094b.'}}],quiz:{question:{en:'A person promises to send you \u20b95,000 and asks you to enter your UPI PIN to accept it. What will happen if you enter your PIN?',hi:'\u090f\u0915 \u0935\u094d\u092f\u0915\u094d\u0924\u093f \u0906\u092a\u0915\u094b \u096b,\u0966\u0966\u0966 \u0930\u0941\u092a\u092f\u0947 \u092d\u0947\u091c\u0928\u0947 \u0915\u093e \u0935\u093e\u0926\u093e \u0915\u0930\u0924\u093e \u0939\u0948 \u0914\u0930 \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092a\u093f\u0928 \u0921\u093e\u0932\u0928\u0947 \u0915\u094b \u0915\u0939\u0924\u093e \u0939\u0948\u0964 \u092a\u093f\u0928 \u0921\u093e\u0932\u0928\u0947 \u092a\u0930 \u0915\u094d\u092f\u093e \u0939\u094b\u0917\u093e?',mr:'\u090f\u0915\u093e \u0935\u094d\u092f\u0915\u094d\u0924\u0940\u0928\u0947 \u096b,\u0966\u0966\u0966 \u092a\u093e\u0920\u0935\u0923\u094d\u092f\u093e\u091a\u0947 \u0906\u0936\u094d\u0935\u093e\u0938\u0928 \u0926\u093f\u0932\u0947 \u0906\u0923\u093f \u0938\u094d\u0935\u0940\u0915\u093e\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092f\u0942\u092a\u0940\u0906\u092f \u092a\u093f\u0928 \u091f\u093e\u0915\u0923\u094d\u092f\u093e\u0938 \u0938\u093e\u0902\u0917\u093f\u0924\u0932\u0947. \u092a\u093f\u0928 \u091f\u093e\u0915\u0932\u094d\u092f\u093e\u0938 \u0915\u093e\u092f \u0939\u094b\u0908\u0932?'},options:[{id:'opt1',text:{en:'\u20b95,000 will be DEDUCTED from your bank account.',hi:'\u0906\u092a\u0915\u0947 \u0916\u093e\u0924\u0947 \u0938\u0947 \u096b,\u0966\u0966\u0966 \u0930\u0941\u092a\u092f\u0947 \u0915\u091f \u091c\u093e\u090f\u0902\u0917\u0947\u0964',mr:'\u0924\u0941\u092e\u091a\u094d\u092f\u093e \u092c\u0901\u0915 \u0916\u093e\u0924\u094d\u092f\u093e\u0924\u0942\u0928 \u096b,\u0966\u0966\u0966 \u0930\u0941\u092a\u092f\u0947 \u0915\u093e\u092a\u0932\u0947 \u091c\u093e\u0924\u0940\u0932.'},isCorrect:!0,explanation:{en:'Exactly right! Entering your PIN always authorizes a debit.',hi:'\u092c\u093f\u0932\u094d\u0915\u0941\u0932 \u0938\u0939\u0940! \u092a\u093f\u0928 \u0921\u093e\u0932\u0928\u0947 \u0915\u093e \u092e\u0924\u0932\u092c \u0939\u092e\u0947\u0936\u093e \u092a\u0948\u0938\u0947 \u0915\u091f\u0928\u093e \u0939\u094b\u0924\u093e \u0939\u0948\u0964',mr:'\u0905\u0917\u0926\u0940 \u092c\u0930\u094b\u092c\u0930! \u092a\u093f\u0928 \u091f\u093e\u0915\u0923\u0947 \u092e\u094d\u0939\u0923\u091c\u0947 \u0916\u093e\u0924\u094d\u092f\u093e\u0924\u0942\u0928 \u092a\u0948\u0938\u0947 \u091c\u093e\u0923\u0947.'}},{id:'opt2',text:{en:'\u20b95,000 will be credited safely into your account.',hi:'\u096b,\u0966\u0966\u0966 \u0930\u0941\u092a\u092f\u0947 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0930\u0942\u092a \u0938\u0947 \u0906\u092a\u0915\u0947 \u0916\u093e\u0924\u0947 \u092e\u0947\u0902 \u0906 \u091c\u093e\u090f\u0902\u0917\u0947\u0964',mr:'\u096b,\u0966\u0966\u0966 \u0930\u0941\u092a\u092f\u0947 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924\u092a\u0923\u0947 \u0916\u093e\u0924\u094d\u092f\u093e\u0924 \u091c\u092e\u093e \u0939\u094b\u0924\u0940\u0932.'},isCorrect:!1,explanation:{en:'Dangerous mistake: PIN stands for Personal Identification Number to spend money, never to receive it.',hi:'\u0917\u0902\u092d\u0940\u0930 \u092d\u0942\u0932: \u092a\u093f\u0928 \u0916\u0930\u094d\u091a \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0939\u094b\u0924\u093e \u0939\u0948, \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0928\u0939\u0940\u0902\u0964',mr:'\u092e\u094b\u0920\u0940 \u091a\u0942\u0915: \u092a\u093f\u0928 \u092a\u0948\u0938\u0947 \u0916\u0930\u094d\u091a \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0905\u0938\u0924\u094b, \u092e\u093f\u0933\u0935\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0928\u093e\u0939\u0940.'}}]}},{id:'fake_officer',icon:'\ud83d\udc6e',badge:'Impersonation',estimatedMinutes:3,title:{en:'Fake Bank Officer & Police Calls',hi:'\u092b\u0930\u094d\u091c\u0940 \u092c\u0948\u0902\u0915 \u0905\u0927\u093f\u0915\u093e\u0930\u0940 \u0914\u0930 \u092a\u0941\u0932\u093f\u0938 \u0915\u0949\u0932',mr:'\u092c\u0928\u093e\u0935\u091f \u092c\u0901\u0915 \u0905\u0927\u093f\u0915\u093e\u0930\u0940 \u0906\u0923\u093f \u092a\u094b\u0932\u093f\u0938 \u0915\u0949\u0932'},subtitle:{en:'How to handle high-pressure callers claiming your account is under legal investigation',hi:'\u0916\u093e\u0924\u0947 \u0915\u0940 \u091c\u093e\u0902\u091a \u0915\u093e \u0926\u093e\u0935\u093e \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u0947 \u092b\u0930\u094d\u091c\u0940 \u0915\u0949\u0932\u094b\u0902 \u0938\u0947 \u0915\u0948\u0938\u0947 \u0928\u093f\u092a\u091f\u0947\u0902',mr:'\u0916\u093e\u0924\u094d\u092f\u093e\u0935\u0930 \u0915\u093e\u0930\u0935\u093e\u0908\u091a\u0940 \u092d\u0940\u0924\u0940 \u0926\u093e\u0916\u0935\u0923\u093e\u0931\u094d\u092f\u093e \u0916\u094b\u091f\u094d\u092f\u093e \u0915\u0949\u0932\u094d\u0938\u092a\u093e\u0938\u0942\u0928 \u0938\u093e\u0935\u0927 \u0930\u093e\u0939\u093e'},goldenRule:{en:'Police and CBI officers NEVER demand money transfers or conduct criminal trials over phone or video calls.',hi:'\u092a\u0941\u0932\u093f\u0938 \u092f\u093e \u0938\u0940\u092c\u0940\u0906\u0908 \u0915\u092d\u0940 \u092d\u0940 \u092b\u094b\u0928 \u092f\u093e \u0935\u0940\u0921\u093f\u092f\u094b \u0915\u0949\u0932 \u092a\u0930 \u092a\u0948\u0938\u0947 \u091f\u094d\u0930\u093e\u0902\u0938\u092b\u0930 \u0915\u0930\u0928\u0947 \u0915\u0940 \u092e\u093e\u0902\u0917 \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u0940\u0964',mr:'\u092a\u094b\u0932\u093f\u0938 \u0915\u093f\u0902\u0935\u093e \u0938\u0940\u092c\u0940\u0906\u092f \u0915\u0927\u0940\u0939\u0940 \u092b\u094b\u0928\u0935\u0930 \u092a\u0948\u0938\u0947 \u091f\u094d\u0930\u093e\u0928\u094d\u0938\u092b\u0930 \u0915\u0930\u093e\u092f\u0932\u093e \u0938\u093e\u0902\u0917\u0924 \u0928\u093e\u0939\u0940\u0924.'},slides:[{slideNumber:1,headline:{en:'The Threat: Legal Intimidation',hi:'\u0927\u092e\u0915\u0940: \u0915\u093e\u0928\u0942\u0928\u0940 \u0915\u093e\u0930\u094d\u0930\u0935\u093e\u0908 \u0915\u093e \u0921\u0930',mr:'\u0927\u092e\u0915\u0940: \u0915\u093e\u092f\u0926\u0947\u0936\u0940\u0930 \u0915\u093e\u0930\u0935\u093e\u0908\u091a\u0940 \u092d\u0940\u0924\u0940'},content:{en:'You get a phone call from a stern voice claiming to be an IPS Officer or CBI Director: "Your Aadhaar is tied to money laundering. You will be arrested unless you verify your funds by sending them to a secure RBI account."',hi:'\u0915\u0949\u0932 \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u093e \u0916\u0941\u0926 \u0915\u094b \u0906\u0908\u092a\u0940\u090f\u0938 \u092f\u093e \u0938\u0940\u092c\u0940\u0906\u0908 \u0905\u0927\u093f\u0915\u093e\u0930\u0940 \u092c\u0924\u093e\u0924\u093e \u0939\u0948: "\u0906\u092a\u0915\u0947 \u0906\u0927\u093e\u0930 \u0938\u0947 \u092e\u0928\u0940 \u0932\u0949\u0928\u094d\u0921\u094d\u0930\u093f\u0902\u0917 \u0939\u0941\u0908 \u0939\u0948\u0964 \u0917\u093f\u0930\u092b\u094d\u0924\u093e\u0930\u0940 \u0938\u0947 \u092c\u091a\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0905\u092a\u0928\u0947 \u092a\u0948\u0938\u0947 \u0906\u0930\u092c\u0940\u0906\u0908 \u0915\u0947 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0916\u093e\u0924\u0947 \u092e\u0947\u0902 \u091f\u094d\u0930\u093e\u0902\u0938\u092b\u0930 \u0915\u0930\u0947\u0902\u0964"',mr:'\u0915\u0949\u0932 \u0915\u0930\u0923\u093e\u0930\u093e \u0938\u094d\u0935\u0924\u0903\u0932\u093e \u092a\u094b\u0932\u093f\u0938 \u0915\u093f\u0902\u0935\u093e \u0938\u0940\u092c\u0940\u0906\u092f \u0905\u0927\u093f\u0915\u093e\u0930\u0940 \u0938\u093e\u0902\u0917\u0924\u094b: "\u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0906\u0927\u093e\u0930\u0935\u0930 \u092c\u0947\u0915\u093e\u092f\u0926\u0947\u0936\u0940\u0930 \u0935\u094d\u092f\u0935\u0939\u093e\u0930 \u091d\u093e\u0932\u0947 \u0906\u0939\u0947\u0924. \u0905\u091f\u0915\u0947\u092a\u093e\u0938\u0942\u0928 \u0935\u093e\u091a\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092a\u0948\u0938\u0947 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0916\u093e\u0924\u094d\u092f\u093e\u0924 \u091f\u094d\u0930\u093e\u0928\u094d\u0938\u092b\u0930 \u0915\u0930\u093e."'},tip:{en:'There is NO SUCH THING as a "Secure RBI Verification Account". All money sent goes straight to the scammer.',hi:'"\u0906\u0930\u092c\u0940\u0906\u0908 \u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u0916\u093e\u0924\u093e" \u091c\u0948\u0938\u0940 \u0915\u094b\u0908 \u091a\u0940\u091c \u0928\u0939\u0940\u0902 \u0939\u094b\u0924\u0940\u0964 \u092d\u0947\u091c\u093e \u0917\u092f\u093e \u0938\u093e\u0930\u093e \u092a\u0948\u0938\u093e \u0920\u0917 \u0915\u0940 \u091c\u0947\u092c \u092e\u0947\u0902 \u091c\u093e\u0924\u093e \u0939\u0948\u0964',mr:'"\u0906\u0930\u092c\u0940\u0906\u092f \u0938\u093f\u0915\u094d\u092f\u0941\u0930\u093f\u091f\u0940 \u0916\u093e\u0924\u0947" \u0905\u0938\u0947 \u0915\u093e\u0939\u0940\u0939\u0940 \u0905\u0938\u094d\u0924\u093f\u0924\u094d\u0935\u093e\u0924 \u0928\u0938\u0924\u0947. \u0938\u0930\u094d\u0935 \u092a\u0948\u0938\u0947 \u092d\u093e\u092e\u091f\u094d\u092f\u093e\u0915\u0921\u0947 \u091c\u093e\u0924\u093e\u0924.'},speechScript:{en:'Lesson 5: Fake Officer Calls. Scammers pretend to be high-ranking police officers or tax officials to scare you. Remember that genuine police never ask you to transfer money to prove your innocence.',hi:'\u092a\u093e\u0920 \u096b: \u092b\u0930\u094d\u091c\u0940 \u0905\u0927\u093f\u0915\u093e\u0930\u0940 \u0915\u0949\u0932\u0964 \u0920\u0917 \u0906\u092a\u0915\u094b \u0921\u0930\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092c\u0921\u093c\u0947 \u092a\u0941\u0932\u093f\u0938 \u0905\u092b\u0938\u0930 \u092c\u0928\u0924\u0947 \u0939\u0948\u0902\u0964 \u092f\u093e\u0926 \u0930\u0916\u0947\u0902, \u0905\u0938\u0932\u0940 \u092a\u0941\u0932\u093f\u0938 \u0915\u092d\u0940 \u0905\u092a\u0928\u0940 \u092c\u0947\u0917\u0941\u0928\u093e\u0939\u0940 \u0938\u093e\u092c\u093f\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092a\u0948\u0938\u0947 \u0928\u0939\u0940\u0902 \u092e\u093e\u0902\u0917\u0924\u0940\u0964',mr:'\u0927\u0921\u093e \u096b: \u0916\u094b\u091f\u0947 \u0905\u0927\u093f\u0915\u093e\u0930\u0940 \u0915\u0949\u0932\u094d\u0938. \u092d\u093e\u092e\u091f\u0947 \u092e\u094b\u0920\u0947 \u092a\u094b\u0932\u093f\u0938 \u0905\u0927\u093f\u0915\u093e\u0930\u0940 \u0905\u0938\u0932\u094d\u092f\u093e\u091a\u0947 \u092d\u093e\u0938\u0935\u0942\u0928 \u0918\u093e\u092c\u0930\u0935\u0924\u093e\u0924. \u0916\u0930\u0947 \u092a\u094b\u0932\u093f\u0938 \u0915\u0927\u0940\u0939\u0940 \u092b\u094b\u0928\u0935\u0930 \u092a\u0948\u0938\u0947 \u092e\u093e\u0917\u0924 \u0928\u093e\u0939\u0940\u0924.'}}],quiz:{question:{en:'A caller claiming to be a CBI inspector tells you to transfer \u20b950,000 to an "RBI verification account" to clear your name. What should you do?',hi:'\u0938\u0940\u092c\u0940\u0906\u0908 \u0915\u093e \u0928\u093e\u092e \u0932\u0947\u0915\u0930 \u0915\u094b\u0908 \u0935\u094d\u092f\u0915\u094d\u0924\u093f \u0905\u092a\u0928\u0947 \u0928\u093e\u092e \u0915\u094b \u092c\u0947\u0926\u093e\u0917 \u0938\u093e\u092c\u093f\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u096b\u0966,\u0966\u0966\u0966 \u0930\u0941\u092a\u092f\u0947 \u091f\u094d\u0930\u093e\u0902\u0938\u092b\u0930 \u0915\u0930\u0928\u0947 \u0915\u094b \u0915\u0939\u0947 \u0924\u094b \u0906\u092a \u0915\u094d\u092f\u093e \u0915\u0930\u0947\u0902\u0917\u0947?',mr:'\u0938\u0940\u092c\u0940\u0906\u092f \u0905\u0927\u093f\u0915\u093e\u0930\u0940 \u0938\u093e\u0902\u0917\u0942\u0928 \u096b\u0966,\u0966\u0966\u0966 \u0930\u0941\u092a\u092f\u0947 \u0906\u0930\u092c\u0940\u0906\u092f \u0916\u093e\u0924\u094d\u092f\u093e\u0924 \u091f\u094d\u0930\u093e\u0928\u094d\u0938\u092b\u0930 \u0915\u0930\u093e\u092f\u0932\u093e \u0938\u093e\u0902\u0917\u093f\u0924\u0932\u0947 \u0924\u0930 \u0915\u093e\u092f \u0915\u0930\u093e\u0932?'},options:[{id:'opt1',text:{en:'Hang up immediately and call 1930 Cybercrime Helpline.',hi:'\u0924\u0941\u0930\u0902\u0924 \u092b\u094b\u0928 \u0915\u093e\u091f\u0947\u0902 \u0914\u0930 \u0967\u096f\u0969\u0966 \u0938\u093e\u0907\u092c\u0930 \u0939\u0947\u0932\u094d\u092a\u0932\u093e\u0907\u0928 \u092a\u0930 \u0915\u0949\u0932 \u0915\u0930\u0947\u0902\u0964',mr:'\u0924\u094d\u0935\u0930\u093f\u0924 \u092b\u094b\u0928 \u0915\u091f \u0915\u0930\u093e \u0906\u0923\u093f \u0967\u096f\u0969\u0966 \u0938\u093e\u092f\u092c\u0930 \u0939\u0947\u0932\u094d\u092a\u0932\u093e\u0907\u0928\u0935\u0930 \u0924\u0915\u094d\u0930\u093e\u0930 \u0915\u0930\u093e.'},isCorrect:!0,explanation:{en:'Excellent! Law enforcement never conducts financial audits over personal phone calls.',hi:'\u092c\u0939\u0941\u0924 \u092c\u0922\u093c\u093f\u092f\u093e! \u0915\u093e\u0928\u0942\u0928 \u092a\u094d\u0930\u0935\u0930\u094d\u0924\u0928 \u090f\u091c\u0947\u0902\u0938\u093f\u092f\u093e\u0902 \u0915\u092d\u0940 \u092b\u094b\u0928 \u092a\u0930 \u092a\u0948\u0938\u0947 \u091f\u094d\u0930\u093e\u0902\u0938\u092b\u0930 \u0915\u0930\u0928\u0947 \u0915\u094b \u0928\u0939\u0940\u0902 \u0915\u0939\u0924\u0940\u0902\u0964',mr:'\u0909\u0924\u094d\u0924\u092e! \u0915\u093e\u092f\u0926\u094d\u092f\u093e\u0928\u0941\u0938\u093e\u0930 \u092a\u094b\u0932\u093f\u0938 \u092b\u094b\u0928\u0935\u0930\u0942\u0928 \u0905\u0938\u0947 \u092a\u0948\u0938\u0947 \u091f\u094d\u0930\u093e\u0928\u094d\u0938\u092b\u0930 \u092e\u093e\u0917\u0924 \u0928\u093e\u0939\u0940\u0924.'}},{id:'opt2',text:{en:'Transfer the money quickly to avoid police coming to your home.',hi:'\u092a\u0941\u0932\u093f\u0938 \u0938\u0947 \u092c\u091a\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0924\u0941\u0930\u0902\u0924 \u092a\u0948\u0938\u0947 \u091f\u094d\u0930\u093e\u0902\u0938\u092b\u0930 \u0915\u0930 \u0926\u0947\u0902\u0964',mr:'\u092a\u094b\u0932\u093f\u0938 \u0918\u0930\u0940 \u092f\u0947\u090a \u0928\u092f\u0947\u0924 \u092e\u094d\u0939\u0923\u0942\u0928 \u0932\u0917\u0947\u091a \u092a\u0948\u0938\u0947 \u092a\u093e\u0920\u0935\u093e.'},isCorrect:!1,explanation:{en:'Unsafe: This is extortion. Once sent, the fraudster will cut contact.',hi:'\u0905\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924: \u092f\u0939 \u091c\u092c\u0930\u0928 \u0935\u0938\u0942\u0932\u0940 \u0939\u0948\u0964 \u092a\u0948\u0938\u0947 \u092d\u0947\u091c\u0924\u0947 \u0939\u0940 \u0920\u0917 \u092b\u094b\u0928 \u092c\u0902\u0926 \u0915\u0930 \u0926\u0947\u0917\u093e\u0964',mr:'\u0927\u094b\u0915\u093e\u0926\u093e\u092f\u0915: \u0939\u0940 \u0916\u0902\u0921\u0923\u0940 \u0906\u0939\u0947. \u092a\u0948\u0938\u0947 \u092e\u093f\u0933\u0924\u093e\u091a \u092d\u093e\u092e\u091f\u093e \u0917\u093e\u092f\u092c \u0939\u094b\u0908\u0932.'}}]}},{id:'phishing_links',icon:'\ud83d\udd17',badge:'Web Safety',estimatedMinutes:2,title:{en:'Phishing Links & Shortened URLs',hi:'\u092b\u093f\u0936\u093f\u0902\u0917 \u0932\u093f\u0902\u0915 \u0914\u0930 \u0938\u0902\u0926\u093f\u0917\u094d\u0927 \u0935\u0947\u092c\u0938\u093e\u0907\u091f',mr:'\u092b\u093f\u0936\u093f\u0902\u0917 \u0932\u093f\u0902\u0915\u094d\u0938 \u0906\u0923\u093f \u0938\u0902\u0936\u092f\u093e\u0938\u094d\u092a\u0926 \u0935\u0947\u092c\u0938\u093e\u0907\u091f'},subtitle:{en:'Spot suspicious links ending in .xyz, .top, or bit.ly disguised as official banks',hi:'\u090f\u0938\u090f\u092e\u090f\u0938 \u092e\u0947\u0902 \u0906\u0928\u0947 \u0935\u093e\u0932\u0947 \u091b\u094b\u091f\u0947 \u0914\u0930 \u0938\u0902\u0926\u093f\u0917\u094d\u0927 \u0932\u093f\u0902\u0915 \u0915\u0940 \u092a\u0939\u091a\u093e\u0928 \u0915\u0930\u0928\u093e \u0938\u0940\u0916\u0947\u0902',mr:'\u092e\u0947\u0938\u0947\u091c\u092e\u0927\u0940\u0932 \u0938\u0902\u0936\u092f\u093e\u0938\u094d\u092a\u0926 \u0906\u0923\u093f \u0916\u094b\u091f\u094d\u092f\u093e \u0932\u093f\u0902\u0915\u094d\u0938 \u0913\u0933\u0916\u093e\u092f\u0932\u093e \u0936\u093f\u0915\u093e'},goldenRule:{en:'Never click links from unknown numbers. Always type official website addresses directly into your browser.',hi:'\u0905\u091c\u094d\u091e\u093e\u0924 \u0928\u0902\u092c\u0930\u094b\u0902 \u0938\u0947 \u0906\u090f \u0932\u093f\u0902\u0915 \u092a\u0930 \u0915\u092d\u0940 \u0915\u094d\u0932\u093f\u0915 \u0928 \u0915\u0930\u0947\u0902\u0964 \u0939\u092e\u0947\u0936\u093e \u0906\u0927\u093f\u0915\u093e\u0930\u093f\u0915 \u0935\u0947\u092c\u0938\u093e\u0907\u091f \u0915\u093e \u092a\u0924\u093e \u0916\u0941\u0926 \u091f\u093e\u0907\u092a \u0915\u0930\u0947\u0902\u0964',mr:'\u0905\u0928\u094b\u0933\u0916\u0940 \u0928\u0902\u092c\u0930\u0935\u0930\u0942\u0928 \u0906\u0932\u0947\u0932\u094d\u092f\u093e \u0932\u093f\u0902\u0915\u0935\u0930 \u0915\u0927\u0940\u0939\u0940 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0942 \u0928\u0915\u093e. \u0928\u0947\u0939\u092e\u0940 \u0905\u0927\u093f\u0915\u0943\u0924 \u092a\u0924\u094d\u0924\u093e \u0938\u094d\u0935\u0924\u0903 \u091f\u093e\u0908\u092a \u0915\u0930\u093e.'},slides:[{slideNumber:1,headline:{en:'How to Spot a Fake Link',hi:'\u092b\u0930\u094d\u091c\u0940 \u0932\u093f\u0902\u0915 \u0915\u0940 \u092a\u0939\u091a\u093e\u0928 \u0915\u0948\u0938\u0947 \u0915\u0930\u0947\u0902',mr:'\u0916\u094b\u091f\u0940 \u0932\u093f\u0902\u0915 \u0915\u0936\u0940 \u0913\u0933\u0916\u093e\u092f\u091a\u0940'},content:{en:'Real Indian government and bank sites end in ".gov.in", ".bank.in", or official corporate domains like "sbi.co.in". Scammers use fake extensions like "sbi-rewards.xyz" or "incometax-refund.top".',hi:'\u0938\u0930\u0915\u093e\u0930\u0940 \u0914\u0930 \u092c\u0948\u0902\u0915 \u0938\u093e\u0907\u091f\u094b\u0902 \u0915\u0947 \u0905\u0902\u0924 \u092e\u0947\u0902 ".gov.in" \u092f\u093e ".co.in" \u0939\u094b\u0924\u093e \u0939\u0948\u0964 \u0920\u0917 "sbi-rewards.xyz" \u091c\u0948\u0938\u0947 \u092b\u0930\u094d\u091c\u0940 \u0928\u093e\u092e\u094b\u0902 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964',mr:'\u0936\u093e\u0938\u0915\u0940\u092f \u0906\u0923\u093f \u092c\u0901\u0915 \u0935\u0947\u092c\u0938\u093e\u0907\u091f\u091a\u094d\u092f\u093e \u0936\u0947\u0935\u091f\u0940 ".gov.in" \u0915\u093f\u0902\u0935\u093e ".co.in" \u0905\u0938\u0924\u0947. \u092d\u093e\u092e\u091f\u0947 ".xyz" \u0915\u093f\u0902\u0935\u093e ".top" \u0938\u093e\u0930\u0916\u0947 \u0916\u094b\u091f\u0947 \u092a\u0924\u094d\u0924\u0947 \u0935\u093e\u092a\u0930\u0924\u093e\u0924.'},tip:{en:'Look at the domain name carefully. Even a single changed letter indicates a dangerous imitation.',hi:'\u0921\u094b\u092e\u0947\u0928 \u0928\u093e\u092e \u0927\u094d\u092f\u093e\u0928 \u0938\u0947 \u0926\u0947\u0916\u0947\u0902\u0964 \u090f\u0915 \u0905\u0915\u094d\u0937\u0930 \u0915\u093e \u092d\u0940 \u092c\u0926\u0932\u093e\u0935 \u0928\u0915\u0932\u0940 \u0935\u0947\u092c\u0938\u093e\u0907\u091f \u0915\u093e \u0938\u0902\u0915\u0947\u0924 \u0939\u0948\u0964',mr:'\u0938\u094d\u092a\u0947\u0932\u093f\u0902\u0917 \u0915\u093e\u0933\u091c\u0940\u092a\u0942\u0930\u094d\u0935\u0915 \u0924\u092a\u093e\u0938\u093e. \u090f\u0915\u093e \u0905\u0915\u094d\u0937\u0930\u093e\u091a\u093e \u092b\u0930\u0915\u0939\u0940 \u092b\u0938\u0935\u0923\u0941\u0915\u0940\u091a\u0947 \u0932\u0915\u094d\u0937\u0923 \u0905\u0938\u0942 \u0936\u0915\u0924\u094b.'},speechScript:{en:'Lesson 6: Phishing Links. Fraudsters send SMS with links that look like your bank. Always examine the address. Genuine banks use .co.in or .bank.in, never random letters or unfamiliar extensions.',hi:'\u092a\u093e\u0920 \u096c: \u092b\u093f\u0936\u093f\u0902\u0917 \u0932\u093f\u0902\u0915\u0964 \u0927\u094b\u0916\u0947\u092c\u093e\u091c \u092c\u0948\u0902\u0915 \u091c\u0948\u0938\u0947 \u0926\u093f\u0916\u0928\u0947 \u0935\u093e\u0932\u0947 \u0932\u093f\u0902\u0915 \u092d\u0947\u091c\u0924\u0947 \u0939\u0948\u0902\u0964 \u0939\u092e\u0947\u0936\u093e \u0935\u0947\u092c\u0938\u093e\u0907\u091f \u0915\u093e \u092a\u0924\u093e \u091c\u093e\u0902\u091a\u0947\u0902\u0964 \u0905\u0938\u0932\u0940 \u092c\u0948\u0902\u0915 \u0915\u092d\u0940 \u0905\u091c\u094d\u091e\u093e\u0924 \u090f\u0915\u094d\u0938\u091f\u0947\u0902\u0936\u0928 \u0915\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u0947\u0964',mr:'\u0927\u0921\u093e \u096c: \u092b\u093f\u0936\u093f\u0902\u0917 \u0932\u093f\u0902\u0915\u094d\u0938. \u092d\u093e\u092e\u091f\u0947 \u092c\u0901\u0915\u0947\u0938\u093e\u0930\u0916\u094d\u092f\u093e \u0926\u093f\u0938\u0923\u093e\u0931\u094d\u092f\u093e \u0932\u093f\u0902\u0915 \u092a\u093e\u0920\u0935\u0924\u093e\u0924. \u092a\u0924\u094d\u0924\u093e \u0928\u0940\u091f \u0924\u092a\u093e\u0938\u093e. \u0916\u0930\u0940 \u092c\u0901\u0915 \u0915\u0927\u0940\u0939\u0940 \u0905\u0928\u094b\u0933\u0916\u0940 \u0928\u093e\u0935\u0947 \u0935\u093e\u092a\u0930\u0924 \u0928\u093e\u0939\u0940.'}}],quiz:{question:{en:'Which of the following website links is safe for State Bank of India net banking?',hi:'\u092d\u093e\u0930\u0924\u0940\u092f \u0938\u094d\u091f\u0947\u091f \u092c\u0948\u0902\u0915 \u0915\u0940 \u0928\u0947\u091f \u092c\u0948\u0902\u0915\u093f\u0902\u0917 \u0915\u0947 \u0932\u093f\u090f \u0907\u0928\u092e\u0947\u0902 \u0938\u0947 \u0915\u094c\u0928 \u0938\u093e \u0932\u093f\u0902\u0915 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0939\u0948?',mr:'\u0938\u094d\u091f\u0947\u091f \u092c\u0901\u0915 \u0911\u092b \u0907\u0902\u0921\u093f\u092f\u093e\u091a\u094d\u092f\u093e \u0928\u0947\u091f \u092c\u0901\u0915\u093f\u0902\u0917\u0938\u093e\u0920\u0940 \u0916\u093e\u0932\u0940\u0932\u092a\u0948\u0915\u0940 \u0915\u094b\u0923\u0924\u0940 \u0932\u093f\u0902\u0915 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0906\u0939\u0947?'},options:[{id:'opt1',text:{en:'https://www.onlinesbi.sbi',hi:'https://www.onlinesbi.sbi',mr:'https://www.onlinesbi.sbi'},isCorrect:!0,explanation:{en:'Correct! The ".sbi" top-level domain is officially owned and protected by SBI.',hi:'\u092c\u093f\u0932\u094d\u0915\u0941\u0932 \u0938\u0939\u0940! ".sbi" \u0906\u0927\u093f\u0915\u093e\u0930\u093f\u0915 \u0914\u0930 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0921\u094b\u092e\u0947\u0928 \u0939\u0948\u0964',mr:'\u0905\u0917\u0926\u0940 \u092c\u0930\u094b\u092c\u0930! ".sbi" \u0939\u0947 \u090f\u0938\u092c\u0940\u0906\u092f\u091a\u0947 \u0938\u094d\u0935\u0924\u0903\u091a\u0947 \u0905\u0927\u093f\u0915\u0943\u0924 \u0906\u0923\u093f \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0921\u094b\u092e\u0947\u0928 \u0906\u0939\u0947.'}},{id:'opt2',text:{en:'http://sbi-banking-login.xyz',hi:'http://sbi-banking-login.xyz',mr:'http://sbi-banking-login.xyz'},isCorrect:!1,explanation:{en:'Dangerous: ".xyz" with unencrypted HTTP is an obvious phishing trap.',hi:'\u0905\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924: ".xyz" \u0914\u0930 \u0905\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 HTTP \u0938\u093e\u092b \u0924\u094c\u0930 \u092a\u0930 \u092b\u093f\u0936\u093f\u0902\u0917 \u0915\u093e \u091c\u093e\u0932 \u0939\u0948\u0964',mr:'\u0927\u094b\u0915\u093e\u0926\u093e\u092f\u0915: ".xyz" \u0906\u0923\u093f HTTP \u0939\u0940 \u0909\u0918\u0921\u092a\u0923\u0947 \u0916\u094b\u091f\u0940 \u0932\u093f\u0902\u0915 \u0906\u0939\u0947.'}}]}},{id:'digital_arrest',icon:'\u2696\ufe0f',badge:'High Threat',estimatedMinutes:3,title:{en:'Digital Arrest Scams',hi:'\u0921\u093f\u091c\u093f\u091f\u0932 \u0905\u0930\u0947\u0938\u094d\u091f \u0927\u094b\u0916\u093e\u0927\u0921\u093c\u0940',mr:'\u0921\u093f\u091c\u093f\u091f\u0932 \u0905\u091f\u0915 \u092b\u0938\u0935\u0923\u0942\u0915'},subtitle:{en:'Understand how scammers use Skype video calls in fake police setups to trap seniors',hi:'\u0928\u0915\u0932\u0940 \u092a\u0941\u0932\u093f\u0938 \u0938\u094d\u091f\u0947\u0936\u0928 \u0914\u0930 \u0935\u0940\u0921\u093f\u092f\u094b \u0915\u0949\u0932 \u0926\u094d\u0935\u093e\u0930\u093e \u0921\u0930\u093e\u0928\u0947 \u0935\u093e\u0932\u0947 \u0917\u093f\u0930\u094b\u0939 \u0938\u0947 \u0938\u093e\u0935\u0927\u093e\u0928 \u0930\u0939\u0947\u0902',mr:'\u0935\u094d\u0939\u093f\u0921\u093f\u0913 \u0915\u0949\u0932\u0935\u0930\u0942\u0928 \u092a\u094b\u0932\u093f\u0938\u093e\u0902\u091a\u0947 \u0928\u093e\u091f\u0915 \u0915\u0930\u0942\u0928 \u092b\u0938\u0935\u0923\u093e\u0931\u094d\u092f\u093e \u091f\u094b\u0933\u0940\u092a\u093e\u0938\u0942\u0928 \u0938\u093e\u0935\u0927 \u0930\u093e\u0939\u093e'},goldenRule:{en:'There is NO provision for "Digital Arrest" under Indian law. No court or police officer can arrest you via Skype or WhatsApp.',hi:'\u092d\u093e\u0930\u0924\u0940\u092f \u0915\u093e\u0928\u0942\u0928 \u092e\u0947\u0902 "\u0921\u093f\u091c\u093f\u091f\u0932 \u0905\u0930\u0947\u0938\u094d\u091f" \u0915\u093e \u0915\u094b\u0908 \u092a\u094d\u0930\u093e\u0935\u0927\u093e\u0928 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u0915\u094b\u0908 \u092d\u0940 \u092a\u0941\u0932\u093f\u0938 \u092b\u094b\u0928 \u092a\u0930 \u0906\u092a\u0915\u094b \u0905\u0930\u0947\u0938\u094d\u091f \u0928\u0939\u0940\u0902 \u0915\u0930 \u0938\u0915\u0924\u0940\u0964',mr:'\u092d\u093e\u0930\u0924\u0940\u092f \u0915\u093e\u092f\u0926\u094d\u092f\u093e\u0924 "\u0921\u093f\u091c\u093f\u091f\u0932 \u0905\u091f\u0915" \u0928\u093e\u0935\u093e\u091a\u0940 \u0915\u094b\u0923\u0924\u0940\u0939\u0940 \u0938\u0902\u0915\u0932\u094d\u092a\u0928\u093e \u0928\u093e\u0939\u0940. \u0935\u094d\u0939\u0949\u091f\u094d\u0938\u0972\u092a\u0935\u0930 \u0915\u094b\u0923\u093e\u0932\u093e\u0939\u0940 \u0905\u091f\u0915 \u0915\u0930\u0924\u093e \u092f\u0947\u0924 \u0928\u093e\u0939\u0940.'},slides:[{slideNumber:1,headline:{en:'The Reality of Digital Arrest',hi:'\u0921\u093f\u091c\u093f\u091f\u0932 \u0905\u0930\u0947\u0938\u094d\u091f \u0915\u0940 \u0938\u091a\u094d\u091a\u093e\u0908',mr:'\u0921\u093f\u091c\u093f\u091f\u0932 \u0905\u091f\u0915\u0947\u091a\u0947 \u0935\u093e\u0938\u094d\u0924\u0935'},content:{en:'Scammers dress in fake police uniforms, sit in front of fake police station emblems, and force you to stay on video call for hours claiming you are under "Digital Arrest" until you empty your fixed deposits.',hi:'\u0920\u0917 \u0928\u0915\u0932\u0940 \u092a\u0941\u0932\u093f\u0938 \u0935\u0930\u094d\u0926\u0940 \u092a\u0939\u0928\u0915\u0930 \u0935\u0940\u0921\u093f\u092f\u094b \u0915\u0949\u0932 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u0915\u0939\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0906\u092a "\u0921\u093f\u091c\u093f\u091f\u0932 \u0905\u0930\u0947\u0938\u094d\u091f" \u092e\u0947\u0902 \u0939\u0948\u0902\u0964 \u0935\u0947 \u0906\u092a\u0915\u0940 \u091c\u092e\u093e \u092a\u0942\u0902\u091c\u0940 \u0916\u093e\u0932\u0940 \u0915\u0930\u093e\u0928\u0947 \u0924\u0915 \u0915\u0949\u0932 \u0915\u093e\u091f\u0928\u0947 \u0928\u0939\u0940\u0902 \u0926\u0947\u0924\u0947\u0964',mr:'\u092d\u093e\u092e\u091f\u0947 \u092a\u094b\u0932\u093f\u0938\u093e\u0902\u091a\u093e \u0917\u0923\u0935\u0947\u0936 \u0918\u093e\u0932\u0942\u0928 \u0935\u094d\u0939\u093f\u0921\u093f\u0913 \u0915\u0949\u0932 \u0915\u0930\u0924\u093e\u0924 \u0906\u0923\u093f \u0921\u093f\u091c\u093f\u091f\u0932 \u0905\u091f\u0915\u0947\u091a\u0940 \u092d\u0940\u0924\u0940 \u0926\u093e\u0916\u0935\u0942\u0928 \u0924\u0941\u092e\u091a\u0940 \u0938\u0930\u094d\u0935 \u092c\u091a\u0924 \u0932\u0941\u091f\u0924\u093e\u0924.'},tip:{en:'Indian police NEVER conduct video call interrogations or demand fund transfers. Hang up immediately.',hi:'\u092d\u093e\u0930\u0924\u0940\u092f \u092a\u0941\u0932\u093f\u0938 \u0915\u092d\u0940 \u0935\u0940\u0921\u093f\u092f\u094b \u0915\u0949\u0932 \u092a\u0930 \u092a\u0942\u091b\u0924\u093e\u091b \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u0940 \u0914\u0930 \u0928 \u0939\u0940 \u092a\u0948\u0938\u0947 \u092e\u093e\u0902\u0917\u0924\u0940 \u0939\u0948\u0964 \u0924\u0941\u0930\u0902\u0924 \u092b\u094b\u0928 \u0915\u093e\u091f \u0926\u0947\u0902\u0964',mr:'\u092d\u093e\u0930\u0924\u0940\u092f \u092a\u094b\u0932\u093f\u0938 \u0915\u0927\u0940\u0939\u0940 \u0935\u094d\u0939\u093f\u0921\u093f\u0913 \u0915\u0949\u0932\u0935\u0930\u0942\u0928 \u091a\u094c\u0915\u0936\u0940 \u0915\u093f\u0902\u0935\u093e \u092a\u0948\u0936\u093e\u0902\u091a\u0940 \u092e\u093e\u0917\u0923\u0940 \u0915\u0930\u0924 \u0928\u093e\u0939\u0940\u0924. \u0924\u094d\u0935\u0930\u093f\u0924 \u0915\u0949\u0932 \u0915\u091f \u0915\u0930\u093e.'},speechScript:{en:'Lesson 7: Digital Arrest Scams. Criminals use fake video calls with police logos to isolate seniors. Remember, Digital Arrest does not exist in Indian law. If anyone tries this, hang up and tell your family immediately.',hi:'\u092a\u093e\u0920 \u096d: \u0921\u093f\u091c\u093f\u091f\u0932 \u0905\u0930\u0947\u0938\u094d\u091f\u0964 \u0905\u092a\u0930\u093e\u0927\u0940 \u092a\u0941\u0932\u093f\u0938 \u0935\u0930\u094d\u0926\u0940 \u092e\u0947\u0902 \u0935\u0940\u0921\u093f\u092f\u094b \u0915\u0949\u0932 \u0915\u0930\u0915\u0947 \u0921\u0930\u093e\u0924\u0947 \u0939\u0948\u0902\u0964 \u092f\u093e\u0926 \u0930\u0916\u0947\u0902, \u092d\u093e\u0930\u0924\u0940\u092f \u0915\u093e\u0928\u0942\u0928 \u092e\u0947\u0902 \u0921\u093f\u091c\u093f\u091f\u0932 \u0905\u0930\u0947\u0938\u094d\u091f \u091c\u0948\u0938\u093e \u0915\u0941\u091b \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u0910\u0938\u093e \u0915\u0949\u0932 \u0906\u0928\u0947 \u092a\u0930 \u0924\u0941\u0930\u0902\u0924 \u092b\u094b\u0928 \u0915\u093e\u091f\u0947\u0902 \u0914\u0930 \u092a\u0930\u093f\u0935\u093e\u0930 \u0915\u094b \u092c\u0924\u093e\u090f\u0902\u0964',mr:'\u0927\u0921\u093e \u096d: \u0921\u093f\u091c\u093f\u091f\u0932 \u0905\u091f\u0915. \u092d\u093e\u092e\u091f\u0947 \u0935\u094d\u0939\u093f\u0921\u093f\u0913 \u0915\u0949\u0932\u0935\u0930 \u092a\u094b\u0932\u093f\u0938\u093e\u0902\u091a\u0947 \u0938\u094b\u0902\u0917 \u0906\u0923\u0924\u093e\u0924. \u0915\u093e\u092f\u0926\u094d\u092f\u093e\u0928\u0941\u0938\u093e\u0930 \u0921\u093f\u091c\u093f\u091f\u0932 \u0905\u091f\u0915 \u0905\u0938\u094d\u0924\u093f\u0924\u094d\u0935\u093e\u0924 \u0928\u093e\u0939\u0940. \u0905\u0938\u093e \u0915\u0949\u0932 \u0906\u0932\u094d\u092f\u093e\u0938 \u0932\u0917\u0947\u091a \u092b\u094b\u0928 \u092c\u0902\u0926 \u0915\u0930\u093e.'}}],quiz:{question:{en:'A person on a WhatsApp video call in a police uniform orders you not to leave your room because you are under "Digital Arrest". What should you do?',hi:'\u0935\u0940\u0921\u093f\u092f\u094b \u0915\u0949\u0932 \u092a\u0930 \u092a\u0941\u0932\u093f\u0938 \u0935\u0930\u094d\u0926\u0940 \u092a\u0939\u0928\u0947 \u0935\u094d\u092f\u0915\u094d\u0924\u093f \u0915\u0939\u0947 \u0915\u093f \u0906\u092a "\u0921\u093f\u091c\u093f\u091f\u0932 \u0905\u0930\u0947\u0938\u094d\u091f" \u0939\u0948\u0902 \u0914\u0930 \u0915\u092e\u0930\u093e \u0928 \u091b\u094b\u0921\u093c\u0947\u0902\u0964 \u0906\u092a \u0915\u094d\u092f\u093e \u0915\u0930\u0947\u0902\u0917\u0947?',mr:'\u0935\u094d\u0939\u093f\u0921\u093f\u0913 \u0915\u0949\u0932\u0935\u0930 \u092a\u094b\u0932\u093f\u0938\u093e\u0902\u091a\u094d\u092f\u093e \u0917\u0923\u0935\u0947\u0936\u093e\u0924\u0940\u0932 \u0935\u094d\u092f\u0915\u094d\u0924\u0940\u0928\u0947 \u0924\u0941\u092e\u094d\u0939\u093e\u0932\u093e "\u0921\u093f\u091c\u093f\u091f\u0932 \u0905\u091f\u0915" \u091d\u093e\u0932\u094d\u092f\u093e\u091a\u0947 \u0938\u093e\u0902\u0917\u0942\u0928 \u0916\u094b\u0932\u0940\u0924\u0942\u0928 \u092c\u093e\u0939\u0947\u0930 \u0928 \u092a\u0921\u0923\u094d\u092f\u093e\u091a\u093e \u0939\u0941\u0915\u0942\u092e \u0926\u093f\u0932\u093e. \u0915\u093e\u092f \u0915\u0930\u093e\u0932?'},options:[{id:'opt1',text:{en:'Disconnect the video call immediately and report to 1930.',hi:'\u0924\u0941\u0930\u0902\u0924 \u0935\u0940\u0921\u093f\u092f\u094b \u0915\u0949\u0932 \u0915\u093e\u091f\u0947\u0902 \u0914\u0930 \u0967\u096f\u0969\u0966 \u092a\u0930 \u0936\u093f\u0915\u093e\u092f\u0924 \u0915\u0930\u0947\u0902\u0964',mr:'\u0924\u094d\u0935\u0930\u093f\u0924 \u0935\u094d\u0939\u093f\u0921\u093f\u0913 \u0915\u0949\u0932 \u0915\u091f \u0915\u0930\u093e \u0906\u0923\u093f \u0967\u096f\u0969\u0966 \u0935\u0930 \u0924\u0915\u094d\u0930\u093e\u0930 \u0915\u0930\u093e.'},isCorrect:!0,explanation:{en:'Correct! Digital arrest is completely fraudulent. Hanging up breaks their psychological grip.',hi:'\u092c\u093f\u0932\u094d\u0915\u0941\u0932 \u0938\u0939\u0940! \u0921\u093f\u091c\u093f\u091f\u0932 \u0905\u0930\u0947\u0938\u094d\u091f \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u0938\u0947 \u092b\u0930\u094d\u091c\u0940 \u0939\u0948\u0964 \u0915\u0949\u0932 \u0915\u093e\u091f\u0924\u0947 \u0939\u0940 \u0909\u0928\u0915\u093e \u0926\u092c\u093e\u0935 \u091f\u0942\u091f \u091c\u093e\u0924\u093e \u0939\u0948\u0964',mr:'\u0905\u0917\u0926\u0940 \u092c\u0930\u094b\u092c\u0930! \u0921\u093f\u091c\u093f\u091f\u0932 \u0905\u091f\u0915 \u0939\u0940 \u0915\u0947\u0935\u0933 \u092b\u0938\u0935\u0923\u0942\u0915 \u0906\u0939\u0947. \u0915\u0949\u0932 \u0915\u091f \u0915\u0947\u0932\u094d\u092f\u093e\u0928\u0947 \u0924\u094d\u092f\u093e\u0902\u091a\u0947 \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0923 \u0938\u0941\u091f\u0924\u0947.'}},{id:'opt2',text:{en:'Stay on the video call and transfer money as ordered.',hi:'\u0915\u0949\u0932 \u092a\u0930 \u092c\u0928\u0947 \u0930\u0939\u0947\u0902 \u0914\u0930 \u0909\u0928\u0915\u0947 \u0915\u0939\u0947 \u0905\u0928\u0941\u0938\u093e\u0930 \u092a\u0948\u0938\u0947 \u091f\u094d\u0930\u093e\u0902\u0938\u092b\u0930 \u0915\u0930\u0947\u0902\u0964',mr:'\u0915\u0949\u0932 \u0938\u0941\u0930\u0942 \u0920\u0947\u0935\u093e \u0906\u0923\u093f \u0938\u093e\u0902\u0917\u093f\u0924\u0932\u094d\u092f\u093e\u092a\u094d\u0930\u092e\u093e\u0923\u0947 \u092a\u0948\u0938\u0947 \u092a\u093e\u0920\u0935\u093e.'},isCorrect:!1,explanation:{en:'Unsafe: They will intimidate you until all your life savings are stolen.',hi:'\u0905\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924: \u0935\u0947 \u0906\u092a\u0915\u0940 \u091c\u0940\u0935\u0928\u092d\u0930 \u0915\u0940 \u0915\u092e\u093e\u0908 \u0932\u0942\u091f\u0928\u0947 \u0924\u0915 \u0921\u0930\u093e\u0924\u0947 \u0930\u0939\u0947\u0902\u0917\u0947\u0964',mr:'\u0927\u094b\u0915\u093e\u0926\u093e\u092f\u0915: \u0924\u0947 \u0924\u0941\u092e\u091a\u0947 \u0938\u0930\u094d\u0935 \u0915\u0937\u094d\u091f\u093e\u091a\u0947 \u092a\u0948\u0938\u0947 \u0932\u0941\u091f\u0942\u0928 \u0918\u0947\u0924\u0940\u0932.'}}]}},{id:'customer_support',icon:'\ud83d\udcde',badge:'Search Engine Trap',estimatedMinutes:2,title:{en:'Fake Customer Care Scams',hi:'\u092b\u0930\u094d\u091c\u0940 \u0915\u0938\u094d\u091f\u092e\u0930 \u0915\u0947\u092f\u0930 \u0927\u094b\u0916\u093e\u0927\u0921\u093c\u0940',mr:'\u092c\u0928\u093e\u0935\u091f \u0917\u094d\u0930\u093e\u0939\u0915 \u0938\u0947\u0935\u093e \u092b\u0938\u0935\u0923\u0942\u0915'},subtitle:{en:'Why you should never search Google for customer support phone numbers',hi:'\u0917\u0942\u0917\u0932 \u092a\u0930 \u0915\u0938\u094d\u091f\u092e\u0930 \u0915\u0947\u092f\u0930 \u0928\u0902\u092c\u0930 \u0916\u094b\u091c\u0928\u0947 \u0915\u093e \u091c\u094b\u0916\u093f\u092e \u0938\u092e\u091d\u0947\u0902',mr:'\u0917\u0941\u0917\u0932\u0935\u0930 \u0915\u0938\u094d\u091f\u092e\u0930 \u0915\u0947\u0905\u0930 \u0928\u0902\u092c\u0930 \u0936\u094b\u0927\u0923\u094d\u092f\u093e\u091a\u0947 \u0927\u094b\u0915\u0947 \u0938\u092e\u091c\u0942\u0928 \u0918\u094d\u092f\u093e'},goldenRule:{en:'Never trust helpline numbers found on Google search. Always find official contacts inside your authentic bank or shopping app.',hi:'\u0917\u0942\u0917\u0932 \u0938\u0930\u094d\u091a \u092a\u0930 \u092e\u093f\u0932\u0947 \u0939\u0947\u0932\u094d\u092a\u0932\u093e\u0907\u0928 \u0928\u0902\u092c\u0930\u094b\u0902 \u092a\u0930 \u0915\u092d\u0940 \u092d\u0930\u094b\u0938\u093e \u0928 \u0915\u0930\u0947\u0902\u0964 \u0939\u092e\u0947\u0936\u093e \u0905\u092a\u0928\u0947 \u0905\u0938\u0932\u0940 \u0910\u092a \u0915\u0947 \u092d\u0940\u0924\u0930 \u0938\u0939\u093e\u092f\u0924\u093e \u0905\u0928\u0941\u092d\u093e\u0917 \u092e\u0947\u0902 \u091c\u093e\u090f\u0902\u0964',mr:'\u0917\u0941\u0917\u0932\u0935\u0930 \u0926\u093f\u0938\u0923\u093e\u0931\u094d\u092f\u093e \u0915\u0938\u094d\u091f\u092e\u0930 \u0915\u0947\u0905\u0930 \u0928\u0902\u092c\u0930\u0935\u0930 \u0915\u0927\u0940\u0939\u0940 \u0935\u093f\u0936\u094d\u0935\u093e\u0938 \u0920\u0947\u0935\u0942 \u0928\u0915\u093e. \u0928\u0947\u0939\u092e\u0940 \u0905\u0927\u093f\u0915\u0943\u0924 \u0972\u092a\u092e\u0927\u0940\u0932 \u0928\u0902\u092c\u0930 \u0935\u093e\u092a\u0930\u093e.'},slides:[{slideNumber:1,headline:{en:'The Search Engine Trap',hi:'\u0938\u0930\u094d\u091a \u0907\u0902\u091c\u0928 \u0915\u093e \u091c\u093e\u0932',mr:'\u0938\u0930\u094d\u091a \u0907\u0902\u091c\u093f\u0928\u091a\u093e \u0938\u093e\u092a\u0933\u093e'},content:{en:'Scammers pay to display fake toll-free numbers at the top of Google search results for banks, airlines, and courier services. When seniors call, they ask you to install AnyDesk or TeamViewer to "fix your issue".',hi:'\u0920\u0917 \u0917\u0942\u0917\u0932 \u092a\u0930 \u0905\u092a\u0928\u0947 \u092b\u0930\u094d\u091c\u0940 \u0928\u0902\u092c\u0930 \u090a\u092a\u0930 \u0926\u093f\u0916\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0935\u093f\u091c\u094d\u091e\u093e\u092a\u0928 \u0926\u0947\u0924\u0947 \u0939\u0948\u0902\u0964 \u091c\u092c \u0906\u092a \u0915\u0949\u0932 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0924\u094b \u0935\u0947 \u090f\u0928\u0940\u0921\u0947\u0938\u094d\u0915 \u091c\u0948\u0938\u093e \u0930\u093f\u092e\u094b\u091f \u0910\u092a \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0930\u0928\u0947 \u0915\u094b \u0915\u0939\u0924\u0947 \u0939\u0948\u0902\u0964',mr:'\u092d\u093e\u092e\u091f\u0947 \u0917\u0941\u0917\u0932\u0935\u0930 \u0916\u094b\u091f\u0947 \u0928\u0902\u092c\u0930 \u0935\u0930 \u0906\u0923\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u091c\u093e\u0939\u093f\u0930\u093e\u0924\u0940 \u0926\u0947\u0924\u093e\u0924. \u0924\u0941\u092e\u094d\u0939\u0940 \u0915\u0949\u0932 \u0915\u0947\u0932\u094d\u092f\u093e\u0935\u0930 \u0924\u0947 \u092e\u094b\u092c\u093e\u0908\u0932\u092e\u0927\u094d\u092f\u0947 \u090f\u0928\u0940\u0921\u0947\u0938\u094d\u0915 \u0938\u093e\u0930\u0916\u0947 \u0972\u092a \u0921\u093e\u090a\u0928\u0932\u094b\u0921 \u0915\u0930\u093e\u092f\u0932\u093e \u0938\u093e\u0902\u0917\u0924\u093e\u0924.'},tip:{en:'Never install remote screen-sharing apps on instructions from unknown phone callers.',hi:'\u0905\u091c\u094d\u091e\u093e\u0924 \u0915\u0949\u0932 \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u094b\u0902 \u0915\u0947 \u0915\u0939\u0928\u0947 \u092a\u0930 \u0938\u094d\u0915\u094d\u0930\u0940\u0928-\u0936\u0947\u092f\u0930\u093f\u0902\u0917 \u0910\u092a \u0915\u092d\u0940 \u0907\u0902\u0938\u094d\u091f\u0949\u0932 \u0928 \u0915\u0930\u0947\u0902\u0964',mr:'\u092b\u094b\u0928\u0935\u0930\u0940\u0932 \u0905\u0928\u094b\u0933\u0916\u0940 \u0935\u094d\u092f\u0915\u094d\u0924\u0940\u091a\u094d\u092f\u093e \u0938\u093e\u0902\u0917\u0923\u094d\u092f\u093e\u0935\u0930\u0942\u0928 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0936\u0947\u0905\u0930\u093f\u0902\u0917 \u0972\u092a \u0915\u0927\u0940\u0939\u0940 \u0907\u0928\u094d\u0938\u094d\u091f\u0949\u0932 \u0915\u0930\u0942 \u0928\u0915\u093e.'},speechScript:{en:'Lesson 8: Fake Customer Support. When you need help with an app or delivery, never search random numbers on the internet. Fraudsters post their own numbers and ask you to install screen sharing tools to steal your money.',hi:'\u092a\u093e\u0920 \u096e: \u092b\u0930\u094d\u091c\u0940 \u0915\u0938\u094d\u091f\u092e\u0930 \u0938\u092a\u094b\u0930\u094d\u091f\u0964 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0938\u092e\u0938\u094d\u092f\u093e \u0915\u0947 \u0938\u092e\u093e\u0927\u093e\u0928 \u0915\u0947 \u0932\u093f\u090f \u0907\u0902\u091f\u0930\u0928\u0947\u091f \u092a\u0930 \u0930\u0948\u0902\u0921\u092e \u0928\u0902\u092c\u0930 \u0928 \u0916\u094b\u091c\u0947\u0902\u0964 \u0927\u094b\u0916\u0947\u092c\u093e\u091c \u0905\u092a\u0928\u0947 \u0928\u0902\u092c\u0930 \u0921\u093e\u0932\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u0938\u094d\u0915\u094d\u0930\u0940\u0928-\u0936\u0947\u092f\u0930\u093f\u0902\u0917 \u0910\u092a \u0938\u0947 \u0906\u092a\u0915\u093e \u092b\u094b\u0928 \u0939\u0948\u0915 \u0915\u0930 \u0932\u0947\u0924\u0947 \u0939\u0948\u0902\u0964',mr:'\u0927\u0921\u093e \u096e: \u092c\u0928\u093e\u0935\u091f \u0917\u094d\u0930\u093e\u0939\u0915 \u0938\u0947\u0935\u093e. \u0915\u094b\u0923\u0924\u094d\u092f\u093e\u0939\u0940 \u0938\u092e\u0938\u094d\u092f\u0947\u0938\u093e\u0920\u0940 \u0907\u0902\u091f\u0930\u0928\u0947\u091f\u0935\u0930 \u0928\u0902\u092c\u0930 \u0936\u094b\u0927\u0942 \u0928\u0915\u093e. \u092d\u093e\u092e\u091f\u0947 \u0916\u094b\u091f\u0947 \u0928\u0902\u092c\u0930 \u091f\u093e\u0915\u0942\u0928 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0936\u0947\u0905\u0930\u093f\u0902\u0917 \u0972\u092a\u0926\u094d\u0935\u093e\u0930\u0947 \u092b\u094b\u0928 \u0939\u0945\u0915 \u0915\u0930\u0924\u093e\u0924.'}}],quiz:{question:{en:'You need customer support for a failed online purchase. How should you find the genuine customer care number?',hi:'\u0911\u0928\u0932\u093e\u0907\u0928 \u0916\u0930\u0940\u0926\u093e\u0930\u0940 \u0915\u0940 \u0938\u092e\u0938\u094d\u092f\u093e \u0915\u0947 \u0932\u093f\u090f \u0938\u0939\u0940 \u0915\u0938\u094d\u091f\u092e\u0930 \u0915\u0947\u092f\u0930 \u0928\u0902\u092c\u0930 \u0915\u0948\u0938\u0947 \u0922\u0942\u0902\u0922\u0928\u093e \u091a\u093e\u0939\u093f\u090f?',mr:'\u0911\u0928\u0932\u093e\u0907\u0928 \u0916\u0930\u0947\u0926\u0940\u091a\u094d\u092f\u093e \u0938\u092e\u0938\u094d\u092f\u0947\u0938\u093e\u0920\u0940 \u0905\u0927\u093f\u0915\u0943\u0924 \u0915\u0938\u094d\u091f\u092e\u0930 \u0915\u0947\u0905\u0930 \u0928\u0902\u092c\u0930 \u0915\u0938\u093e \u092e\u093f\u0933\u0935\u093e\u0935\u093e?'},options:[{id:'opt1',text:{en:'Open the official app directly and go to the built-in Help / Support section.',hi:'\u0938\u0940\u0927\u0947 \u0906\u0927\u093f\u0915\u093e\u0930\u093f\u0915 \u0910\u092a \u0916\u094b\u0932\u0947\u0902 \u0914\u0930 \u0909\u0938\u092e\u0947\u0902 \u0926\u093f\u090f \u0917\u090f \u0938\u0939\u093e\u092f\u0924\u093e \u0905\u0928\u0941\u092d\u093e\u0917 \u092e\u0947\u0902 \u091c\u093e\u090f\u0902\u0964',mr:'\u0925\u0947\u091f \u0905\u0927\u093f\u0915\u0943\u0924 \u0972\u092a \u0909\u0918\u0921\u093e \u0906\u0923\u093f \u0924\u094d\u092f\u093e\u0924\u0940\u0932 \u092e\u0926\u0924 (Help) \u0935\u093f\u092d\u093e\u0917\u093e\u0924 \u091c\u093e.'},isCorrect:!0,explanation:{en:'Correct! Contact details inside verified apps cannot be manipulated by outside scammers.',hi:'\u092c\u093f\u0932\u094d\u0915\u0941\u0932 \u0938\u0939\u0940! \u0910\u092a \u0915\u0947 \u0905\u0902\u0926\u0930 \u0915\u0940 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0914\u0930 \u092a\u094d\u0930\u092e\u093e\u0923\u093f\u0924 \u0939\u094b\u0924\u0940 \u0939\u0948\u0964',mr:'\u0905\u0917\u0926\u0940 \u092c\u0930\u094b\u092c\u0930! \u0905\u0927\u093f\u0915\u0943\u0924 \u0972\u092a\u092e\u0927\u0940\u0932 \u092e\u093e\u0939\u093f\u0924\u0940 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0906\u0923\u093f \u0916\u0930\u0940 \u0905\u0938\u0924\u0947.'}},{id:'opt2',text:{en:'Call the first toll-free number that appears on Google search results.',hi:'\u0917\u0942\u0917\u0932 \u0938\u0930\u094d\u091a \u092a\u0930 \u0938\u092c\u0938\u0947 \u090a\u092a\u0930 \u0906\u0928\u0947 \u0935\u093e\u0932\u0947 \u091f\u094b\u0932-\u092b\u094d\u0930\u0940 \u0928\u0902\u092c\u0930 \u092a\u0930 \u0915\u0949\u0932 \u0915\u0930\u0947\u0902\u0964',mr:'\u0917\u0941\u0917\u0932 \u0938\u0930\u094d\u091a\u0935\u0930 \u0938\u0930\u094d\u0935\u093e\u0924 \u0935\u0930 \u0926\u093f\u0938\u0923\u093e\u0931\u094d\u092f\u093e \u0928\u0902\u092c\u0930\u0935\u0930 \u0915\u0949\u0932 \u0915\u0930\u093e.'},isCorrect:!1,explanation:{en:'Dangerous: Scammers regularly manipulate search results with fake numbers.',hi:'\u0905\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924: \u0927\u094b\u0916\u0947\u092c\u093e\u091c \u0938\u0930\u094d\u091a \u0907\u0902\u091c\u0928 \u092a\u0930 \u0905\u092a\u0928\u0947 \u092b\u0930\u094d\u091c\u0940 \u0928\u0902\u092c\u0930 \u0935\u093f\u091c\u094d\u091e\u093e\u092a\u093f\u0924 \u0915\u0930 \u0926\u0947\u0924\u0947 \u0939\u0948\u0902\u0964',mr:'\u0927\u094b\u0915\u093e\u0926\u093e\u092f\u0915: \u092d\u093e\u092e\u091f\u0947 \u0917\u0941\u0917\u0932\u0935\u0930 \u0938\u094d\u0935\u0924\u0903\u091a\u0947 \u0916\u094b\u091f\u0947 \u0928\u0902\u092c\u0930 \u091c\u093e\u0939\u093f\u0930\u093e\u0924 \u092e\u094d\u0939\u0923\u0942\u0928 \u091f\u093e\u0915\u0924\u093e\u0924.'}}]}}]},544,[]);
